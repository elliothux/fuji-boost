+    fn source_hash(c: &Config) -> String {
+        let bytes: Vec<u8> = c
+            .initial_script
+            .iter()
+            .chain(&c.preparation)
+            .chain(&c.profile)
+            .flat_map(|(o, v)| o.to_le_bytes().into_iter().chain(v.to_le_bytes()))
+            .collect();
+        fujimod_emulator_devices::fingerprint::bytes(&bytes)["sha256"]
+            .as_str()
+            .unwrap()
+            .into()
+    }
+    fn mode5_hash(c: &Config) -> String {
+        let bytes: Vec<u8> = c
+            .mode5_scripts
+            .iter()
+            .flatten()
+            .flat_map(|(a, v)| a.to_le_bytes().into_iter().chain(v.to_le_bytes()))
+            .collect();
+        fujimod_emulator_devices::fingerprint::bytes(&bytes)["sha256"]
+            .as_str()
+            .unwrap()
+            .into()
+    }
+    fn removal_hash(c: &Config) -> String {
+        let bytes: Vec<u8> = c
+            .removal_script
+            .iter()
+            .flat_map(|(o, v)| o.to_le_bytes().into_iter().chain(v.to_le_bytes()))
+            .chain(c.removal_poll.iter().flat_map(|v| v.to_le_bytes()))
+            .collect();
+        fujimod_emulator_devices::fingerprint::bytes(&bytes)["sha256"]
+            .as_str()
+            .unwrap()
+            .into()
+    }
+    fn config() -> Config {
