+    #[test]
+    fn selector1_checkpoint_origins_arity_maps_and_histories_validate_before_commit() {
+        for origin in [false, true] {
+            let c = selector1_config();
+            let mut m = BankedCalibration::new(c.clone()).unwrap();
+            let mut h = TestHost::new();
+            selector1_base(&mut m, &mut h, 0, origin);
+            let base = m.checkpoint().unwrap();
+            write(&mut m, &mut h, q(0, 0x5038), 0x03204020);
+            let prefix = m.checkpoint().unwrap();
+            write(&mut m, &mut h, q(0, 0x5438), 0x83);
+            write(&mut m, &mut h, q(0, 0x5384), 1);
+            let pending = m.checkpoint().unwrap();
+            let mut fresh = BankedCalibration::new(c).unwrap();
+            fresh.restore_checkpoint(&prefix).unwrap();
+            fresh.restore_checkpoint(&pending).unwrap();
+            assert_eq!(fresh.save(), m.save());
+            for bad in 0..19 {
+                let mut state: State = pending.decode(NAME).unwrap();
+                match bad {
+                    0 => state.units[0].stage = Stage::Selector1(0, origin),
+                    1 => state.units[0].stage = Stage::Selector1(3, origin),
+                    2 => state.units[0].stage = Stage::Selector1(usize::MAX, origin),
+                    3 => state.units[0].stage = Stage::Pending(Action::Selector1(!origin)),
+                    4 => {
+                        state.units[0].pending.as_mut().unwrap().action = Action::Selector1(!origin)
+                    }
+                    5 => {
+                        state.units[0].stage = Stage::Pending(Action::Selector1(!origin));
+                        state.units[0].pending.as_mut().unwrap().action =
+                            Action::Selector1(!origin);
+                    }
+                    6 => state.units[0].pending.as_mut().unwrap().action = Action::Mode2,
+                    7 => state.units[0].pending = None,
+                    8 => state.units[0].pending.as_mut().unwrap().token = 0,
+                    9 => state.units[0].pending.as_mut().unwrap().token = 1,
+                    10 => state.units[0].pending.as_mut().unwrap().token = state.generation + 1,
+                    11 => state.units[0].pending.as_mut().unwrap().due += 1,
+                    12 => state.generation -= 1,
+                    13 => state.generation += 1,
+                    14 => state.identity.selector1_source_sha256 = None,
+                    15 => {
+                        state.units[0].paired.insert(0x5038, 0x01004100);
+                    }
+                    16 => {
+                        state.units[0].primary.insert(0x4660, 0);
+                    }
+                    17 => state.units[0].stage = Stage::Selector1Done(origin),
+                    _ => state.units.swap(0, 1),
+                }
+                let before = fresh.save();
+                assert!(
+                    fresh
+                        .restore_checkpoint(&Checkpoint::encode(NAME, &state).unwrap())
+                        .is_err(),
+                    "origin {origin} bad {bad}"
+                );
+                assert_eq!(fresh.save(), before);
+            }
+            for bad in 0..7 {
+                let mut value = serde_json::to_value(&m.state).unwrap();
+                value["units"][0]["stage"] = match bad {
+                    0 => serde_json::json!({"Selector1":[1,origin,0]}),
+                    1 => serde_json::json!({"Selector1":[1]}),
+                    2 => serde_json::json!({"Selector1":[1,0]}),
+                    3 => serde_json::json!({"Selector1Done":{"from_post":origin,"unknown":1}}),
+                    4 => serde_json::json!({"Pending":{"Selector1":{"from_post":origin}}}),
+                    5 => serde_json::json!({"Pending":{"Selector1":0}}),
+                    _ => serde_json::json!({"Selector1":[1,"false"]}),
+                };
+                let before = fresh.save();
+                assert!(
+                    fresh
+                        .restore_checkpoint(&Checkpoint::encode(NAME, &value).unwrap())
+                        .is_err(),
+                    "arity {bad}"
+                );
+                assert_eq!(fresh.save(), before);
+            }
+            let token = m.state.units[0].pending.as_ref().unwrap().token;
+            fresh.restore_checkpoint(&base).unwrap();
+            let before = fresh.save();
+            h.now += 8;
+            fresh.event(&mut h.cx(), token);
+            assert_eq!(fresh.save(), before);
+            let at = h.now;
+            advance(&mut m, &mut h, at);
+            fresh.restore_checkpoint(&m.checkpoint().unwrap()).unwrap();
+            assert_eq!(fresh.save(), m.save());
+        }
+    }
