+    fn p(i: usize, off: u32) -> u64 {
+        0xff600000 + (i as u64) * 0x10000 + u64::from(off)
+    }
+    fn q(i: usize, off: u32) -> u64 {
+        0xff500000 + (i as u64) * 0x10000 + u64::from(off)
+    }
+    fn program(m: &mut BankedCalibration, h: &mut TestHost, i: usize) {
+        for (o, v) in m.config.initial_script.clone() {
+            write(m, h, p(i, o), v);
+        }
+    }
+    fn configured(m: &mut BankedCalibration, h: &mut TestHost, i: usize) {
+        program(m, h, i);
+        write(m, h, q(i, 0x7c18), 0x40000000);
+        let at = h.now + 8;
+        advance(m, h, at);
+        for (o, v) in m
+            .config
+            .preparation
+            .clone()
+            .into_iter()
+            .chain(m.config.profile.clone())
+        {
+            write(m, h, q(i, o), v);
+            m.validate_checkpoint(&m.checkpoint().unwrap()).unwrap();
+        }
+    }
+    fn controller(m: &mut BankedCalibration, h: &mut TestHost, i: usize) {
