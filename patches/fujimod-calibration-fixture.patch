+    #[test]
+    fn post_control_four_events_are_delayed_masked_ordered_and_do_not_reuse_cold_effects() {
+        let mut m = BankedCalibration::new(post_config()).unwrap();
+        let mut h = TestHost::new();
+        for unit in 0..4 {
+            post_ready(&mut m, &mut h, unit);
+            let old = m.state.units.clone();
+            let generation = m.state.generation;
+            for (n, (o, v)) in POST_CONTROL.into_iter().enumerate() {
+                refused(&mut m, &mut h, p(unit, o), v);
+                refused(&mut m, &mut h, q(unit, o), v ^ 1);
+                write(&mut m, &mut h, q(unit, o), v);
+                m.validate_checkpoint(&m.checkpoint().unwrap()).unwrap();
+                if let Some(action) = BankedCalibration::post_action(n) {
+                    let pending = m.state.units[unit].pending.clone().unwrap();
+                    assert_eq!(pending.action, action);
+                    assert_eq!(pending.due, h.now + 8);
+                    write(&mut m, &mut h, q(unit, o), v);
+                    assert_eq!(m.state.generation, generation + n as u64 + 1);
+                    refused(&mut m, &mut h, q(unit, 0x7c18), 0x40000000);
+                    let before = m.save();
+                    m.event(&mut h.cx(), pending.token + 100);
+                    assert_eq!(m.save(), before);
+                    let at = h.now + 7;
+                    advance(&mut m, &mut h, at);
+                    assert_eq!(m.save(), before);
+                    let at = h.now + 1;
+                    advance(&mut m, &mut h, at);
+                    let u = &m.state.units[unit];
+                    match n {
+                        0 => {
+                            assert_eq!(u.paired[&0x7c18], 1);
+                            assert_eq!(u.primary, old[unit].primary);
+                        }
+                        1 => assert_eq!(u.paired[&0x7090], old[unit].paired[&0x7090] & !1),
+                        2 => {
+                            assert_eq!(u.primary[&0x2110], old[unit].primary[&0x2110] | 1);
+                            for off in [0x40dc, 0x42dc] {
+                                assert_eq!(
+                                    u.primary[&off],
+                                    (old[unit].primary[&off] & !0x1300) | 0x300
+                                );
+                            }
+                            for off in [
+                                0x444c, 0x4620, 0x40ec, 0x42ec, 0x40f8, 0x42f8, 0x4138, 0x413c,
+                                0x4140, 0x4144, 0x4148, 0x4338, 0x433c, 0x4340, 0x4344, 0x4348,
+                            ] {
+                                assert_eq!(u.primary[&off], old[unit].primary[&off]);
+                            }
+                        }
+                        3 => assert_eq!(u.paired[&0x7364], 1),
+                        _ => unreachable!(),
+                    }
+                    let done = m.save();
+                    m.event(&mut h.cx(), pending.token);
+                    assert_eq!(m.save(), done);
+                }
+                let checkpoint = m.checkpoint().unwrap();
+                let mut fresh = BankedCalibration::new(m.config.clone()).unwrap();
+                fresh.restore_checkpoint(&checkpoint).unwrap();
+                assert_eq!(fresh.save(), m.save());
+            }
+            assert_eq!(m.state.units[unit].stage, Stage::PostControlDone);
+            assert!(!m.state.units[unit].paired.contains_key(&0x7364));
+            assert_eq!(m.state.generation, generation + 4);
+            for i in 0..4 {
+                if i != unit {
+                    assert_eq!(m.state.units[i], old[i]);
+                }
+            }
+            refused(&mut m, &mut h, q(unit, 0x7c50), 1);
+            refused(&mut m, &mut h, q(unit, 0x7114), 0);
+        }
+        assert_eq!(m.state.generation, 51);
+    }
