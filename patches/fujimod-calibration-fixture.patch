+        for i in 0..4 {
+            removed(&mut m, &mut h, i);
+        }
+        assert_eq!(m.state.generation, 23);
+        let baseline = m.state.units.clone();
+        for unit in 0..4 {
+            let plan = m.reprogram_plans[unit].clone().unwrap();
+            assert_eq!(plan.len(), 730);
+            assert_eq!(plan[722], (true, 0x7040, 0x100));
+            assert_eq!(plan[727], (true, 0x7080, 0x100));
+            assert_eq!(plan[729], (true, 0x7c18, 0x40000000));
+            let cache = m.config.reprogram.as_ref().unwrap().cached[unit].unwrap();
+            assert_eq!(
+                plan[716],
+                (
+                    false,
+                    0x4660,
+                    (0x03000004 & !0x07ff0000) | (cache[0] & 0x07ff0000)
+                )
+            );
+            assert_ne!(
+                baseline[unit].primary[&0x4660] & 0xffff,
+                plan[716].2 & 0xffff
+            );
+            let others = m.state.units.clone();
+            reprogram_prefix(&mut m, &mut h, unit, 730);
+            let u = &m.state.units[unit];
+            assert_eq!(u.stage, Stage::ReprogramDone);
+            assert_eq!(u.paired[&0x7c18], 0x40000000);
+            assert_eq!(u.paired[&0x7090], 0xa5a401);
+            assert_eq!(u.primary[&0x4670] & 0x30000, 0x30000);
+            // Fields never in this plan preserve the canonical Removed values.
+            for (&o, &v) in &baseline[unit].paired {
+                if !plan.iter().any(|&(paired, off, _)| paired && off == o)
+                    && ![0x7044, 0x7090].contains(&o)
+                {
+                    assert_eq!(u.paired[&o], v, "retained {o:x}");
+                }
+            }
+            for (i, other) in others.iter().enumerate() {
+                if i != unit {
+                    assert_eq!(&m.state.units[i], other);
+                }
+            }
+            refused(&mut m, &mut h, q(unit, 0x7114), 0);
+            refused(&mut m, &mut h, p(unit, 0x2000), 0xb00);
+        }
+        assert_eq!(m.state.generation, 35);
+    }
