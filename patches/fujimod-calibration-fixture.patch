+            (0x448c, 0x300),
+            (0x4660, 0x03000000),
+            (0x4664, 0x300),
+        ]);
+        for off in (0..0x10000).step_by(4) {
+            if words.len() == 686 {
+                break;
+            }
+            words.entry(off).or_insert(0);
+        }
