+        let at = h.now + 8;
+        advance(m, h, at);
+        write(m, h, q(i, 0x7040), 0x10);
+        m.validate_checkpoint(&m.checkpoint().unwrap()).unwrap();
+        let at = h.now + 8;
+        advance(m, h, at);
+        write(m, h, p(i, 0x2000), 0xb01);
+        m.validate_checkpoint(&m.checkpoint().unwrap()).unwrap();
+        let at = h.now + 8;
+        advance(m, h, at);
