+                .map(|s| serde_json::to_value(s).unwrap())
+                .unwrap()
+        );
+        fresh.restore_checkpoint(&pending).unwrap();
+        assert_eq!(fresh.save(), m.save());
+        for bad in 0..19 {
+            let mut state: State = pending.decode(NAME).unwrap();
+            match bad {
+                0 => state.units[0].stage = Stage::PostMode2(0),
+                1 => state.units[0].stage = Stage::PostMode2(71),
+                2 => state.units[0].stage = Stage::PostMode2(usize::MAX),
+                3 => state.units[0].stage = Stage::Mode2(70),
+                4 => state.units[0].stage = Stage::PostMode2Done,
+                5 => state.units[0].pending = None,
+                6 => state.units[0].pending.as_mut().unwrap().action = Action::Mode2,
+                7 => state.units[0].pending.as_mut().unwrap().token = 0,
+                8 => state.units[0].pending.as_mut().unwrap().token = 1,
+                9 => state.units[0].pending.as_mut().unwrap().token = state.generation + 1,
+                10 => state.units[0].pending.as_mut().unwrap().due += 1,
+                11 => state.generation -= 1,
+                12 => state.generation += 1,
+                13 => state.identity.post_mode2_source_sha256 = None,
+                14 => {
+                    state.units[0].paired.insert(0x5384, 0);
+                }
+                15 => {
+                    state.units[0].primary.insert(0x4660, 0);
+                }
+                16 => {
+                    state.units[0].paired.insert(0x7c50, 1);
+                }
+                17 => {
+                    state.units[0].paired.insert(0x7090, 1);
+                }
+                _ => state.units.swap(0, 1),
+            }
+            let before = fresh.save();
+            assert!(
+                fresh
+                    .restore_checkpoint(&Checkpoint::encode(NAME, &state).unwrap())
+                    .is_err(),
+                "state {bad}"
+            );
+            assert_eq!(fresh.save(), before);
+        }
+        let mut unknown = serde_json::to_value(&m.state).unwrap();
+        unknown["identity"]["unknown"] = 0.into();
+        assert!(serde_json::from_value::<State>(unknown).is_err());
+        let token = m.state.units[0].pending.as_ref().unwrap().token;
+        fresh.restore_checkpoint(&post).unwrap();
+        let before = fresh.save();
+        h.now += 8;
+        fresh.event(&mut h.cx(), token);
+        assert_eq!(fresh.save(), before);
+        let at = h.now;
+        advance(&mut m, &mut h, at);
+        fresh.restore_checkpoint(&m.checkpoint().unwrap()).unwrap();
+        assert_eq!(fresh.save(), m.save());
+    }
