+            (0x4674, 0),
+            (0x4678, 0),
+            (0x40dc, 0),
+            (0x42dc, 0),
+            (0x444c, 0),
+            (0x4620, 0),
+            (0x4480, 0x30099),
+            (0x4484, 0x03000300),
