+    fn selector1_config() -> Config {
+        let mut c = post_mode2_config();
+        c.selector1_source_sha256 = Some("ab12".repeat(16));
+        c
+    }
+    fn selector1_base(m: &mut BankedCalibration, h: &mut TestHost, unit: usize, from_post: bool) {
+        if from_post {
+            post_complete(m, h, unit);
+            post_mode2_prefix(m, h, unit, 0, 71);
+        } else {
+            if m.state.units[unit].stage != Stage::Complete {
+                cold_complete(m, h, unit);
+            }
+            mode5_done(m, h, unit);
+            mode2_prefix(m, h, unit, 0, 71);
+        }
+        let at = h.now + 8;
+        advance(m, h, at);
+        assert_eq!(
+            m.state.units[unit].stage,
+            if from_post {
+                Stage::PostMode2Done
+            } else {
+                Stage::Mode2Done
+            }
+        );
+    }
