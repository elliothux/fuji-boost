+    #[test]
+    fn post_mode2_cross_unit_tokens_and_last_command_overflow_do_not_commit() {
+        let c = post_mode2_config();
+        let mut m = BankedCalibration::new(c.clone()).unwrap();
+        let mut h = TestHost::new();
+        for unit in 0..2 {
+            post_complete(&mut m, &mut h, unit);
+            post_mode2_prefix(&mut m, &mut h, unit, 0, 70);
+        }
+        for unit in 0..2 {
+            write(&mut m, &mut h, q(unit, 0x5384), 1);
+        }
+        let first = m.state.units[0].pending.clone().unwrap();
+        let second = m.state.units[1].pending.clone().unwrap();
+        assert_ne!(first.token, second.token);
+        let mut bad = m.state.clone();
+        bad.units[1].pending.as_mut().unwrap().token = first.token;
+        let before = m.save();
+        assert!(
+            m.restore_checkpoint(&Checkpoint::encode(NAME, &bad).unwrap())
+                .is_err()
+        );
+        assert_eq!(m.save(), before);
+        h.now = first.due;
+        m.event(&mut h.cx(), first.token);
+        assert_eq!(m.state.units[0].stage, Stage::PostMode2Done);
+        assert_eq!(m.state.units[1].stage, Stage::Pending(Action::PostMode2));
+        m.event(&mut h.cx(), second.token);
+        assert_eq!(m.state.units[1].stage, Stage::PostMode2Done);
+        m.validate_checkpoint(&m.checkpoint().unwrap()).unwrap();
+        for which in 0..2 {
+            let mut m = BankedCalibration::new(c.clone()).unwrap();
+            let mut h = TestHost::new();
+            post_complete(&mut m, &mut h, 0);
+            post_mode2_prefix(&mut m, &mut h, 0, 0, 70);
+            if which == 0 {
+                h.now = u64::MAX - 7;
+            } else {
+                m.state.generation = u64::MAX;
+            }
+            refused(&mut m, &mut h, q(0, 0x5384), 1);
+            assert!(m.state.units[0].pending.is_none());
+            assert_eq!(m.state.units[0].paired[&0x5384], 0);
+        }
+    }
