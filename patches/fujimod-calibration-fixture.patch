+    #[test]
+    fn selector1_both_origins_keep_ordinary_and_preinitialized_histories_and_exact_maps() {
+        for from_post in [false, true] {
+            for preinit in [false, true] {
+                let mut c = selector1_config();
+                c.unit0_preinitialized = preinit;
+                if !from_post {
+                    let r = c.reprogram.as_mut().unwrap();
+                    r.cached[0] = None;
+                    r.input_sha256 = r.hash();
+                }
+                let mut m = BankedCalibration::new(c.clone()).unwrap();
+                let mut h = TestHost::new();
+                selector1_base(&mut m, &mut h, 0, from_post);
+                let baseline = m.state.units.clone();
+                let before_generation = m.state.generation;
+                let expected_base = match (from_post, preinit) {
+                    (false, false) => 7,
+                    (false, true) => 2,
+                    (true, false) => 15,
+                    (true, true) => 10,
+                };
+                assert_eq!(before_generation, expected_base);
+                refused(&mut m, &mut h, q(0, 0x5038), 0x01004100);
+                for (n, (o, v)) in SELECTOR1.into_iter().enumerate() {
+                    refused(&mut m, &mut h, p(0, o), v);
+                    refused(&mut m, &mut h, q(0, o), v ^ 1);
+                    write(&mut m, &mut h, q(0, o), v);
+                    assert_eq!(m.state.units[0].primary, baseline[0].primary);
+                    for i in 1..4 {
+                        assert_eq!(m.state.units[i], baseline[i]);
+                    }
+                    m.validate_checkpoint(&m.checkpoint().unwrap()).unwrap();
+                    if n < 2 {
+                        assert_eq!(m.state.units[0].stage, Stage::Selector1(n + 1, from_post));
+                        assert_eq!(m.state.generation, before_generation);
+                        refused(&mut m, &mut h, q(0, o), v);
+                    }
+                    let mut fresh = BankedCalibration::new(c.clone()).unwrap();
+                    fresh.restore_checkpoint(&m.checkpoint().unwrap()).unwrap();
+                    assert_eq!(fresh.save(), m.save());
+                }
+                let pending = m.state.units[0].pending.clone().unwrap();
+                assert_eq!(pending.action, Action::Selector1(from_post));
+                assert_eq!(pending.due, h.now + 8);
+                write(&mut m, &mut h, q(0, 0x5384), 1);
+                assert_eq!(m.state.generation, before_generation + 1);
+                refused(&mut m, &mut h, q(0, 0x5038), 0x03204020);
+                let before = m.save();
+                m.event(&mut h.cx(), pending.token + 100);
+                assert_eq!(m.save(), before);
+                let at = h.now + 7;
+                advance(&mut m, &mut h, at);
+                assert_eq!(m.save(), before);
+                let old = m.state.units[0].clone();
+                let at = h.now + 1;
+                advance(&mut m, &mut h, at);
+                let mut expected = old;
+                expected.paired.insert(0x5384, 0);
+                expected.pending = None;
+                expected.stage = Stage::Selector1Done(from_post);
+                assert_eq!(m.state.units[0], expected);
+                assert_eq!(
+                    m.state.units[0].paired[&0x7090],
+                    baseline[0].paired[&0x7090]
+                );
+                let done = m.save();
+                m.event(&mut h.cx(), pending.token);
+                assert_eq!(m.save(), done);
+                let mut fresh = BankedCalibration::new(c).unwrap();
+                fresh.restore_checkpoint(&m.checkpoint().unwrap()).unwrap();
+                assert_eq!(fresh.save(), m.save());
+                for (o, v) in [
+                    (0x5038, 0x03204020),
+                    (0x5038, 0x01004100),
+                    (0x5438, 0x81),
+                    (0x5384, 1),
+                    (0x7114, 0),
+                ] {
+                    refused(&mut m, &mut h, q(0, o), v);
+                }
+            }
+        }
+    }
