+    fn reprogram_config() -> Config {
+        let mut c = config();
+        c.unit0_preinitialized = true;
+        // Synthetic high status bits must survive the two new masked events.
+        c.profile[0] = (0x7090, 0xa5a580);
+        c.source_sha256 = source_hash(&c);
+        let mut r = Reprogram {
+            profile: c.profile.iter().map(|&(o, v)| (o, v ^ 0x100)).collect(),
+            cached: [Some([
+                0x12345678, 0x98765432, 0x89abcdef, 0x87654321, 0xfedcba98, 0x76543210,
+            ]); 4],
+            input_sha256: String::new(),
+        };
+        r.input_sha256 = r.hash();
+        c.reprogram = Some(r);
+        c
+    }
+
+    fn removed(m: &mut BankedCalibration, h: &mut TestHost, unit: usize) {
+        if m.state.units[unit].stage != Stage::Complete {
+            cold_complete(m, h, unit);
+        }
+        mode5_done(m, h, unit);
+        for (o, v) in m.config.removal_script.clone() {
+            write(m, h, q(unit, o), v);
+        }
+        write(m, h, q(unit, 0x7080), 0x100);
+        let at = h.now + 8;
+        advance(m, h, at);
+        assert_eq!(m.state.units[unit].stage, Stage::Removed);
+    }
+
+    fn reprogram_prefix(m: &mut BankedCalibration, h: &mut TestHost, unit: usize, count: usize) {
+        for (n, (paired, off, value)) in m.reprogram_plans[unit]
+            .clone()
+            .unwrap()
+            .into_iter()
+            .take(count)
+            .enumerate()
+        {
+            write(
+                m,
+                h,
+                if paired { q(unit, off) } else { p(unit, off) },
+                value,
+            );
+            m.validate_checkpoint(&m.checkpoint().unwrap()).unwrap();
+            if let Some(action) = BankedCalibration::reprogram_action(n) {
+                assert_eq!(m.state.units[unit].stage, Stage::Pending(action));
+                let at = h.now + 8;
+                advance(m, h, at);
+                m.validate_checkpoint(&m.checkpoint().unwrap()).unwrap();
+            }
+        }
+    }
