+                        || c.due.is_some_and(|at| !progress.last_tick.checked_add(p.beat_ticks).is_some_and(|min| at >= min)) {
+                        return Err("Invalid XP4 DMA peripheral cursor or clock".into());
+                    }
+                },
+                _ => return Err("XP4 DMA peripheral checkpoint identity differs".into()),
+            }
         }
         self.channels = state
             .channels
