+//! An explicit bounded, single-use SPI byte sequence; no physical peer is inferred.
+use crate::spi::Input;
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+
+#[derive(Serialize, Deserialize)]
+#[serde(try_from = "ByteExchangeState")]
+pub struct ByteExchange {
+    expected: Vec<u8>,
+    response: Vec<u8>,
+    position: u8,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct ByteExchangeState {
+    expected: Vec<u8>,
+    response: Vec<u8>,
+    position: u8,
+}
+
+impl TryFrom<ByteExchangeState> for ByteExchange {
+    type Error = String;
+
+    fn try_from(saved: ByteExchangeState) -> Result<Self, Self::Error> {
+        let mut peer = Self::new(saved.expected, saved.response)?;
+        if usize::from(saved.position) > peer.expected.len() {
+            return Err("SPI byte sequence checkpoint position exceeds its length".into());
+        }
+        peer.position = saved.position;
+        Ok(peer)
+    }
+}
+
+impl ByteExchange {
+    pub fn new(expected: Vec<u8>, response: Vec<u8>) -> Result<Self, String> {
+        if expected.is_empty() || expected.len() > 128 || expected.len() != response.len() {
+            return Err("SPI byte sequence requires equal lengths in 1..=128".into());
+        }
+        Ok(Self {
+            expected,
+            response,
+            position: 0,
+        })
+    }
+}
+
+impl Input for ByteExchange {
+    fn exchange(&mut self, bits: u32, tx: u16, _: u64) -> Result<u16, String> {
+        let index = usize::from(self.position);
+        if bits != 8 || self.expected.get(index).copied().map(u16::from) != Some(tx) {
+            return Err("SPI byte exchange is outside the declared byte sequence".into());
+        }
+        let rx = self.response[index];
+        self.position += 1;
+        Ok(u16::from(rx))
+    }
+    fn save(&self) -> Value {
+        serde_json::to_value(self).unwrap()
+    }
+    fn restore(&mut self, value: &Value) -> Result<(), String> {
+        let saved: Self = serde_json::from_value(value.clone()).map_err(|e| e.to_string())?;
+        if saved.expected != self.expected
+            || saved.response != self.response
+            || usize::from(saved.position) > self.expected.len()
+        {
+            return Err(
+                "SPI byte exchange checkpoint differs from its declared byte sequence".into(),
+            );
+        }
+        self.position = saved.position;
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    #[test]
+    fn admits_only_the_declared_bytes_once_and_resumes_mid_frame() {
+        let expected = [0xa5, 0x5a, 0x3c, 0xc3];
+        let response = [0xc3, 0x3c, 0xa5, 0x5a];
+        let mut peer = ByteExchange::new(expected.to_vec(), response.to_vec()).unwrap();
+        let before = peer.save();
+        assert!(peer.exchange(16, 0xa5, 0).is_err());
+        assert!(peer.exchange(8, 0, 0).is_err());
+        assert_eq!(peer.save(), before);
+        assert_eq!(peer.exchange(8, 0xa5, 1).unwrap(), 0xc3);
+        assert_eq!(peer.exchange(8, 0x5a, 2).unwrap(), 0x3c);
+        let mut restored = ByteExchange::new(expected.to_vec(), response.to_vec()).unwrap();
+        restored.restore(&peer.save()).unwrap();
+        assert_eq!(restored.exchange(8, 0x3c, 3).unwrap(), 0xa5);
+        assert_eq!(restored.exchange(8, 0xc3, 4).unwrap(), 0x5a);
+        let complete = restored.save();
+        assert!(restored.exchange(8, 0xa5, 5).is_err());
+        assert_eq!(restored.save(), complete);
+    }
+
+    #[test]
+    fn admits_two_declared_headers_and_restores_between_them() {
+        let expected = vec![0, 8, 32, 208, 8, 16, 128, 34];
+        let response = vec![0, 0, 0, 0, 8, 0, 160, 218];
+        let mut peer = ByteExchange::new(expected.clone(), response.clone()).unwrap();
+        for index in 0..4 {
+            assert_eq!(
+                peer.exchange(8, u16::from(expected[index]), index as u64)
+                    .unwrap(),
+                u16::from(response[index])
+            );
+        }
+        let saved = peer.save();
+        let mut restored = ByteExchange::new(expected.clone(), response.clone()).unwrap();
+        restored.restore(&saved).unwrap();
+        for index in 4..8 {
+            let before = restored.save();
+            assert!(
+                restored
+                    .exchange(16, u16::from(expected[index]), 0)
+                    .is_err()
+            );
+            assert!(
+                restored
+                    .exchange(8, u16::from(expected[index]) ^ 1, 0)
+                    .is_err()
+            );
+            assert_eq!(restored.save(), before);
+            assert_eq!(
+                restored
+                    .exchange(8, u16::from(expected[index]), index as u64)
+                    .unwrap(),
+                u16::from(response[index])
+            );
+        }
+        let complete = restored.save();
+        assert!(restored.exchange(8, 0, 9).is_err());
+        assert_eq!(restored.save(), complete);
+    }
+
+    #[test]
+    fn requires_equal_nonempty_bounded_lengths_and_admits_all_128_bytes() {
+        for (expected, response) in [
+            (vec![], vec![]),
+            (vec![], vec![0]),
+            (vec![0], vec![]),
+            (vec![0], vec![0, 1]),
+            (vec![0; 129], vec![0; 129]),
+        ] {
+            assert!(ByteExchange::new(expected, response).is_err());
+        }
+        let expected: Vec<u8> = (0..128).collect();
+        let response: Vec<u8> = (128..=255).collect();
+        let mut peer = ByteExchange::new(expected.clone(), response.clone()).unwrap();
+        for index in 0..128 {
+            assert_eq!(
+                peer.exchange(8, u16::from(expected[index]), index as u64)
+                    .unwrap(),
+                u16::from(response[index])
+            );
+        }
+        let complete = peer.save();
+        assert_eq!(complete["position"], json!(128));
+        assert!(peer.exchange(8, 128, 129).is_err());
+        assert_eq!(peer.save(), complete);
+        let mut restored = ByteExchange::new(expected, response).unwrap();
+        restored.restore(&complete).unwrap();
+        assert_eq!(restored.save(), complete);
+        let mut invalid = complete.clone();
+        invalid["position"] = json!(129);
+        assert!(restored.restore(&invalid).is_err());
+        assert_eq!(restored.save(), complete);
+        let mut one = ByteExchange::new(vec![7], vec![9]).unwrap();
+        assert_eq!(one.exchange(8, 7, 0).unwrap(), 9);
+        assert!(one.exchange(8, 7, 1).is_err());
+    }
+
+    #[test]
+    fn deserialization_cannot_bypass_sequence_or_position_validation() {
+        for value in [
+            json!({"expected": [], "response": [], "position": 0}),
+            json!({"expected": [1], "response": [], "position": 0}),
+            json!({"expected": vec![0; 129], "response": vec![0; 129], "position": 0}),
+            json!({"expected": [1], "response": [2], "position": 2}),
+            json!({"expected": [1], "response": [2], "position": 0, "unexpected": 0}),
+        ] {
+            assert!(serde_json::from_value::<ByteExchange>(value).is_err());
+        }
+    }
+
+    #[test]
+    fn four_byte_checkpoint_shape_and_sequence_identity_are_preserved() {
+        let mut peer = ByteExchange::new(vec![1, 2, 3, 4], vec![5, 6, 7, 8]).unwrap();
+        assert_eq!(
+            peer.save(),
+            json!({"expected": [1, 2, 3, 4],
+            "response": [5, 6, 7, 8], "position": 0})
+        );
+        peer.exchange(8, 1, 0).unwrap();
+        let before = peer.save();
+        for (field, value) in [
+            ("expected", json!([1, 2, 3])),
+            ("response", json!([5, 6, 7])),
+            ("position", json!(-1)),
+            ("position", json!(256)),
+        ] {
+            let mut changed = before.clone();
+            changed[field] = value;
+            assert!(peer.restore(&changed).is_err());
+            assert_eq!(peer.save(), before);
+        }
+        let mut longer = ByteExchange::new(vec![1, 2, 3, 4, 5], vec![5, 6, 7, 8, 9]).unwrap();
+        let longer_before = longer.save();
+        assert!(longer.restore(&before).is_err());
+        assert_eq!(longer.save(), longer_before);
+        peer.restore(&json!({"expected": [1, 2, 3, 4],
+            "response": [5, 6, 7, 8], "position": 4}))
+            .unwrap();
+        assert!(peer.exchange(8, 1, 1).is_err());
+    }
+
+    #[test]
+    fn rejects_a_different_fixture_or_invalid_checkpoint_without_mutation() {
+        let mut peer = ByteExchange::new(vec![1, 2, 3, 4], vec![5, 6, 7, 8]).unwrap();
+        let before = peer.save();
+        for (field, value) in [
+            ("expected", json!([0, 2, 3, 4])),
+            ("response", json!([0, 6, 7, 8])),
+            ("position", json!(5)),
+            ("unexpected", json!(0)),
+        ] {
+            let mut changed = before.clone();
+            changed[field] = value;
+            assert!(peer.restore(&changed).is_err());
+            assert_eq!(peer.save(), before);
+        }
+    }
+}
