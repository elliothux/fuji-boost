+use super::*;
+use fujimod_emulator_devices::dma::Port;
+use fujimod_emulator_devices::test_host::ram::{Ram,Effect};
+use std::collections::VecDeque;
+const FIFO:u64=0xfff34008;
+#[derive(Clone,Default)]
+struct Wire { rx:VecDeque<u8>,tx:Vec<u8>,rx_since:Option<u64>,tx_since:u64,capacity:usize,pops:usize }
+impl Port for Wire {
+    fn request(&self,d:Direction,burst:bool)->Option<u64> {
+        if burst { return None; }
+        match d { Direction::Receive => (!self.rx.is_empty()).then_some(self.rx_since).flatten(),
+            Direction::Transmit => (self.tx.len()<self.capacity).then_some(self.tx_since) }
+    }
+    fn receive(&mut self,now:u64,bytes:u8)->Result<u64,String> {
+        if bytes!=1 || !self.request(Direction::Receive,false).is_some_and(|at|at<=now) { return Err("no RX request".into()); }
+        let b=self.rx.pop_front().unwrap(); self.pops+=1;
+        if self.rx.is_empty() { self.rx_since=None; } Ok(b.into())
+    }
+    fn transmit(&mut self,now:u64,bytes:u8,value:u64)->Result<(),String> {
+        if bytes!=1 || value>255 || !self.request(Direction::Transmit,false).is_some_and(|at|at<=now) {return Err("no TX request".into());}
+        self.tx.push(value as u8); Ok(())
+    }
+}
+fn fixture()->(DmaController,Arc<Mutex<Wire>>,Ram) {
+    let shared=port(vec![],0,Geometry{erase_bytes:4096,page_bytes:256,erase_ticks:8,page_ticks:8}).unwrap();
+    let mut d=DmaController::new(shared,[37;16]);
+    let wire=Arc::new(Mutex::new(Wire{capacity:8,..Default::default()}));
+    for (request,direction) in [(4,Direction::Receive),(5,Direction::Transmit)] {
+        let shared:SharedPort=wire.clone(); d.connect_peripheral(request,FIFO,direction,shared,256,2).unwrap();
+    }
+    let mut h=Ram::new(256);
+    write(&mut d,&mut h,0xfff4a508,0x01000400).unwrap();
+    write(&mut d,&mut h,0xfff4a50c,0x10005).unwrap();
+    (d,wire,h)
+}
+fn write(d:&mut DmaController,h:&mut Ram,address:u64,value:u64)->Result<(),String> {
+    let mut cx=h.cx(); d.write(&mut cx,address,4,value); cx.take_refusal().map_or(Ok(()),Err)
+}
+fn configure(d:&mut DmaController,h:&mut Ram,n:usize,src:u64,dst:u64,count:u64)->Result<(),String> {
+    let base=DMA+n as u64*0x1000;
+    for (o,v) in [(0x10,count-1),(0x14,src),(0x18,dst),(0x1c,if src==FIFO {4}else{0}),(0x20,if dst==FIFO {4}else{0})] {write(d,h,base+o,v)?;}
+    Ok(())
+}
+fn submit(d:&mut DmaController,h:&mut Ram,n:usize)->Result<(),String> {write(d,h,DMA+n as u64*0x1000+0x28,0x10201011)}
+fn step(d:&mut DmaController,h:&mut Ram)->Result<bool,String> {
+    let Some(at)=d.next_deadline(h.now) else {return Ok(false)};
+    assert!(at>=h.now); h.now=at; let mut cx=h.cx(); d.advance(&mut cx); cx.take_refusal().map_or(Ok(true),Err)
+}
+fn drain(d:&mut DmaController,h:&mut Ram) {for _ in 0..64 {if !step(d,h).unwrap(){return}} panic!("peripheral did not block or finish");}
+fn feed(w:&Arc<Mutex<Wire>>,tick:u64,bytes:&[u8]) {let mut w=w.lock().unwrap();w.rx.extend(bytes);w.rx_since=Some(tick);}
+#[test]
+fn rx_before_tx_waits_then_consumes_four_distinct_received_bytes() {
+    let (mut d,w,mut h)=fixture(); h.bytes[16..20].copy_from_slice(&[1,2,3,4]);h.bytes[64..68].fill(0x5a);
+    configure(&mut d,&mut h,5,FIFO,64,4).unwrap();submit(&mut d,&mut h,5).unwrap();
+    assert_eq!(d.next_deadline(0),None);let waiting=d.save();
+    d.advance(&mut h.cx());assert_eq!(d.save(),waiting);assert!(h.effects.is_empty());
+    configure(&mut d,&mut h,6,16,FIFO,4).unwrap();submit(&mut d,&mut h,6).unwrap();drain(&mut d,&mut h);
+    assert_eq!(w.lock().unwrap().tx,[1,2,3,4]);assert_eq!(d.channels[6].completed,1);assert_eq!(d.channels[5].completed,0);
+    assert_eq!(&h.bytes[64..68],&[0x5a;4]);
+    let ready=h.now+3;feed(&w,ready,&[0x19,0x2a,0x3b,0x4c]);assert_eq!(d.next_deadline(h.now),Some(ready));drain(&mut d,&mut h);
+    assert_eq!(&h.bytes[64..68],&[0x19,0x2a,0x3b,0x4c]);assert_eq!(w.lock().unwrap().pops,4);
+    assert_eq!(d.channels[5].completed,1);assert!(!d.channels[5].submitted);assert_eq!(d.channels[5].regs[5],FIFO as u32);assert_eq!(d.channels[5].regs[6],68);
+    assert_eq!(h.effects.iter().filter(|e|matches!(e,Effect::Irq(37,true))).count(),2);
+    write(&mut d,&mut h,DMA+0x5030,0).unwrap();assert_eq!(h.effects.last(),Some(&Effect::Irq(37,false)));
+}
+#[test]
+fn invalid_full_ram_extent_width_and_mux_never_consume_fifo() {
+    for case in 0..4 {
+        let (mut d,w,mut h)=fixture();feed(&w,0,&[1,2,3,4]);
+        configure(&mut d,&mut h,5,FIFO,if case==0 {254}else{64},4).unwrap();
+        if case==1 {write(&mut d,&mut h,DMA+0x501c,0x10004).unwrap();}
+        if case==2 {write(&mut d,&mut h,0xfff4a508,0x01000700).unwrap();}
+        if case==3 {write(&mut d,&mut h,DMA+0x5014,64).unwrap();write(&mut d,&mut h,DMA+0x5018,FIFO).unwrap();}
+        let before=d.save();assert!(submit(&mut d,&mut h,5).is_err());assert_eq!(d.save(),before);assert_eq!(w.lock().unwrap().pops,0);assert!(h.effects.is_empty());
+    }
+    let (mut d,w,mut h)=fixture();configure(&mut d,&mut h,6,254,FIFO,4).unwrap();assert!(submit(&mut d,&mut h,6).is_err());assert!(w.lock().unwrap().tx.is_empty());
+}
+#[test]
+fn backpressure_and_disabled_request_recheck_do_not_complete_a_waiting_channel() {
+    let (mut d,w,mut h)=fixture();w.lock().unwrap().capacity=1;h.bytes[16..20].copy_from_slice(&[1,2,3,4]);
+    configure(&mut d,&mut h,6,16,FIFO,4).unwrap();submit(&mut d,&mut h,6).unwrap();drain(&mut d,&mut h);
+    assert_eq!(w.lock().unwrap().tx,[1]);assert!(d.channels[6].submitted);assert_eq!(d.next_deadline(h.now),None);
+    w.lock().unwrap().capacity=8;drain(&mut d,&mut h);assert_eq!(w.lock().unwrap().tx,[1,2,3,4]);
+    configure(&mut d,&mut h,5,FIFO,64,1).unwrap();feed(&w,h.now,&[9]);submit(&mut d,&mut h,5).unwrap();step(&mut d,&mut h).unwrap();
+    w.lock().unwrap().rx.clear();step(&mut d,&mut h).unwrap();assert_eq!(d.next_deadline(h.now),None);assert_eq!(d.channels[5].peripheral.as_ref().unwrap().transferred,0);
+    feed(&w,h.now,&[7]);drain(&mut d,&mut h);assert_eq!(h.bytes[64],7);
+}
+#[test]
+fn cancel_and_active_mux_guard_preserve_unconsumed_bytes() {
+    let (mut d,w,mut h)=fixture();feed(&w,0,&[1,2,3,4]);configure(&mut d,&mut h,5,FIFO,64,4).unwrap();submit(&mut d,&mut h,5).unwrap();
+    let before=d.save();assert!(write(&mut d,&mut h,0xfff4a508,0x01000500).is_err());assert_eq!(d.save(),before);
+    step(&mut d,&mut h).unwrap();step(&mut d,&mut h).unwrap();assert_eq!(w.lock().unwrap().pops,1);
+    write(&mut d,&mut h,DMA+0x5028,0).unwrap();assert_eq!(d.next_deadline(h.now),None);
+    assert_eq!(w.lock().unwrap().rx,VecDeque::from([2,3,4]));assert_eq!(d.channels[5].completed,0);assert!(d.channels[5].peripheral.is_none());
+}
+#[test]
+fn checkpoint_keeps_cursor_and_rejects_missing_or_changed_wiring() {
+    let (mut a,wa,mut h)=fixture();feed(&wa,0,&[1,2,3,4]);configure(&mut a,&mut h,5,FIFO,64,4).unwrap();submit(&mut a,&mut h,5).unwrap();
+    step(&mut a,&mut h).unwrap();step(&mut a,&mut h).unwrap();step(&mut a,&mut h).unwrap();let saved=a.save();
+    let (mut b,wb,mut hb)=fixture();*wb.lock().unwrap()=wa.lock().unwrap().clone();hb.now=h.now;hb.bytes=h.bytes.clone();b.restore(&saved).unwrap();
+    drain(&mut a,&mut h);drain(&mut b,&mut hb);assert_eq!(a.save(),b.save());assert_eq!(h.bytes,hb.bytes);
+    let (mut live,_,_)=fixture();let before=live.save();
+    for field in ["peripheral_ports","peripheral"] {
+        let mut bad=saved.clone();if field=="peripheral" {bad["channels"][5].as_object_mut().unwrap().remove(field);}else{bad.as_object_mut().unwrap().remove(field);}
+        assert!(live.restore(&bad).is_err());assert_eq!(live.save(),before);
+    }
+    for (key,value) in [("transferred",json!(4)),("last_tick",json!(0)),("unknown",json!(1))] {
+        let mut bad=saved.clone();bad["channels"][5]["peripheral"][key]=value;assert!(live.restore(&bad).is_err());assert_eq!(live.save(),before);
+    }
+    let mut bad=saved.clone();bad["peripheral_ports"][0][4]=json!(3);assert!(live.restore(&bad).is_err());
+}
