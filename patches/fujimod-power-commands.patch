+    /// Diagnostic command contract; does not model enabled/pending transitions.
+    pub fn with_initialization_commands(self) -> Result<Self, String> {
+        self.initialization_commands(false)
+    }
+
+    /// A preexisting input only: the first initialization command invalidates status16.
+    pub fn with_latched_startup_cause(self) -> Result<Self, String> {
+        self.initialization_commands(true)
+    }
+
+    // Explicit fixed reads are independent of command writes; commands never supply readback.
+    fn initialization_commands(mut self, latched_cause: bool) -> Result<Self, String> {
+        let status = if latched_cause { 0x10 } else { 0 };
+        if self.state.inputs.get(&16) != Some(&status)
+            || [16, 17].iter().any(|r| self.state.retained_registers.contains(r))
+            || self
+                .state
+                .disable_writes
+                .iter()
+                .any(|(register, _)| [16, 17].contains(register))
+            || self
+                .state
+                .rtc
+                .as_ref()
+                .is_some_and(|rtc| rtc.config.owns(17))
+        {
+            return Err("Power initialization commands require the declared status16 input and exclusive status16/command17 write ownership".into());
+        }
+        self.state.initialization_commands = true;
+        self.state.latched_startup_cause = latched_cause;
+        Ok(self)
+    }
+
+    /// Selected checksum echo only; the fixed read input and hardware state stay independent.
+    pub fn with_word2_one_echo(mut self) -> Result<Self, String> {
+        if !self.state.inputs.contains_key(&2)
+            || self.state.word2_one_acks.is_some()
+            || self.state.retained_registers.contains(&2)
+            || self.state.disable_writes.iter().any(|(r, _)| *r == 2)
+            || self.state.rtc.as_ref().is_some_and(|r| r.config.owns(2))
+        {
+            return Err("Word2 echo requires a separate fixed read input and exclusive write ownership".into());
+        }
+        self.state.word2_one_acks = Some(Vec::new());
+        Ok(self)
+    }
+
+    /// Diagnostic recording only: retain the first2560001 ticks and a checked total.
+    pub fn with_word2_one_count_only(mut self) -> Result<Self, String> {
+        if self.state.word2_one_acks.as_ref().is_none_or(|acks| !acks.is_empty())
+            || self.state.word2_one_total_acks.is_some()
+        {
+            return Err("Word2 one count-only recording requires an unused separate0001 echo and cannot be enabled twice".into());
+        }
+        self.state.word2_one_total_acks = Some(0);
+        Ok(self)
+    }
+
+    /// Synthetic 0101 checksum echo only; no word2 hardware effects or readback.
+    pub fn with_word2_bit8_echo(mut self) -> Result<Self, String> {
+        if self.state.word2_one_acks.is_none() || self.state.word2_bit8_acks.is_some() {
+            return Err("Word2 bit8 echo requires the separate0001 echo and cannot be enabled twice".into());
+        }
+        self.state.word2_bit8_acks = Some(Vec::new());
+        self.state.word2_bit8_total_acks = Some(0);
+        Ok(self)
+    }
