+    #[test]
+    fn explicit_command_read_input_is_independent_of_writes_and_checkpoint_identity() {
+        let (mut peer, _) = selected();
+        peer.state.inputs.insert(16, 0x10);
+        peer.state.inputs.insert(17, 0xa55a);
+        let mut peer = peer.with_latched_startup_cause().unwrap();
+        let read = [17, 0, 0, 0xee];
+        let response = [0, 0xa5, 0x5a, 0xef];
+        assert_eq!(frame(&mut peer, read).unwrap(), response);
+        for (value, checksum) in [(0x7f00, 0xef), (0x3700, 0x37)] {
+            assert_eq!(frame(&mut peer, [0x91, value >> 8, value & 255, checksum]).unwrap(), [0, 0, 0, checksum]);
+            assert_eq!(frame(&mut peer, read).unwrap(), response);
+        }
+        assert_eq!(peer.state.commands, [(0, 0x7f00), (0, 0x3700)]);
+        assert!(!peer.state.stored.contains_key(&17));
+        assert!(peer.state.status16_unknown);
+        let saved = peer.save();
+        peer.restore(&saved).unwrap();
+        let mut changed = saved;
+        changed["inputs"]["17"] = 0.into();
+        assert!(peer.restore(&changed).is_err());
+        assert_eq!(frame(&mut peer, read).unwrap(), response);
+
+        let (mut absent, _) = selected();
+        absent.state.inputs.insert(16, 0x10);
+        let mut absent = absent.with_latched_startup_cause().unwrap();
+        assert_eq!(frame(&mut absent, read).unwrap_err(), "Unsupported checksum power SPI read register17");
+    }
