+        assert!(!peer.state.status16_unknown);
+        assert!(peer.state.commands.is_empty());
+        select(&mut gpio, false);
+        select(&mut gpio, true);
+        assert_eq!(frame(&mut peer, [0x91, 0x7f, 0, 0xef]).unwrap(), [0, 0, 0, 0xef]);
+        assert!(peer.state.status16_unknown);
+        assert_eq!(peer.state.inputs[&16], 0x10);
+        let after = peer.save();
+        peer.restore(&after).unwrap();
+        assert!(frame(&mut peer, [16, 0, 0, 0xef]).unwrap_err().contains("unqualified"));
+        let mut invalid = after;
+        invalid["status16_unknown"] = false.into();
+        assert!(peer.restore(&invalid).is_err());
+        peer.restore(&initial).unwrap();
+        assert_eq!(frame(&mut peer, [16, 0, 0, 0xef]).unwrap(), [0, 0, 0x10, 0xdf]);
+        let (mut wrong, _) = selected();
+        wrong.state.inputs.insert(16, 1);
+        assert!(wrong.with_latched_startup_cause().is_err());
+    }
