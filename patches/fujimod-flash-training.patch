+    #[test]
+    fn identity_prefix_refuses_unprovided_upper_bytes() {
+        let p = port(
+            vec![],
+            0x2c,
+            Geometry {
+                erase_bytes: 131072,
+                page_bytes: 256,
+                erase_ticks: 4096,
+                page_ticks: 512,
+            },
+        )
+        .unwrap();
+        let mut flash = SerialFlashController::new(p.clone(), 37)
+            .with_identity_bytes(1)
+            .unwrap();
+        let mut h = TestHost {
+            now: 0,
+            ram: vec![],
+            irqs: vec![],
+            events: vec![],
+            records: vec![],
+        };
+        write(&mut flash, &mut h, 0, CONTROLLER + 0x90, 0x9f800001, 0);
+        h.now = 8;
+        event(&mut flash, &mut h, 0, 1);
+        assert_eq!(flash.regs[0xa0 / 4], 0x2c);
+        assert!(
+            flash
+                .access(
+                    &mut Cx::new(&mut h, 0, 0, 0),
+                    CONTROLLER + 0x90,
+                    4,
+                    true,
+                    0x9fa00001
+                )
+                .unwrap_err()
+                .contains("supplied byte prefix")
+        );
+        assert!(flash.due.is_none());
+        let mut saved = flash.save();
+        saved["identity_bytes"] = json!(3);
+        assert!(flash.restore(&saved).is_err());
+        assert!(
+            SerialFlashController::new(p.clone(), 37)
+                .with_identity_bytes(0)
+                .is_err()
+        );
+        assert!(
+            SerialFlashController::new(p, 37)
+                .with_identity_bytes(4)
+                .is_err()
+        );
     }
