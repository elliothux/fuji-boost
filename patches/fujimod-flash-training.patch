+    #[test]
+    fn diagnostic_training_requires_ordered_writes_and_elapsed_events() {
+        let p = port(
+            vec![],
+            0,
+            Geometry {
+                erase_bytes: 131072,
+                page_bytes: 256,
+                erase_ticks: 4096,
+                page_ticks: 512,
+            },
+        )
+        .unwrap();
+        let mut flash = SerialFlashController::new(p.clone(), 37).with_training_handshake();
+        let mut strict = SerialFlashController::new(p, 37);
+        let mut h = TestHost {
+            now: 100,
+            ram: vec![],
+            irqs: vec![],
+            events: vec![],
+            records: vec![],
+        };
+        write(&mut strict, &mut h, 0, CONTROLLER + 0xb4, 0x40000000, 0);
+        assert!(strict.next_deadline(100).is_none());
+        assert!(
+            flash
+                .access(
+                    &mut Cx::new(&mut h, 0, 0, 0),
+                    CONTROLLER + 0xb4,
+                    4,
+                    true,
+                    0xc01f0004
+                )
+                .is_err()
+        );
+        write(&mut flash, &mut h, 0, CONTROLLER + 0xb4, 0x80200020, 0);
+        assert!(flash.next_deadline(100).is_none());
+        write(&mut flash, &mut h, 0, CONTROLLER + 0xb4, 0, 0);
+        write(&mut flash, &mut h, 0, CONTROLLER + 0xb8, 30, 0);
+        write(&mut flash, &mut h, 0, CONTROLLER + 0xb4, 0x40000000, 0);
+        let checkpoint = flash.save();
+        flash.restore(&checkpoint).unwrap();
+        let mut invalid = checkpoint.clone();
+        invalid["training_handshake"] = json!(false);
+        assert!(flash.restore(&invalid).is_err());
+        invalid = checkpoint;
+        invalid["registers"][0xb4 / 4] = json!(0xc01f0004u32);
+        assert!(flash.restore(&invalid).is_err());
+        h.now = 107;
+        event(&mut flash, &mut h, 0, 5);
+        assert_eq!(flash.regs[0xbc / 4], 0);
+        h.now = 108;
+        event(&mut flash, &mut h, 0, 5);
+        assert_eq!(flash.regs[0xbc / 4], 0x8000);
+        write(&mut flash, &mut h, 0, CONTROLLER + 0xb4, 0xc01f0004, 0);
+        let checkpoint = flash.save();
+        flash.restore(&checkpoint).unwrap();
+        h.now = 116;
+        event(&mut flash, &mut h, 0, 6);
+        assert_eq!(flash.regs[0xbc / 4], 0x8001);
+        assert_eq!(h.records.len(), 2);
+        assert!(h.irqs.is_empty());
+        write(&mut flash, &mut h, 0, CONTROLLER + 0xb4, 0, 0);
+        assert_eq!(flash.regs[0xbc / 4], 0);
+        write(&mut flash, &mut h, 0, CONTROLLER + 0xb4, 0x40000000, 0);
+        write(&mut flash, &mut h, 0, CONTROLLER + 0xb4, 0, 0);
+        h.now = 124;
+        event(&mut flash, &mut h, 0, 5);
+        assert_eq!(flash.regs[0xbc / 4], 0);
+        assert!(
+            flash
+                .access(&mut Cx::new(&mut h, 0, 0, 0), CONTROLLER + 0xbc, 4, true, 1)
+                .is_err()
+        );
+    }
