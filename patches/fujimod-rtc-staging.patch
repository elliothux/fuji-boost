+    #[test]
+    fn explicit_staging_readback_is_observational_and_independent_of_the_counter() {
+        let strict = StagedClock::new(config()).unwrap();
+        assert!(strict.read(103, 0).is_err());
+        assert!(strict.read(104, 0).is_err());
+        let mut cfg = config();
+        cfg.staging_readback = true;
+        let mut clock = StagedClock::new(cfg).unwrap();
+        assert_eq!(clock.read(103, 0).unwrap(), 0);
+        assert_eq!(clock.read(104, 0).unwrap(), 0);
+        clock.write(103, 0x5678, 1).unwrap();
+        assert_eq!(clock.read(103, 2).unwrap(), 0x5678);
+        assert_eq!(clock.read(104, 2).unwrap(), 0);
+        clock.write(104, 0x1234, 3).unwrap();
+        clock.write(100, 0x202, 10).unwrap();
+        let saved = serde_json::to_value(&clock).unwrap();
+        assert_eq!(clock.read(101, 30).unwrap(), 0x567a);
+        assert_eq!(clock.read(103, 30).unwrap(), 0x5678);
+        assert_eq!(clock.read(104, 30).unwrap(), 0x1234);
+        assert_eq!(serde_json::to_value(&clock).unwrap(), saved);
+        let mut resumed: StagedClock = serde_json::from_value(saved).unwrap();
+        resumed.validate_restore(&clock).unwrap();
+        assert!(resumed.validate_restore(&strict).is_err());
+        resumed.write(103, 0xabcd, 31).unwrap();
+        assert_eq!(resumed.read(103, 32).unwrap(), 0xabcd);
+        assert_eq!(resumed.read(104, 32).unwrap(), 0x1234);
+        assert_eq!(resumed.read(101, 32).unwrap(), 0x567a);
+        assert!(resumed.read(42, 32).is_err());
+    }
