+    #[test]
+    fn legacy_omitted_flag_json_and_checkpoint_bytes_stay_compatible_and_policies_isolate() {
+        #[derive(Serialize)]
+        struct LegacyState {
+            ticks: u64,
+            stage: Stage,
+        }
+        let request = Request {
+            command: 1,
+            started: 100,
+            due: 108,
+            token: TOKEN,
+        };
+        for stage in [Stage::Idle, Stage::Pending(request), Stage::Done(request)] {
+            let legacy = LegacyState { ticks: 8, stage };
+            let saved = Checkpoint::encode(NAME, &legacy).unwrap();
+            let mut m = AudioResetFixture::new(8).unwrap();
+            m.restore_checkpoint(&saved).unwrap();
+            assert_eq!(
+                serde_json::to_vec(&m.state).unwrap(),
+                serde_json::to_vec(&legacy).unwrap()
+            );
+            assert_eq!(
+                serde_json::to_vec(&m.checkpoint().unwrap()).unwrap(),
+                serde_json::to_vec(&saved).unwrap()
+            );
+            assert!(m.save().get("allow_second_command").is_none());
+            let mut two = AudioResetFixture::new_with_second_command(8).unwrap();
+            let before = two.save();
+            assert!(two.restore_checkpoint(&saved).is_err());
+            assert_eq!(two.save(), before);
+            let before = m.save();
+            assert!(m.restore_checkpoint(&two.checkpoint().unwrap()).is_err());
+            assert_eq!(m.save(), before);
+        }
+        let legacy_second = LegacyState {
+            ticks: 8,
+            stage: Stage::Pending(Request {
+                token: 2,
+                ..request
+            }),
+        };
+        let mut m = AudioResetFixture::new(8).unwrap();
+        let before = m.save();
+        assert!(
+            m.restore_checkpoint(&Checkpoint::encode(NAME, &legacy_second).unwrap())
+                .is_err()
+        );
+        assert_eq!(m.save(), before);
+    }
