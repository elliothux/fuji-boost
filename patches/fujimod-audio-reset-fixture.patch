+    #[test]
+    fn second_pending_checkpoint_restores_generation_and_rejects_invalid_state_atomically() {
+        let mut m = AudioResetFixture::new_with_second_command(8).unwrap();
+        let mut h = Clock {
+            now: 100,
+            ..Default::default()
+        };
+        m.write(&mut Cx::new(&mut h, 0, 0, 0), ADDRESS, 4, 1);
+        h.now = 108;
+        m.advance(&mut Cx::new(&mut h, 0, 0, 0));
+        h.now = 200;
+        m.write(&mut Cx::new(&mut h, 0, 0, 0), ADDRESS, 4, 1);
+        let pending = m.checkpoint().unwrap();
+        let mut restored = AudioResetFixture::new_with_second_command(8).unwrap();
+        restored.restore_checkpoint(&pending).unwrap();
+        assert_eq!(restored.save(), m.save());
+        assert_eq!(restored.next_deadline(200), Some(208));
+        h.now = 207;
+        restored.advance(&mut Cx::new(&mut h, 3, 0x1234, 0));
+        assert_eq!(restored.save(), m.save());
+        h.now = 208;
+        restored.event(&mut Cx::new(&mut h, 3, 0x1234, 0), 1);
+        assert_eq!(restored.save(), m.save());
+        assert_eq!(
+            restored.read(&mut Cx::new(&mut h, 3, 0x1234, 0), ADDRESS, 4),
+            1
+        );
+        restored.advance(&mut Cx::new(&mut h, 3, 0x1234, 0));
+        m.restore_checkpoint(&restored.checkpoint().unwrap())
+            .unwrap();
+        assert_eq!(m.save(), restored.save());
+        refused(&mut m, &mut h, ADDRESS, 4, Some(1));
+        let mut unknown_request = pending.decode::<serde_json::Value>(NAME).unwrap();
+        unknown_request["stage"]["Pending"]["extra"] = serde_json::json!(1);
+        let mut invalid = vec![
+            pending
+                .clone()
+                .with_children(vec![restored.checkpoint().unwrap()]),
+            pending.clone().with_blobs(vec![vec![1u8].into()]),
+            Checkpoint::encode("other-device", &m.state).unwrap(),
+            Checkpoint::encode(NAME, &unknown_request).unwrap(),
+            Checkpoint::encode(
+                NAME,
+                &serde_json::json!({"ticks": 8, "stage": "Unknown", "allow_second_command": true}),
+            )
+            .unwrap(),
+        ];
+        for malformed in 0..7 {
+            let mut bad: State = pending.decode(NAME).unwrap();
+            if let Stage::Pending(ref mut request) = bad.stage {
+                match malformed {
+                    0 => request.command = 0,
+                    1 => request.token = 0,
+                    2 => request.token = 3,
+                    3 => request.due += 1,
+                    4 => request.started = u64::MAX,
+                    5 => bad.ticks = 9,
+                    _ => bad.allow_second_command = false,
+                }
+            }
+            invalid.push(Checkpoint::encode(NAME, &bad).unwrap());
+        }
+        for saved in invalid {
+            let before = m.save();
+            assert!(m.restore_checkpoint(&saved).is_err());
+            assert_eq!(m.save(), before);
+        }
+    }
