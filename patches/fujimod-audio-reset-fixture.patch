+    #[test]
+    fn second_command_deadline_overflow_preserves_first_completion() {
+        for ticks in [0, 1_000_001, u64::MAX] {
+            assert!(AudioResetFixture::new_with_second_command(ticks).is_err());
+        }
+        assert!(AudioResetFixture::new_with_second_command(1).is_ok());
+        assert!(AudioResetFixture::new_with_second_command(1_000_000).is_ok());
+        let mut m = AudioResetFixture::new_with_second_command(8).unwrap();
+        let mut h = Clock::default();
+        m.write(&mut Cx::new(&mut h, 0, 0, 0), ADDRESS, 4, 1);
+        h.now = 8;
+        m.advance(&mut Cx::new(&mut h, 0, 0, 0));
+        h.now = u64::MAX - 7;
+        refused(&mut m, &mut h, ADDRESS, 4, Some(1));
+        h.now = u64::MAX - 8;
+        m.write(&mut Cx::new(&mut h, 0, 0, 0), ADDRESS, 4, 1);
+        assert_eq!(h.events, [(8, 1), (u64::MAX, 2)]);
+        let pending = m.save();
+        h.now = u64::MAX - 1;
+        m.advance(&mut Cx::new(&mut h, 0, 0, 0));
+        h.now = u64::MAX;
+        m.event(&mut Cx::new(&mut h, 0, 0, 0), 1);
+        assert_eq!(m.save(), pending);
+        m.advance(&mut Cx::new(&mut h, 0, 0, 0));
+        assert_eq!(m.read(&mut Cx::new(&mut h, 0, 0, 0), ADDRESS, 4), 0);
+        refused(&mut m, &mut h, ADDRESS, 4, Some(1));
+    }
