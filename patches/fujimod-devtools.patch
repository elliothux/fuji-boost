+    fn reprogram_prefix(m: &mut BankedCalibration, h: &mut TestHost, unit: usize, count: usize) {
+        for (n, (paired, off, value)) in m.reprogram_plans[unit]
+            .clone()
+            .unwrap()
+            .into_iter()
+            .take(count)
+            .enumerate()
+        {
+            write(
+                m,
+                h,
+                if paired { q(unit, off) } else { p(unit, off) },
+                value,
+            );
+            m.validate_checkpoint(&m.checkpoint().unwrap()).unwrap();
+            if let Some(action) = BankedCalibration::reprogram_action(n) {
+                assert_eq!(m.state.units[unit].stage, Stage::Pending(action));
+                let at = h.now + 8;
+                advance(m, h, at);
+                m.validate_checkpoint(&m.checkpoint().unwrap()).unwrap();
+            }
+        }
+    }
