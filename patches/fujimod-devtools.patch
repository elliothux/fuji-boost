+    fn reprogram_config() -> Config {
+        let mut c = config();
+        c.unit0_preinitialized = true;
+        // Synthetic high status bits must survive the two new masked events.
+        c.profile[0] = (0x7090, 0xa5a580);
+        c.source_sha256 = source_hash(&c);
+        let mut r = Reprogram {
+            profile: c.profile.iter().map(|&(o, v)| (o, v ^ 0x100)).collect(),
+            cached: [Some([
+                0x12345678, 0x98765432, 0x89abcdef, 0x87654321, 0xfedcba98, 0x76543210,
+            ]); 4],
+            input_sha256: String::new(),
+        };
+        r.input_sha256 = r.hash();
+        c.reprogram = Some(r);
+        c
+    }
