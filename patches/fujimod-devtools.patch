+            refused(&mut m, &mut h, p(unit, 0x7114), 0);
+            refused(&mut m, &mut h, q(unit, 0x7c40), 0x80000000);
+            let mut expected = before[unit].clone();
+            expected.removal_origins.push(expected.selector_reentries);
+            expected.selector_reentries = 0;
+            for (n, (o, v)) in c
+                .removal_script
+                .iter()
+                .copied()
+                .chain([(0x7080, 0x100)])
+                .enumerate()
+            {
+                write(&mut m, &mut h, q(unit, o), v);
+                expected.paired.insert(o, v);
+                assert_eq!(m.state.units[unit].primary, expected.primary);
+                assert_eq!(m.state.units[unit].paired, expected.paired);
+                assert_eq!(m.state.units[unit].removal_origins.len(), cycle + 1);
+                let mut restored = BankedCalibration::new(c.clone()).unwrap();
+                restored
+                    .restore_checkpoint(&m.checkpoint().unwrap())
+                    .unwrap();
+                assert_eq!(restored.save(), m.save());
+                for other in [0, 2, 3] {
+                    assert_eq!(m.state.units[other], before[other]);
+                }
+                if n == 3 {
