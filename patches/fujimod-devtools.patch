diff --git a/crates/emulator-xp4-io/src/linked_dma_input_fixture.rs b/crates/emulator-xp4-io/src/linked_dma_input_fixture.rs
new file mode 100644
index 0000000..91b4d87
--- /dev/null
+++ b/crates/emulator-xp4-io/src/linked_dma_input_fixture.rs
@@ -0,0 +1,383 @@
+//! Opt-in zero-word input with an optional finite budget; physical owner/format are unqualified.
+//! Tracked registers remain discovery/fallback accesses, not modeled reads.
+use fujimod_emulator_devices::{
+    Cx, Device,
+    checkpoint::Checkpoint,
+    dma::{Direction, Port},
+};
+use serde::{Deserialize, Serialize};
+
+const NAME: &str = "xp4-linked-dma-input";
+#[cfg(test)]
+const CONFIG: u64 = 0xfff4f008;
+#[cfg(test)]
+const ENABLE: u64 = 0xfff4f018;
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct State {
+    direction: Direction,
+    word_limit: Option<u64>,
+    received: u64,
+    transmitted: u64,
+    config: u32,
+    enable: u32,
+    since: Option<u64>,
+}
+
+pub struct LinkedDmaInputFixture {
+    state: State,
+}
+
+impl LinkedDmaInputFixture {
+    pub fn new(word_limit: Option<u64>) -> Result<Self, String> {
+        if word_limit.is_some_and(|limit| !(1..=262144).contains(&limit)) {
+            return Err("Linked DMA synthetic word limit must be in1..=262144".into());
+        }
+        Ok(Self {
+            state: State {
+                direction: Direction::Receive,
+                word_limit,
+                received: 0,
+                transmitted: 0,
+                config: 0,
+                enable: 0,
+                since: None,
+            },
+        })
+    }
+
+    pub fn output() -> Self {
+        let mut output = Self::new(None).unwrap();
+        output.state.direction = Direction::Transmit;
+        output
+    }
+    fn base(&self) -> u64 {
+        match self.state.direction { Direction::Receive => 0xfff4f000, Direction::Transmit => 0xfff78000 }
+    }
+    fn enabled(value: u32) -> bool {
+        value & 1 != 0 && value & 0x01010000 != 0
+    }
+
+    fn validate_state(&self, state: &State) -> Result<(), String> {
+        if state.direction != self.state.direction
+            || state.direction == Direction::Receive && state.transmitted != 0
+            || state.direction == Direction::Transmit && state.received != 0
+            || state.word_limit != self.state.word_limit
+            || state.word_limit.is_some_and(|limit| state.received > limit)
+            || Self::enabled(state.enable) != state.since.is_some()
+        {
+            return Err("Invalid or different linked DMA input checkpoint".into());
+        }
+        Ok(())
+    }
+
+    fn load_checkpoint(&self, saved: &Checkpoint) -> Result<State, String> {
+        if !saved.blobs().is_empty() || !saved.children().is_empty() {
+            return Err("Unexpected linked DMA input checkpoint attachments".into());
+        }
+        let state = saved.decode(self.name())?;
+        self.validate_state(&state)?;
+        Ok(state)
+    }
+}
+
+impl Port for LinkedDmaInputFixture {
+    fn request(&self, direction: Direction, burst: bool) -> Option<u64> {
+        if direction != self.state.direction || burst || self.state.word_limit.is_some_and(|limit| self.state.received >= limit)
+        {
+            return None;
+        }
+        self.state.since
+    }
+
+    fn receive(&mut self, now: u64, bytes: u8) -> Result<u64, String> {
+        let since = self
+            .request(Direction::Receive, false)
+            .ok_or("Linked DMA synthetic word input is not available")?;
+        if bytes != 4 || now < since {
+            return Err("Linked DMA synthetic input requires an available4B word".into());
+        }
+        self.state.received = self.state.received.checked_add(1).ok_or("Linked DMA input counter overflow")?;
+        Ok(0)
+    }
+
+    fn transmit(&mut self, now: u64, bytes: u8, value: u64) -> Result<(), String> {
+        let since = self.request(Direction::Transmit, false)
+            .ok_or("Linked DMA synthetic output is not enabled")?;
+        if bytes != 4 || value > u32::MAX as u64 || now < since {
+            return Err("Linked DMA synthetic output requires an available4B word".into());
+        }
+        self.state.transmitted = self.state.transmitted.checked_add(1)
+            .ok_or("Linked DMA output counter overflow")?;
+        Ok(())
+    }
+}
+
+impl Device for LinkedDmaInputFixture {
+    fn name(&self) -> &'static str {
+        match self.state.direction { Direction::Receive => NAME, Direction::Transmit => "xp4-linked-dma-output" }
+    }
+
+    fn read(&mut self, cx: &mut Cx<'_>, _: u64, _: u8) -> u64 {
+        cx.unmodeled();
+        0
+    }
+
+    fn write(&mut self, cx: &mut Cx<'_>, address: u64, size: u8, value: u64) {
+        if size == 4
+            && let Ok(value) = u32::try_from(value)
+        {
+            match address.wrapping_sub(self.base()) {
+                8 => self.state.config = value,
+                0x18 => {
+                    let was_enabled = Self::enabled(self.state.enable);
+                    let enabled = Self::enabled(value);
+                    self.state.enable = value;
+                    if !enabled {
+                        self.state.since = None;
+                    } else if !was_enabled {
+                        self.state.since = Some(cx.now());
+                    }
+                }
+                _ => {}
+            }
+        }
+        // Keep framework shadow values and discovery evidence for these accesses.
+        cx.unmodeled();
+    }
+
+    fn save(&self) -> serde_json::Value {
+        serde_json::to_value(&self.state).unwrap()
+    }
+
+    fn restore(&mut self, value: &serde_json::Value) -> Result<(), String> {
+        let state: State = serde_json::from_value(value.clone()).map_err(|e| e.to_string())?;
+        self.validate_state(&state)?;
+        self.state = state;
+        Ok(())
+    }
+
+    fn checkpoint(&self) -> Result<Checkpoint, String> {
+        Checkpoint::encode(self.name(), &self.state)
+    }
+
+    fn validate_checkpoint(&self, saved: &Checkpoint) -> Result<(), String> {
+        self.load_checkpoint(saved).map(|_| ())
+    }
+
+    fn restore_checkpoint(&mut self, saved: &Checkpoint) -> Result<(), String> {
+        self.state = self.load_checkpoint(saved)?;
+        Ok(())
+    }
+
+    fn fingerprint(&self) -> Result<serde_json::Value, String> {
+        Ok(self.save())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use fujimod_emulator_devices::{Host, Record};
+    use serde_json::json;
+
+    #[derive(Default)]
+    struct Clock(u64);
+    impl Host for Clock {
+        fn now(&self) -> u64 {
+            self.0
+        }
+        fn schedule(&mut self, _: usize, _: u64, _: u64) {
+            panic!("input must not schedule events");
+        }
+        fn set_irq(&mut self, _: u32, _: bool) {
+            panic!("input must not change IRQs");
+        }
+        fn raise_irq(&mut self, _: usize, _: u32) -> Result<(), String> {
+            panic!("input must not raise IRQs");
+        }
+        fn ram_read(&self, _: u64, _: &mut [u8]) -> Result<(), String> {
+            panic!("input must not read RAM");
+        }
+        fn ram_write(&mut self, _: u64, _: &[u8]) -> Result<(), String> {
+            panic!("input must not write RAM");
+        }
+        fn record(&mut self, _: Record) {
+            panic!("input must not synthesize model records");
+        }
+    }
+
+    fn write_at(device: &mut LinkedDmaInputFixture, now: u64, address: u64, size: u8, value: u64) {
+        let mut host = Clock(now);
+        let mut cx = Cx::new(&mut host, 3, 0x1234, 0);
+        device.write(&mut cx, address, size, value);
+        assert!(cx.is_unmodeled());
+        assert!(cx.refusal().is_some());
+    }
+
+    #[test]
+    fn waits_for_qualified_enable_and_keeps_first_assertion_tick() {
+        let mut device = LinkedDmaInputFixture::new(Some(3)).unwrap();
+        assert_eq!(device.name(), NAME);
+        assert_eq!(device.request(Direction::Receive, false), None);
+        write_at(&mut device, 10, CONFIG, 4, 0x1000256b);
+        for value in [0, 1, 0x10000, 0x1000000] {
+            write_at(&mut device, 20, ENABLE, 4, value);
+            assert_eq!(device.request(Direction::Receive, false), None);
+        }
+        write_at(&mut device, 30, ENABLE, 4, 0x10001);
+        assert_eq!(device.request(Direction::Receive, false), Some(30));
+        write_at(&mut device, 40, ENABLE, 4, 0x1010001);
+        assert_eq!(device.request(Direction::Receive, false), Some(30));
+        assert_eq!(device.request(Direction::Receive, true), None);
+        assert_eq!(device.request(Direction::Transmit, false), None);
+        assert_eq!(device.receive(40, 4).unwrap(), 0);
+        write_at(&mut device, 50, ENABLE, 4, 0);
+        assert_eq!(device.request(Direction::Receive, false), None);
+        write_at(&mut device, 60, ENABLE, 4, 0x1000001);
+        assert_eq!(device.request(Direction::Receive, false), Some(60));
+        assert_eq!(device.save()["received"], json!(1));
+    }
+
+    #[test]
+    fn finite_zero_words_do_not_reset_across_disable_or_forge_completion() {
+        for limit in [0, 262145, u64::MAX] {
+            assert!(LinkedDmaInputFixture::new(Some(limit)).is_err());
+        }
+        assert!(LinkedDmaInputFixture::new(Some(262144)).is_ok());
+        let mut device = LinkedDmaInputFixture::new(Some(2)).unwrap();
+        write_at(&mut device, 5, ENABLE, 4, 0x10001);
+        assert_eq!(device.receive(5, 4).unwrap(), 0);
+        write_at(&mut device, 6, ENABLE, 4, 0);
+        write_at(&mut device, 7, ENABLE, 4, 0x10001);
+        assert_eq!(device.receive(7, 4).unwrap(), 0);
+        assert_eq!(device.request(Direction::Receive, false), None);
+        let exhausted = device.save();
+        assert!(device.receive(8, 4).is_err());
+        assert_eq!(device.save(), exhausted);
+        write_at(&mut device, 9, ENABLE, 4, 0);
+        write_at(&mut device, 10, ENABLE, 4, 0x10001);
+        assert_eq!(device.save()["received"], json!(2));
+        assert_eq!(device.request(Direction::Receive, false), None);
+        assert_eq!(device.next_deadline(10), None);
+    }
+
+    #[test]
+    fn unlimited_silence_continues_past_old_budget_and_checkpoint() {
+        let mut device = LinkedDmaInputFixture::new(None).unwrap();
+        write_at(&mut device, 5, ENABLE, 4, 0x10001);
+        for now in 5..200_005 { assert_eq!(device.receive(now, 4).unwrap(), 0); }
+        let mut resumed = LinkedDmaInputFixture::new(None).unwrap();
+        resumed.restore_checkpoint(&device.checkpoint().unwrap()).unwrap();
+        assert_eq!(resumed.request(Direction::Receive, false), Some(5));
+        assert_eq!(resumed.receive(200_005, 4).unwrap(), 0);
+        assert_eq!(resumed.save()["received"], 200_001);
+        assert!(LinkedDmaInputFixture::new(Some(2)).unwrap().restore_checkpoint(&device.checkpoint().unwrap()).is_err());
+    }
+
+    #[test]
+    fn invalid_receive_transmit_and_reads_have_no_effects() {
+        let mut device = LinkedDmaInputFixture::new(Some(1)).unwrap();
+        let waiting = device.save();
+        assert!(device.receive(100, 4).is_err());
+        assert!(device.transmit(100, 4, 0).is_err());
+        assert_eq!(device.save(), waiting);
+        write_at(&mut device, 100, ENABLE, 4, 0x10001);
+        let before = device.save();
+        for bytes in [0, 1, 2, 8] {
+            assert!(device.receive(100, bytes).is_err());
+            assert_eq!(device.save(), before);
+        }
+        assert!(device.receive(99, 4).is_err());
+        assert!(device.transmit(100, 4, u64::MAX).is_err());
+        for address in [CONFIG, ENABLE, 0xfff4f01c, 0xfff4f024] {
+            for _ in 0..200 {
+                let mut host = Clock(100);
+                let mut cx = Cx::new(&mut host, 0, 0, 0);
+                assert_eq!(device.read(&mut cx, address, 4), 0);
+                assert!(cx.is_unmodeled());
+            }
+        }
+        for (address, size, value) in [
+            (CONFIG, 2, 1),
+            (ENABLE, 8, 0),
+            (CONFIG + 1, 4, 1),
+            (0xfff4f01c, 4, 1),
+            (ENABLE, 4, 1 << 32),
+        ] {
+            write_at(&mut device, 200, address, size, value);
+            assert_eq!(device.save(), before);
+        }
+    }
+
+    #[test]
+    fn output_requires_guest_enable_discards_words_and_restores_count_and_direction() {
+        let mut output = LinkedDmaInputFixture::output();
+        assert_eq!(output.name(), "xp4-linked-dma-output");
+        assert!(output.transmit(10, 4, 123).is_err());
+        write_at(&mut output, 10, 0xfff78018, 4, 0x1000001);
+        assert_eq!(output.request(Direction::Transmit, false), Some(10));
+        assert_eq!(output.request(Direction::Receive, false), None);
+        assert!(output.receive(10, 4).is_err());
+        for (now, bytes, value) in [(9, 4, 0), (10, 1, 0), (10, 4, 1u64 << 32)] {
+            assert!(output.transmit(now, bytes, value).is_err());
+        }
+        output.transmit(10, 4, 0x12345678).unwrap();
+        let saved = output.checkpoint().unwrap();
+        let mut resumed = LinkedDmaInputFixture::output();
+        resumed.restore_checkpoint(&saved).unwrap();
+        assert_eq!(resumed.save()["transmitted"], 1);
+        assert!(LinkedDmaInputFixture::new(None).unwrap().restore_checkpoint(&saved).is_err());
+        write_at(&mut resumed, 20, 0xfff78018, 4, 0);
+        assert!(resumed.transmit(20, 4, 0).is_err());
+        assert_eq!(resumed.save()["transmitted"], 1);
+    }
+
+    #[test]
+    fn restores_enabled_disabled_and_exhausted_state_with_identity() {
+        let mut device = LinkedDmaInputFixture::new(Some(2)).unwrap();
+        write_at(&mut device, 20, CONFIG, 4, 0x1000252b);
+        write_at(&mut device, 30, ENABLE, 4, 0x10001);
+        device.receive(40, 4).unwrap();
+        let mut restored = LinkedDmaInputFixture::new(Some(2)).unwrap();
+        restored
+            .restore_checkpoint(&device.checkpoint().unwrap())
+            .unwrap();
+        assert_eq!(restored.save(), device.save());
+        assert_eq!(restored.request(Direction::Receive, false), Some(30));
+        write_at(&mut device, 50, ENABLE, 4, 0);
+        restored.restore(&device.save()).unwrap();
+        assert_eq!(restored.request(Direction::Receive, false), None);
+        write_at(&mut restored, 60, ENABLE, 4, 0x1000001);
+        restored.receive(60, 4).unwrap();
+        device
+            .restore_checkpoint(&restored.checkpoint().unwrap())
+            .unwrap();
+        assert_eq!(device.fingerprint().unwrap(), restored.save());
+        assert_eq!(device.request(Direction::Receive, false), None);
+        let before = device.save();
+        for (key, value) in [
+            ("word_limit", json!(3)),
+            ("received", json!(3)),
+            ("enable", json!(0)),
+            ("since", json!(null)),
+            ("config", json!(1u64 << 32)),
+            ("received", json!(-1)),
+            ("unexpected", json!(0)),
+        ] {
+            let mut invalid = before.clone();
+            invalid[key] = value;
+            assert!(device.restore(&invalid).is_err());
+            let checkpoint = Checkpoint::encode(NAME, &invalid).unwrap();
+            assert!(device.validate_checkpoint(&checkpoint).is_err());
+            assert!(device.restore_checkpoint(&checkpoint).is_err());
+            assert_eq!(device.save(), before);
+        }
+        let wrong_kind = Checkpoint::encode("different", &device.state).unwrap();
+        assert!(device.restore_checkpoint(&wrong_kind).is_err());
+        let child = device.checkpoint().unwrap().with_children(vec![wrong_kind]);
+        assert!(device.restore_checkpoint(&child).is_err());
+        assert_eq!(device.save(), before);
+    }
+}
