+    fn configured(m: &mut BankedCalibration, h: &mut TestHost, i: usize) {
+        program(m, h, i);
+        write(m, h, q(i, 0x7c18), 0x40000000);
+        let at = h.now + 8;
+        advance(m, h, at);
+        for (o, v) in m
