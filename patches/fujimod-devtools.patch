+    let (mut d, wire, mut h) = fixture(2944);
+    d.linked_ports.get_mut(&4).unwrap().word_ticks = (1125, 2);
+    d.linked_ports.get_mut(&4).unwrap().dram_bytes = 8192;
+    h.bytes.resize(8192, 0xcc);
+    for cycle in 0..2 {
+        wire.lock().unwrap().since = Some(h.now);
+        configure(&mut d, &mut h, 1024, 1920, 257);
+        descriptor(&mut h, 256, 2944, 1920, 305);
+        descriptor(&mut h, 304, 4864, 1920, 353);
+        descriptor(&mut h, 352, 6784, 128, 0);
+        submit(&mut d, &mut h).unwrap();
+        let start = h.now;
+        for word in 1u64..=1472 {
+            while d.linked_words[4] < cycle * 1472 + word { step(&mut d, &mut h).unwrap(); }
+            let paused = if word > 1440 { 100 } else { 0 };
+            assert_eq!(h.now - start, word.min(1440) + (word.saturating_sub(1440) * 1125).div_ceil(2) + paused);
+            if [1,480,481,1440,1441,1472].contains(&word) {
+                let saved = d.save();
+                let (mut fresh, _, _) = fixture(2944);
+                fresh.linked_ports.get_mut(&4).unwrap().word_ticks = (1125, 2);
+                fresh.linked_ports.get_mut(&4).unwrap().dram_bytes = 8192;
+                fresh.restore(&saved).unwrap();
+                assert_eq!(fresh.save(), saved);
+                d.restore(&saved).unwrap();
+            }
+            if word == 1440 {
+                wire.lock().unwrap().since = None;
+                assert_eq!(d.next_deadline(h.now), None);
+                h.now += 100;
+                wire.lock().unwrap().since = Some(h.now);
+            }
+        }
+        assert_eq!(h.now - start, 19540);
+        assert!(!d.channels[4].submitted);
+    }
+    assert_eq!(wire.lock().unwrap().pops, 2944);
+}
