+        clock.now += 100;
+        restored.write(&mut Cx::new(&mut clock, core, pc, 0), ADDRESS, 4, 0);
+        assert_eq!(restored.next_deadline(clock.now), Some(clock.now + 8));
+        (device.save(), clock.records)
+    }
