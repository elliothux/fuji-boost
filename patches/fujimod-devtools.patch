diff --git a/crates/emulator-xp4-display/src/clock.rs b/crates/emulator-xp4-display/src/clock.rs
new file mode 100644
index 0000000..0075203
--- /dev/null
+++ b/crates/emulator-xp4-display/src/clock.rs
@@ -0,0 +1,191 @@
+//! FFFAB000 program/request/ready block; display/pixel-clock identity is unproven.
+//! The lock law and constructor-supplied latency are synthetic assumptions.
+use fujimod_emulator_devices::{Cx, Device};
+use serde::{Deserialize, Serialize};
+
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct State {
+    regs: [u32; 6],
+    ready: bool,
+    generation: u64,
+    due: Option<u64>,
+}
+
+pub struct Clock {
+    base: u64,
+    lock_ticks: u64,
+    state: State,
+}
+
+impl Clock {
+    pub fn new(base: u64, lock_ticks: u64) -> Result<Self, String> {
+        if base != 0xfffab000 || lock_ticks == 0 {
+            return Err("Invalid XP4 display clock base or lock latency".into());
+        }
+        Ok(Self {
+            base,
+            lock_ticks,
+            state: State {
+                regs: [0; 6],
+                ready: false,
+                generation: 0,
+                due: None,
+            },
+        })
+    }
+
+    fn index(&self, address: u64, size: u8) -> Option<usize> {
+        let offset = address.checked_sub(self.base)?;
+        (size == 4 && offset < 0x18 && offset.is_multiple_of(4)).then_some((offset / 4) as usize)
+    }
+}
+
+impl Device for Clock {
+    fujimod_emulator_devices::checkpoint_fields!(state: State);
+
+    fn name(&self) -> &'static str {
+        "xp4-display-clock"
+    }
+
+    fn read(&mut self, cx: &mut Cx<'_>, address: u64, size: u8) -> u64 {
+        let Some(index) = self.index(address, size) else {
+            cx.unmodeled();
+            return 0;
+        };
+        let value = self.state.regs[index];
+        u64::from(if index == 0 {
+            (value & !1) | u32::from(self.state.ready)
+        } else {
+            value
+        })
+    }
+
+    fn write(&mut self, cx: &mut Cx<'_>, address: u64, size: u8, value: u64) {
+        let Some(index) = self.index(address, size) else {
+            cx.unmodeled();
+            return;
+        };
+        if index == 0 {
+            let Some(due) = cx.now().checked_add(self.lock_ticks) else {
+                cx.fail("XP4 display clock deadline overflow");
+                return;
+            };
+            let Some(generation) = self.state.generation.checked_add(1) else {
+                cx.fail("XP4 display clock generation overflow");
+                return;
+            };
+            self.state.ready = false;
+            self.state.generation = generation;
+            self.state.due = Some(due);
+            cx.schedule(due, generation);
+        }
+        self.state.regs[index] = value as u32;
+    }
+
+    fn event(&mut self, cx: &mut Cx<'_>, token: u64) {
+        if token == self.state.generation && self.state.due.is_some_and(|due| cx.now() >= due) {
+            self.state.ready = true;
+            self.state.due = None;
+        }
+    }
+
+    fn save(&self) -> serde_json::Value {
+        serde_json::to_value(&self.state).unwrap()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use fujimod_emulator_devices::test_host::recording::RecordingHost;
+
+    const BASE: u64 = 0xfffab000;
+
+    #[test]
+    fn lock_deadline_rearm_and_checkpoint_round_trip() {
+        let mut clock = Clock::new(BASE, 2700).unwrap();
+        let mut host = RecordingHost {
+            now: 100,
+            ..Default::default()
+        };
+        let mut cx = Cx::new(&mut host, 0, 0, 2);
+        assert_eq!(clock.read(&mut cx, BASE, 4), 0);
+        for offset in (4..0x18).step_by(4) {
+            clock.write(&mut cx, BASE + offset, 4, 0xdead0000 + offset);
+            assert_eq!(clock.read(&mut cx, BASE + offset, 4), 0xdead0000 + offset);
+        }
