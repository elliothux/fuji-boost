+
+const SELECTOR1: [(u32, u32); 3] = [(0x5038, 0x03204020), (0x5438, 0x83), (0x5384, 1)];
+const SELECTOR0: [(u32, u32); 3] = [(0x5038, 0x01004100), (0x5438, 0x81), (0x5384, 1)];
+
+fn selector_script(reentries: u64) -> [(u32, u32); 3] {
+    if reentries & 1 == 0 {
+        SELECTOR1
+    } else {
+        SELECTOR0
+    }
+}
+
+fn mode2_selector_valid(unit: usize, n: usize, value: u32) -> bool {
+    // Unit 0 selectors are a 4-bit field: catalog inputs choose 0..=7, the measured
+    // jig inputs choose 8 at entry 26.
+    (23..=46).contains(&n)
+        && match unit {
+            0 => value <= 15,
+            1 | 2 => matches!(value, 0 | 1 | 2 | 5),
+            _ => value <= 4,
+        }
+        && (n != 46 || value == 0)
+}
+
+impl Reprogram {
+    fn hash(&self) -> String {
+        let mask = self
+            .cached
+            .iter()
+            .enumerate()
+            .fold(0u32, |m, (i, c)| m | if c.is_some() { 1 << i } else { 0 });
+        let bytes: Vec<_> = mask
+            .to_le_bytes()
+            .into_iter()
+            .chain(
+                self.profile
+                    .iter()
+                    .flat_map(|(o, v)| o.to_le_bytes().into_iter().chain(v.to_le_bytes())),
+            )
+            .chain(
+                self.cached
+                    .iter()
+                    .flatten()
+                    .flatten()
+                    .flat_map(|v| v.to_le_bytes()),
+            )
+            .collect();
+        fujimod_emulator_devices::fingerprint::bytes(&bytes)["sha256"]
+            .as_str()
+            .unwrap()
+            .into()
+    }
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Identity {
+    source_sha256: String,
+    mode5_sha256: String,
+    removal_sha256: String,
+    results: [[u16; 4]; 4],
+    latency_ticks: u64,
+    unit0_preinitialized: bool,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    mode2_sha256: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    reprogram_sha256: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    post_control_source_sha256: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    post_mode2_source_sha256: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    selector1_source_sha256: Option<String>,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+enum Action {
+    Pll,
+    Clear3,
+    Clear10,
+    Controller,
+    Finalize,
+    Mode5,
+    Mode2,
+    Removal,
+    ReprogramClear,
+    ReprogramReady,
+    ReprogramPll,
+    PostPll,
+    PostClear,
+    PostController,
+    PostFinalize,
+    PostMode2,
+    Selector1(bool),
+}
+impl Action {
+    fn command(self) -> (bool, u32, u32) {
+        match self {
+            Self::Pll => (true, 0x7c18, 0x40000000),
+            Self::Clear3 => (true, 0x7040, 3),
+            Self::Clear10 => (true, 0x7040, 0x10),
+            Self::Controller => (false, 0x2000, 0xb01),
+            Self::Finalize => (true, 0x7360, 0xff00c00d),
+            Self::Mode5 | Self::Mode2 | Self::PostMode2 | Self::Selector1(_) => (true, 0x5384, 1),
+            Self::Removal | Self::ReprogramReady => (true, 0x7080, 0x100),
+            Self::ReprogramClear => (true, 0x7040, 0x100),
+            Self::ReprogramPll => (true, 0x7c18, 0x40000000),
+            Self::PostPll => (true, 0x7c50, 1),
+            Self::PostClear => (true, 0x7080, 0x200),
+            Self::PostController => (true, 0x7c50, 0),
+            Self::PostFinalize => (true, 0x7360, 0xff00c00d),
+        }
+    }
+    fn label(self) -> &'static str {
+        match self {
+            Self::Pll => "paired-kick",
+            Self::Clear3 => "paired-command3",
+            Self::Clear10 => "paired-command10",
+            Self::Controller => "controller",
+            Self::Finalize => "finalization",
+            Self::Mode5 => "mode5",
+            Self::Mode2 => "mode2",
+            Self::Removal => "removal",
+            Self::ReprogramClear => "reprogram-clear",
+            Self::ReprogramReady => "reprogram-ready",
+            Self::ReprogramPll => "reprogram-pll",
+            Self::PostPll => "post-control-pll",
+            Self::PostClear => "post-control-clear",
+            Self::PostController => "post-control-controller",
+            Self::PostFinalize => "post-control-finalization",
+            Self::PostMode2 => "post-mode2",
+            Self::Selector1(_) => "selector1",
+        }
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+enum Stage {
+    Initial(usize),
+    Kick,
+    Pending(Action),
+    Preparation(usize),
+    Profile(usize),
+    Command3,
+    Command10,
+    Controller,
+    Quality,
+    Acknowledge,
+    FinalWrites(usize),
+    Complete,
+    Mode5(usize),
+    Mode5Done,
+    Mode2(usize),
+    Mode2Done,
+    Removal(usize),
+    Removed,
+    Reprogram(usize),
+    ReprogramDone,
+    PostControl(usize),
+    PostControlDone,
+    PostMode2(usize),
+    PostMode2Done,
+    Selector1(usize, bool),
+    Selector1Done(bool),
+}
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Pending {
+    action: Action,
+    started: u64,
+    due: u64,
+    token: u64,
+}
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Mode5Origin {
+    from_post: bool,
+    reentries: u64,
+    removals: Vec<u64>,
+    selectors: BTreeMap<usize, u32>,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Unit {
+    stage: Stage,
+    primary: BTreeMap<u32, u32>,
+    paired: BTreeMap<u32, u32>,
+    pending: Option<Pending>,
+    #[serde(default, skip_serializing_if = "BTreeMap::is_empty")]
+    mode2_selectors: BTreeMap<usize, u32>,
+    #[serde(default, skip_serializing_if = "is_zero")]
+    selector_reentries: u64,
+    // Completed post-control selector counts before each removal restart.
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    removal_origins: Vec<u64>,
+    // Selector/removal histories consumed by full mode5 reentries.
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    mode5_origins: Vec<Mode5Origin>,
+}
+fn is_zero(value: &u64) -> bool {
+    *value == 0
+}
+impl Unit {
+    fn empty() -> Self {
+        Self {
+            stage: Stage::Initial(0),
+            primary: BTreeMap::new(),
+            paired: BTreeMap::new(),
+            pending: None,
+            mode2_selectors: BTreeMap::new(),
+            selector_reentries: 0,
+            removal_origins: Vec::new(),
+            mode5_origins: Vec::new(),
+        }
+    }
+    fn pll_done(&mut self) {
+        for (offset, mask) in [(0x4670, 0x30000), (0x4674, 0x30003), (0x4678, 0x30003)] {
+            *self.primary.get_mut(&offset).unwrap() |= mask;
+        }
+        self.paired.insert(0x7c18, 1);
+    }
+    fn controller_done(&mut self, results: [u16; 4]) {
+        *self.primary.get_mut(&0x2110).unwrap() |= 1;
+        for offset in [0x40dc, 0x42dc] {
+            let v = self.primary.get_mut(&offset).unwrap();
+            *v = (*v & !0x1300) | 0x300;
+        }
+        for (offset, low, high) in [
+            (0x444c, results[0], results[1]),
+            (0x4620, results[2], results[3]),
+        ] {
+            let v = self.primary.get_mut(&offset).unwrap();
+            *v = (*v & !0x07ff07ff) | u32::from(low) | (u32::from(high) << 16);
+        }
+    }
+}
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct State {
+    identity: Identity,
+    units: [Unit; 4],
+    generation: u64,
+}
+
+pub struct BankedCalibration {
+    config: Config,
+    state: State,
+    reprogram_plans: [Option<Vec<(bool, u32, u32)>>; 4],
+}
+impl BankedCalibration {
+    pub fn new(config: Config) -> Result<Self, String> {
+        for (script, count) in [
+            (&config.initial_script, 686),
+            (&config.preparation, 7),
+            (&config.profile, 17),
+        ] {
+            if script.len() != count
+                || script.iter().any(|(o, _)| o & 3 != 0 || *o >= 0x10000)
+                || script.iter().map(|(o, _)| o).collect::<BTreeSet<_>>().len() != count
+            {
+                return Err("Invalid banked calibration script extent/alignment/uniqueness".into());
+            }
+        }
+        if !(1..=1_000_000).contains(&config.latency_ticks)
+            || config.results.iter().flatten().any(|v| *v > 0x7ff)
+        {
+            return Err("Invalid banked calibration results or latency".into());
+        }
+        let bytes: Vec<u8> = config
+            .initial_script
+            .iter()
+            .chain(&config.preparation)
+            .chain(&config.profile)
+            .flat_map(|(o, v)| o.to_le_bytes().into_iter().chain(v.to_le_bytes()))
+            .collect();
+        let digest = fujimod_emulator_devices::fingerprint::bytes(&bytes);
+        if digest["sha256"].as_str() != Some(config.source_sha256.as_str()) {
+            return Err("Banked calibration source hash differs from its scripts".into());
+        }
+        for (unit, script) in config.mode5_scripts.iter().enumerate() {
+            let base = 0xff500000 + (unit as u32) * 0x10000;
+            if script.len() != 71 {
+                return Err("Invalid mode5 script length".into());
+            }
+            for (n, &(address, value)) in script.iter().enumerate() {
+                let valid = match n {
+                    0..=22 => address == base + 0x5000 + n as u32 * 4 && value == 0x01004100,
+                    23..=46 => {
+                        address == base + 0x5200 + (n - 23) as u32 * 4
+                            && value <= 7
+                            && (n != 46 || value == 0)
+                    }
+                    47..=69 => address == base + 0x5400 + (n - 47) as u32 * 4 && value == 0x81,
+                    70 => address == base + 0x5384 && value == 1,
+                    _ => false,
+                };
+                if !valid {
+                    return Err("Unsupported mode5 script grammar".into());
+                }
+            }
+        }
+        let bytes: Vec<u8> = config
+            .mode5_scripts
+            .iter()
+            .flatten()
+            .flat_map(|(a, v)| a.to_le_bytes().into_iter().chain(v.to_le_bytes()))
+            .collect();
+        if fujimod_emulator_devices::fingerprint::bytes(&bytes)["sha256"].as_str()
+            != Some(config.mode5_sha256.as_str())
+        {
+            return Err("Mode5 source hash differs from its scripts".into());
+        }
+        if let Some(mode2) = &config.mode2 {
+            for (unit, script) in mode2.scripts.iter().enumerate() {
+                let base = 0xff500000 + unit as u32 * 0x10000;
+                if script.len() != 71 {
+                    return Err("Invalid mode2 script length".into());
+                }
+                for (n, &(address, value)) in script.iter().enumerate() {
+                    let valid = match n {
+                        0..=22 => {
+                            address == base + 0x5000 + n as u32 * 4
+                                && if matches!(unit, 1 | 2) {
+                                    matches!(value, 0x01004100 | 0x05004200 | 0x09004600)
+                                } else {
+                                    value == 0x01004100
+                                }
+                        }
+                        23..=46 => {
+                            address == base + 0x5200 + (n - 23) as u32 * 4
+                                && mode2_selector_valid(unit, n, value)
+                        }
+                        47..=69 => {
+                            address == base + 0x5400 + (n - 47) as u32 * 4
+                                && match unit {
+                                    0 => value == 0x81,
+                                    1 | 2 => matches!(value, 0x81 | 0x83 | 0xa1),
+                                    _ => matches!(value, 0x81 | 0xa1),
+                                }
+                        }
+                        70 => address == base + 0x5384 && value == 1,
+                        _ => false,
+                    };
+                    if !valid {
+                        return Err("Unsupported mode2 script grammar".into());
+                    }
+                }
+            }
+            let bytes: Vec<u8> = mode2
+                .scripts
+                .iter()
+                .flatten()
+                .flat_map(|(a, v)| a.to_le_bytes().into_iter().chain(v.to_le_bytes()))
+                .collect();
+            if fujimod_emulator_devices::fingerprint::bytes(&bytes)["sha256"].as_str()
+                != Some(mode2.source_sha256.as_str())
+            {
+                return Err("Mode2 source hash differs from its scripts".into());
+            }
+        }
+        if config.removal_script != [(0x7114, 0), (0x7c40, 0x80000000), (0x7c14, 0x80000000)]
+            || config.removal_poll != [0x7080, 0x100, 0x7090, 1, 1]
+        {
+            return Err("Unsupported removal script/poll grammar".into());
+        }
+        let bytes: Vec<u8> = config
+            .removal_script
+            .iter()
+            .flat_map(|(o, v)| o.to_le_bytes().into_iter().chain(v.to_le_bytes()))
+            .chain(config.removal_poll.iter().flat_map(|v| v.to_le_bytes()))
+            .collect();
+        if fujimod_emulator_devices::fingerprint::bytes(&bytes)["sha256"].as_str()
+            != Some(config.removal_sha256.as_str())
+        {
+            return Err("Removal source hash differs from its script/poll".into());
+        }
+        let initial: BTreeMap<_, _> = config.initial_script.iter().copied().collect();
+        for (o, mask, expected) in [
+            (0x2000, u32::MAX, 0xb00),
+            (0x2110, 1, 0),
+            (0x4670, 0x30000, 0),
+            (0x4674, 0x30003, 0),
+            (0x4678, 0x30003, 0),
+            (0x40dc, 0x1300, 0),
+            (0x42dc, 0x1300, 0),
+            (0x444c, 0x07ff07ff, 0),
+            (0x4620, 0x07ff07ff, 0),
+        ] {
+            if initial.get(&o).is_none_or(|v| v & mask != expected) {
+                return Err("Unsupported initial banked calibration control/results".into());
+            }
+        }
+        if config
+            .preparation
+            .iter()
+            .chain(&config.profile)
+            .any(|(o, _)| {
+                [0x7c18, 0x7040, 0x7044, 0x7360, 0x7364].contains(o)
+                    || config.mode5_scripts[0]
+                        .iter()
+                        .any(|(a, _)| a & 0xffff == *o)
+            })
+        {
+            return Err("Configuration script overlaps command/status registers".into());
+        }
+        if config
+            .preparation
+            .iter()
+            .chain(&config.profile)
+            .map(|(o, _)| o)
+            .collect::<BTreeSet<_>>()
+            .len()
+            != 24
+        {
+            return Err("Paired configuration scripts overlap".into());
+        }
+        if let Some(hash) = &config.post_control_source_sha256 {
+            if config.reprogram.is_none()
+                || config.latency_ticks != 8
+                || hash.len() != 64
+                || !hash
+                    .bytes()
+                    .all(|v| v.is_ascii_digit() || (b'a'..=b'f').contains(&v))
+            {
+                return Err("Invalid post-control source hash/reprogram dependency/latency".into());
+            }
+        }
+        if let Some(hash) = &config.post_mode2_source_sha256 {
+            if config.reprogram.is_none()
+                || config.post_control_source_sha256.is_none()
+                || config.mode2.is_none()
+                || config.latency_ticks != 8
+                || hash.len() != 64
+                || !hash
+                    .bytes()
+                    .all(|v| v.is_ascii_digit() || (b'a'..=b'f').contains(&v))
+            {
+                return Err("Invalid post-mode2 source hash/dependencies/latency".into());
+            }
+        }
+        if let Some(hash) = &config.selector1_source_sha256 {
+            if config.mode2.is_none()
+                || config.latency_ticks != 8
+                || hash.len() != 64
+                || !hash
+                    .bytes()
+                    .all(|v| v.is_ascii_digit() || (b'a'..=b'f').contains(&v))
+            {
+                return Err("Invalid selector1 source hash/mode2 dependency/latency".into());
+            }
+        }
+        let mut reprogram_plans: [Option<Vec<(bool, u32, u32)>>; 4] = std::array::from_fn(|_| None);
+        if let Some(r) = &config.reprogram {
+            if config.latency_ticks != 8
+                || r.cached.iter().all(Option::is_none)
+                || r.profile.len() != 17
+                || !r
+                    .profile
+                    .iter()
+                    .map(|(o, _)| o)
+                    .eq(config.profile.iter().map(|(o, _)| o))
+            {
+                return Err("Invalid reprogram targets/profile/latency".into());
+            }
+            if r.hash() != r.input_sha256 {
+                return Err("Reprogram input hash differs from its inputs".into());
+            }
+            let mut primary = initial.clone();
+            primary.extend(REPROGRAM_SUPPLEMENT);
+            for (unit, cached) in r.cached.iter().enumerate() {
+                let Some(cached) = cached else { continue };
+                let mut plan: Vec<_> = config
+                    .initial_script
+                    .iter()
+                    .map(|&(o, v)| (false, o, v))
+                    .chain(config.preparation.iter().map(|&(o, v)| (true, o, v)))
+                    .chain(r.profile.iter().map(|&(o, v)| (true, o, v)))
+                    .chain(REPROGRAM_SUPPLEMENT.into_iter().map(|(o, v)| (false, o, v)))
+                    .collect();
+                for ((off, mask), value) in REPROGRAM_RMW.into_iter().zip(cached) {
+                    let old = primary
+                        .get(&off)
+                        .ok_or("Missing reprogram RMW initial word")?;
+                    plan.push((false, off, (old & !mask) | (value & mask)));
+                }
+                plan.push(Action::ReprogramClear.command());
+                plan.extend(REPROGRAM_PAIRED.into_iter().map(|(o, v)| (true, o, v)));
+                plan.push(Action::ReprogramReady.command());
+                plan.push((true, 0x7c80, 2));
+                plan.push(Action::ReprogramPll.command());
+                debug_assert_eq!(plan.len(), 730);
+                reprogram_plans[unit] = Some(plan);
+            }
+        }
+        let identity = Identity {
+            source_sha256: config.source_sha256.clone(),
+            mode5_sha256: config.mode5_sha256.clone(),
+            removal_sha256: config.removal_sha256.clone(),
+            results: config.results,
+            latency_ticks: config.latency_ticks,
+            unit0_preinitialized: config.unit0_preinitialized,
+            mode2_sha256: config.mode2.as_ref().map(|m| m.source_sha256.clone()),
+            reprogram_sha256: config.reprogram.as_ref().map(|r| r.input_sha256.clone()),
+            post_control_source_sha256: config.post_control_source_sha256.clone(),
+            post_mode2_source_sha256: config.post_mode2_source_sha256.clone(),
+            selector1_source_sha256: config.selector1_source_sha256.clone(),
+        };
+        let mut model = Self {
+            config,
+            reprogram_plans,
+            state: State {
+                identity,
+                units: std::array::from_fn(|_| Unit::empty()),
+                generation: 0,
+            },
+        };
+        if model.config.unit0_preinitialized {
+            model.state.units[0] = model.expected_unit(0, Stage::Complete)?;
+        }
+        Ok(model)
+    }
+
+    fn address(address: u64, size: u8) -> Result<(usize, bool, u32), String> {
+        if size != 4 || address & 3 != 0 {
+            return Err("Banked calibration requires aligned words".into());
+        }
+        let (paired, base) = if (0xff500000..0xff540000).contains(&address) {
+            (true, 0xff500000)
+        } else if (0xff600000..0xff640000).contains(&address) {
+            (false, 0xff600000)
+        } else {
+            return Err("Unknown banked calibration window".into());
+        };
+        Ok((
+            ((address - base) / 0x10000) as usize,
+            paired,
+            ((address - base) % 0x10000) as u32,
+        ))
+    }
+
+    fn reprogram_action(n: usize) -> Option<Action> {
+        match n {
+            722 => Some(Action::ReprogramClear),
+            727 => Some(Action::ReprogramReady),
+            729 => Some(Action::ReprogramPll),
+            _ => None,
+        }
+    }
+
+    fn reprogram_busy(u: &mut Unit, action: Action) {
+        match action {
+            Action::ReprogramClear => {
+                *u.paired.entry(0x7044).or_insert(0) |= 1;
+            }
+            Action::ReprogramReady => {
+                *u.paired.entry(0x7090).or_insert(0) &= !0xff;
+            }
+            _ => {}
+        }
+    }
+
+    fn reprogram_done(u: &mut Unit, action: Action) -> Stage {
+        match action {
+            Action::ReprogramClear => {
+                *u.paired.entry(0x7044).or_insert(0) &= !1;
+                Stage::Reprogram(723)
+            }
+            Action::ReprogramReady => {
+                let status = u.paired.entry(0x7090).or_insert(0);
+                *status = (*status & !0xff) | 1;
+                Stage::Reprogram(728)
+            }
+            Action::ReprogramPll => {
+                for (o, mask) in [(0x4670, 0x30000), (0x4674, 0x30003), (0x4678, 0x30003)] {
+                    *u.primary.get_mut(&o).unwrap() |= mask;
+                }
+                Stage::ReprogramDone
+            }
+            _ => unreachable!(),
+        }
+    }
+
+    fn post_action(n: usize) -> Option<Action> {
+        [
+            Action::PostPll,
+            Action::PostClear,
+            Action::PostController,
+            Action::PostFinalize,
+        ]
+        .get(n)
+        .copied()
+    }
+
+    fn post_busy(u: &mut Unit, action: Action) {
+        if action == Action::PostFinalize {
+            *u.paired.entry(0x7364).or_insert(0) &= !1;
+        }
+    }
+
+    // Explicit fixture effects; the guest's polling order does not prove their physical cause.
+    fn post_done(u: &mut Unit, action: Action) -> Stage {
+        let n = match action {
+            Action::PostPll => {
+                let status = u.paired.get_mut(&0x7c18).unwrap();
+                *status = (*status & !0x40000001) | 1;
+                1
+            }
+            Action::PostClear => {
+                *u.paired.get_mut(&0x7090).unwrap() &= !1;
+                2
+            }
+            Action::PostController => {
+                *u.primary.get_mut(&0x2110).unwrap() |= 1;
+                for o in [0x40dc, 0x42dc] {
+                    let word = u.primary.get_mut(&o).unwrap();
+                    *word = (*word & !0x1300) | 0x300;
+                }
+                3
+            }
+            Action::PostFinalize => {
+                *u.paired.get_mut(&0x7364).unwrap() |= 1;
+                4
+            }
+            _ => unreachable!(),
+        };
+        Stage::PostControl(n)
+    }
+
+    fn write_word(
+        &mut self,
+        cx: &mut Cx<'_>,
+        unit: usize,
+        paired: bool,
+        offset: u32,
+        value: u32,
+    ) -> Result<(), String> {
+        let u = &self.state.units[unit];
+        if let Some(p) = &u.pending {
+            return if p.action.command() == (paired, offset, value) {
+                Ok(())
+            } else {
+                Err("Different banked calibration request while busy".into())
+            };
+        }
+        // UNMEASURED FUNCTIONAL ASSUMPTION: firmware 0x11c33a8 replays the exact
+        // mode5 table after selector0; reuse the existing timed completion.
+        let mode5_restart = matches!(u.stage, Stage::Selector1Done(_))
+            && u.selector_reentries & 1 == 1
+            && (paired, offset, value) == (true, 0x5000, self.config.mode5_scripts[unit][0].1);
+        let removal_restart = u.stage == Stage::Selector1Done(true)
+            && (paired, offset, value)
+                == (
+                    true,
+                    self.config.removal_script[0].0,
+                    self.config.removal_script[0].1,
+                );
+        let reentries = if removal_restart || mode5_restart {
+            0
+        } else if matches!(u.stage, Stage::Selector1Done(_)) {
+            u.selector_reentries
+                .checked_add(1)
+                .ok_or("Calibration selector reentry overflow")?
+        } else {
+            u.selector_reentries
+        };
+        let stage = if mode5_restart {
+            Stage::Complete
+        } else if removal_restart {
+            Stage::Mode5Done
+        } else {
+            u.stage
+        };
+        let (expected, next, action) = match stage {
+            Stage::Initial(n) => (
+                (
+                    false,
+                    self.config.initial_script[n].0,
+                    self.config.initial_script[n].1,
+                ),
+                if n + 1 == 686 {
+                    Stage::Kick
+                } else {
+                    Stage::Initial(n + 1)
+                },
+                None,
+            ),
+            Stage::Preparation(n) => (
+                (
+                    true,
+                    self.config.preparation[n].0,
+                    self.config.preparation[n].1,
+                ),
+                if n + 1 == 7 {
+                    Stage::Profile(0)
+                } else {
+                    Stage::Preparation(n + 1)
+                },
+                None,
+            ),
+            Stage::Profile(n) => (
+                (true, self.config.profile[n].0, self.config.profile[n].1),
+                if n + 1 == 17 {
+                    Stage::Command3
+                } else {
+                    Stage::Profile(n + 1)
+                },
+                None,
+            ),
+            Stage::Kick => (
+                Action::Pll.command(),
+                Stage::Pending(Action::Pll),
+                Some(Action::Pll),
+            ),
+            Stage::Command3 => (
+                Action::Clear3.command(),
+                Stage::Pending(Action::Clear3),
+                Some(Action::Clear3),
+            ),
+            Stage::Command10 => (
+                Action::Clear10.command(),
+                Stage::Pending(Action::Clear10),
+                Some(Action::Clear10),
+            ),
+            Stage::Controller => (
+                Action::Controller.command(),
+                Stage::Pending(Action::Controller),
+                Some(Action::Controller),
+            ),
+            Stage::Quality => (
+                Action::Finalize.command(),
+                Stage::Pending(Action::Finalize),
+                Some(Action::Finalize),
+            ),
+            Stage::Acknowledge => ((true, 0x7364, 1), Stage::FinalWrites(0), None),
+            Stage::FinalWrites(n) => (
+                (true, FINAL[n].0, FINAL[n].1),
+                if n + 1 == FINAL.len() {
+                    Stage::Complete
+                } else {
+                    Stage::FinalWrites(n + 1)
+                },
+                None,
+            ),
+            Stage::Complete | Stage::Mode5(_) => {
+                let n = if let Stage::Mode5(n) = u.stage { n } else { 0 };
+                let &(address, value) = self.config.mode5_scripts[unit]
+                    .get(n)
+                    .ok_or("Invalid mode5 prefix")?;
+                let action = (n == 70).then_some(Action::Mode5);
+                (
+                    (true, address & 0xffff, value),
+                    if n == 70 {
+                        Stage::Pending(Action::Mode5)
+                    } else {
+                        Stage::Mode5(n + 1)
+                    },
+                    action,
+                )
+            }
+            Stage::Mode5Done
+                if self.config.mode2.as_ref().is_some_and(|mode2| {
+                    let (a, v) = mode2.scripts[unit][0];
+                    (true, a & 0xffff, v) == (paired, offset, value)
+                }) =>
+            {
+                ((true, offset, value), Stage::Mode2(1), None)
+            }
+            Stage::Mode2(n) => {
+                if !(1..71).contains(&n) {
+                    return Err("Invalid mode2 prefix".into());
+                }
+                let mode2 = self
+                    .config
+                    .mode2
+                    .as_ref()
+                    .ok_or("Mode2 is not configured")?;
+                let (a, v) = mode2.scripts[unit][n];
+                (
+                    (true, a & 0xffff, v),
+                    if n == 70 {
+                        Stage::Pending(Action::Mode2)
+                    } else {
+                        Stage::Mode2(n + 1)
+                    },
+                    (n == 70).then_some(Action::Mode2),
+                )
+            }
+            Stage::Mode5Done | Stage::Removal(_) => {
+                let n = if let Stage::Removal(n) = u.stage {
+                    n
+                } else {
+                    0
+                };
+                if n == 3 {
+                    (
+                        Action::Removal.command(),
+                        Stage::Pending(Action::Removal),
+                        Some(Action::Removal),
+                    )
+                } else {
+                    let &(o, v) = self
+                        .config
+                        .removal_script
+                        .get(n)
+                        .ok_or("Invalid removal prefix")?;
+                    ((true, o, v), Stage::Removal(n + 1), None)
+                }
+            }
+            Stage::Removed | Stage::Reprogram(_) if self.reprogram_plans[unit].is_some() => {
+                let n = if let Stage::Reprogram(n) = u.stage {
+                    n
+                } else {
+                    0
+                };
+                let expected = *self.reprogram_plans[unit]
+                    .as_ref()
+                    .and_then(|p| p.get(n))
+                    .ok_or("Reprogram unit/prefix is not configured")?;
+                let action = Self::reprogram_action(n);
+                (
+                    expected,
+                    action.map_or(Stage::Reprogram(n + 1), Stage::Pending),
+                    action,
+                )
+            }
+            Stage::ReprogramDone | Stage::PostControl(_)
+                if self.config.post_control_source_sha256.is_some() =>
+            {
+                let n = if let Stage::PostControl(n) = u.stage {
+                    n
+                } else {
+                    0
+                };
+                let (o, v) = *POST_CONTROL.get(n).ok_or("Invalid post-control prefix")?;
+                let action = Self::post_action(n);
+                (
+                    (true, o, v),
+                    action.map_or(
+                        if n == 7 {
+                            Stage::PostControlDone
+                        } else {
+                            Stage::PostControl(n + 1)
+                        },
+                        Stage::Pending,
+                    ),
+                    action,
+                )
+            }
+            Stage::PostControlDone | Stage::PostMode2(_)
+                if self.config.post_mode2_source_sha256.is_some() =>
+            {
+                let n = if let Stage::PostMode2(n) = u.stage {
+                    n
+                } else {
+                    0
+                };
+                let mode2 = self
+                    .config
+                    .mode2
+                    .as_ref()
+                    .ok_or("Post-mode2 is not configured")?;
+                let (a, v) = *mode2.scripts[unit]
+                    .get(n)
+                    .ok_or("Invalid post-mode2 prefix")?;
+                (
+                    (true, a & 0xffff, v),
+                    if n == 70 {
+                        Stage::Pending(Action::PostMode2)
+                    } else {
+                        Stage::PostMode2(n + 1)
+                    },
+                    (n == 70).then_some(Action::PostMode2),
+                )
+            }
+            Stage::Mode2Done
+            | Stage::PostMode2Done
+            | Stage::Selector1(_, _)
+            | Stage::Selector1Done(_)
+                if self.config.selector1_source_sha256.is_some() =>
+            {
+                let (n, from_post) = match u.stage {
+                    Stage::Selector1(n, origin) => (n, origin),
+                    Stage::Selector1Done(origin) => (0, origin),
+                    Stage::PostMode2Done => (0, true),
+                    _ => (0, false),
+                };
+                let (o, v) = *selector_script(reentries)
+                    .get(n)
+                    .ok_or("Invalid selector1 prefix")?;
+                (
+                    (true, o, v),
+                    if n == 2 {
+                        Stage::Pending(Action::Selector1(from_post))
+                    } else {
+                        Stage::Selector1(n + 1, from_post)
+                    },
+                    (n == 2).then_some(Action::Selector1(from_post)),
+                )
+            }
+            _ => return Err("Banked calibration reentry/reset/mode is not modeled".into()),
+        };
+        let selector = matches!(u.stage, Stage::Mode2(n) if mode2_selector_valid(unit, n, value));
+        if expected != (paired, offset, value)
+            && !(selector && (expected.0, expected.1) == (paired, offset))
+        {
+            return Err(format!(
+                "Unexpected banked calibration write unit{unit} paired{paired} {offset:#x}={value:#x} (expected paired{} {:#x}={:#x} at {:?})",
+                expected.0, expected.1, expected.2, u.stage
+            ));
+        }
+        let pending = if let Some(action) = action {
+            Some(Pending {
+                action,
+                started: cx.now(),
+                due: cx
+                    .now()
+                    .checked_add(self.config.latency_ticks)
+                    .ok_or("Calibration deadline overflow")?,
+                token: self
+                    .state
+                    .generation
+                    .checked_add(1)
+                    .ok_or("Calibration generation overflow")?,
+            })
+        } else {
+            None
+        };
+        let u = &mut self.state.units[unit];
+        if !removal_restart
+            && !mode5_restart
+            && matches!(u.stage, Stage::Selector1Done(_) | Stage::Selector1(_, _))
+        {
+            cx.record(Record::new(
+                "XP4 calibration selector reentry write",
+                [
+                    ("unit", Field::int(unit as u64)),
+                    ("preceding_stage", Field::str(&format!("{:?}", u.stage))),
+                    ("reentry", Field::int(reentries)),
+                    ("offset", Field::hex(offset.into())),
+                    ("value", Field::hex(value.into())),
+                    ("tick", Field::int(cx.now())),
+                ],
+            ));
+        }
+        if removal_restart || !u.removal_origins.is_empty() {
+            cx.record(Record::new(
+                "XP4 calibration cycle write",
+                [
+                    ("unit", Field::int(unit as u64)),
+                    ("preceding_stage", Field::str(&format!("{:?}", u.stage))),
+                    ("offset", Field::hex(offset.into())),
+                    ("value", Field::hex(value.into())),
+                    ("tick", Field::int(cx.now())),
+                ],
+            ));
+        }
+        if mode5_restart {
+            let Stage::Selector1Done(from_post) = u.stage else {
+                unreachable!()
+            };
+            u.mode5_origins.push(Mode5Origin {
+                from_post,
+                reentries: u.selector_reentries,
+                removals: std::mem::take(&mut u.removal_origins),
+                selectors: std::mem::take(&mut u.mode2_selectors),
+            });
+        }
+        if removal_restart {
+            u.removal_origins.push(u.selector_reentries);
+        }
+        u.selector_reentries = reentries;
+        if selector && expected.2 != value {
+            if let Stage::Mode2(n) = u.stage {
+                u.mode2_selectors.insert(n, value);
+            }
+        }
+        if paired {
+            u.paired.insert(offset, value);
+        } else {
+            u.primary.insert(offset, value);
+        }
+        if matches!(u.stage, Stage::Acknowledge | Stage::PostControl(4)) {
+            // No W1C law is implied by the observed final write.
+            u.paired.remove(&0x7364);
+            cx.record(Record::new(
+                "XP4 calibration fixture final write recorded",
+                [
+                    ("unit", Field::int(unit as u64)),
+                    ("tick", Field::int(cx.now())),
+                ],
+            ));
+        }
+        if let Some(p) = &pending {
+            match p.action {
+                Action::Clear3 => {
+                    u.paired.insert(0x7044, 1);
+                }
+                Action::Clear10 => {
+                    u.paired.insert(0x7044, 0x10);
+                }
+                Action::Finalize => {
+                    u.paired.insert(0x7364, 0);
+                }
+                Action::Removal => {
+                    *u.paired.entry(0x7090).or_insert(0) &= !1;
+                }
+                _ => {}
+            }
+            Self::reprogram_busy(u, p.action);
+            Self::post_busy(u, p.action);
+            self.state.generation = p.token;
+            cx.schedule(p.due, p.token);
+        }
+        u.pending = pending;
+        u.stage = next;
+        Ok(())
+    }
+
+    // Build the scripted register state at each prefix, before selector deviations.
+    fn expected_unit(&self, unit: usize, target: Stage) -> Result<Unit, String> {
+        self.expected_repeated_unit(unit, target, 0, None, None)
+    }
+
+    fn expected_repeated_unit(
+        &self,
+        unit: usize,
+        target: Stage,
+        reentries: u64,
+        removal_base: Option<&Unit>,
+        mode5_base: Option<&Unit>,
+    ) -> Result<Unit, String> {
+        if matches!(
+            target,
+            Stage::Selector1(_, _) | Stage::Pending(Action::Selector1(_)) | Stage::Selector1Done(_)
+        ) {
+            if self.config.selector1_source_sha256.is_none() {
+                return Err("Selector1 is not configured".into());
+            }
+            let (count, from_post) = match target {
+                Stage::Selector1(n, origin) if (1..3).contains(&n) => (n, origin),
+                Stage::Pending(Action::Selector1(origin)) | Stage::Selector1Done(origin) => {
+                    (3, origin)
+                }
+                _ => return Err("Invalid selector1 prefix".into()),
+            };
+            let mut u = self.expected_repeated_unit(
+                unit,
+                if from_post {
+                    Stage::PostMode2Done
+                } else {
+                    Stage::Mode2Done
+                },
+                0,
+                removal_base,
+                mode5_base,
+            )?;
+            if reentries != 0 {
+                u.paired.extend(selector_script(reentries - 1));
+                u.paired.insert(0x5384, 0);
+            }
+            u.paired
+                .extend(selector_script(reentries)[..count].iter().copied());
+            if matches!(target, Stage::Selector1Done(_)) {
+                u.paired.insert(0x5384, 0);
+            }
+            u.stage = target;
+            u.selector_reentries = reentries;
+            return Ok(u);
+        }
+        if reentries != 0 {
+            return Err("Selector reentry history outside selector phase".into());
+        }
+        if matches!(
+            target,
+            Stage::PostMode2(_) | Stage::Pending(Action::PostMode2) | Stage::PostMode2Done
+        ) {
+            if self.config.post_mode2_source_sha256.is_none() {
+                return Err("Post-mode2 is not configured".into());
+            }
+            let count = match target {
+                Stage::PostMode2(n) if (1..71).contains(&n) => n,
+                Stage::Pending(Action::PostMode2) | Stage::PostMode2Done => 71,
+                _ => return Err("Invalid post-mode2 prefix".into()),
+            };
+            let mut u = self.expected_repeated_unit(
+                unit,
+                Stage::PostControlDone,
+                0,
+                removal_base,
+                mode5_base,
+            )?;
+            let mode2 = self
+                .config
+                .mode2
+                .as_ref()
+                .ok_or("Post-mode2 is not configured")?;
+            u.paired.extend(
+                mode2.scripts[unit][..count]
+                    .iter()
+                    .map(|(a, v)| (a & 0xffff, *v)),
+            );
+            if target == Stage::PostMode2Done {
+                u.paired.insert(0x5384, 0);
+            }
+            u.stage = target;
+            return Ok(u);
+        }
+        if matches!(
+            target,
+            Stage::PostControl(_)
+                | Stage::PostControlDone
+                | Stage::Pending(
+                    Action::PostPll
+                        | Action::PostClear
+                        | Action::PostController
+                        | Action::PostFinalize
+                )
+        ) {
+            if self.config.post_control_source_sha256.is_none() {
+                return Err("Post-control is not configured".into());
+            }
+            let count = match target {
+                Stage::PostControl(n) if (1..8).contains(&n) => n,
+                Stage::PostControlDone => 8,
+                Stage::Pending(Action::PostPll) => 1,
+                Stage::Pending(Action::PostClear) => 2,
+                Stage::Pending(Action::PostController) => 3,
+                Stage::Pending(Action::PostFinalize) => 4,
+                _ => return Err("Invalid post-control prefix".into()),
+            };
+            let mut u = self.expected_repeated_unit(
+                unit,
+                Stage::ReprogramDone,
+                0,
+                removal_base,
+                mode5_base,
+            )?;
+            for (n, &(o, v)) in POST_CONTROL[..count].iter().enumerate() {
+                u.paired.insert(o, v);
+                if n == 4 {
+                    u.paired.remove(&0x7364);
+                }
+                if let Some(action) = Self::post_action(n) {
+                    Self::post_busy(&mut u, action);
+                    if target != Stage::Pending(action) {
+                        Self::post_done(&mut u, action);
+                    }
+                }
+            }
+            u.stage = target;
+            return Ok(u);
+        }
+        if matches!(
+            target,
+            Stage::Reprogram(_)
+                | Stage::ReprogramDone
+                | Stage::Pending(
+                    Action::ReprogramClear | Action::ReprogramReady | Action::ReprogramPll
+                )
+        ) {
+            let plan = self.reprogram_plans[unit]
+                .as_ref()
+                .ok_or("Reprogram unit is not configured")?;
+            let count = match target {
+                Stage::Reprogram(n) if (1..730).contains(&n) => n,
+                Stage::Pending(Action::ReprogramClear) => 723,
+                Stage::Pending(Action::ReprogramReady) => 728,
+                Stage::Pending(Action::ReprogramPll) | Stage::ReprogramDone => 730,
+                _ => return Err("Invalid reprogram prefix".into()),
+            };
+            let mut u =
+                self.expected_repeated_unit(unit, Stage::Removed, 0, removal_base, mode5_base)?;
+            for (n, &(paired, off, value)) in plan[..count].iter().enumerate() {
+                if paired {
+                    u.paired.insert(off, value);
+                } else {
+                    u.primary.insert(off, value);
+                }
+                if let Some(action) = Self::reprogram_action(n) {
+                    Self::reprogram_busy(&mut u, action);
+                    if target != Stage::Pending(action) {
+                        Self::reprogram_done(&mut u, action);
+                    }
+                }
+            }
+            u.stage = target;
+            return Ok(u);
+        }
+        if matches!(
+            target,
+            Stage::Removal(_) | Stage::Pending(Action::Removal) | Stage::Removed
+        ) {
+            let mut u = match removal_base {
+                Some(base) => base.clone(),
+                None => self.expected_repeated_unit(unit, Stage::Mode5Done, 0, None, mode5_base)?,
+            };
+            let n = match target {
+                Stage::Removal(n) if (1..=3).contains(&n) => n,
+                Stage::Removal(_) => return Err("Invalid removal prefix".into()),
+                Stage::Pending(Action::Removal) | Stage::Removed => 3,
+                _ => 0,
+            };
+            u.paired
+                .extend(self.config.removal_script[..n].iter().copied());
+            if matches!(target, Stage::Pending(Action::Removal) | Stage::Removed) {
+                u.paired.insert(0x7080, 0x100);
+            }
+            if target == Stage::Removed {
+                *u.paired.entry(0x7090).or_insert(0) |= 1;
+            }
+            u.selector_reentries = 0;
+            u.stage = target;
+            return Ok(u);
+        }
+        if removal_base.is_some() {
+            return Err("Calibration removal history outside its continuation".into());
+        }
+        if let Some(base) = mode5_base {
+            let mut u = base.clone();
+            let (mode5_count, mode2_count, done) = match target {
+                Stage::Mode5(n) if (1..71).contains(&n) => (n, 0, false),
+                Stage::Pending(Action::Mode5) => (71, 0, false),
+                Stage::Mode5Done => (71, 0, true),
+                Stage::Mode2(n) if (1..71).contains(&n) => (71, n, false),
+                Stage::Pending(Action::Mode2) => (71, 71, false),
+                Stage::Mode2Done => (71, 71, true),
+                _ => return Err("Mode5 history outside its continuation".into()),
+            };
+            u.paired.extend(
+                self.config.mode5_scripts[unit][..mode5_count]
+                    .iter()
+                    .map(|(a, v)| (a & 0xffff, *v)),
+            );
+            if mode2_count != 0 || done {
+                u.paired.insert(0x5384, 0);
+                *u.paired.entry(0x7090).or_insert(0) &= !1;
+            }
+            if mode2_count != 0 {
+                let mode2 = self
+                    .config
+                    .mode2
+                    .as_ref()
+                    .ok_or("Mode2 is not configured")?;
+                u.paired.extend(
+                    mode2.scripts[unit][..mode2_count]
+                        .iter()
+                        .map(|(a, v)| (a & 0xffff, *v)),
+                );
+                if done {
+                    u.paired.insert(0x5384, 0);
+                }
+            }
+            u.stage = target;
+            return Ok(u);
+        }
+
+        let mut u = Unit::empty();
+        let initial = if let Stage::Initial(n) = target {
+            if n >= 686 {
+                return Err("Invalid initial prefix".into());
+            }
+            n
+        } else {
+            686
+        };
+        u.primary
+            .extend(self.config.initial_script[..initial].iter().copied());
+        if matches!(target, Stage::Initial(_)) {
+            u.stage = target;
+            return Ok(u);
+        }
+        u.stage = Stage::Kick;
+        if target == u.stage {
+            return Ok(u);
+        }
+        u.paired.insert(0x7c18, 0x40000000);
+        u.stage = Stage::Pending(Action::Pll);
+        if target == u.stage {
+            return Ok(u);
+        }
+        u.pll_done();
+        let n = if let Stage::Preparation(n) = target {
+            if n >= 7 {
+                return Err("Invalid preparation prefix".into());
+            }
+            n
+        } else {
+            7
+        };
+        u.paired
+            .extend(self.config.preparation[..n].iter().copied());
+        if matches!(target, Stage::Preparation(_)) {
+            u.stage = target;
+            return Ok(u);
+        }
+        let n = if let Stage::Profile(n) = target {
+            if n >= 17 {
+                return Err("Invalid profile prefix".into());
+            }
+            n
+        } else {
+            17
+        };
+        u.paired.extend(self.config.profile[..n].iter().copied());
+        if matches!(target, Stage::Profile(_)) {
+            u.stage = target;
+            return Ok(u);
+        }
+        for (before, action, after) in [
+            (Stage::Command3, Action::Clear3, Stage::Command10),
+            (Stage::Command10, Action::Clear10, Stage::Controller),
+            (Stage::Controller, Action::Controller, Stage::Quality),
+            (Stage::Quality, Action::Finalize, Stage::Acknowledge),
+        ] {
+            u.stage = before;
+            if target == u.stage {
+                return Ok(u);
+            }
+            let (paired, off, value) = action.command();
+            if paired {
+                u.paired.insert(off, value);
+            } else {
+                u.primary.insert(off, value);
+            }
+            match action {
+                Action::Clear3 => {
+                    u.paired.insert(0x7044, 1);
+                }
+                Action::Clear10 => {
+                    u.paired.insert(0x7044, 0x10);
+                }
+                Action::Finalize => {
+                    u.paired.insert(0x7364, 0);
+                }
+                _ => {}
+            }
+            u.stage = Stage::Pending(action);
+            if target == u.stage {
+                return Ok(u);
+            }
+            match action {
+                Action::Clear3 | Action::Clear10 => {
+                    u.paired.insert(0x7044, 0);
+                }
+                Action::Controller => u.controller_done(self.config.results[unit]),
+                Action::Finalize => {
+                    u.paired.insert(0x7364, 1);
+                }
+                _ => {}
+            }
+            u.stage = after;
+        }
+        if target == Stage::Acknowledge {
+            return Ok(u);
+        }
+        u.paired.remove(&0x7364);
+        let n = if let Stage::FinalWrites(n) = target {
+            if n >= FINAL.len() {
+                return Err("Invalid final prefix".into());
+            }
+            n
+        } else if matches!(
+            target,
+            Stage::Complete
+                | Stage::Mode5(_)
+                | Stage::Pending(Action::Mode5)
+                | Stage::Mode5Done
+                | Stage::Mode2(_)
+                | Stage::Pending(Action::Mode2)
+                | Stage::Mode2Done
+                | Stage::Removal(_)
+                | Stage::Pending(Action::Removal)
+                | Stage::Removed
+        ) {
+            FINAL.len()
+        } else {
+            return Err("Invalid calibration phase".into());
+        };
+        u.paired.extend(FINAL[..n].iter().copied());
+        let n = match target {
+            Stage::Mode5(n) if (1..71).contains(&n) => n,
+            Stage::Mode5(_) => return Err("Invalid mode5 prefix".into()),
+            Stage::Pending(Action::Mode5)
+            | Stage::Mode5Done
+            | Stage::Mode2(_)
+            | Stage::Pending(Action::Mode2)
+            | Stage::Mode2Done
+            | Stage::Removal(_)
+            | Stage::Pending(Action::Removal)
+            | Stage::Removed => 71,
+            _ => 0,
+        };
+        u.paired.extend(
+            self.config.mode5_scripts[unit][..n]
+                .iter()
+                .map(|(a, v)| (a & 0xffff, *v)),
+        );
+        if matches!(
+            target,
+            Stage::Mode5Done
+                | Stage::Mode2(_)
+                | Stage::Pending(Action::Mode2)
+                | Stage::Mode2Done
+                | Stage::Removal(_)
+                | Stage::Pending(Action::Removal)
+                | Stage::Removed
+        ) {
+            u.paired.insert(0x5384, 0);
+            // Explicit virtual status convention, not a recovered physical reset value.
+            *u.paired.entry(0x7090).or_insert(0) &= !1;
+        }
+        let n = match target {
+            Stage::Mode2(n) if (1..71).contains(&n) => n,
+            Stage::Mode2(_) => return Err("Invalid mode2 prefix".into()),
+            Stage::Pending(Action::Mode2) | Stage::Mode2Done => 71,
+            _ => 0,
+        };
+        if n != 0 {
+            let mode2 = self
+                .config
+                .mode2
+                .as_ref()
+                .ok_or("Mode2 is not configured")?;
+            u.paired.extend(
+                mode2.scripts[unit][..n]
+                    .iter()
+                    .map(|(a, v)| (a & 0xffff, *v)),
+            );
+            if target == Stage::Mode2Done {
+                u.paired.insert(0x5384, 0);
+            }
+            u.stage = target;
+            return Ok(u);
+        }
+        u.stage = target;
+        Ok(u)
+    }
+
+    fn validate_state(&self, state: &State) -> Result<(), String> {
+        if state.identity != self.state.identity {
+            return Err("Calibration checkpoint configuration differs".into());
+        }
+        let mut tokens = BTreeSet::new();
+        let mut issued = 0u64;
+        for (i, u) in state.units.iter().enumerate() {
+            if i == 0
+                && self.config.unit0_preinitialized
+                && !matches!(
+                    u.stage,
+                    Stage::Complete
+                        | Stage::Mode5(_)
+                        | Stage::Pending(Action::Mode5)
+                        | Stage::Mode5Done
+                        | Stage::Mode2(_)
+                        | Stage::Pending(Action::Mode2)
+                        | Stage::Mode2Done
+                        | Stage::Removal(_)
+                        | Stage::Pending(Action::Removal)
+                        | Stage::Removed
+                        | Stage::Reprogram(_)
+                        | Stage::ReprogramDone
+                        | Stage::PostControl(_)
+                        | Stage::PostControlDone
+                        | Stage::PostMode2(_)
+                        | Stage::PostMode2Done
+                        | Stage::Selector1(_, _)
+                        | Stage::Selector1Done(_)
+                        | Stage::Pending(Action::Selector1(_))
+                        | Stage::Pending(Action::PostMode2)
+                        | Stage::Pending(
+                            Action::PostPll
+                                | Action::PostClear
+                                | Action::PostController
+                                | Action::PostFinalize
+                        )
+                        | Stage::Pending(
+                            Action::ReprogramClear | Action::ReprogramReady | Action::ReprogramPll
+                        )
+                )
+            {
+                return Err("Preinitialized unit0 checkpoint differs".into());
+            }
+            let mut mode5_base = None;
+            let mut prior_commands = 0u64;
+            for origin in &u.mode5_origins {
+                if origin.reentries & 1 == 0 {
+                    return Err("Mode5 reentry requires completed selector0".into());
+                }
+                let mut removal_base = None;
+                for &reentries in &origin.removals {
+                    removal_base = Some(self.expected_repeated_unit(
+                        i,
+                        Stage::Selector1Done(true),
+                        reentries,
+                        removal_base.as_ref(),
+                        mode5_base.as_ref(),
+                    )?);
+                    prior_commands = prior_commands
+                        .checked_add(10)
+                        .and_then(|n| n.checked_add(reentries))
+                        .ok_or("Calibration removal command count overflow")?;
+                }
+                let mut base = self.expected_repeated_unit(
+                    i,
+                    Stage::Selector1Done(origin.from_post),
+                    origin.reentries,
+                    removal_base.as_ref(),
+                    mode5_base.as_ref(),
+                )?;
+                for (&n, &value) in &origin.selectors {
+                    if !mode2_selector_valid(i, n, value) || origin.from_post {
+                        return Err("Invalid mode5 origin selector".into());
+                    }
+                    let (address, scripted) = self.config.mode2.as_ref().unwrap().scripts[i][n];
+                    if value == scripted {
+                        return Err("Redundant mode5 origin selector".into());
+                    }
+                    base.paired.insert(address & 0xffff, value);
+                }
+                mode5_base = Some(base);
+                prior_commands = prior_commands
+                    .checked_add(if origin.from_post { 11 } else { 3 })
+                    .and_then(|n| n.checked_add(origin.reentries))
+                    .ok_or("Calibration mode5 command count overflow")?;
+            }
+            let mut removal_base = None;
+            for &reentries in &u.removal_origins {
+                removal_base = Some(self.expected_repeated_unit(
+                    i,
+                    Stage::Selector1Done(true),
+                    reentries,
+                    removal_base.as_ref(),
+                    mode5_base.as_ref(),
+                )?);
+                prior_commands = prior_commands
+                    .checked_add(10)
+                    .and_then(|n| n.checked_add(reentries))
+                    .ok_or("Calibration removal command count overflow")?;
+            }
+            issued = issued
+                .checked_add(prior_commands)
+                .ok_or("Calibration command count overflow")?;
+            let mut expected = self.expected_repeated_unit(
+                i,
+                u.stage,
+                u.selector_reentries,
+                removal_base.as_ref(),
+                mode5_base.as_ref(),
+            )?;
+            let mode2_count = match u.stage {
+                Stage::Mode2(n) => n,
+                Stage::Pending(Action::Mode2)
+                | Stage::Mode2Done
+                | Stage::Selector1(_, false)
+                | Stage::Pending(Action::Selector1(false))
+                | Stage::Selector1Done(false) => 71,
+                _ => 0,
+            };
+            for (&n, &value) in &u.mode2_selectors {
+                if n >= mode2_count || !mode2_selector_valid(i, n, value) {
+                    return Err("Invalid mode2 selector deviation".into());
+                }
+                let (address, scripted) = self.config.mode2.as_ref().unwrap().scripts[i][n];
+                if value == scripted {
+                    return Err("Redundant mode2 selector deviation".into());
+                }
+                expected.paired.insert(address & 0xffff, value);
+            }
+            if expected.primary != u.primary || expected.paired != u.paired {
+                return Err("Calibration checkpoint registers differ from phase".into());
+            }
+            match (u.stage, &u.pending) {
+                (Stage::Pending(a), Some(p))
+                    if p.action == a
+                        && p.token != 0
+                        && p.token <= state.generation
+                        && tokens.insert(p.token)
+                        && p.started.checked_add(self.config.latency_ticks) == Some(p.due) => {}
+                (Stage::Pending(_), _) | (_, Some(_)) => {
+                    return Err("Invalid calibration pending event".into());
+                }
+                _ => {}
+            }
+            let selector_issued = match u.stage {
+                Stage::Selector1(_, origin) => Some((origin, 0)),
+                Stage::Pending(Action::Selector1(origin)) | Stage::Selector1Done(origin) => {
+                    Some((origin, 1))
+                }
+                _ => None,
+            };
+            if let Some((origin, count)) = selector_issued {
+                let base = match (origin, i == 0 && self.config.unit0_preinitialized) {
+                    (false, false) => 7,
+                    (false, true) => 2,
+                    (true, false) => 15,
+                    (true, true) => 10,
+                };
+                let unit_issued = u
+                    .selector_reentries
+                    .checked_add(base + count)
+                    .ok_or("Calibration selector command count overflow")?;
+                if u.pending.as_ref().is_some_and(|p| {
+                    unit_issued
+                        .checked_add(prior_commands)
+                        .is_none_or(|n| p.token < n)
+                }) {
+                    return Err("Calibration pending token predates unit commands".into());
+                }
+                issued = issued
+                    .checked_add(unit_issued)
+                    .ok_or("Calibration command count overflow")?;
+                continue;
+            }
+            let post_mode2_issued = match u.stage {
+                Stage::PostMode2(_) => Some(0),
+                Stage::Pending(Action::PostMode2) | Stage::PostMode2Done => Some(1),
+                _ => None,
+            };
+            if let Some(count) = post_mode2_issued {
+                let unit_issued: u64 = if i == 0 && self.config.unit0_preinitialized {
+                    9
+                } else {
+                    14
+                } + count;
+                if u.pending.as_ref().is_some_and(|p| {
+                    unit_issued
+                        .checked_add(prior_commands)
+                        .is_none_or(|n| p.token < n)
+                }) {
+                    return Err("Calibration pending token predates unit commands".into());
+                }
+                issued = issued
+                    .checked_add(unit_issued)
+                    .ok_or("Calibration command count overflow")?;
+                continue;
+            }
+            let post_issued = match u.stage {
+                Stage::PostControl(n) => Some(n.min(4) as u64),
+                Stage::PostControlDone => Some(4),
+                Stage::Pending(Action::PostPll) => Some(1),
+                Stage::Pending(Action::PostClear) => Some(2),
+                Stage::Pending(Action::PostController) => Some(3),
+                Stage::Pending(Action::PostFinalize) => Some(4),
+                _ => None,
+            };
+            if let Some(count) = post_issued {
+                let unit_issued: u64 = if i == 0 && self.config.unit0_preinitialized {
+                    5
+                } else {
+                    10
+                } + count;
+                if u.pending.as_ref().is_some_and(|p| {
+                    unit_issued
+                        .checked_add(prior_commands)
+                        .is_none_or(|n| p.token < n)
+                }) {
+                    return Err("Calibration pending token predates unit commands".into());
+                }
+                issued = issued
+                    .checked_add(unit_issued)
+                    .ok_or("Calibration command count overflow")?;
+                continue;
+            }
+            let reprogram_issued = match u.stage {
+                Stage::Reprogram(n) => Some(u64::from(n > 722) + u64::from(n > 727)),
+                Stage::Pending(Action::ReprogramClear) => Some(1),
+                Stage::Pending(Action::ReprogramReady) => Some(2),
+                Stage::Pending(Action::ReprogramPll) | Stage::ReprogramDone => Some(3),
+                _ => None,
+            };
+            if let Some(count) = reprogram_issued {
+                let unit_issued: u64 = if i == 0 && self.config.unit0_preinitialized {
+                    2
+                } else {
+                    7
+                } + count;
+                if u.pending.as_ref().is_some_and(|p| {
+                    unit_issued
+                        .checked_add(prior_commands)
+                        .is_none_or(|n| p.token < n)
+                }) {
+                    return Err("Calibration pending token predates unit commands".into());
+                }
+                issued = issued
+                    .checked_add(unit_issued)
+                    .ok_or("Calibration command count overflow")?;
+                continue;
+            }
+            let cold_issued = if i == 0 && self.config.unit0_preinitialized {
+                0
+            } else {
+                match u.stage {
+                    Stage::Initial(_) | Stage::Kick => 0,
+                    Stage::Pending(Action::Pll)
+                    | Stage::Preparation(_)
+                    | Stage::Profile(_)
+                    | Stage::Command3 => 1,
+                    Stage::Pending(Action::Clear3) | Stage::Command10 => 2,
+                    Stage::Pending(Action::Clear10) | Stage::Controller => 3,
+                    Stage::Pending(Action::Controller) | Stage::Quality => 4,
+                    _ => 5,
+                }
+            };
+            let unit_issued = cold_issued
+                + u64::from(matches!(
+                    u.stage,
+                    Stage::Pending(Action::Mode5)
+                        | Stage::Mode5Done
+                        | Stage::Mode2(_)
+                        | Stage::Pending(Action::Mode2)
+                        | Stage::Mode2Done
+                        | Stage::Removal(_)
+                        | Stage::Pending(Action::Removal)
+                        | Stage::Removed
+                ))
+                + u64::from(matches!(
+                    u.stage,
+                    Stage::Pending(Action::Mode2) | Stage::Mode2Done
+                ))
+                + u64::from(matches!(
+                    u.stage,
+                    Stage::Pending(Action::Removal) | Stage::Removed
+                ));
+            if u.pending.as_ref().is_some_and(|p| {
+                unit_issued
+                    .checked_add(prior_commands)
+                    .is_none_or(|n| p.token < n)
+            }) {
+                return Err("Calibration pending token predates unit commands".into());
+            }
+            issued = issued
+                .checked_add(unit_issued)
+                .ok_or("Calibration command count overflow")?;
+        }
+        if state.generation != issued {
+            return Err("Calibration checkpoint generation differs from phases".into());
+        }
+        Ok(())
+    }
+}
