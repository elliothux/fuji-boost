+    fn repeated_requests(core: usize, pc: u64, polls: usize) -> (serde_json::Value, Vec<Record>) {
+        let mut device = Fff50000ReadyFixture::new_with_second_request(8).unwrap();
+        let mut clock = Clock::default();
+        refused(&mut device, &mut clock, ADDRESS, 4, None);
+        for ordinal in 1..=8u64 {
+            clock.now = ordinal * 100;
+            let due = clock.now + 8;
+            let mut cx = Cx::new(&mut clock, core, pc, 0);
+            device.write(&mut cx, ADDRESS, 4, 0);
+            assert!(cx.refusal().is_none());
+            assert_eq!(device.next_deadline(clock.now), Some(due));
+            let pending = device.save();
+            let events = clock.events.clone();
+            let records = clock.records.clone();
+            for now in [due - 1, due] {
+                clock.now = now;
+                refused(&mut device, &mut clock, ADDRESS, 4, Some(0));
+                refused(&mut device, &mut clock, ADDRESS, 4, Some(0x100000000));
+                refused(&mut device, &mut clock, ADDRESS, 8, Some(0));
+                refused(&mut device, &mut clock, 0xfff5002c, 4, Some(0));
+                for _ in 0..polls {
+                    let mut cx = Cx::new(&mut clock, core, pc, 0);
+                    assert_eq!(device.read(&mut cx, ADDRESS, 4), 0);
+                    assert!(cx.refusal().is_none());
+                }
+                for token in [0, ordinal + 1, ordinal - 1] {
+                    device.event(&mut Cx::new(&mut clock, core, pc, 0), token);
+                }
+                if now < due {
+                    device.event(&mut Cx::new(&mut clock, core, pc, 0), ordinal);
+                    device.advance(&mut Cx::new(&mut clock, core, pc, 0));
+                }
+                assert_eq!(device.save(), pending);
+                assert_eq!(clock.events, events);
+                assert_eq!(clock.records, records);
+            }
+            let saved = device.checkpoint().unwrap();
+            let mut restored = Fff50000ReadyFixture::new_with_second_request(8).unwrap();
+            restored.restore_checkpoint(&saved).unwrap();
+            assert_eq!(restored.save(), device.save());
+            device = restored;
+            device.advance(&mut Cx::new(&mut clock, core, pc, 0));
+            assert_eq!(
+                device.read(&mut Cx::new(&mut clock, core, pc, 0), ADDRESS, 4),
+                1
+            );
+            assert_eq!(device.next_deadline(due), None);
+            let ready = device.save();
+            let records = clock.records.clone();
+            device.event(&mut Cx::new(&mut clock, core, pc, 0), ordinal);
+            assert_eq!(device.save(), ready);
+            assert_eq!(clock.records, records);
+        }
