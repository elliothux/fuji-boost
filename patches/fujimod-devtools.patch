diff --git a/crates/emulator-xp4-io/src/audio_handshake.rs b/crates/emulator-xp4-io/src/audio_handshake.rs
new file mode 100644
index 0000000..b6525a5
--- /dev/null
+++ b/crates/emulator-xp4-io/src/audio_handshake.rs
@@ -0,0 +1,362 @@
+//! WAVE's FFFA8000 write-zero/ready and FFFA8004 write-one/self-clear polls.
+//! Processing (+8 bit0 at start) completes with an IRQ edge; latency/reset words are synthetic.
+use fujimod_emulator_devices::{Cx, Device, Record, Value as Field, checkpoint::Checkpoint};
+use serde::{Deserialize, Serialize};
+
+const NAME: &str = "xp4-audio-handshake";
+pub const BASE: u64 = 0xfffa8000;
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Request {
+    started: u64,
+    due: u64,
+    token: u64,
+    completion_irq: bool,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct State {
+    ticks: u64,
+    irq: u32,
+    words: [u32; 5],
+    pending: [Option<Request>; 2],
+    generation: u64,
+}
+
+pub struct AudioHandshake {
+    state: State,
+}
+
+impl AudioHandshake {
+    pub fn new(ticks: u64, irq: u32) -> Result<Self, String> {
+        if !(1..=1_000_000).contains(&ticks) || irq >= 512 {
+            return Err("Invalid audio handshake latency".into());
+        }
+        Ok(Self {
+            state: State {
+                ticks,
+                irq,
+                words: [0; 5],
+                pending: [None, None],
+                generation: 0,
+            },
+        })
+    }
+
+    fn index(address: u64, size: u8) -> Option<usize> {
+        (size == 4 && (BASE..BASE + 20).contains(&address) && address & 3 == 0)
+            .then_some(((address.wrapping_sub(BASE)) / 4) as usize)
+    }
+}
+
+impl Device for AudioHandshake {
+    fn name(&self) -> &'static str {
+        NAME
+    }
+
+    fn read(&mut self, cx: &mut Cx<'_>, address: u64, size: u8) -> u64 {
+        if let Some(index) = Self::index(address, size) {
+            return u64::from(self.state.words[index]);
+        }
+        cx.fail("Unsupported audio handshake read");
+        0
+    }
+
+    fn write(&mut self, cx: &mut Cx<'_>, address: u64, size: u8, value: u64) {
+        let Some(index) = Self::index(address, size).filter(|_| value <= u64::from(u32::MAX))
+        else {
+            cx.fail("Unsupported audio handshake write");
+            return;
+        };
+        if index >= 2 {
+            self.state.words[index] = value as u32;
+            return;
+        }
+        if value != index as u64 || self.state.pending[index].is_some() {
+            cx.fail("Unsupported or busy audio handshake request");
+            return;
+        }
+        let (Some(due), Some(token)) = (
+            cx.now().checked_add(self.state.ticks),
+            self.state.generation.checked_add(1),
+        ) else {
+            cx.fail("Audio handshake deadline/token overflow");
+            return;
+        };
+        // shortcut: completed requests may repeat; qualify other commands against new firmware traces.
+        self.state.words[index] = value as u32;
+        self.state.pending[index] = Some(Request {
+            started: cx.now(),
+            due,
+            token,
+            completion_irq: index == 1 && self.state.words[2] & 1 != 0,
+        });
+        self.state.generation = token;
+        cx.schedule(due, token);
+        cx.record(Record::new(
+            "XP4 audio request scheduled",
+            [
+                ("address", Field::int(address)),
+                ("command", Field::int(value)),
+                ("tick", Field::int(cx.now())),
+                ("due", Field::int(due)),
+            ],
+        ));
+    }
+
+    fn event(&mut self, cx: &mut Cx<'_>, token: u64) {
+        for index in 0..2 {
+            if let Some(request) = &self.state.pending[index]
+                && request.token == token
+                && request.due <= cx.now()
+            {
+                self.state.words[index] = 1 - index as u32;
+                if request.completion_irq {
+                    cx.set_irq(self.state.irq, false);
+                    cx.set_irq(self.state.irq, true);
+                    cx.set_irq(self.state.irq, false);
+                }
+                cx.record(Record::new(
+                    "XP4 audio request completed",
+                    [
+                        ("address", Field::int(BASE + index as u64 * 4)),
+                        ("value", Field::int(self.state.words[index])),
+                        ("tick", Field::int(request.due)),
+                    ],
+                ));
+                self.state.pending[index] = None;
+            }
+        }
+    }
+
+    fn advance(&mut self, cx: &mut Cx<'_>) {
+        for index in 0..2 {
+            if let Some(request) = &self.state.pending[index] {
+                self.event(cx, request.token);
+            }
+        }
+    }
+
+    fn next_deadline(&self, _: u64) -> Option<u64> {
+        self.state
+            .pending
+            .iter()
+            .flatten()
+            .map(|request| request.due)
+            .min()
+    }
+
+    fn pollable(&self, address: u64, size: u8) -> bool {
+        Self::index(address, size).is_some_and(|index| index < 2)
+    }
+
+    fn save(&self) -> serde_json::Value {
+        serde_json::to_value(&self.state).unwrap()
+    }
+    fn fingerprint(&self) -> Result<serde_json::Value, String> {
+        Ok(self.save())
+    }
+    fn checkpoint(&self) -> Result<Checkpoint, String> {
+        Checkpoint::encode(NAME, &self.state)
+    }
+
+    fn validate_checkpoint(&self, saved: &Checkpoint) -> Result<(), String> {
+        let state: State = saved.decode(NAME)?;
+        if !saved.blobs().is_empty()
+            || !saved.children().is_empty()
+            || state.ticks != self.state.ticks
+            || state.irq != self.state.irq
+            || state.words[0] > 1
+            || state.words[1] != u32::from(state.pending[1].is_some())
+            || state.pending.iter().enumerate().any(|(index, request)| {
+                request.as_ref().is_some_and(|r| {
+                    state.words[index] != index as u32
+                        || index == 0 && r.completion_irq
+                        || r.token == 0
+                        || r.token > state.generation
+                        || r.started.checked_add(state.ticks) != Some(r.due)
+                })
+            })
+            || matches!(&state.pending, [Some(a), Some(b)] if a.token == b.token)
+        {
+            return Err("Invalid audio handshake checkpoint or latency".into());
+        }
+        Ok(())
+    }
+
+    fn restore_checkpoint(&mut self, saved: &Checkpoint) -> Result<(), String> {
+        self.validate_checkpoint(saved)?;
+        self.state = saved.decode(NAME)?;
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use fujimod_emulator_devices::Host;
+
+    #[derive(Default)]
+    struct Clock {
+        now: u64,
+        events: Vec<(u64, u64)>,
+        irqs: Vec<(u64, u32, bool)>,
+    }
+    impl Host for Clock {
+        fn now(&self) -> u64 {
+            self.now
+        }
+        fn schedule(&mut self, _: usize, at: u64, token: u64) {
+            self.events.push((at, token));
+        }
+        fn set_irq(&mut self, line: u32, level: bool) {
+            self.irqs.push((self.now, line, level));
+        }
+        fn raise_irq(&mut self, _: usize, _: u32) -> Result<(), String> {
+            panic!("no audio IRQ");
+        }
+        fn ram_read(&self, _: u64, _: &mut [u8]) -> Result<(), String> {
+            panic!("no audio RAM");
+        }
+        fn ram_write(&mut self, _: u64, _: &[u8]) -> Result<(), String> {
+            panic!("no audio RAM");
+        }
+        fn record(&mut self, _: Record) {}
+    }
+
+    #[test]
+    fn exact_deadlines_observational_reads_and_checkpoint_continuation() {
+        let mut clock = Clock {
+            now: 100,
+            ..Default::default()
+        };
+        let mut source = AudioHandshake::new(8, 144).unwrap();
+        for (offset, value) in [(0, 0), (12, 0), (16, 0x158ce40), (8, 0), (4, 1)] {
+            source.write(
+                &mut Cx::new(&mut clock, 0, 0x11c4588, 0),
+                BASE + offset,
+                4,
+                value,
+            );
+        }
+        assert_eq!(clock.events, [(108, 1), (108, 2)]);
+        let saved = source.checkpoint().unwrap();
+        let mut resumed = AudioHandshake::new(8, 144).unwrap();
+        resumed.restore_checkpoint(&saved).unwrap();
+        for model in [&mut source, &mut resumed] {
+            let before = model.save();
+            clock.now = 108;
+            for _ in 0..3 {
+                assert_eq!(
+                    model.read(&mut Cx::new(&mut clock, 3, 0xdead, 0), BASE, 4),
+                    0
+                );
+                assert_eq!(
+                    model.read(&mut Cx::new(&mut clock, 3, 0xdead, 0), BASE + 4, 4),
+                    1
+                );
+            }
+            assert_eq!(before, model.save());
+            clock.now = 107;
+            model.advance(&mut Cx::new(&mut clock, 3, 0xdead, 0));
+            assert_eq!(before, model.save());
+            clock.now = 108;
+            model.event(&mut Cx::new(&mut clock, 3, 0xdead, 0), 999);
+            assert_eq!(before, model.save());
+            model.advance(&mut Cx::new(&mut clock, 3, 0xdead, 0));
+            assert_eq!(model.state.words, [1, 0, 0, 0, 0x158ce40]);
+            assert_eq!(model.next_deadline(108), None);
+            model.write(&mut Cx::new(&mut clock, 3, 0xdead, 0), BASE + 4, 4, 1);
+            model.event(&mut Cx::new(&mut clock, 3, 0xdead, 0), 2);
+            assert_eq!(model.state.words[1], 1);
+        }
+        assert_eq!(source.save(), resumed.save());
+        assert!(clock.irqs.is_empty());
+    }
+
+    #[test]
+    fn processing_edge_at_deadline_survives_checkpoint_and_ignores_stale_events() {
+        let mut clock = Clock { now: 100, ..Default::default() };
+        let mut source = AudioHandshake::new(8, 144).unwrap();
+        source.write(&mut Cx::new(&mut clock, 0, 0, 0), BASE + 8, 4, 1);
+        source.write(&mut Cx::new(&mut clock, 0, 0, 0), BASE + 4, 4, 1);
+        // Completion mode belongs to the started request, not subsequent register writes.
+        source.write(&mut Cx::new(&mut clock, 0, 0, 0), BASE + 8, 4, 0);
+        let saved = source.checkpoint().unwrap();
+        let mut resumed = AudioHandshake::new(8, 144).unwrap();
+        resumed.restore_checkpoint(&saved).unwrap();
+        assert!(AudioHandshake::new(8, 145).unwrap().restore_checkpoint(&saved).is_err());
+        for model in [&mut source, &mut resumed] {
+            clock.irqs.clear();
+            clock.now = 107;
+            model.advance(&mut Cx::new(&mut clock, 0, 0, 0));
+            assert!(clock.irqs.is_empty());
+            clock.now = 108;
+            model.event(&mut Cx::new(&mut clock, 0, 0, 0), 1);
+            model.advance(&mut Cx::new(&mut clock, 0, 0, 0));
+            model.event(&mut Cx::new(&mut clock, 0, 0, 0), 1);
+            assert_eq!(clock.irqs, [(108, 144, false), (108, 144, true), (108, 144, false)]);
+            assert_eq!(model.state.words[1], 0);
+        }
+        assert_eq!(source.save(), resumed.save());
+    }
+
+    #[test]
+    fn rejected_accesses_overflows_and_checkpoints_are_atomic() {
+        for ticks in [0, 1_000_001, u64::MAX] {
+            assert!(AudioHandshake::new(ticks, 144).is_err());
+        }
+        let mut model = AudioHandshake::new(8, 144).unwrap();
+        let mut clock = Clock::default();
+        for (address, size, value) in [
+            (BASE, 4, 1),
+            (BASE + 4, 4, 0),
+            (BASE + 20, 4, 0),
+            (BASE + 1, 4, 0),
+            (BASE, 2, 0),
+            (BASE + 8, 4, u64::MAX),
+        ] {
+            let before = model.save();
+            let mut cx = Cx::new(&mut clock, 0, 0, 0);
+            model.write(&mut cx, address, size, value);
+            assert!(cx.refusal().is_some());
+            assert_eq!(model.save(), before);
+        }
+        clock.now = u64::MAX;
+        let mut cx = Cx::new(&mut clock, 0, 0, 0);
+        model.write(&mut cx, BASE, 4, 0);
+        assert!(cx.refusal().is_some());
+        assert_eq!(model.state.generation, 0);
+        clock.now = 1;
+        model.write(&mut Cx::new(&mut clock, 0, 0, 0), BASE, 4, 0);
+        let before = model.save();
+        let mut cx = Cx::new(&mut clock, 0, 0, 0);
+        model.write(&mut cx, BASE, 4, 0);
+        assert!(cx.refusal().is_some());
+        assert_eq!(model.save(), before);
+        let good = model.state.clone();
+        let mut invalid = vec![];
+        let mut s = good.clone();
+        s.ticks = 9;
+        invalid.push(s);
+        let mut s = good.clone();
+        s.pending[0].as_mut().unwrap().due += 1;
+        invalid.push(s);
+        let mut s = good.clone();
+        s.pending[0].as_mut().unwrap().token = 0;
+        invalid.push(s);
+        let mut s = good.clone();
+        s.words[1] = 1;
+        invalid.push(s);
+        for state in invalid {
+            assert!(
+                model
+                    .restore_checkpoint(&Checkpoint::encode(NAME, &state).unwrap())
+                    .is_err()
+            );
+            assert_eq!(model.save(), before);
+        }
+    }
+}
