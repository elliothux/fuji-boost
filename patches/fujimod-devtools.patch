+#[cfg(test)]
+mod memory_watch_mmu_tests {
+    use super::*;
+    use serde_json::json;
+
+    unsafe fn raw_probe(
+        access: Access,
+        address: u64,
+        size: i32,
+        value: i64,
+        data: *mut std::ffi::c_void,
+    ) {
+        unsafe { &mut *data.cast::<Vec<(Access, u64, i32, i64)>>() }
+            .push((access, address, size, value));
+    }
+
+    #[test]
+    fn memory_watch_uses_physical_data_hook_addresses_under_mmu() {
+        for va in [0x0020_0100u64, 0x8020_0100] {
+            const DECOY_PA: u64 = 0x0020_0100;
+            const PA: u64 = 0x0010_0100;
+            const CODE_PA: u64 = 0x0010_1000;
+            let code_va = (va & !0xfffff) + 0x1000;
+            let old = 0x1122_3344u32;
+            let decoy = 0x5566_7788u32;
+            let written = 0xa1b2_c3d4u32;
+            let old_bytes = old.to_le_bytes();
+
+            let definition: Definition = serde_json::from_value(json!({
+                "ram_size": 4 * 1024 * 1024,
+                "cores": 1,
+                "discovery": false,
+                "cbar": 0xffff0000u32
+            }))
+            .unwrap();
+            let session = Session::new(definition, None).unwrap();
+
+            // Reuse the existing Cortex-A7 short-descriptor MMU test's sections:
+            // VA section0 -> PA section0 (code/table), VA section2 -> PA section1.
+            let table: Vec<u8> = [0x0000_0c02u32, 0, 0x0010_0c02, 0x0000_0c02]
+                .into_iter()
+                .flat_map(u32::to_le_bytes)
+                .collect();
+            session.write(0x4000, &table).unwrap();
+            session
+                .write(
+                    (0x4000 + (va >> 20) * 4) as usize,
+                    &0x00100c02u32.to_le_bytes(),
+                )
+                .unwrap();
+            session.write(PA as usize, &old_bytes).unwrap();
+            // The low-VA case has different bytes at the same numeric physical address.
+            session
+                .write(DECOY_PA as usize, &decoy.to_le_bytes())
+                .unwrap();
+            let code: Vec<u8> = [0xe590_2000u32, 0xe580_1000] // LDR r2,[r0]; STR r1,[r0]
+                .into_iter()
+                .flat_map(u32::to_le_bytes)
+                .collect();
+            session.write(CODE_PA as usize, &code).unwrap();
+
+            let cp = |crn| arm::Coprocessor {
+                cp: 15,
+                opc1: 0,
+                crn,
+                crm: 0,
+                opc2: 0,
+                secure: 0,
+                wide: false,
+            };
+            session.inner.cpus[0]
+                .coprocessor(cp(2), Some(0x4000))
+                .unwrap(); // TTBR0
+            session.inner.cpus[0]
+                .coprocessor(cp(3), Some(0xffff_ffff))
+                .unwrap(); // DACR: manager domains
+            let sctlr = session.inner.cpus[0].coprocessor(cp(1), None).unwrap();
+            session.inner.cpus[0]
+                .coprocessor(cp(1), Some(sctlr | 1))
+                .unwrap();
+            session.write_register(0, arm::CPSR, 0xd3).unwrap(); // A32 SVC, little-endian
+            session.write_register(0, arm::PC, code_va).unwrap();
+            session.write_register(0, arm::CORE[0], va).unwrap();
+            session
+                .write_register(0, arm::CORE[1], u64::from(written))
+                .unwrap();
+
+            assert_eq!(
+                session.inner.cpus[0].translate(va, Access::Write).unwrap(),
+                PA
+            );
+            assert_eq!(session.read_virtual(0, va as u32, 4).unwrap(), old_bytes);
+            // The same physical RAM is watched through both low and high VA aliases.
+            session
+                .memory_watch_begin(vec![(PA, PA + 4), (CODE_PA, CODE_PA + 8)], 8)
+                .unwrap();
+            let mut raw = Box::new(Vec::<(Access, u64, i32, i64)>::new());
+            let probe = unsafe {
+                session.inner.cpus[0].install_hook(CpuHook::Memory {
+                    callback: raw_probe,
+                    data: (&mut *raw as *mut Vec<(Access, u64, i32, i64)>).cast(),
+                    read: true,
+                    write: true,
+                    range: HookRange::All,
+                })
+            }
+            .unwrap();
+            session.run(0, 2).unwrap();
+            session.inner.cpus[0].remove_hook(probe).unwrap();
+            assert!(session.state(false).failure.is_none());
+            let watch = session.memory_watch_state();
+            session.memory_watch_end().unwrap();
+
+            assert!(watch.violation.is_none());
+            assert_eq!(watch.ranges, vec![(PA, PA + 4), (CODE_PA, CODE_PA + 8)]);
+            assert_eq!(
+                raw.iter()
+                    .map(|&(access, address, size, _)| (access, address, size))
+                    .collect::<Vec<_>>(),
+                [(Access::Read, PA, 4), (Access::Write, PA, 4)]
+            );
+            assert_eq!(watch.records.len(), 4);
+            let data: Vec<_> = watch
+                .records
+                .iter()
+                .filter(|row| row.source != "cpu-fetch")
+                .collect();
+            let fetch: Vec<_> = watch
+                .records
+                .iter()
+                .filter(|row| row.source == "cpu-fetch")
+                .collect();
+            assert_eq!(data.len(), 2);
+            assert_eq!(fetch.len(), 2);
+            for (i, row) in fetch.iter().enumerate() {
+                assert_eq!(row.address, code_va + 4 * i as u64);
+                assert_eq!(row.physical, CODE_PA + 4 * i as u64);
+                assert_eq!(row.address_space, "virtual");
+                assert!(row.before.is_none() && row.value.is_none());
+            }
+            assert_eq!(session.read_register(0, arm::PC).unwrap(), code_va + 8);
+            assert_eq!(session.instructions(), [2]);
+            for (record, source, value) in [
+                (data[0], "cpu-read", u64::from(old)),
+                (data[1], "cpu-write", u64::from(written)),
+            ] {
+                assert_eq!(record.source, source);
+                assert_eq!(record.core, 0);
+                assert_eq!(record.address, PA);
+                assert_eq!(record.address_space, "physical");
+                assert_eq!(record.physical, PA);
+                assert_eq!(record.size, 4);
+                assert_eq!(record.byte_order, "little");
+                assert_eq!(record.before.as_deref(), Some(old_bytes.as_slice()));
+                assert_eq!(record.value, Some(value));
+            }
+            assert_eq!(
+                session.read_register(0, arm::CORE[2]).unwrap(),
+                u64::from(old)
+            );
+
+            // Separate post-run physical reads prove this test's store committed.
+            // A cpu-write record/value by itself remains a write intent.
+            let mut actual = [0; 4];
+            session.read(PA as usize, &mut actual).unwrap();
+            assert_eq!(actual, written.to_le_bytes());
+            session.read(DECOY_PA as usize, &mut actual).unwrap();
+            assert_eq!(actual, decoy.to_le_bytes());
+        }
+    }
+}
