+    fn repeated_commands(core: usize, pc: u64, polls: usize) -> (serde_json::Value, Vec<Record>) {
+        let mut m = AudioResetFixture::new_with_second_command(8).unwrap();
+        let mut h = Clock::default();
+        for ordinal in 1..=8u64 {
+            h.now = ordinal * 100;
+            let due = h.now + 8;
+            let mut cx = Cx::new(&mut h, core, pc, 0);
+            m.write(&mut cx, ADDRESS, 4, 1);
+            assert!(cx.refusal().is_none());
+            assert_eq!(m.next_deadline(h.now), Some(due));
+            let pending = m.save();
+            let events = h.events.clone();
+            let records = h.records.clone();
+            for now in [due - 1, due] {
+                h.now = now;
+                let mut cx = Cx::new(&mut h, 3 - core, pc + 4, 0);
+                m.write(&mut cx, ADDRESS, 4, 1);
+                assert!(cx.refusal().is_none());
+                for _ in 0..polls {
+                    assert_eq!(m.read(&mut Cx::new(&mut h, core, pc, 0), ADDRESS, 4), 1);
+                }
+                for token in [0, ordinal + 1, ordinal - 1] {
+                    m.event(&mut Cx::new(&mut h, core, pc, 0), token);
+                }
+                if now < due {
+                    m.event(&mut Cx::new(&mut h, core, pc, 0), ordinal);
+                    m.advance(&mut Cx::new(&mut h, core, pc, 0));
+                }
+                assert_eq!(m.save(), pending);
+                assert_eq!(h.events, events);
+                assert_eq!(h.records, records);
+            }
+            refused(&mut m, &mut h, ADDRESS, 4, Some(2));
+            let saved = m.checkpoint().unwrap();
+            let mut restored = AudioResetFixture::new_with_second_command(8).unwrap();
+            restored.restore_checkpoint(&saved).unwrap();
+            assert_eq!(restored.save(), m.save());
+            m = restored;
+            m.advance(&mut Cx::new(&mut h, core, pc, 0));
+            assert_eq!(m.read(&mut Cx::new(&mut h, core, pc, 0), ADDRESS, 4), 0);
+            assert_eq!(m.next_deadline(due), None);
+            let completed = m.save();
+            let records = h.records.clone();
+            m.event(&mut Cx::new(&mut h, core, pc, 0), ordinal);
+            assert_eq!(m.save(), completed);
+            assert_eq!(h.records, records);
+        }
+        assert_eq!(
+            h.events,
+            (1..=8).map(|n| (n * 100 + 8, n)).collect::<Vec<_>>()
+        );
+        assert_eq!(h.records.len(), 16);
+        for (index, record) in h.records.iter().enumerate() {
+            let (name, value) = record.fields.last().unwrap();
+            assert_eq!(name.as_ref(), "ordinal");
+            assert_eq!(value, &Field::int((index / 2 + 1) as u64));
+        }
+        let saved = m.checkpoint().unwrap();
+        let mut restored = AudioResetFixture::new_with_second_command(8).unwrap();
+        restored.restore_checkpoint(&saved).unwrap();
+        assert_eq!(restored.save(), m.save());
+        h.now += 100;
+        restored.write(&mut Cx::new(&mut h, core, pc, 0), ADDRESS, 4, 1);
+        assert_eq!(restored.next_deadline(h.now), Some(h.now + 8));
+        (m.save(), h.records)
+    }
