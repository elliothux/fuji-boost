+/* Physical RAM identity bypasses the current guest MMU and covers every alias.
+ * PageDesc also includes blocks translated ahead of their first execution. */
+static bool code_write(struct uc_struct *uc, uint64_t address, uint64_t size,
+                       bool invalidate)
+{
+    bool overlaps = false;
+    while (size) {
+        MemoryRegion *mr = uc->memory_mapping(uc, address);
+        uint64_t len = MIN(size, int128_get64(mr->size) - (address - mr->addr));
+        ram_addr_t start = memory_region_get_ram_addr(mr) + address - mr->addr;
+        ram_addr_t end = start + len;
+        for (ram_addr_t page = start & TARGET_PAGE_MASK; page < end;
+             page += TARGET_PAGE_SIZE) {
+            PageDesc *pd = page_find(uc, page >> TARGET_PAGE_BITS);
+            if (pd && pd->first_tb) {
+                overlaps = true;
+                if (invalidate)
+                    tb_invalidate_phys_range(uc, MAX(start, page),
+                                             MIN(end, page + TARGET_PAGE_SIZE));
+            }
+        }
+        address += len;
+        size -= len;
+    }
+    return overlaps;
+}
