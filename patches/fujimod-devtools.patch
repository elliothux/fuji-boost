+        let definition = json!({
+            "ram_size": 65536, "cores": 2, "discovery": false, "cbar": 0xffff0000u32
+        });
+        for conflict in [false, true] {
+            let board = Session::new(serde_json::from_value(definition.clone()).unwrap(), None).unwrap();
+            board.write(0x1000, &[
+                0xe1902f9fu32, // LDREX r2,[r0]
+                0xe1803f91,    // STREX r3,r1,[r0]
+                0xeafffffe,
+            ].into_iter().flat_map(u32::to_le_bytes).collect::<Vec<_>>()).unwrap();
+            board.write(0x2000, &0xe5801000u32.to_le_bytes()).unwrap(); // STR r1,[r0]
+            for core in 0..2 {
+                board.write_register(core, arm::PC, 0x1000 + core as u64 * 0x1000).unwrap();
+                board.write_register(core, arm::CORE[0], 0x8000).unwrap();
+                board.write_register(core, arm::CORE[1], 7).unwrap();
+            }
+            board.run(0, 1).unwrap();
+            let checkpoint = board.checkpoint().unwrap();
+            let restored = Session::new(serde_json::from_value(definition.clone()).unwrap(), None).unwrap();
+            let mut memory = vec![0; 65536];
+            board.read(0, &mut memory).unwrap();
+            restored.write(0, &memory).unwrap();
+            restored.restore_checkpoint(&checkpoint).unwrap();
+            restored.write_register(1, arm::CORE[0], if conflict { 0x8000 } else { 0x9000 }).unwrap();
+            restored.run(1, 1).unwrap();
+            restored.run(0, 1).unwrap();
+            assert_eq!(restored.read_register(0, arm::CORE[3]).unwrap(), u64::from(conflict));
