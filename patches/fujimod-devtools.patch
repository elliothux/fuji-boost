+    fn post_config() -> Config {
+        let mut c = reprogram_config();
+        let mut words: BTreeMap<_, _> = c.initial_script.iter().copied().collect();
+        for o in [0x40ec, 0x42ec, 0x40f8, 0x42f8] {
+            words.insert(o, 0);
+        }
+        for o in [
+            0x4138, 0x413c, 0x4140, 0x4144, 0x4338, 0x433c, 0x4340, 0x4344,
+        ] {
+            words.insert(o, 0x02800280);
+        }
+        for o in [0x4148, 0x4348] {
+            words.insert(o, 0x280);
+        }
+        while words.len() > 686 {
+            let k = *words.keys().next().unwrap();
+            words.remove(&k);
+        }
+        c.initial_script = words.into_iter().collect();
+        c.source_sha256 = source_hash(&c);
+        c.post_control_source_sha256 = Some("ab".repeat(32));
+        c
+    }
