+#[test]
+fn request_gates_distinct_words_mixed_lengths_and_explicit_noncontiguous_tail() {
+    let (mut d, wire, mut h) = fixture(80);
+    configure(&mut d, &mut h, 1024, 64, 257);
+    descriptor(&mut h, 256, 1152, 128, 305);
+    descriptor(&mut h, 304, 1408, 64, 513);
+    descriptor(&mut h, 512, 1536, 64, 0x900);
+    submit(&mut d, &mut h).unwrap();
+    assert_eq!(d.next_deadline(0), None);
+    d.advance(&mut h.cx());
+    assert_eq!(wire.lock().unwrap().pops, 0);
+    assert!(h.effects.is_empty());
+    wire.lock().unwrap().since = Some(5);
+    drain(&mut d, &mut h);
+    assert_eq!(&h.bytes[1024..1088], expected(0, 16));
+    assert_eq!(&h.bytes[1152..1280], expected(16, 32));
+    assert_eq!(&h.bytes[1408..1472], expected(48, 16));
+    assert_eq!(&h.bytes[1536..1600], expected(64, 16));
+    assert_eq!(wire.lock().unwrap().pops, 80);
+    assert_eq!(d.channels[4].completed, 4);
+    assert!(!d.channels[4].submitted);
+    assert!(d.channels[4].linked.is_none());
+    assert_eq!(d.channels[4].regs[5], ADDRESS as u32);
+    assert_eq!(d.channels[4].regs[6], 1600);
+    assert_eq!(d.channels[4].regs[9], 0x900);
+    assert_eq!(
+        h.effects
+            .iter()
+            .filter(|e| matches!(e, Effect::Irq(211, true)))
+            .count(),
+        1,
+        "only the chain end signals completion"
+    );
+}
