+// Area-average linear light into the hardware's 16x16 statistics grid.
+fn statistics_scene(
+    source: &Source,
+    profile: &serde_json::Value,
+) -> Result<serde_json::Value, String> {
+    let (width, height) = match source {
+        Source::Gray => return Ok(profile.clone()),
+        Source::Analytic => (1024, 768),
+        Source::Rgb { width, height, rgb } => {
+            if !(1..=8192).contains(width)
+                || !(1..=8192).contains(height)
+                || rgb.len() as u64 != u64::from(*width) * u64::from(*height) * 3
+            {
+                return Err("Invalid statistics RGB source dimensions or length".into());
+            }
+            (*width as usize, *height as usize)
+        }
+    };
+    let linear = |value: u8| {
+        let v = f64::from(value) / 255.0;
+        if v <= 0.04045 {
+            v / 12.92
+        } else {
+            ((v + 0.055) / 1.055).powf(2.4)
+        }
+    };
+    // IEC sRGB EOTF, scaled so 128 -> 2048, clipped per pixel before averaging.
+    let lut: [f64; 256] =
+        std::array::from_fn(|v| (linear(v as u8) * 2048.0 / linear(128)).clamp(0.0, 4095.0));
+    let mut rgb = Vec::with_capacity(16 * 16 * 3);
+    for y in 0..16 {
+        for x in 0..16 {
+            let (left, right) = (x * width, (x + 1) * width);
+            let (top, bottom) = (y * height, (y + 1) * height);
+            let mut sums = [0.0; 3];
+            for py in top / 16..bottom.div_ceil(16) {
+                let dy = bottom.min((py + 1) * 16) - top.max(py * 16);
+                for px in left / 16..right.div_ceil(16) {
+                    let dx = right.min((px + 1) * 16) - left.max(px * 16);
+                    let pixel = match source {
+                        Source::Rgb { rgb, .. } => {
+                            rgb[(py * width + px) * 3..][..3].try_into().unwrap()
+                        }
+                        // shortcut: statistics use frame 0, update here if animated metering is needed.
+                        _ => fujimod_virtual_scene::rgb(
+                            fujimod_virtual_scene::Scene {
+                                width: 1024,
+                                height: 768,
+                                frame: 0,
+                            },
+                            px as u64,
+                            py as u64,
+                        ),
+                    };
+                    for channel in 0..3 {
+                        sums[channel] += lut[pixel[channel] as usize] * (dx * dy) as f64;
+                    }
+                }
+            }
+            rgb.extend(sums.map(|sum| (sum / (width * height) as f64).round() as u16));
+        }
+    }
+    let mut scene = profile.clone();
+    scene
+        .as_object_mut()
+        .ok_or("statistics profile must be an object")?
+        .remove("luma");
+    scene["width"] = 16.into();
+    scene["height"] = 16.into();
+    scene["rgb"] = serde_json::to_value(rgb).unwrap();
+    Ok(scene)
+}
