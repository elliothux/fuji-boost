+//! Synthetic FA ready/completion/AA10 handshake, independent of the ready-only fixture.
+//! Timing, DMA, physical ACK, errors, cancellation and concurrency are unqualified.
+//! Checkpoints cover this device; the runtime must separately restore its events and GIC.
+use fujimod_emulator_devices::{Cx, Device, Record, Value as Field, checkpoint::Checkpoint};
+use serde::{Deserialize, Serialize};
+
+const NAME: &str = "xp4-fa-completion-fixture";
+pub const STATUS: u64 = 0xfa000000;
+pub const ARM: u64 = 0xfa00001c;
+pub const CONTROL: u64 = 0xfff4aa10;
+pub const IRQ: u32 = 145;
+const READY: u64 = 0x10000;
+const ACK: u64 = READY | 1;
+const MAX_GENERATION: u64 = u64::MAX / 2;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Request {
+    generation: u64,
+    started: u64,
+    due: u64,
+    token: u64,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+enum Stage {
+    Cold,
+    Initialized,
+    Preparing(Request),
+    Ready(Request),
+    Busy(Request),
+    Latched(Request),
+    Acknowledged(Request),
+    Done(Request),
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct State {
+    ready_ticks: u64,
+    completion_ticks: u64,
+    source_sha256: String,
+    control: u32,
+    generation: u64,
+    stage: Stage,
+}
+
+pub struct FaCompletionFixture {
+    state: State,
+}
+
+impl FaCompletionFixture {
+    pub fn new(
+        ready_ticks: u64,
+        completion_ticks: u64,
+        source_sha256: String,
+    ) -> Result<Self, String> {
+        if !(1..=1_000_000).contains(&ready_ticks)
+            || !(1..=1_000_000).contains(&completion_ticks)
+            || source_sha256.len() != 64
+            || !source_sha256
+                .bytes()
+                .all(|v| v.is_ascii_digit() || (b'a'..=b'f').contains(&v))
+        {
+            return Err("Invalid FA completion fixture configuration".into());
+        }
+        Ok(Self {
+            state: State {
+                ready_ticks,
+                completion_ticks,
+                source_sha256,
+                control: 0,
+                generation: 0,
+                stage: Stage::Cold,
+            },
+        })
+    }
+
+    fn status(&self) -> u64 {
+        match self.state.stage {
+            Stage::Cold | Stage::Initialized | Stage::Preparing(_) => 0,
+            Stage::Ready(_) | Stage::Acknowledged(_) | Stage::Done(_) => READY,
+            Stage::Busy(_) | Stage::Latched(_) => ACK,
+        }
+    }
+
+    fn request(&self, generation: u64, started: u64, completion: bool) -> Option<Request> {
+        if generation == 0 || generation > MAX_GENERATION {
+            return None;
+        }
+        let token = generation
+            .checked_mul(2)?
+            .checked_add(u64::from(completion))?;
+        let ticks = if completion {
+            self.state.completion_ticks
+        } else {
+            self.state.ready_ticks
+        };
+        Some(Request {
+            generation,
+            started,
+            due: started.checked_add(ticks)?,
+            token,
+        })
+    }
+
+    fn pending(&self) -> Option<Request> {
+        match self.state.stage {
+            Stage::Preparing(r) | Stage::Busy(r) => Some(r),
+            _ => None,
+        }
+    }
+
+    fn record(&self, cx: &mut Cx<'_>, label: &'static str, r: Request) {
+        cx.record(Record::new(
+            label,
+            [
+                ("generation", Field::int(r.generation)),
+                ("token", Field::int(r.token)),
+                ("tick", Field::int(cx.now())),
+                ("due", Field::int(r.due)),
+                ("status", Field::int(self.status())),
+                ("control", Field::int(self.state.control)),
+            ],
+        ));
+    }
+
+    fn validate_state(&self, state: &State) -> Result<(), String> {
+        if state.ready_ticks != self.state.ready_ticks
+            || state.completion_ticks != self.state.completion_ticks
+            || state.source_sha256 != self.state.source_sha256
+            || state.control & !15 != 0
+            || state.generation > MAX_GENERATION
+        {
+            return Err("FA completion checkpoint configuration/control differs".into());
+        }
+        let request = match state.stage {
+            Stage::Cold if state.generation != 0 => {
+                return Err("Invalid cold FA completion generation".into());
+            }
+            Stage::Cold | Stage::Initialized => None,
+            Stage::Preparing(r) | Stage::Ready(r) => Some((r, false)),
+            Stage::Busy(r) | Stage::Latched(r) | Stage::Done(r) => Some((r, true)),
+            Stage::Acknowledged(r) => {
+                if state.control & 8 == 0 {
+                    return Err("FA completion acknowledged strobe missing".into());
+                }
+                Some((r, true))
+            }
+        };
+        if let Some((r, completion)) = request
+            && (r.generation != state.generation
+                || self.request(r.generation, r.started, completion) != Some(r))
+        {
+            return Err("Invalid FA completion request/generation/token/deadline".into());
+        }
+        Ok(())
+    }
+}
+
+impl Device for FaCompletionFixture {
+    fn name(&self) -> &'static str {
+        NAME
+    }
+
+    fn read(&mut self, cx: &mut Cx<'_>, address: u64, size: u8) -> u64 {
+        if size == 4 {
+            match address {
+                STATUS => return self.status(),
+                CONTROL => return u64::from(self.state.control),
+                _ => {}
+            }
+        }
+        cx.fail("Unsupported FA completion fixture read");
+        0
+    }
+
+    fn write(&mut self, cx: &mut Cx<'_>, address: u64, size: u8, value: u64) {
+        if size != 4 {
+            cx.fail("FA completion fixture requires exact words");
+            return;
+        }
+        if address == CONTROL {
+            if value > 15 {
+                cx.fail("Unsupported FA completion control bits");
+                return;
+            }
+            let value = value as u32;
+            match self.state.stage {
+                Stage::Latched(r) if value == (self.state.control | 8) => {
+                    self.state.control = value;
+                    self.state.stage = Stage::Acknowledged(r);
+                    cx.set_irq(IRQ, false);
+                    self.record(cx, "Synthetic FA completion acknowledged", r);
+                }
+                Stage::Acknowledged(r) if value == (self.state.control & !8) => {
+                    self.state.control = value;
+                    self.state.stage = Stage::Done(r);
+                    self.record(cx, "Synthetic FA completion strobe cleared", r);
+                }
+                Stage::Latched(_) | Stage::Acknowledged(_) => {
+                    cx.fail("Unsupported FA completion strobe sequence/RMW value");
+                }
+                _ => self.state.control = value,
+            }
+            return;
+        }
+        let next = match (self.state.stage, address, value) {
+            (Stage::Cold | Stage::Done(_), STATUS, 0) => Stage::Initialized,
+            (Stage::Initialized, ARM, 0x40) => {
+                let Some(r) = self
+                    .state
+                    .generation
+                    .checked_add(1)
+                    .and_then(|g| self.request(g, cx.now(), false))
+                else {
+                    cx.fail("FA completion ready deadline/generation overflow");
+                    return;
+                };
+                Stage::Preparing(r)
+            }
+            (Stage::Ready(r), STATUS, ACK) => {
+                let Some(request) = self.request(r.generation, cx.now(), true) else {
+                    cx.fail("FA completion deadline overflow");
+                    return;
+                };
+                Stage::Busy(request)
+            }
+            _ => {
+                cx.fail("Unsupported FA completion sequence/address/value");
+                return;
+            }
+        };
+        self.state.stage = next;
+        if let Some(r) = self.pending() {
+            self.state.generation = r.generation;
+            cx.schedule(r.due, r.token);
+            self.record(cx, "Synthetic FA completion phase scheduled", r);
+        }
+    }
+
+    fn event(&mut self, cx: &mut Cx<'_>, token: u64) {
+        let Some(r) = self.pending() else { return };
+        if token != r.token || r.generation != self.state.generation || cx.now() < r.due {
+            return;
+        }
+        match self.state.stage {
+            Stage::Preparing(_) => self.state.stage = Stage::Ready(r),
+            Stage::Busy(_) => {
+                self.state.stage = Stage::Latched(r);
+                cx.set_irq(IRQ, true);
+            }
+            _ => unreachable!(),
+        }
+        self.record(cx, "Synthetic FA completion phase elapsed", r);
+    }
+
+    fn advance(&mut self, cx: &mut Cx<'_>) {
+        if let Some(r) = self.pending() {
+            self.event(cx, r.token);
+        }
+    }
+
+    fn next_deadline(&self, _: u64) -> Option<u64> {
+        self.pending().map(|r| r.due)
+    }
+
+    fn pollable(&self, address: u64, size: u8) -> bool {
+        address == STATUS && size == 4
+    }
+
+    fn save(&self) -> serde_json::Value {
+        serde_json::to_value(&self.state).unwrap()
+    }
+
+    fn checkpoint(&self) -> Result<Checkpoint, String> {
+        Checkpoint::encode(NAME, &self.state)
+    }
+
+    fn validate_checkpoint(&self, saved: &Checkpoint) -> Result<(), String> {
+        if !saved.blobs().is_empty() || !saved.children().is_empty() {
+            return Err("Unexpected FA completion checkpoint attachments".into());
+        }
+        self.validate_state(&saved.decode(NAME)?)
+    }
+
+    fn restore_checkpoint(&mut self, saved: &Checkpoint) -> Result<(), String> {
+        self.validate_checkpoint(saved)?;
+        self.state = saved.decode(NAME)?;
+        Ok(())
+    }
+
+    fn fingerprint(&self) -> Result<serde_json::Value, String> {
+        Ok(self.save())
+    }
+}
