+//! Default-off functional experiment, not a physical XDMAC specification.
+use super::*;
+use serde::{Deserialize, Serialize};
+
+pub(super) const REQUEST: u8 = 28;
+pub(super) const ADDRESS: u64 = 0xfff4f000;
+const CHANNEL: usize = 4;
+const WORD_BYTES: u64 = 4;
+
+pub(super) struct Endpoint {
+    pub(super) request: u8,
+    pub(super) address: u64,
+    direction: Direction,
+    port: SharedPort,
+    dram_bytes: usize,
+    word_ticks: (u64, u64),
+}
+#[derive(Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(super) struct Identity {
+    request: u8,
+    channel: usize,
+    address: u64,
+    dram_bytes: usize,
+    word_ticks: (u64, u64),
+    word_bytes: u64,
+    startup_fifo_words: u64,
+    direction: Direction,
+}
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(super) struct Progress {
+    pub(super) transferred: u64,
+    last_tick: u64,
+    segment_started_at: u64,
+    segments: u64,
+    completed_base: u64,
+    words_base: u64,
+    segment_words_base: u64,
+}
+impl Progress {
+    pub(super) fn new(now: u64, completed: u64, words: u64) -> Self {
+        Self {
+            transferred: 0,
+            last_tick: now,
+            segment_started_at: now,
+            segments: 1,
+            completed_base: completed,
+            words_base: words,
+            segment_words_base: words,
+        }
+    }
+}
+
+impl Endpoint {
+    // Round cumulative sample-clock time, so fractional word periods never drift.
+    fn duration(&self, start: u64, count: u64, base: u64) -> Option<u64> {
+        // UNMEASURED FUNCTIONAL ASSUMPTION: one 1440-word RX startup FIFO
+        // drains at bus speed, then retain the declared steady sample clock.
+        let fifo: u64 = if self.direction == Direction::Receive { 1440 } else { 0 };
+        let buffered = fifo.saturating_sub(start.checked_sub(base)?).min(count);
+        let count = count - buffered;
+        let (ticks, words) = (u128::from(self.word_ticks.0), u128::from(self.word_ticks.1));
+        let start = (u128::from(start) + u128::from(buffered)) % words;
+        let end = start + u128::from(count);
+        u64::try_from(end.checked_mul(ticks)?.div_ceil(words) - (start * ticks).div_ceil(words)).ok()?.checked_add(buffered)
+    }
+}
+
+fn validate_segment(regs: &[u32; 14], p: &Endpoint) -> Result<(), String> {
+    let (fifo, ram, fixed, increment) = match p.direction {
+        Direction::Receive => (5, 6, 7, 8),
+        Direction::Transmit => (6, 5, 8, 7),
+    };
+    let size = u64::from(regs[4]) + 1;
+    let flags = regs[9];
+    let next = u64::from(flags & !15);
+    if u64::from(regs[fifo]) != p.address
+        || regs[fixed] != 0x20f04
+        || regs[increment] != 0x20f00
+        || size > FLASH_SIZE
+        || !size.is_multiple_of(64)
+        || !u64::from(regs[ram])
+            .checked_add(size)
+            .is_some_and(|end| end <= p.dram_bytes as u64)
+        || flags & 14 != 0
+        || flags & 1 != 0 && (next == 0 || next + 32 > p.dram_bytes as u64)
+    {
+        return Err("Unsupported linked DMA segment or DRAM extent".into());
+    }
+    Ok(())
+}
+
+impl DmaController {
+    /// Qualified audio clock as (ticks, words); all other ports stay byte-paced.
+    pub fn connect_linked_input(
+        &mut self, port: SharedPort, dram_bytes: usize, word_ticks: (u64, u64),
+    ) -> Result<(), String> {
+        self.connect_linked(CHANNEL, Endpoint { port, dram_bytes, word_ticks,
+            request: REQUEST, address: ADDRESS, direction: Direction::Receive })
+    }
+    pub fn connect_linked_output(
+        &mut self, port: SharedPort, dram_bytes: usize, word_ticks: (u64, u64),
+    ) -> Result<(), String> {
+        self.connect_linked(8, Endpoint { port, dram_bytes, word_ticks,
+            request: 30, address: 0xfff78004, direction: Direction::Transmit })
+    }
+    fn connect_linked(&mut self, channel: usize, p: Endpoint) -> Result<(), String> {
+        if self.linked_ports.contains_key(&channel)
+            || p.dram_bytes == 0 || p.dram_bytes as u64 > p.address
+            || p.word_ticks.1 == 0 || p.word_ticks.0 < p.word_ticks.1
+            || self.channels.iter().any(|c| c.submitted)
+            || self.peripherals.contains_key(&p.request)
+            || self.peripherals.values().any(|other| other.address == p.address)
+        {
+            return Err("Invalid or active linked DMA wiring".into());
+        }
+        self.linked_ports.insert(channel, p);
+        Ok(())
+    }
+    pub(super) fn linked_identity(&self) -> Vec<Identity> {
+        self.linked_ports.iter().map(|(&channel, p)| Identity {
+            request: p.request, channel, address: p.address, direction: p.direction,
+            dram_bytes: p.dram_bytes, word_ticks: p.word_ticks,
+            word_bytes: WORD_BYTES,
+            startup_fifo_words: if p.direction == Direction::Receive { 1440 } else { 0 },
+        }).collect()
+    }
+    pub(super) fn linked_request(
+        &self,
+        n: usize,
+        c: &Channel,
+        control: u32,
+        mux: &BTreeMap<u64, u32>,
+    ) -> Result<bool, String> {
+        let request = Self::selector(mux, n);
+        let endpoint = self.linked_ports.values().any(|p|
+            u64::from(c.regs[5]) == p.address || u64::from(c.regs[6]) == p.address
+            || request == p.request && control & 0x00f00000 == 0x00200000);
+        if !endpoint { return Ok(false); }
+        let p = self.linked_ports.get(&n).ok_or("Unsupported linked DMA channel")?;
+        if request != p.request || control & !0x10000000 != 0x00201011 {
+            return Err("Unsupported linked DMA request or control".into());
+        }
+        validate_segment(&c.regs, p)?;
+        Ok(true)
+    }
+    fn linked_word_ticks(&self, n: usize) -> u64 {
+        let p = &self.linked_ports[&n];
+        p.duration(self.linked_words[n], 1, self.channels[n].linked.as_ref().unwrap().words_base).unwrap()
+    }
+    pub(super) fn linked_deadline(&self, n: usize, now: u64) -> Option<u64> {
+        let c = &self.channels[n];
+        let p = self.linked_ports.get(&n)?;
+        let progress = c.linked.as_ref()?;
+        match p.port.lock() {
+            Ok(port) => match port.request(p.direction, false) {
+                None => c.due.map(|_| now),
+                Some(since) => Some(c.due.map_or(since.max(now), |due| {
+                    since
+                        .max(progress.last_tick)
+                        .max(self.mux_changed[n])
+                        .checked_add(self.linked_word_ticks(n))
+                        .map_or(now, |earliest| due.max(earliest).max(now))
+                })),
+            },
+            Err(_) => Some(now),
+        }
+    }
+    pub(super) fn service_linked(&mut self, cx: &mut Cx<'_>, n: usize) -> Result<(), String> {
+        let c = &self.channels[n];
+        let progress = c.linked.as_ref().ok_or("Missing linked DMA cursor")?;
+        let p = self
+            .linked_ports
+            .get(&n)
+            .ok_or("Missing linked DMA port")?;
+        let ready = p
+            .port
+            .lock()
+            .map_err(|_| "Linked DMA port poisoned")?
+            .request(p.direction, false);
+        let Some(since) = ready.filter(|at| *at <= cx.now()) else {
+            self.channels[n].due = None;
+            return Ok(());
+        };
+        if let Some(due) = c.due {
+            let earliest = since
+                .max(progress.last_tick)
+                .max(self.mux_changed[n])
+                .checked_add(self.linked_word_ticks(n))
+                .ok_or("Linked DMA deadline overflow")?;
+            if due.max(earliest) > cx.now() {
+                self.channels[n].due = Some(due.max(earliest));
+                return Ok(());
+            }
+        }
+        if c.due.is_none() {
+            let at = cx
+                .now()
+                .max(since)
+                .max(progress.last_tick)
+                .max(self.mux_changed[n])
+                .checked_add(self.linked_word_ticks(n))
+                .ok_or("Linked DMA deadline overflow")?;
+            self.channels[n].due = Some(at);
+            return Ok(());
+        }
+        let size = u64::from(c.regs[4]) + 1;
+        let offset = progress.transferred;
+        let last = offset + WORD_BYTES == size;
+        let source = u64::from(c.regs[5]);
+        let destination = u64::from(c.regs[6]);
+        let next = c.regs[9];
+        let source_shape = c.regs[7];
+        let destination_shape = c.regs[8];
+        let next_regs = if last && c.regs[9] & 1 != 0 {
+            // Fetch now: the original producer can splice a next pointer while DMA runs.
+            let bytes = cx.ram_bytes(u64::from(c.regs[9] & !15), 32)?;
+            if bytes[24..].iter().any(|&v| v != 0) {
+                return Err("Unsupported linked DMA opaque descriptor words".into());
+            }
+            let mut regs = c.regs;
+            for (slot, bytes) in regs[4..10].iter_mut().zip(bytes[..24].chunks_exact(4)) {
+                *slot = u32::from_le_bytes(bytes.try_into().unwrap());
+            }
+            validate_segment(&regs, p)?;
+            Some(regs)
+        } else {
+            None
+        };
+        if last && c.completed == u64::MAX {
+            return Err("Linked DMA completion counter overflow".into());
+        }
+        let words = self.linked_words[n].checked_add(1).ok_or("Linked DMA word counter overflow")?;
+        match p.direction {
+            Direction::Receive => {
+                let word = p.port.lock().map_err(|_| "Linked DMA port poisoned")?
+                    .receive(cx.now(), WORD_BYTES as u8)?;
+                let word = u32::try_from(word).map_err(|_| "Linked DMA returned a non-word")?;
+                cx.ram_write(destination + offset, &word.to_le_bytes())?;
+            }
+            Direction::Transmit => {
+                let bytes = cx.ram_bytes(source + offset, WORD_BYTES as usize)?;
+                let word = u32::from_le_bytes(bytes.try_into().unwrap());
+                p.port.lock().map_err(|_| "Linked DMA port poisoned")?
+                    .transmit(cx.now(), WORD_BYTES as u8, word.into())?;
+            }
+        }
+        self.linked_words[n] = words;
+        let c = &mut self.channels[n];
+        let mut progress = c.linked.take().unwrap();
+        c.due = None;
+        progress.transferred += WORD_BYTES;
+        progress.last_tick = cx.now();
+        if !last {
+            c.linked = Some(progress);
+            return Ok(());
+        }
+        c.completed += 1;
+        let ram = if p.direction == Direction::Receive { 6 } else { 5 };
+        c.regs[ram] += size as u32;
+        let chain_end = next_regs.is_none();
+        if let Some(regs) = next_regs {
+            c.regs = regs;
+            c.regs[12] = 0x10001;
+            progress.transferred = 0;
+            progress.segment_started_at = cx.now();
+            progress.segment_words_base = words;
+            progress.segments += 1;
+            c.linked = Some(progress);
+        } else {
+            c.regs[12] = 1;
+            c.regs[10] &= !0x10000000;
+            c.submitted = false;
+        }
+        // Completion IRQ only at chain end: the WAVE consumer at 0x125d6b0 treats each
+        // edge as end of transfer, so per-block edges end recording while DMA still runs.
+        if chain_end {
+            cx.set_irq(self.routes[n], false);
+            cx.set_irq(self.routes[n], true);
+        }
+        cx.record(Record::new(
+            "XP4 linked DMA block complete",
+            [
+                ("channel", Field::int(n as u64)),
+                ("source", Field::int(source)),
+                ("destination", Field::int(destination)),
+                ("size", Field::int(size)),
+                ("next", Field::int(next)),
+                ("source_shape", Field::int(source_shape)),
+                ("destination_shape", Field::int(destination_shape)),
+                ("chain_end", Field::int(u64::from(chain_end))),
+                ("irq", Field::int(self.routes[n])),
+                ("tick", Field::int(cx.now())),
+            ],
+        ));
+        Ok(())
+    }
+    pub(super) fn validate_linked_checkpoint(
+        &self,
+        n: usize,
+        c: &Channel,
+        mux: &BTreeMap<u64, u32>,
+        words: u64,
+    ) -> Result<(), String> {
+        let expected = c.submitted && self.linked_request(n, c, c.regs[10], mux)?;
+        match (&c.linked, expected) {
+            (None, false) => Ok(()),
+            (Some(progress), true) if c.peripheral.is_none() => {
+                let size = u64::from(c.regs[4]) + 1;
+                let p = &self.linked_ports[&n];
+                let duration = |start, count| p.duration(start, count, progress.words_base);
+                let prior_words = progress.segment_words_base.checked_sub(progress.words_base);
+                let earliest_segment = prior_words.and_then(|count| duration(progress.words_base, count))
+                    .and_then(|ticks| c.submitted_at.checked_add(ticks));
+                if progress.segments < 1
+                    || c.regs[10] & 0x10000000 == 0
+                    || ![0x10000, 0x10001].contains(&c.regs[12])
+                    || c.completed.checked_sub(progress.completed_base)
+                        != Some(progress.segments - 1)
+                    || !prior_words.is_some_and(|count| count / 16 >= progress.segments - 1)
+                    || progress.segments == 1 && prior_words != Some(0)
+                    || progress.segment_words_base.checked_add(progress.transferred / WORD_BYTES) != Some(words)
+                    || progress.transferred >= size
+                    || !progress.transferred.is_multiple_of(WORD_BYTES)
+                    || progress.segment_started_at < c.submitted_at
+                    || progress.segments == 1 && progress.segment_started_at != c.submitted_at
+                    || !earliest_segment.is_some_and(|at| at <= progress.segment_started_at)
+                    || progress.last_tick < progress.segment_started_at
+                    || progress.transferred == 0
+                        && progress.last_tick != progress.segment_started_at
+                    || !progress
+                        .transferred
+                        .checked_div(WORD_BYTES)
+                        .and_then(|v| duration(progress.segment_words_base, v))
+                        .and_then(|v| progress.segment_started_at.checked_add(v))
+                        .is_some_and(|at| at <= progress.last_tick)
+                    || c.due.is_some_and(|at| {
+                        !progress
+                            .last_tick
+                            .checked_add(p.duration(words, 1, progress.words_base).unwrap())
+                            .is_some_and(|min| at >= min)
+                    })
+                {
+                    return Err("Invalid linked DMA cursor or clock".into());
+                }
+                Ok(())
+            }
+            _ => Err("Linked DMA checkpoint identity differs".into()),
+        }
+    }
+}
