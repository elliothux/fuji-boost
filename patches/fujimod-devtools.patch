+#[cfg(test)]
+mod sd_spec_tests {
+    use fujimod_emulator_devices::{Device, parts::card_contacts::Contacts, test_host::ram::Ram};
+    use fujimod_emulator_ip::sdhci::host::{InitializationFault, Options, Protocol, SdHost};
+    const BASE: u64 = 0xfffc4000;
+
+    fn write(m: &mut SdHost, h: &mut Ram, offset: u64, size: u8, value: u64) -> Option<String> {
+        let mut cx = h.cx();
+        m.write(&mut cx, BASE + offset, size, value);
+        cx.refusal().map(str::to_owned)
+    }
+    fn read(m: &mut SdHost, h: &mut Ram, offset: u64, size: u8) -> u64 {
+        m.read(&mut h.cx(), BASE + offset, size)
+    }
+    fn command(m: &mut SdHost, h: &mut Ram, word: u32, argument: u32) {
+        assert_eq!(write(m, h, 0x30, 2, 0xffff), None);
+        assert_eq!(write(m, h, 8, 4, argument.into()), None);
+        assert_eq!(write(m, h, 12, 4, word.into()), None, "CMD{}", word >> 24);
+        h.now = m.next_deadline(h.now).unwrap();
+        let mut cx = h.cx();
+        m.advance(&mut cx);
+        assert_eq!(cx.refusal(), None, "CMD{}", word >> 24);
+    }
+
+    /// The X-T4 driver's use of the FujiMod host: inverted write protect, upper-half
+    /// present-state reads, driver strength, and fixed-size data commands before ACMD6.
+    #[test]
+    fn xt4_driver_sequence_is_accepted() {
+        let card = fujimod_emulator_storage::fat::format(
+            &fujimod_emulator_storage::fat::Options {
+                sectors: 0x800000,
+                max_dirty_sectors: 65536,
+                partition_start: 8192,
+                sectors_per_cluster: 64,
+                label: "FUJIFILM".into(),
+                read_only_files: vec![],
+            },
+            &[],
+        )
+        .unwrap();
+        let options = Options {
+            base: BASE,
+            protocol: Protocol::Sdhc,
+            transfer_ticks: 4,
+            clock_ticks: 2,
+            rca: 1,
+            ram_bytes: 0x10000,
+            initialization_fault: InitializationFault::None,
+        };
+        let mut m = SdHost::new_polled(options, card, Contacts::new(true, false))
+            .unwrap()
+            .with_inverted_write_protect();
+        let mut h = Ram::new(0x10000);
+        assert_eq!(write(&mut m, &mut h, 0x2c, 2, 5), None);
+        h.now = 2;
+        m.advance(&mut h.cx());
+        assert_eq!(write(&mut m, &mut h, 0x28, 2, 0x100), None);
+        assert_eq!(write(&mut m, &mut h, 0x34, 2, 0xffff), None);
+        // Writable card: bit 19 clear on this inverted host; idle DAT/CMD lines high.
+        assert_eq!(read(&mut m, &mut h, 0x24, 4), 0x01f7_0000);
+        assert_eq!(read(&mut m, &mut h, 0x26, 2), 0x1f7);
+        assert_eq!(write(&mut m, &mut h, 0x3e, 2, 0x30), None);
+        assert!(write(&mut m, &mut h, 0x3e, 2, 0x08).is_some(), "1.8 V signalling refuses");
+        for (word, argument) in [
+            (0, 0),
+            (0x081a_0000, 0x1aa),
+            (0x371a_0000, 0),
+            (0x2902_0000, 0x4110_0000),
+            (0x0209_0000, 0),
+            (0x031a_0000, 0),
+            (0x0909_0000, 0x1_0000),
+            (0x071b_0000, 0x1_0000),
+            (0x371a_0000, 0x1_0000),
+        ] {
+            command(&mut m, &mut h, word, argument);
+        }
+        // ACMD13 on the 1-bit bus without CMD16: SD status reports a 1-bit bus.
+        h.bytes[0] = 0xaa;
+        assert_eq!(write(&mut m, &mut h, 4, 2, 64), None);
+        command(&mut m, &mut h, 0x0d3a_0011, 0);
+        assert_eq!(h.bytes[0], 0);
+        // Standard CMD6 switch form: group 1 function 1, other groups unchanged.
+        command(&mut m, &mut h, 0x063a_0011, 0x80ff_fff1);
+    }
+}
