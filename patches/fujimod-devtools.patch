+        unsafe { (*board.inner.state.get()).devices = Some(Devices::empty()); }
+        let devices = unsafe { (*board.inner.state.get()).devices.as_mut().unwrap() };
+        for output in [2, 0] {
+            devices.frames.insert(output, Frame {
+                output, sequence: 17, width: 2, height: 1, rgba: vec![255; 8],
+            });
