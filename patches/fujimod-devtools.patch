+    #[test]
+    fn round_robin_selection_preserves_order_for_every_waiting_mask() {
+        let board = Session::new(serde_json::from_value(serde_json::json!({
+            "ram_size": 65536, "cores": 4, "discovery": true
+        })).unwrap(), None).unwrap();
