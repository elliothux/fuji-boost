diff --git a/crates/emulator-cpu-unicorn/src/durable/a7.rs b/crates/emulator-cpu-unicorn/src/durable/a7.rs
new file mode 100644
index 0000000..ef19c6a
--- /dev/null
+++ b/crates/emulator-cpu-unicorn/src/durable/a7.rs
@@ -0,0 +1,230 @@
+//! ARMv7-A banks and Cortex-A7 system registers with both security banks.
+//! Translation tables live in guest RAM; restoring TTBR/SCTLR flushes the TLB.
+use super::*;
+#[cfg(test)]
+mod tests;
+
+const MODES: [u32; 8] = [0x10, 0x11, 0x12, 0x13, 0x16, 0x17, 0x1b, 0x1f];
+/// Banked (secure and non-secure) 32-bit selectors; SCTLR is installed last.
+const CP15: [(u32, u32, u32, u32); 22] = [
+    (0, 1, 0, 0),  // SCTLR
+    (0, 1, 0, 1),  // ACTLR
+    (0, 2, 0, 2),  // TTBCR
+    (0, 3, 0, 0),  // DACR
+    (0, 5, 0, 0),  // DFSR
+    (0, 5, 0, 1),  // IFSR
+    (0, 5, 1, 0),  // ADFSR
+    (0, 5, 1, 1),  // AIFSR
+    (0, 6, 0, 0),  // DFAR
+    (0, 6, 0, 2),  // IFAR
+    (0, 10, 2, 0), // PRRR
+    (0, 10, 2, 1), // NMRR
+    (0, 10, 3, 0), // AMAIR0
+    (0, 10, 3, 1), // AMAIR1
+    (0, 12, 0, 0), // VBAR
+    (0, 13, 0, 0), // FCSEIDR
+    (0, 13, 0, 1), // CONTEXTIDR
+    (0, 13, 0, 2), // TPIDRURW
+    (0, 13, 0, 3), // TPIDRURO
+    (0, 13, 0, 4), // TPIDRPRW
+    (2, 0, 0, 0),  // CSSELR
+    (0, 14, 1, 0), // CNTKCTL
+];
+/// Banked 64-bit selectors (opc1, crm): TTBR0, TTBR1, PAR.
+const WIDE: [(u32, u32); 3] = [(0, 2), (1, 2), (0, 7)];
+/// Secure-only selectors: SCR, SDER, NSACR, MVBAR.
+const SECURE: [(u32, u32, u32, u32); 4] = [(0, 1, 1, 0), (0, 1, 1, 1), (0, 1, 1, 2), (0, 12, 0, 1)];
+const SCALARS: [Register; 4] = [
+    Register::Arm32(arm::Register::Cpacr),
+    Register::Arm32(arm::Register::Fpexc),
+    Register::Arm32(arm::Register::Fpscr),
+    Register::Diagnostic(Diagnostic::ExceptionSyndrome),
+];
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct State {
+    identity: [u32; 4],
+    cpsr: u32,
+    registers: [u32; 16],
+    scalar: [u32; 4],
+    vectors: [[u8; 16]; 16],
+    banks: [Bank; 8],
+    cp15: [[u32; 2]; 22],
+    wide: [[u64; 2]; 3],
+    secure: [u32; 4],
+}
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Bank {
+    registers: [u32; 7],
+    spsr: Option<u32>,
+}
+
+fn cp(
+    cpu: &Core,
+    selector: (u32, u32, u32, u32),
+    secure: u32,
+    value: Option<u32>,
+) -> Result<u32, String> {
+    let (opc1, crn, crm, opc2) = selector;
+    u32::try_from(cpu.coprocessor(
+        arm::Coprocessor {
+            cp: 15,
+            opc1,
+            crn,
+            crm,
+            opc2,
+            secure,
+            wide: false,
+        },
+        value.map(u64::from),
+    )?)
+    .map_err(|_| "A7 system register exceeds 32 bits".into())
+}
+fn wide(
+    cpu: &Core,
+    (opc1, crm): (u32, u32),
+    secure: u32,
+    value: Option<u64>,
+) -> Result<u64, String> {
+    cpu.coprocessor(
+        arm::Coprocessor {
+            cp: 15,
+            opc1,
+            crn: 0,
+            crm,
+            opc2: 0,
+            secure,
+            wide: true,
+        },
+        value,
+    )
+}
+fn identity(cpu: &Core) -> Result<[u32; 4], String> {
+    if cpu.model != Model::CortexA7 {
+        return Err("CPU snapshot requires the Cortex-A7 model".into());
+    }
+    let mut fpsid = [0; 4];
+    cpu.read_register(Register::Arm32(arm::Register::Fpsid), &mut fpsid)?;
+    Ok([
+        cp(cpu, (0, 0, 0, 0), 0, None)?,
+        cp(cpu, (0, 0, 0, 5), 0, None)?,
+        cp(cpu, (1, 0, 0, 1), 0, None)?, // CLIDR; CCSIDR follows CSSELR
+        u32::from_le_bytes(fpsid),
+    ])
+}
+fn put(cpu: &Core, register: Register, value: u32) -> Result<(), String> {
+    cpu.write_register(register, &value.to_le_bytes())
+}
+fn shared(mode: u32) -> bool {
+    matches!(mode, 0x10 | 0x1f)
+}
+
+impl State {
+    pub(super) fn capture(cpu: &Core, context: &Context) -> Result<Self, String> {
+        let cpsr = context.get32(arm::CPSR)?;
+        let registers = array(arm::CORE.map(|r| context.get32(r)))?;
+        let scalar = array(SCALARS.map(|r| context.get32(r)))?;
+        let vectors = array((0..16).map(|i| context.get(Register::Arm32(arm::Register::Q(i)))))?;
+        let banks = (|| {
+            array(MODES.map(|mode| {
+                context.put32(arm::CPSR, cpsr & !31 | mode)?;
+                Ok(Bank {
+                    registers: array((8..15).map(|i| context.get32(arm::CORE[i])))?,
+                    spsr: if shared(mode) {
+                        None
+                    } else {
+                        Some(context.get32(arm::SPSR)?)
+                    },
+                })
+            }))
+        })();
+        let restored = context.put32(arm::CPSR, cpsr);
+        let banks = banks?;
+        restored?;
+        Ok(Self {
+            identity: identity(cpu)?,
+            cpsr,
+            registers,
+            scalar,
+            vectors,
+            banks,
+            cp15: array(CP15.map(|s| array((0..2).map(|secure| cp(cpu, s, secure, None)))))?,
+            wide: array(WIDE.map(|s| array((0..2).map(|secure| wide(cpu, s, secure, None)))))?,
+            secure: array(SECURE.map(|s| cp(cpu, s, 1, None)))?,
+        })
+    }
+    pub(super) fn validate(&self, cpu: &Core) -> Result<(), String> {
+        if self.identity != identity(cpu)? {
+            return Err("CPU snapshot architectural identity differs".into());
+        }
+        let mode = MODES
+            .iter()
+            .position(|&m| m == self.cpsr & 31)
+            .ok_or("invalid A7 snapshot processor mode")?;
+        for (i, bank) in self.banks.iter().enumerate() {
+            if bank.spsr.is_none() != shared(MODES[i])
+                || (MODES[i] != 0x11 && bank.registers[..5] != self.banks[0].registers[..5])
+            {
+                return Err("inconsistent A7 snapshot register banks".into());
+            }
+        }
+        if self.banks[0] != self.banks[7] || self.registers[8..15] != self.banks[mode].registers {
+            return Err("inconsistent A7 snapshot current/shared bank".into());
+        }
+        Ok(())
+    }
+    pub(super) fn install(&self, cpu: &Core) -> Result<(), String> {
+        self.validate(cpu)?;
+        // Write only changed selectors: constant registers have no backing
+        // field, and Unicorn would store their value at the state origin.
+        let set = |selector, secure, value| {
+            if cp(cpu, selector, secure, None)? != value {
+                cp(cpu, selector, secure, Some(value))?;
+            }
+            Ok::<_, String>(())
+        };
+        for (selector, &value) in SECURE.into_iter().zip(&self.secure) {
+            set(selector, 1, value)?;
+        }
+        for (selector, values) in WIDE.into_iter().zip(&self.wide) {
+            for (secure, &value) in values.iter().enumerate() {
+                if wide(cpu, selector, secure as u32, None)? != value {
+                    wide(cpu, selector, secure as u32, Some(value))?;
+                }
+            }
+        }
+        for (selector, values) in CP15.into_iter().zip(&self.cp15).skip(1) {
+            for (secure, &value) in values.iter().enumerate() {
+                set(selector, secure as u32, value)?;
+            }
+        }
+        for (mode, bank) in MODES.into_iter().zip(&self.banks) {
+            put(cpu, arm::CPSR, 0xd0 | mode)?;
+            for (index, &value) in bank.registers.iter().enumerate() {
+                put(cpu, arm::CORE[index + 8], value)?;
+            }
+            if let Some(spsr) = bank.spsr {
+                put(cpu, arm::SPSR, spsr)?;
+            }
+        }
+        for (register, &value) in SCALARS.into_iter().zip(&self.scalar) {
+            put(cpu, register, value)?;
+        }
+        for (index, value) in self.vectors.iter().enumerate() {
+            cpu.write_register(Register::Arm32(arm::Register::Q(index as u8)), value)?;
+        }
+        for (secure, &value) in self.cp15[0].iter().enumerate() {
+            set(CP15[0], secure as u32, value)?;
+        }
+        for (register, &value) in arm::CORE[..8].iter().zip(&self.registers[..8]) {
+            put(cpu, *register, value)?;
+        }
+        // PC host writes select Thumb from bit 0; the exact CPSR follows it.
+        put(cpu, arm::PC, self.registers[15])?;
+        put(cpu, arm::CPSR, self.cpsr)?;
+        // Raw TTBR/SCTLR writes bypass the guest's TLB maintenance.
+        cpu.check(unsafe { (cpu.api.uc_ctl)(cpu.raw, ffi::ctl(11, 0, 1)) })?;
+        cpu.invalidate_code(None)
+    }
+}
