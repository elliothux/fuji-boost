@@ -0,0 +1,674 @@
+//! Synthetic reset requests, with opt-in repeatable commands.
+//! Delay and word-zero completion are virtual conventions, not physical reset/clock laws.
+use fujimod_emulator_devices::{Cx, Device, Record, Value as Field, checkpoint::Checkpoint};
+use serde::{Deserialize, Serialize};
+
+const NAME: &str = "xp4-audio-reset-fixture";
+const ADDRESS: u64 = 0xfff4f01c;
+const TOKEN: u64 = 1;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Request {
+    command: u32,
+    started: u64,
+    due: u64,
+    token: u64,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+enum Stage {
+    Idle,
+    Pending(Request),
+    Done(Request),
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct State {
+    ticks: u64,
+    stage: Stage,
+    #[serde(default, skip_serializing_if = "std::ops::Not::not")]
+    // Legacy checkpoint field: enables repeat commands without an ordinal limit.
+    allow_second_command: bool,
+}
+
+pub struct AudioResetFixture {
+    state: State,
+}
+
+impl AudioResetFixture {
+    pub fn new(ticks: u64) -> Result<Self, String> {
+        if !(1..=1_000_000).contains(&ticks) {
+            return Err("Invalid audio reset fixture latency".into());
+        }
+        Ok(Self {
+            state: State {
+                ticks,
+                stage: Stage::Idle,
+                allow_second_command: false,
+            },
+        })
+    }
+
+    /// Opt-in repeated completed commands; no physical audio identity or timing is implied.
+    pub fn new_with_second_command(ticks: u64) -> Result<Self, String> {
+        let mut fixture = Self::new(ticks)?;
+        fixture.state.allow_second_command = true;
+        Ok(fixture)
+    }
+
+    fn access(address: u64, size: u8) -> bool {
+        address == ADDRESS && size == 4
+    }
+
+    fn validate_state(&self, state: &State) -> Result<(), String> {
+        if state.ticks != self.state.ticks {
+            return Err("Audio reset checkpoint latency differs".into());
+        }
+        if state.allow_second_command != self.state.allow_second_command {
+            return Err("Audio reset checkpoint command policy differs".into());
+        }
+        if let Stage::Pending(r) | Stage::Done(r) = state.stage {
+            if r.command != 1
+                || !(r.token == TOKEN || (state.allow_second_command && r.token > 0))
+                || r.started.checked_add(state.ticks) != Some(r.due)
+            {
+                return Err("Invalid audio reset checkpoint request/deadline".into());
+            }
+        }
+        Ok(())
+    }
+}
+
+impl Device for AudioResetFixture {
+    fn name(&self) -> &'static str {
+        NAME
+    }
+
+    fn read(&mut self, cx: &mut Cx<'_>, address: u64, size: u8) -> u64 {
+        if Self::access(address, size) {
+            match self.state.stage {
+                Stage::Pending(_) => return 1,
+                Stage::Done(_) => return 0,
+                Stage::Idle => {}
+            }
+        }
+        cx.fail("Unknown audio reset fixture read");
+        0
+    }
+
+    fn write(&mut self, cx: &mut Cx<'_>, address: u64, size: u8, value: u64) {
+        if !Self::access(address, size) || value != 1 {
+            cx.fail("Unsupported audio reset fixture write");
+            return;
+        }
+        let token = match self.state.stage {
+            Stage::Pending(_) => return, // Same request never postpones the scheduled completion.
+            Stage::Done(request) if self.state.allow_second_command => {
+                let Some(token) = request.token.checked_add(1) else {
+                    cx.fail("Audio reset fixture token overflow");
+                    return;
+                };
+                token
+            }
+            Stage::Done(_) => {
+                cx.fail("Audio reset fixture reentry is not modeled");
+                return;
+            }
+            Stage::Idle => TOKEN,
+        };
+        let Some(due) = cx.now().checked_add(self.state.ticks) else {
+            cx.fail("Audio reset fixture deadline overflow");
+            return;
+        };
+        let request = Request {
+            command: 1,
+            started: cx.now(),
+            due,
+            token,
+        };
+        self.state.stage = Stage::Pending(request);
+        cx.schedule(due, token);
+        cx.record(Record::new(
+            "XP4 audio reset fixture scheduled",
+            [
+                ("address", Field::int(ADDRESS)),
+                ("command", Field::int(request.command)),
+                ("tick", Field::int(request.started)),
+                ("due", Field::int(due)),
+            ]
+            .into_iter()
+            .chain(
+                self.state
+                    .allow_second_command
+                    .then_some(("ordinal", Field::int(request.token))),
+            ),
+        ));
+    }
+
+    fn event(&mut self, cx: &mut Cx<'_>, token: u64) {
+        let Stage::Pending(request) = self.state.stage else {
+            return;
+        };
+        if token != request.token || cx.now() < request.due {
+            return;
+        }
+        self.state.stage = Stage::Done(request);
+        cx.record(Record::new(
+            "XP4 audio reset fixture completed",
+            [
+                ("address", Field::int(ADDRESS)),
+                ("command", Field::int(request.command)),
+                ("tick", Field::int(request.due)),
+            ]
+            .into_iter()
+            .chain(
+                self.state
+                    .allow_second_command
+                    .then_some(("ordinal", Field::int(request.token))),
+            ),
+        ));
+    }
+
+    fn advance(&mut self, cx: &mut Cx<'_>) {
+        if let Stage::Pending(request) = self.state.stage {
+            self.event(cx, request.token);
+        }
+    }
+
+    fn next_deadline(&self, _: u64) -> Option<u64> {
+        if let Stage::Pending(request) = self.state.stage {
+            Some(request.due)
+        } else {
+            None
+        }
+    }
+
+    fn pollable(&self, address: u64, size: u8) -> bool {
+        Self::access(address, size) && !matches!(self.state.stage, Stage::Idle)
+    }
+
+    fn save(&self) -> serde_json::Value {
+        serde_json::to_value(&self.state).unwrap()
+    }
+
+    fn checkpoint(&self) -> Result<Checkpoint, String> {
+        Checkpoint::encode(NAME, &self.state)
+    }
+
+    fn validate_checkpoint(&self, saved: &Checkpoint) -> Result<(), String> {
+        if !saved.blobs().is_empty() || !saved.children().is_empty() {
+            return Err("Unexpected audio reset checkpoint attachments".into());
+        }
+        self.validate_state(&saved.decode(NAME)?)
+    }
+
+    fn restore_checkpoint(&mut self, saved: &Checkpoint) -> Result<(), String> {
+        self.validate_checkpoint(saved)?;
+        self.state = saved.decode(NAME)?;
+        Ok(())
+    }
+
+    fn fingerprint(&self) -> Result<serde_json::Value, String> {
+        Ok(self.save())
+    }
+}
