+    fn p(i: usize, off: u32) -> u64 {
+        0xff600000 + (i as u64) * 0x10000 + u64::from(off)
+    }
+    fn q(i: usize, off: u32) -> u64 {
+        0xff500000 + (i as u64) * 0x10000 + u64::from(off)
