+    fn mode2_hash(mode2: &Mode2) -> String {
+        let bytes: Vec<u8> = mode2
+            .scripts
+            .iter()
+            .flatten()
+            .flat_map(|(a, v)| a.to_le_bytes().into_iter().chain(v.to_le_bytes()))
+            .collect();
+        fujimod_emulator_devices::fingerprint::bytes(&bytes)["sha256"]
+            .as_str()
+            .unwrap()
+            .to_owned()
+    }
+    fn mode2_config() -> Config {
+        let mut c = config();
+        let mut mode2 = Mode2 {
+            scripts: c.mode5_scripts.clone(),
+            source_sha256: String::new(),
+        };
+        for (unit, script) in mode2.scripts.iter_mut().enumerate() {
+            for (n, (_, v)) in script[23..46].iter_mut().enumerate() {
+                *v = match unit {
+                    0 => n as u32 % 8,
+                    1 | 2 => [0, 1, 2, 5][n % 4],
+                    _ => n as u32 % 5,
+                };
+            }
+            if matches!(unit, 1 | 2) {
+                script[1].1 = 0x09004600;
+                script[7].1 = 0x05004200;
+                script[48].1 = 0x83;
+                script[65].1 = 0xa1;
+            } else if unit == 3 {
+                script[65].1 = 0xa1;
+            }
+        }
+        mode2.source_sha256 = mode2_hash(&mode2);
+        c.mode2 = Some(mode2);
+        c.unit0_preinitialized = true;
+        c
+    }
+    fn mode2_prefix(
+        m: &mut BankedCalibration,
+        h: &mut TestHost,
+        unit: usize,
+        start: usize,
+        end: usize,
+    ) {
+        for (a, v) in m.config.mode2.as_ref().unwrap().scripts[unit][start..end].to_vec() {
+            write(m, h, a.into(), v);
+        }
+    }
