+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::{Definition, Session};
+    use serde_json::json;
+
+    const VA: u32 = 0x200100;
+    const PA: u32 = 0x100100;
+
+    fn session(word: u32) -> Session {
+        let definition: Definition = serde_json::from_value(json!({
+            "ram_size": 4 * 1024 * 1024, "cores": 1,
+            "discovery": false, "cbar": 0xffff0000u32
+        }))
+        .unwrap();
+        let session = Session::new(definition, None).unwrap();
+        let table: Vec<_> = [0x00000c02u32, 0, 0x00100c02, 0x00000c02]
+            .into_iter()
+            .flat_map(u32::to_le_bytes)
+            .collect();
+        session.write(0x4000, &table).unwrap();
+        session.write(PA as usize, &word.to_le_bytes()).unwrap();
+        session
+            .write(VA as usize, &0xe12fff1eu32.to_le_bytes())
+            .unwrap();
+        let c = &session.inner;
+        c.write_cp(0, 2, 0, 0x4000).unwrap();
+        c.write_cp(0, 3, 0, 0xffffffff).unwrap();
+        let sctlr = c.cp(0, 1, 0, 0, 0).unwrap() as u32;
+        c.write_cp(0, 1, 0, sctlr | 1 | (1 << 23)).unwrap();
+        session.write_register(0, arm::CPSR, 0xd3).unwrap();
+        session.write_register(0, arm::PC, u64::from(VA)).unwrap();
+        session.write_register(0, arm::CORE[1], 0x400000).unwrap();
+        session
+    }
+
+    #[test]
+    fn failure_caches_first_same_core_fetch_and_physical_view_without_delivering_abort() {
+        let session = session(0);
+        let c = &session.inner;
+        let registers_before: Vec<_> = arm::CORE.iter().map(|&r| c.reg(0, r).unwrap()).collect();
+        let cpsr_before = c.reg(0, arm::CPSR).unwrap();
+        let cp_before = [c.cp(0, 5, 0, 0, 0).unwrap(), c.cp(0, 6, 0, 0, 0).unwrap()];
+        assert!(
+            serde_json::to_value(session.state(false))
+                .unwrap()
+                .get("abort_failure")
+                .is_none()
+        );
+        assert_eq!(
+            c.deliver_abort(0, false, "cpu-DataAbort-callback")
+                .unwrap_err(),
+            "Unsupported ARM data-abort instruction 0x00000000"
+        );
+        let state = session.state(false);
+        let diagnostic = state.abort_failure.unwrap();
+        assert_eq!(diagnostic["source"], "cpu-DataAbort-callback");
+        assert_eq!(diagnostic["core"], 0);
+        assert_eq!(diagnostic["pc_used_for_diagnosis"], VA);
+        assert_eq!(diagnostic["word_used_for_decode"], 0);
+        assert_eq!(
+            diagnostic["fetch_inspection_after_failure"]["physical"]["Ok"],
+            PA
+        );
+        assert_eq!(
+            diagnostic["fetch_inspection_after_failure"]["backing_word"]["Ok"],
+            0
+        );
+        assert_eq!(diagnostic["cpsr_after_failure"]["Ok"], cpsr_before);
+        assert_eq!(state.data_aborts, [0]);
+        assert_eq!(session.instructions(), [0]);
+        assert_eq!(
+            arm::CORE
+                .iter()
+                .map(|&r| c.reg(0, r).unwrap())
+                .collect::<Vec<_>>(),
+            registers_before
+        );
+        assert_eq!(
+            [c.cp(0, 5, 0, 0, 0).unwrap(), c.cp(0, 6, 0, 0, 0).unwrap()],
+            cp_before
+        );
+        assert!(c.deliver_abort(0, false, "later-attempt").is_err());
+        assert_eq!(session.state(false).abort_failure.unwrap(), diagnostic);
+        assert!(session.device_records().is_empty() && session.frontier(false).is_empty());
+    }
+
+    #[test]
+    fn explained_data_abort_keeps_architectural_entry_and_has_no_failure_diagnostic() {
+        let session = session(0xe5910000); // LDR R0,[R1]; section4 is unmapped.
+        session
+            .inner
+            .deliver_abort(0, false, "cpu-DataAbort-callback")
+            .unwrap();
+        let state = session.state(false);
+        assert!(state.abort_failure.is_none());
+        assert_eq!(state.data_aborts, [1]);
+        assert_eq!(session.read_register(0, arm::PC).unwrap(), 0x10);
+        assert_eq!(session.read_register(0, arm::CPSR).unwrap() & 31, 0x17);
+        assert_eq!(session.inner.cp(0, 6, 0, 0, 0).unwrap(), 0x400000);
+        assert_eq!(session.inner.cp(0, 5, 0, 0, 0).unwrap() & 15, 5);
     }
