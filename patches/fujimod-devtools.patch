+            results: [[1, 2, 3, 4], [5, 6, 7, 8], [0; 4], [9, 10, 11, 12]],
+            latency_ticks: 8,
+            source_sha256: String::new(),
+            mode5_scripts: std::array::from_fn(|unit| {
+                let base = 0xff500000 + unit as u32 * 0x10000;
+                (0..23)
+                    .map(|i| (base + 0x5000 + i * 4, 0x01004100))
+                    .chain((0..24).map(|i| {
+                        (
+                            base + 0x5200 + i * 4,
+                            if i == 23 { 0 } else { unit as u32 + 1 },
+                        )
+                    }))
+                    .chain((0..23).map(|i| (base + 0x5400 + i * 4, 0x81)))
+                    .chain([(base + 0x5384, 1)])
+                    .collect()
