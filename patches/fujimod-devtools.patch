diff --git a/crates/emulator-xp4-board/src/ram_write_watch.rs b/crates/emulator-xp4-board/src/ram_write_watch.rs
new file mode 100644
index 0000000..7fa1920
--- /dev/null
+++ b/crates/emulator-xp4-board/src/ram_write_watch.rs
@@ -0,0 +1,339 @@
+//! Opt-in physical RAM write observations. CPU callbacks are pre-store operands.
+use super::{Cluster, Session};
+use fujimod_emulator_cpu::{Access, arm};
+use serde::Serialize;
+
+#[derive(Clone, Serialize)]
+struct Context {
+    core: usize,
+    pc: Result<u32, String>,
+    cpsr: Result<u32, String>,
+    sp: Result<u32, String>,
+    #[serde(rename = "spWritePhysical")]
+    sp_write_physical: Result<u64, String>,
+}
+
+#[derive(Clone, Serialize)]
+pub(super) struct Record {
+    origin: &'static str,
+    physical: u64,
+    size: usize,
+    #[serde(rename = "samplePhysical")]
+    sample_physical: u64,
+    #[serde(rename = "sampleBytes")]
+    sample_bytes: usize,
+    before: Result<Vec<u8>, String>,
+    after: Option<Result<Vec<u8>, String>>,
+    value: Option<u64>,
+    context: Option<Context>,
+    instructions: u64,
+    tick: u64,
+}
+
+pub(super) struct Watch {
+    ranges: Vec<(u64, u64)>,
+    limit: usize,
+    records: Vec<Record>,
+    dropped: u64,
+}
+
+impl Cluster {
+    fn sample_physical(&self, address: u64, length: usize) -> Result<Vec<u8>, String> {
+        let source = self.memory_pointer(address, length, 1)?;
+        Ok(unsafe { std::slice::from_raw_parts(source, length) }.to_vec())
+    }
+
+    pub(super) fn record_ram_write(
+        &self,
+        origin: &'static str,
+        core: Option<usize>,
+        address: u64,
+        size: usize,
+        value: Option<u64>,
+    ) -> Option<usize> {
+        let (sample, length, instructions, tick) = {
+            let state = unsafe { &mut *self.state.get() };
+            let watch = state.ram_write_watch.as_mut()?;
+            let &(lo, hi) = watch.ranges.iter().find(|&&(lo, hi)| {
+                size != 0 && address < hi && lo < address.saturating_add(size as u64)
+            })?;
+            if watch.records.len() == watch.limit {
+                watch.dropped = watch.dropped.saturating_add(1);
+                return None;
+            }
+            let sample = address.max(lo);
+            let length = (hi.min(address.saturating_add(size as u64)) - sample).min(32);
+            (sample, length as usize, state.instructions, state.ticks)
+        };
+        let context = core.map(|core| {
+            let sp = self.reg(core, arm::CORE[13]);
+            let sp_write_physical = sp
+                .as_ref()
+                .map_err(Clone::clone)
+                .and_then(|&sp| self.cpus[core].translate(u64::from(sp), Access::Write));
+            Context {
+                core,
+                pc: self.reg(core, arm::PC),
+                cpsr: self.reg(core, arm::CPSR),
+                sp,
+                sp_write_physical,
+            }
+        });
+        let record = Record {
+            origin,
+            physical: address,
+            size,
+            sample_physical: sample,
+            sample_bytes: length,
+            before: self.sample_physical(sample, length),
+            after: None,
+            value,
+            context,
+            instructions,
+            tick,
+        };
+        let watch = unsafe { (*self.state.get()).ram_write_watch.as_mut()? };
+        let index = watch.records.len();
+        watch.records.push(record);
+        Some(index)
+    }
+
+    /// Only called after a successful host copy, never to certify a CPU hook.
+    pub(super) fn finish_ram_write(&self, index: Option<usize>) {
+        let Some(index) = index else { return };
+        let (address, length) = {
+            let state = unsafe { &*self.state.get() };
+            let record = &state.ram_write_watch.as_ref().unwrap().records[index];
+            (record.sample_physical, record.sample_bytes)
+        };
+        let after = self.sample_physical(address, length);
+        unsafe {
+            (*self.state.get())
+                .ram_write_watch
+                .as_mut()
+                .unwrap()
+                .records[index]
+                .after = Some(after)
+        };
+    }
+}
+
+impl Session {
+    pub fn ram_write_watch_begin(
+        &self,
+        ranges: Vec<(u64, u64)>,
+        limit: usize,
+    ) -> Result<(), String> {
+        let state = unsafe { &mut *self.inner.state.get() };
+        if self.inner.running.get()
+            || state.driver_guard.is_some()
+            || state.ram_write_watch.is_some()
+        {
+            return Err("RAM write watch requires an unguarded paused board without an existing write watch".into());
+        }
+        if ranges.is_empty()
+            || ranges.len() > 8
+            || !(1..=4096).contains(&limit)
+            || ranges
+                .iter()
+                .any(|&(lo, hi)| lo >= hi || hi > self.inner.ram.len() as u64)
+        {
+            return Err(
+                "RAM write watch requires bounded physical RAM ranges and record limit".into(),
+            );
+        }
+        state.ram_write_watch = Some(Watch {
+            ranges,
+            limit,
+            records: vec![],
+            dropped: 0,
+        });
+        Ok(())
+    }
+
+    pub fn ram_write_watch_snapshot(&self) -> Option<serde_json::Value> {
+        let state = unsafe { &*self.inner.state.get() };
+        state.ram_write_watch.as_ref().map(|watch| serde_json::json!({
+            "ranges":watch.ranges,"limit":watch.limit,"records":watch.records,"dropped":watch.dropped
+        }))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::Definition;
+    use serde_json::json;
+
+    fn board(cores: usize) -> Session {
+        let definition: Definition = serde_json::from_value(json!({
+            "ram_size":4*1024*1024,"cores":cores,"discovery":false,"cbar":0xffff0000u32
+        }))
+        .unwrap();
+        let session = Session::new(definition, None).unwrap();
+        session.write(0x1000, &0xe5801000u32.to_le_bytes()).unwrap(); // STR r1,[r0]
+        session
+    }
+
+    #[test]
+    fn four_core_writes_are_observed_and_the_bound_does_not_block_stores() {
+        let session = board(4);
+        for core in 0..4 {
+            session.write_register(core, arm::PC, 0x1000).unwrap();
+            session.write_register(core, arm::CORE[0], 0x2000).unwrap();
+            session
+                .write_register(core, arm::CORE[1], core as u64 + 1)
+                .unwrap();
+            session
+                .write_register(core, arm::CORE[13], 0x3000 + core as u64 * 0x100)
+                .unwrap();
+        }
+        let before = serde_json::to_value(session.state(true)).unwrap();
+        session
+            .ram_write_watch_begin(vec![(0x2000, 0x2004)], 4)
+            .unwrap();
+        assert_eq!(serde_json::to_value(session.state(true)).unwrap(), before);
+        assert!(
+            session
+                .ram_write_watch_begin(vec![(0x2000, 0x2004)], 4)
+                .is_err()
+        );
+        for core in 0..4 {
+            session.run(core, 1).unwrap();
+            let mut value = [0; 4];
+            session.read(0x2000, &mut value).unwrap();
+            assert_eq!(u32::from_le_bytes(value), core as u32 + 1);
+        }
+        let trace = session.ram_write_watch_snapshot().unwrap();
+        for (core, row) in trace["records"].as_array().unwrap().iter().enumerate() {
+            assert_eq!(row["origin"], "cpu-pre-store");
+            assert_eq!(row["physical"], 0x2000);
+            assert_eq!(row["before"]["Ok"], json!((core as u32).to_le_bytes()));
+            assert!(row["after"].is_null());
+            assert_eq!(row["context"]["core"], core);
+            assert_eq!(row["context"]["pc"]["Ok"], 0x1000);
+            assert_eq!(
+                row["context"]["spWritePhysical"]["Ok"],
+                0x3000 + core * 0x100
+            );
+        }
+        assert_eq!(trace["records"].as_array().unwrap().len(), 4);
+        session.write(0x2000, &[77; 4]).unwrap();
+        assert_eq!(session.ram_write_watch_snapshot().unwrap()["dropped"], 1);
+        let mut actual = [0; 4];
+        session.read(0x2000, &mut actual).unwrap();
+        assert_eq!(actual, [77; 4]);
+    }
+
+    #[test]
+    fn host_copy_samples_are_clipped_and_have_independent_post_copy_bytes() {
+        let session = board(1);
+        assert!(
+            session
+                .ram_write_watch_begin(vec![(0x2004, 0x2000)], 4)
+                .is_err()
+        );
+        assert!(
+            session
+                .ram_write_watch_begin(vec![(0, 0x500000)], 4)
+                .is_err()
+        );
+        assert!(
+            session
+                .ram_write_watch_begin(vec![(0x2000, 0x2004)], 0)
+                .is_err()
+        );
+        session.write(0x2000, &[0xaa; 8]).unwrap();
+        session
+            .ram_write_watch_begin(vec![(0x2002, 0x2006)], 4)
+            .unwrap();
+        session.write(0x3000, &[1; 8]).unwrap();
+        session.write(0x2000, &[0, 1, 2, 3, 4, 5, 6, 7]).unwrap();
+        let trace = session.ram_write_watch_snapshot().unwrap();
+        assert_eq!(trace["records"].as_array().unwrap().len(), 1);
+        let row = &trace["records"][0];
+        assert_eq!(row["origin"], "host-session-write");
+        assert_eq!(row["samplePhysical"], 0x2002);
+        assert_eq!(row["sampleBytes"], 4);
+        assert_eq!(row["before"]["Ok"], json!([170, 170, 170, 170]));
+        assert_eq!(row["after"]["Ok"], json!([2, 3, 4, 5]));
+        assert!(row["context"].is_null());
+    }
+
+    #[test]
+    fn nonidentity_stack_translation_and_translation_errors_are_retained() {
+        let session = board(1);
+        session.write(0x4000, &0x00000c02u32.to_le_bytes()).unwrap();
+        session
+            .write(0x4000 + 0x802 * 4, &0x00100c02u32.to_le_bytes())
+            .unwrap();
+        let cp = |crn| arm::Coprocessor {
+            cp: 15,
+            opc1: 0,
+            crn,
+            crm: 0,
+            opc2: 0,
+            secure: 0,
+            wide: false,
+        };
+        let cpu = &session.inner.cpus[0];
+        cpu.coprocessor(cp(2), Some(0x4000)).unwrap();
+        cpu.coprocessor(cp(3), Some(0xffff_ffff)).unwrap();
+        let sctlr = cpu.coprocessor(cp(1), None).unwrap();
+        cpu.coprocessor(cp(1), Some(sctlr | 1)).unwrap();
+        session.write_register(0, arm::PC, 0x1000).unwrap();
+        session.write_register(0, arm::CORE[0], 0x80200100).unwrap();
+        session.write_register(0, arm::CORE[1], 0x11223344).unwrap();
+        session
+            .write_register(0, arm::CORE[13], 0x80200140)
+            .unwrap();
+        session
+            .ram_write_watch_begin(vec![(0x100100, 0x100104)], 4)
+            .unwrap();
+        session.run(0, 1).unwrap();
+        let trace = session.ram_write_watch_snapshot().unwrap();
+        assert_eq!(trace["records"][0]["physical"], 0x100100);
+        assert_eq!(trace["records"][0]["context"]["sp"]["Ok"], 0x80200140u32);
+        assert_eq!(
+            trace["records"][0]["context"]["spWritePhysical"]["Ok"],
+            0x100140
+        );
+        let mut actual = [0; 4];
+        session.read(0x100100, &mut actual).unwrap();
+        assert_eq!(actual, 0x11223344u32.to_le_bytes());
+        session.write_register(0, arm::PC, 0x1000).unwrap();
+        session
+            .write_register(0, arm::CORE[13], 0xf0001000)
+            .unwrap();
+        session.run(0, 1).unwrap();
+        let trace = session.ram_write_watch_snapshot().unwrap();
+        assert!(trace["records"][1]["context"]["spWritePhysical"]["Err"].is_string());
+        assert!(session.state(false).failure.is_none());
+    }
+
+    #[test]
+    fn emulated_exclusive_store_has_its_own_post_copy_observation() {
+        let session = board(1);
+        let code: Vec<u8> = [0xe1902f9fu32, 0xe1803f91]
+            .into_iter()
+            .flat_map(u32::to_le_bytes)
+            .collect();
+        session.write(0x1000, &code).unwrap();
+        session.write_register(0, arm::PC, 0x1000).unwrap();
+        session.write_register(0, arm::CORE[0], 0x2000).unwrap();
+        session.write_register(0, arm::CORE[1], 0x11223344).unwrap();
+        session
+            .ram_write_watch_begin(vec![(0x2000, 0x2004)], 4)
+            .unwrap();
+        session.run(0, 1).unwrap();
+        assert_eq!(session.read_register(0, arm::PC).unwrap(), 0x1004);
+        session.run(0, 1).unwrap();
+        assert_eq!(session.read_register(0, arm::PC).unwrap(), 0x1008);
+        assert_eq!(session.read_register(0, arm::CORE[3]).unwrap(), 0);
+        let trace = session.ram_write_watch_snapshot().unwrap();
+        assert_eq!(trace["records"].as_array().unwrap().len(), 1);
+        assert_eq!(trace["records"][0]["origin"], "emulated-strex");
+        assert_eq!(trace["records"][0]["before"]["Ok"], json!([0, 0, 0, 0]));
+        assert_eq!(trace["records"][0]["after"]["Ok"], json!([68, 51, 34, 17]));
+    }
+}
