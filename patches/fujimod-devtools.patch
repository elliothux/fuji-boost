+            // OpenVG1.1 §13.3: blend premultiplied colors, then apply coverage.
+            let alpha = match mode {
+                0 => sa,
+                2 => sa * (1. - da) + da,
+                3 | 4 => sa * da,
+                9 => (sa + da).min(1.),
+                _ => sa + da - sa * da,
+            } * coverage
+                + da * (1. - coverage);
