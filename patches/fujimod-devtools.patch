+++ b/crates/emulator-xp4-io/src/bis_peer.rs
@@ -0,0 +1,514 @@
+//! X-T4 BIS scalar transport, qualified by .cache/bis-protocol/PROTOCOL.md.
+use crate::spi::Input;
+use fujimod_emulator_ip::socionext::gpio::SharedPins;
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+
+fn checksum(word: u32) -> u32 {
+    ((word >> 27)
+        + ((word >> 22) & 31)
+        + ((word >> 17) & 31)
+        + ((word >> 12) & 31)
+        + ((word >> 7) & 31)
+        + ((word >> 6) & 1))
+        & 31
+}
+
+fn header(command: u16, data: u16) -> u32 {
+    let word = (u32::from(data) << 16) | (u32::from(command) << 6);
+    word | (checksum(word) << 1)
+}
+
+fn ack(command: u16, sequence: u8) -> u32 {
+    let word = 0x08008000 | (u32::from(sequence) << 24) | (u32::from(command) << 6);
+    word | (checksum(word) << 1)
+}
+
+#[derive(Clone, Default, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct State {
+    tx: [u8; 4],
+    position: usize,
+    h1: bool,
+    command: u16,
+    result: u32,
+    sequence: u8,
+    ready: bool,
+    #[serde(default)]
+    reset_changes: Option<u64>,
+    frames: u64,
+    last_request: [u8; 4],
+    last_reply: [u8; 4],
+}
+
+pub struct BisPeer {
+    // Scenario property bytes, not an assertion about the real MCU's version.
+    version: [u8; 2],
+    pins: SharedPins,
+    state: State,
+}
+
+impl BisPeer {
+    pub fn new(version: [u8; 2], pins: SharedPins) -> Self {
+        let reset_changes = Some(pins.lock().unwrap().output(12, 6).1);
+        Self {
+            version,
+            pins,
+            state: State {
+                reset_changes,
+                ..State::default()
+            },
+        }
+    }
+
+    fn scalar(&self, command: u16) -> u32 {
+        header(
+            command,
+            if command == 20 {
+                u16::from_be_bytes(self.version)
+            } else {
+                0
+            },
+        )
+    }
+
+    fn refusal(tx: [u8; 4], reason: &str) -> String {
+        format!("BIS peer refused request {:02x?}: {reason}", tx)
+    }
+}
+
+impl Input for BisPeer {
+    fn next_deadline(&self, now: u64) -> Option<u64> {
+        let (high, changes) = self.pins.lock().unwrap().output(12, 6);
+        (self.state.reset_changes.is_none() || (!high && self.state.reset_changes != Some(changes)))
+            .then_some(now)
+    }
+
+    fn advance(&mut self) -> Result<(), String> {
+        let mut pins = self.pins.lock().map_err(|_| "BIS GPIO pins poisoned")?;
+        let (high, changes) = pins.output(12, 6);
+        if !high
+            && self
+                .state
+                .reset_changes
+                .is_some_and(|previous| previous != changes)
+        {
+            // 011fe6f8/011fe73c pulse GPIO12.6 before BIS transport initialization.
+            self.state = State::default();
+            pins.set_input(0, 4, false);
+        }
+        self.state.reset_changes = Some(changes);
+        Ok(())
+    }
+
+    fn exchange(&mut self, bits: u32, tx: u16, _: u64) -> Result<u16, String> {
+        if bits != 8 || tx > 255 {
+            return Err(format!("BIS peer requires bytes; bits={bits}, tx={tx:#x}"));
+        }
+        let mut next = self.state.clone();
+        next.tx[next.position] = tx as u8;
+        // Full duplex: H0 describes the previous command; H1 ACKs the current one.
+        let reply = if next.h1 {
+            ack(next.command, next.sequence)
+        } else {
+            self.scalar(next.command)
+        };
+        let rx = reply.to_be_bytes()[next.position];
+        next.position += 1;
+        if next.position == 4 {
+            let word = u32::from_be_bytes(next.tx);
+            if word & 1 != 0 || (word >> 1) & 31 != checksum(word) {
+                return Err(Self::refusal(next.tx, "invalid additive checksum/bit 0"));
+            }
+            if next.h1 {
+                if word & 0xf8008000 != 0x08008000
+                    || word & 0x000f0000 != 0
+                    || ((word >> 6) & 511) != ((next.result >> 6) & 511)
+                {
+                    return Err(Self::refusal(
+                        next.tx,
+                        "H1 does not acknowledge the preceding H0 result",
+                    ));
+                }
+                if next.result != 0 {
+                    if (next.result >> 6) & 511 == 20 {
+                        next.ready = true;
+                    }
+                    next.sequence = (next.sequence + 1) & 7;
+                }
+            } else {
+                let command = ((word >> 6) & 511) as u16;
+                if word & 0x8000 != 0 {
+                    return Err(Self::refusal(next.tx, "expected an H0 scalar request"));
+                }
+                match (command, word >> 16) {
+                    (0 | 20 | 41, 0) | (131, 0 | 8) => {}
+                    // 011f97b4 decodes flags/signed 12-bit data; c300/efa0 only store them.
+                    // shortcut: synthetic zero samples for axes 0/1, replace with measured motion before modelling actuator health.
+                    (42, 0 | 1) => {}
+                    // 011f98a0/011ff05c forward u16; 011fec58 stores it without a value gate.
+                    (282, 0x8b) => {}
+                    // API 1975 packs three selector bits and two flags (011f728c..011f72b0).
+                    (128, data) if data & !0x8107 == 0 => {}
+                    // APIs197c/197d pack 4/6 selector bits and use the status-only callback.
+                    (168, 0..=15) | (169, 0..=63) => {}
+                    // API197a packs two selector bits (011f75c0..011f75cc), status only.
+                    (135, 0..=3) => {}
+                    // APIs 1975/1980/1981 use 011f96c4: scalar result data is not consumed.
+                    (177 | 178, _) => {}
+                    // 011f9dec inserts API1970/command255 after command128; status-only barrier.
+                    (255, 0) => {}
+                    (24 | 176, _) => {
+                        return Err(Self::refusal(
+                            next.tx,
+                            "configuration handoff contents/acceptance are not qualified",
+                        ));
+                    }
+                    _ => {
+                        return Err(Self::refusal(
+                            next.tx,
+                            &format!("unsupported command {command} / scalar {:#06x}", word >> 16),
+                        ));
+                    }
+                }
+                next.command = command;
+                next.result = reply;
+            }
+            next.frames = next
+                .frames
+                .checked_add(1)
+                .ok_or("BIS frame counter overflow")?;
+            next.last_request = next.tx;
+            next.last_reply = reply.to_be_bytes();
+            next.position = 0;
+            next.tx = [0; 4];
+            next.h1 = !next.h1;
+        }
+        if next.ready && !self.state.ready {
+            // Release the observed high phase once version delivery is acknowledged.
+            self.pins
+                .lock()
+                .map_err(|_| "BIS GPIO pins poisoned")?
+                .set_input(0, 4, true);
+        }
+        self.state = next;
+        Ok(u16::from(rx))
+    }
+
+    fn save(&self) -> Value {
+        serde_json::json!({"kind":"bis-peer", "version":self.version,"state":self.state})
+    }
+
+    fn restore(&mut self, value: &Value) -> Result<(), String> {
+        #[derive(Deserialize)]
+        #[serde(deny_unknown_fields)]
+        struct Saved {
+            kind: String,
+            version: [u8; 2],
+            state: State,
+        }
+        let saved: Saved = serde_json::from_value(value.clone()).map_err(|e| e.to_string())?;
+        let s = &saved.state;
+        if saved.kind != "bis-peer"
+            || saved.version != self.version
+            || s.position >= 4
+            || s.sequence > 7
+            || !matches!(
+                s.command,
+                0 | 20 | 41 | 42 | 128 | 131 | 135 | 168 | 169 | 177 | 178 | 255 | 282
+            )
+            || s.tx[s.position..].iter().any(|b| *b != 0)
+            || s.h1 != (s.frames & 1 != 0)
+            || ![0, 20, 41, 42, 128, 131, 135, 168, 169, 177, 178, 255, 282]
+                .into_iter()
+                .any(|c| s.result == self.scalar(c))
+        {
+            return Err("Invalid BIS peer checkpoint or scenario version".into());
+        }
+        self.state = saved.state;
+        Ok(())
+    }
+}
