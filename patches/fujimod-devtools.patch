+#[cfg(test)]
+mod tests {
+    use super::*;
+    use fujimod_emulator_ip::socionext::gpio::Pins;
+
+    #[test]
+    fn bis_levels_assert_initial_low_then_high_and_restore_pending_transition() {
+        use fujimod_emulator_devices::{
+            Cx, Device, parts::gpio::InputIrq, test_host::recording::RecordingHost,
+        };
+        use fujimod_emulator_ip::socionext::gpio::Gpio;
+        let pins = Pins::new([0; 16]);
+        let mut gpio = Gpio::new(0xfff41000, pins.clone())
+            .unwrap()
+            .with_input_irqs(vec![
+                InputIrq {
+                    port: 0,
+                    pin: 4,
+                    line: 171,
+                    active_high: false,
+                },
+                InputIrq {
+                    port: 0,
+                    pin: 4,
+                    line: 155,
+                    active_high: true,
+                },
+            ])
+            .unwrap();
+        let mut host = RecordingHost::default();
+        assert_eq!(gpio.next_deadline(0), Some(0));
+        gpio.advance(&mut Cx::new(&mut host, 0, 0, 0));
+        assert_eq!(host.irqs, [(171, true), (155, false)]);
+        assert_eq!(gpio.next_deadline(0), None);
+        pins.lock().unwrap().set_input(0, 4, true);
+        let pending = gpio.checkpoint().unwrap();
+        gpio.advance(&mut Cx::new(&mut host, 0, 0, 0));
+        assert_eq!(host.irqs[2..], [(171, false), (155, true)]);
+        gpio.restore_checkpoint(&pending).unwrap();
+        assert_eq!(gpio.next_deadline(1), Some(1));
+        gpio.advance(&mut Cx::new(&mut host, 0, 0, 0));
+        assert_eq!(host.irqs[4..], [(171, false), (155, true)]);
+    }
+
+    fn frame(peer: &mut BisPeer, tx: u32) -> Result<u32, String> {
+        let mut rx = [0; 4];
+        for (i, b) in tx.to_be_bytes().into_iter().enumerate() {
+            rx[i] = peer.exchange(8, b.into(), i as u64)? as u8;
+        }
+        Ok(u32::from_be_bytes(rx))
+    }
+
+    fn startup(peer: &mut BisPeer) {
+        for (tx, rx) in [
+            (0x00000514, 0),
+            (0x08108022, 0x08008526),
+            (0, 0xffff052e),
+            (0x08008526, 0x08008012),
+        ] {
+            assert_eq!(frame(peer, tx).unwrap(), rx);
+        }
+        assert!(peer.state.ready);
+        assert_eq!(peer.state.sequence, 1);
+    }
+
+    #[test]
+    fn reset_pulse_resyncs_idle_spi_and_restarts_ack_sequence() {
+        use crate::spi::Spi;
+        use fujimod_emulator_devices::{Cx, Device, test_host::recording::RecordingHost};
+        use fujimod_emulator_ip::socionext::gpio::Gpio;
+        let pins = Pins::new([0; 16]);
+        let mut peer = BisPeer::new([0xff; 2], pins.clone());
+        startup(&mut peer);
+        let mut spi = Spi::new(0xfff34000, Box::new(peer));
+        let mut gpio = Gpio::new(0xfff41000, pins.clone()).unwrap();
+        let mut host = RecordingHost::default();
+        let mut cx = Cx::new(&mut host, 0, 0, 0);
+        gpio.write(&mut cx, 0xfff41300, 4, 0x00400040);
+        assert_eq!(spi.next_deadline(10), None);
+        gpio.write(&mut cx, 0xfff41300, 4, 0x00400000);
+        assert_eq!(spi.next_deadline(10), Some(10));
+        spi.advance(&mut cx);
+        assert_eq!(spi.next_deadline(10), None);
+        assert_eq!(
+            serde_json::to_value(&*pins.lock().unwrap()).unwrap()["inputs"][0],
+            0
+        );
+        let saved = spi.save()["input"].clone();
+        let mut peer = BisPeer::new([0xff; 2], pins);
+        peer.restore(&saved).unwrap();
+        assert_eq!(peer.state.sequence, 0);
+        assert!(!peer.state.ready);
+        startup(&mut peer);
+    }
+
+    #[test]
+    fn unchanged_or_unrelated_outputs_do_not_resync() {
+        use fujimod_emulator_devices::{Cx, Device, test_host::recording::RecordingHost};
+        use fujimod_emulator_ip::socionext::gpio::Gpio;
+        let pins = Pins::new([0; 16]);
+        let mut peer = BisPeer::new([0xff; 2], pins.clone());
+        let mut gpio = Gpio::new(0xfff41000, pins).unwrap();
+        let mut host = RecordingHost::default();
+        startup(&mut peer);
+        let before = peer.save();
+        for word in [0x00400000, 0x00400000, 0x00200020, 0x00200000] {
+            gpio.write(&mut Cx::new(&mut host, 0, 0, 0), 0xfff41300, 4, word);
+            assert_eq!(Input::next_deadline(&peer, 100), None);
+            Input::advance(&mut peer).unwrap();
+            assert_eq!(peer.save(), before);
+        }
+    }
+
+    #[test]
+    fn checkpoint_preserves_pending_reset_and_partial_second_sync() {
+        use fujimod_emulator_devices::{Cx, Device, test_host::recording::RecordingHost};
+        use fujimod_emulator_ip::socionext::gpio::Gpio;
+        let pins = Pins::new([0; 16]);
+        let mut peer = BisPeer::new([0xff; 2], pins.clone());
+        let mut gpio = Gpio::new(0xfff41000, pins.clone()).unwrap();
+        let mut host = RecordingHost::default();
+        startup(&mut peer);
+        for word in [0x00400040, 0x00400000] {
+            gpio.write(&mut Cx::new(&mut host, 0, 0, 0), 0xfff41300, 4, word);
+        }
+        let restored_pins = Pins::new([0; 16]);
+        *restored_pins.lock().unwrap() = pins.lock().unwrap().clone();
+        let mut resumed = BisPeer::new([0xff; 2], restored_pins.clone());
+        resumed.restore(&peer.save()).unwrap();
+        for p in [&mut peer, &mut resumed] {
+            assert_eq!(Input::next_deadline(p, 5), Some(5));
+            Input::advance(p).unwrap();
+            assert_eq!(p.exchange(8, 0, 0).unwrap(), 0);
+            assert_eq!(p.exchange(8, 0, 0).unwrap(), 0);
+        }
+        assert_eq!(peer.save(), resumed.save());
+        let mut partial = BisPeer::new([0xff; 2], restored_pins);
+        partial.restore(&resumed.save()).unwrap();
+        for p in [&mut peer, &mut resumed, &mut partial] {
+            for b in [5, 0x14] {
+                assert_eq!(p.exchange(8, b, 0).unwrap(), 0);
+            }
+            assert_eq!(frame(p, 0x08108022).unwrap(), 0x08008526);
+            assert_eq!(frame(p, 0).unwrap(), 0xffff052e);
+            assert_eq!(frame(p, 0x08008526).unwrap(), 0x08008012);
+            assert!(p.state.ready);
+            assert_eq!(p.state.sequence, 1);
+            assert_eq!(Input::next_deadline(p, 10), None);
+        }
+        assert_eq!(peer.save(), partial.save());
+    }
+
+    #[test]
+    fn legacy_checkpoint_baselines_output_without_replaying_a_reset() {
+        use fujimod_emulator_devices::{Cx, Device, test_host::recording::RecordingHost};
+        use fujimod_emulator_ip::socionext::gpio::Gpio;
+        let pins = Pins::new([0; 16]);
+        let mut peer = BisPeer::new([0xff; 2], pins.clone());
+        startup(&mut peer);
+        let mut saved = peer.save();
+        saved["state"]
+            .as_object_mut()
+            .unwrap()
+            .remove("reset_changes");
+        let mut gpio = Gpio::new(0xfff41000, pins).unwrap();
+        let mut host = RecordingHost::default();
+        gpio.write(&mut Cx::new(&mut host, 0, 0, 0), 0xfff41300, 4, 0x00400040);
+        peer.restore(&saved).unwrap();
+        assert_eq!(Input::next_deadline(&peer, 10), Some(10));
+        Input::advance(&mut peer).unwrap();
+        assert_eq!(Input::next_deadline(&peer, 10), None);
+        assert!(peer.state.ready);
+        assert_eq!(peer.state.sequence, 1);
+    }
