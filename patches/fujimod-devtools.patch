+    pub fn validate_checkpoint(&self, saved: &Saved) -> Result<(), String> {
+        if saved.models.len() != self.models.len() {
+            return Err("Checkpoint device graph differs".into());
+        }
+        for (model, saved) in self.models.iter().zip(&saved.models) {
+            match (model, saved) {
+                (None, None) => {}
+                (Some(model), Some((name, state))) if model.name() == name => {
+                    if let ModelState::Exact(exact) = state {
+                        model.validate_checkpoint(exact)?;
+                    }
+                }
+                _ => return Err("Checkpoint device graph differs".into()),
+            }
+        }
+        Ok(())
+    }
+    pub fn restore_checkpoint(&mut self, saved: &Saved) -> Result<(), String> {
+        self.validate_checkpoint(saved)?;
+        for (model, saved) in self.models.iter_mut().zip(&saved.models) {
+            if let (Some(model), Some((name, state))) = (model, saved) {
+                match state {
+                    ModelState::Exact(exact) => model.restore_checkpoint(exact),
+                    ModelState::Saved(value) => model.restore(value),
+                }
+                .map_err(|e| format!("Restore {name}: {e}"))?;
+            }
+        }
+        self.events.clone_from(&saved.events);
+        self.log.clone_from(&saved.log);
+        self.prior_records = saved.prior_records;
+        self.frames.clone_from(&saved.frames);
+        self.outputs.clone_from(&saved.outputs);
