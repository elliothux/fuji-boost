+    fn exercise(who: (usize, u64)) -> (serde_json::Value, Clock) {
+        let mut m = model();
+        let mut h = Clock {
+            now: 100,
+            ..Default::default()
+        };
+        assert_eq!(read(&mut m, &mut h, CONTROL), 0);
+        for generation in 1..=2 {
+            for value in [8, 9, 13, 15, 11, 9, 8] {
+                write_at(&mut m, &mut h, CONTROL, value, who);
+            }
+            write_at(&mut m, &mut h, STATUS, 0, who);
+            write_at(&mut m, &mut h, ARM, 0x40, who);
+            let ready = m.pending().unwrap();
+            assert_eq!(ready.generation, generation);
+            assert_eq!(ready.token, generation * 2);
+            h.now = ready.due;
+            let before = m.save();
+            let host = h.clone();
+            for _ in 0..4 {
+                assert_eq!(read(&mut m, &mut h, STATUS), 0);
+            }
+            assert_eq!(m.save(), before);
+            assert_eq!(h, host);
+            m.event(&mut Cx::new(&mut h, who.0, who.1, 0), ready.token);
+            assert_eq!(read(&mut m, &mut h, STATUS), READY);
+            write_at(&mut m, &mut h, STATUS, ACK, who);
+            let completion = m.pending().unwrap();
