diff --git a/crates/emulator-xp4-board/src/checkpoint.rs b/crates/emulator-xp4-board/src/checkpoint.rs
new file mode 100644
index 0000000..a0b47b3
--- /dev/null
+++ b/crates/emulator-xp4-board/src/checkpoint.rs
@@ -0,0 +1,276 @@
+//! Durable cluster checkpoints. A checkpoint restores into a session built by
+//! the same factory: wiring, hooks and immutable inputs are never encoded.
+//! Physical memory travels separately (`Session::checkpoint_regions`) and must
+//! be written before `restore_checkpoint`, which flushes translated code.
+use super::*;
+use serde::{Deserialize, Serialize};
+
+const SCHEMA: u32 = 1;
+
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Saved {
+    schema: u32,
+    ram_bytes: usize,
+    windows: Vec<(u64, usize)>,
+    cpus: Vec<Bytes>,
+    next_core: usize,
+    quiescent: bool,
+    run: Run,
+    devices: Option<devices::Saved>,
+}
+#[derive(Serialize, Deserialize)]
+struct Bytes(#[serde(with = "fujimod_emulator_devices::checkpoint::bytes")] Vec<u8>);
+
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Run {
+    instructions: u64,
+    ticks: u64,
+    tick_phase: u64,
+    per_core: Vec<u64>,
+    waiting: Vec<u8>,
+    events: Vec<bool>,
+    recent: Vec<VecDeque<(u32, u32)>>,
+    milestones: BTreeMap<(usize, u32), u64>,
+    discovery: Discovery,
+    failure: Option<String>,
+    redirected: Option<u32>,
+    pages: Vec<u64>,
+    cbar_reads: u64,
+    gic: Gic,
+    timer: Option<timer::Timer>,
+    irq_entries: Vec<u64>,
+    undefined_entries: Vec<u64>,
+    prefetch_aborts: Vec<u64>,
+    data_aborts: Vec<u64>,
+    abort_failure: Option<serde_json::Value>,
+    calls: Vec<Call>,
+    pending_calls: Vec<BTreeMap<u32, Vec<usize>>>,
+    exclusive: Vec<Option<(u64, usize)>>,
+    pc_observers: Vec<BTreeSet<u64>>,
+    cache_dirty: bool,
+}
+
+fn encode<T: Serialize>(value: &T) -> Result<Vec<u8>, String> {
+    let mut bytes = Vec::new();
+    ciborium::into_writer(value, &mut bytes).map_err(|e| format!("Checkpoint encode: {e}"))?;
+    Ok(bytes)
+}
+fn decode<T: serde::de::DeserializeOwned>(bytes: &[u8]) -> Result<T, String> {
+    let mut input = bytes;
+    let value = ciborium::from_reader(&mut input).map_err(|e| format!("Checkpoint decode: {e}"))?;
+    if !input.is_empty() {
+        return Err("Checkpoint has trailing bytes".into());
+    }
+    Ok(value)
+}
+
+impl Cluster {
+    fn checkpoint_boundary(&self) -> Result<(), String> {
+        let state = unsafe { &*self.state.get() };
+        if self.running.get() {
+            return Err("Checkpoint requires a stopped cluster".into());
+        }
+        if state.recorder.is_some()
+            || state.memory_watch.is_some()
+            || state.ram_write_watch.is_some()
+            || state.irq_trace.is_some()
+            || state.driver_guard.is_some()
+        {
+            return Err("Checkpoint requires no installed observation harness".into());
+        }
+        Ok(())
+    }
+}
+
+impl Session {
+    /// Physical memory backed by the session: DRAM, then declared windows.
+    pub fn checkpoint_regions(&self) -> Vec<(u64, usize)> {
+        let c = &self.inner;
+        std::iter::once((0, c.ram.len()))
+            .chain(c.memory.iter().map(|w| (w.base, w.data.len())))
+            .collect()
+    }
+    /// Read backing bytes without device access or permission checks.
+    pub fn checkpoint_read(&self, address: u64, out: &mut [u8]) -> Result<(), String> {
+        let source = self.inner.memory_pointer(address, out.len(), 0)?;
+        unsafe { std::ptr::copy_nonoverlapping(source, out.as_mut_ptr(), out.len()) };
+        Ok(())
+    }
+    /// Write backing bytes (ROM windows included) before `restore_checkpoint`.
+    pub fn checkpoint_write(&self, address: u64, bytes: &[u8]) -> Result<(), String> {
+        self.inner.checkpoint_boundary()?;
+        let target = self.inner.memory_pointer(address, bytes.len(), 0)?;
+        unsafe { std::ptr::copy_nonoverlapping(bytes.as_ptr(), target, bytes.len()) };
+        Ok(())
+    }
+    pub fn checkpoint_fill(&self, address: u64, size: usize, value: u8) -> Result<(), String> {
+        self.inner.checkpoint_boundary()?;
+        let target = self.inner.memory_pointer(address, size, 0)?;
+        unsafe { std::ptr::write_bytes(target, value, size) };
+        Ok(())
+    }
+    /// Everything except physical memory, as CBOR.
+    pub fn checkpoint(&self) -> Result<Vec<u8>, String> {
+        let c = &self.inner;
+        c.checkpoint_boundary()?;
+        c.flush_scanout();
+        let s = unsafe { &*c.state.get() };
+        let cpus = c
+            .cpus
+            .iter()
+            .map(|cpu| cpu.snapshot(None)?.export().map(Bytes))
+            .collect::<Result<_, String>>()?;
+        let run = Run {
+            instructions: s.instructions,
+            ticks: s.ticks,
+            tick_phase: s.tick_phase,
+            per_core: s.per_core.clone(),
+            waiting: s.waiting.clone(),
+            events: s.events.clone(),
+            recent: (0..c.cpus.len()).map(|core| c.recent(core)).collect(),
+            milestones: s.milestones.clone(),
+            discovery: s.discovery.clone(),
+            failure: s.failure.clone(),
+            redirected: s.redirected,
+            pages: s.pages.keys().copied().collect(),
+            cbar_reads: s.cbar_reads,
+            gic: s.gic.clone(),
+            timer: s.timer.clone(),
+            irq_entries: s.irq_entries.clone(),
+            undefined_entries: s.undefined_entries.clone(),
+            prefetch_aborts: s.prefetch_aborts.clone(),
+            data_aborts: s.data_aborts.clone(),
+            abort_failure: s.abort_failure.clone(),
+            calls: s.calls.clone(),
+            pending_calls: s.pending_calls.clone(),
+            exclusive: s.exclusive.clone(),
+            pc_observers: s.pc_observers.clone(),
+            cache_dirty: s.cache_dirty,
+        };
+        encode(&Saved {
+            schema: SCHEMA,
+            ram_bytes: c.ram.len(),
+            windows: self.checkpoint_regions()[1..].to_vec(),
+            cpus,
+            next_core: self.next_core.get(),
+            quiescent: self.quiescent.get(),
+            run,
+            devices: s.devices.as_ref().map(|d| d.checkpoint()),
+        })
+    }
+    /// Restore a checkpoint taken from a session with the same factory inputs.
+    pub fn restore_checkpoint(&self, bytes: &[u8]) -> Result<(), String> {
+        let c = &self.inner;
+        c.checkpoint_boundary()?;
+        let saved: Saved = decode(bytes)?;
+        if saved.schema != SCHEMA {
+            return Err("Unknown XP4 checkpoint schema".into());
+        }
+        if saved.ram_bytes != c.ram.len()
+            || saved.windows != self.checkpoint_regions()[1..]
+            || saved.cpus.len() != c.cpus.len()
+            || saved.run.per_core.len() != c.cpus.len()
+        {
+            return Err("Checkpoint belongs to a different board layout".into());
+        }
+        let s = unsafe { &mut *c.state.get() };
+        if saved.devices.is_some() != s.devices.is_some()
+            || saved.run.timer.is_some() != s.timer.is_some()
+        {
+            return Err("Checkpoint device graph differs".into());
+        }
+        if let (Some(devices), Some(saved)) = (&s.devices, &saved.devices) {
+            devices.validate_checkpoint(saved)?;
+        }
+        // Decode every processor before changing live state.
+        let processors = c
+            .cpus
+            .iter()
+            .zip(&saved.cpus)
+            .map(|(cpu, bytes)| cpu.import_snapshot(&bytes.0))
+            .collect::<Result<Vec<_>, _>>()?;
+        let result = (|| {
+            for &page in &saved.run.pages {
+                c.map_page(page)?;
+            }
+            let s = unsafe { &mut *c.state.get() };
+            if let (Some(devices), Some(saved)) = (&mut s.devices, &saved.devices) {
+                devices.restore_checkpoint(saved)?;
+            }
+            let Run {
+                instructions,
+                ticks,
+                tick_phase,
+                per_core,
+                waiting,
+                events,
+                recent,
+                milestones,
+                discovery,
+                failure,
+                redirected,
+                pages: _,
+                cbar_reads,
+                gic,
+                timer,
+                irq_entries,
+                undefined_entries,
+                prefetch_aborts,
+                data_aborts,
+                abort_failure,
+                calls,
+                pending_calls,
+                exclusive,
+                pc_observers,
+                cache_dirty,
+            } = saved.run;
+            let passive = s.discovery_passive;
+            s.instructions = instructions;
+            s.ticks = ticks;
+            s.tick_phase = tick_phase;
+            s.per_core = per_core;
+            s.waiting = waiting;
+            s.events = events;
+            s.recent = recent.into_iter().map(|rows| {
+                rows.into_iter().map(|(pc, word)| (execution::Span { address: u64::from(pc), instructions: 1 }, Some(word))).collect()
+            }).collect();
+            c.execution.discard_recent();
+            s.milestones = milestones;
+            s.discovery = discovery;
+            s.discovery_passive = passive;
+            s.failure = failure;
+            s.redirected = redirected;
+            s.cbar_reads = cbar_reads;
+            s.gic = gic;
+            s.timer = timer;
+            s.irq_entries = irq_entries;
+            s.undefined_entries = undefined_entries;
+            s.prefetch_aborts = prefetch_aborts;
+            s.data_aborts = data_aborts;
+            s.abort_failure = abort_failure;
+            s.calls = calls;
+            s.pending_calls = pending_calls;
+            s.exclusive = exclusive;
+            s.pc_observers = pc_observers;
+            s.cache_dirty = cache_dirty;
+            s.dma_code_ranges.clear();
+            s.device_deadline = None;
+            s.timer_deadline = None;
+            for (cpu, saved) in c.cpus.iter().zip(&processors) {
+                cpu.restore(saved.as_ref())?;
+            }
+            self.next_core.set(saved.next_core);
+            self.quiescent.set(saved.quiescent);
+            Ok::<_, String>(())
+        })();
+        if let Err(error) = &result {
+            // Never execute a partially restored cluster.
+            unsafe {
+                (*c.state.get()).failure = Some(format!("Checkpoint restore failed: {error}"))
+            };
+        }
+        result
+    }
+}
