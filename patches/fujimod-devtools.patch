+    #[test]
+    fn gpio_deadlines_follow_both_input_polarities_and_checkpoint_restore() {
+        use fujimod_emulator_devices::parts::gpio::InputIrq;
+        use fujimod_emulator_devices::test_host::TestHost;
+        use fujimod_emulator_ip::socionext::gpio::{Gpio, Pins};
+        let pins = Pins::new([0; 16]);
+        let mut gpio = Gpio::new(0xfff41000, pins.clone()).unwrap().with_input_irqs(vec![
+            InputIrq { port: 0, pin: 4, line: 171, active_high: false },
+            InputIrq { port: 0, pin: 4, line: 155, active_high: true },
+        ]).unwrap();
+        let mut host = TestHost::new();
+        assert_eq!(gpio.next_deadline(10), Some(10));
+        gpio.advance(&mut host.cx());
+        assert_eq!(gpio.next_deadline(11), None);
+        let saved = gpio.checkpoint().unwrap();
+        for high in [true, false, true] {
+            pins.lock().unwrap().set_input(0, 4, high);
+            assert_eq!(gpio.next_deadline(12), Some(12));
+            gpio.advance(&mut host.cx());
+            assert_eq!(gpio.next_deadline(13), None);
+        }
+        gpio.restore_checkpoint(&saved).unwrap();
+        assert_eq!(gpio.next_deadline(14), None);
+        pins.lock().unwrap().set_input(0, 4, true);
+        assert_eq!(gpio.next_deadline(15), Some(15));
+        assert_eq!(Gpio::new(0x10000, pins).unwrap().next_deadline(15), None);
+    }
