+            selector1_base(&mut enabled, &mut h, 0, origin);
+            write(&mut enabled, &mut h, q(0, 0x5038), 0x03204020);
+            let saved = enabled.checkpoint().unwrap();
+            let before = m.save();
+            assert!(m.restore_checkpoint(&saved).is_err());
