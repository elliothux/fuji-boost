+use super::*;
+use fujimod_emulator_devices::test_host::{TestHost, advance, write};
+
+#[derive(Default)]
+struct Sequence { sent: Vec<(u16,u64)> }
+impl Input for Sequence {
+    fn exchange(&mut self, bits:u32, tx:u16, tick:u64)->Result<u16,String> {
+        assert_eq!(bits,8);
+        let reply = 0x31 + (self.sent.len() as u16 % 16)*7;
+        self.sent.push((tx,tick));
+        Ok(reply)
+    }
+    fn save(&self)->Value { json!({"sequence":self.sent}) }
+    fn restore(&mut self,v:&Value)->Result<(),String> {
+        self.sent=serde_json::from_value(v["sequence"].clone()).map_err(|e|e.to_string())?; Ok(())
+    }
+}
+fn new()->Spi { Spi::new(0x1000,Box::<Sequence>::default()).with_dma() }
+fn configure(s:&mut Spi,h:&mut TestHost) {
+    for (o,v) in [(0,0xc7),(0x10,36),(4,0xa),(0x24,3)] { write(s,h,0x1000+o,v); }
+}
+#[test]
+fn default_off_and_byte_request_rejections_are_nonmutating() {
+    let mut strict=Spi::new(0x1000,Box::<Sequence>::default());
+    let before=strict.save(); assert!(before.get("dma").is_none());
+    assert!(strict.transmit(0,1,1).is_err()); assert_eq!(strict.save(),before);
+    let mut s=new(); let mut h=TestHost::new(); configure(&mut s,&mut h);
+    let before=s.save(); assert_eq!(s.request(Direction::Receive,false),None);
+    assert_eq!(s.request(Direction::Transmit,false),Some(0));
+    assert_eq!(s.request(Direction::Transmit,true),None);
+    assert!(s.transmit(0,2,1).is_err()); assert!(s.transmit(0,1,256).is_err());
+    assert!(s.receive(0,1).is_err()); assert_eq!(s.save(),before);
+}
+#[test]
+fn intrinsic_clock_produces_distinct_bytes_without_scheduled_events() {
+    let mut s=new(); let mut h=TestHost::new(); configure(&mut s,&mut h);
+    for byte in [1,2,3,4] { s.transmit(0,1,byte).unwrap(); }
+    assert_eq!(s.next_deadline(0),Some(288)); assert_eq!(s.request(Direction::Receive,false),None);
+    advance(&mut s,&mut h,287); assert!(s.rx.is_empty());
+    let mut replies=vec![];
+    for tick in [288,576,864,1152] {
+        advance(&mut s,&mut h,tick);
+        assert_eq!(s.request(Direction::Receive,false),Some(tick));
+        replies.push(s.receive(tick,1).unwrap());
+    }
+    assert_eq!(replies,[0x31,0x38,0x3f,0x46]);
+    assert_eq!(s.input.save(),json!({"sequence":[[1,288],[2,576],[3,864],[4,1152]]}));
+    assert_eq!(s.next_deadline(h.now),None);
+}
+#[test]
+fn receive_backpressure_stalls_clock_and_resumes_after_a_real_pop() {
+    let mut s=new(); let mut h=TestHost::new(); configure(&mut s,&mut h);
+    for byte in 0..9 { s.transmit(0,1,byte).unwrap(); }
+    assert_eq!(s.request(Direction::Transmit,false),None);
+    let before=s.save(); assert!(s.transmit(0,1,9).is_err()); assert_eq!(s.save(),before);
+    for n in 1..=8 { advance(&mut s,&mut h,n*288); }
+    assert_eq!(s.rx.len(),8); assert_eq!(s.tx.len(),1); assert!(s.pending.is_none());
+    assert_eq!(s.next_deadline(h.now),None);
+    assert_eq!(s.receive(h.now,1).unwrap(),0x31);
+    assert_eq!(s.next_deadline(h.now),Some(h.now+288));
+    advance(&mut s,&mut h,2592); assert_eq!(s.rx.len(),8);
+}
+#[test]
+fn disable_and_fifo_clear_update_requests_without_manufacturing_bytes() {
+    let mut s=new(); let mut h=TestHost::new(); configure(&mut s,&mut h);
+    s.transmit(0,1,7).unwrap(); write(&mut s,&mut h,0x1004,8);
+    assert_eq!(s.next_deadline(0),None); assert_eq!(s.request(Direction::Transmit,false),None);
+    advance(&mut s,&mut h,1000); assert!(s.rx.is_empty()); assert_eq!(s.input.save(),json!({"sequence":[]}));
+    write(&mut s,&mut h,0x1004,0xa); s.transmit(h.now,1,9).unwrap();
+    advance(&mut s,&mut h,1288); write(&mut s,&mut h,0x1020,2);
+    assert_eq!(s.request(Direction::Receive,false),None);
+    write(&mut s,&mut h,0x1024,0); assert_eq!(s.request(Direction::Transmit,false),None);
+}
+#[test]
+fn mid_frame_restore_keeps_clock_peer_and_request_identity() {
+    let mut a=new(); let mut h=TestHost::new(); configure(&mut a,&mut h);
+    for byte in [7,8,9] { a.transmit(0,1,byte).unwrap(); }
+    advance(&mut a,&mut h,288); let saved=a.save();
+    let mut b=new(); b.restore(&saved).unwrap(); assert_eq!(b.save(),saved);
+    for tick in [576,864] { advance(&mut a,&mut h,tick); advance(&mut b,&mut h,tick); }
+    assert_eq!(a.save(),b.save());
+    let mut strict=Spi::new(0x1000,Box::<Sequence>::default()); assert!(strict.restore(&saved).is_err());
+    assert!(new().restore(&strict.save()).is_err());
+}
+#[test]
+fn malformed_requests_or_fifo_checkpoint_do_not_mutate_live_state() {
+    let mut s=new(); let mut h=TestHost::new(); configure(&mut s,&mut h); let before=s.save();
+    for (field,value) in [("rx",json!([256])),("tx",json!(vec![0;9])),("unknown",json!(1))] {
