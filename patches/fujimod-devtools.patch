+/// Access kinds are static labels; restored ledgers reuse one copy of each.
+mod interned {
+    use serde::{Deserialize, Deserializer, Serializer};
+    use std::{collections::BTreeSet, sync::Mutex};
+    // An alias keeps Serde from treating the label as borrowed input.
+    pub type Kind = &'static str;
+    static KINDS: Mutex<BTreeSet<&'static str>> = Mutex::new(BTreeSet::new());
+    pub fn serialize<S: Serializer>(kind: &&'static str, serializer: S) -> Result<S::Ok, S::Error> {
+        serializer.serialize_str(kind)
+    }
+    pub fn deserialize<'de, D: Deserializer<'de>>(deserializer: D) -> Result<&'static str, D::Error> {
+        let kind = String::deserialize(deserializer)?;
+        let mut kinds = KINDS.lock().unwrap_or_else(|e| e.into_inner());
+        Ok(match kinds.get(kind.as_str()) {
+            Some(&known) => known,
+            None => {
+                let leaked: &'static str = Box::leak(kind.into_boxed_str());
+                kinds.insert(leaked);
+                leaked
+            }
+        })
+    }
+}
