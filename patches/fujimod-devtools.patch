+        fn reference_packed(mut color: [u8; 4], r: &Bank, gamma: &[u8], order: u32) -> Result<[u8; 4], String> {
+            if get(r, 0x184)? & 0x1000000 != 0 {
+                // The blend descriptor packs four signed Q7 scales followed by four byte-space
+                // Q7 biases, two coefficients per register180..183.
+                for (n, channel) in color.iter_mut().enumerate() {
+                    let shift = (n % 2) * 16;
+                    let scale = (get(r, 0x180 + (n / 2) as u16)? >> shift) as i16 as i32;
+                    let bias = (get(r, 0x182 + (n / 2) as u16)? >> shift) as i16 as i32;
+                    *channel = ((i32::from(*channel) * scale + bias + 64) >> 7).clamp(0, 255) as u8;
+                }
+            }
+            if get(r, 0x184)? & 0x10000 != 0 {
+                for c in &mut color[..3] {
+                    *c = gamma[*c as usize];
+                }
+            }
+            if order & 0x100 == 0 {
+                let alpha = color[3] as u32;
+                for c in &mut color[..3] {
+                    let v = *c as u32 * alpha + 128;
+                    *c = ((v + (v >> 8)) >> 8) as u8;
+                }
+            }
+            Ok(if order >> 24 == 1 {
+                color
+            } else {
+                [color[3], color[2], color[1], color[0]]
+            })
+        }
+        let gamma: Vec<u8> = (0..=255).rev().collect();
+        for transform in [None, Some([(128, 0), (-128, 32767), (32767, -32768), (0, 64)])] {
+            let mut regs = Bank::new();
+            if let Some(transform) = transform {
+                for n in 0..2 {
+                    regs.insert(0x180 + n as u16, u32::from(transform[2*n].0 as u16) | (u32::from(transform[2*n+1].0 as u16) << 16));
+                    regs.insert(0x182 + n as u16, u32::from(transform[2*n].1 as u16) | (u32::from(transform[2*n+1].1 as u16) << 16));
+                }
+            }
+            for use_gamma in [false, true] {
+                regs.insert(0x184, if transform.is_some() { 0x1000000 } else { 0 } | if use_gamma { 0x10000 } else { 0 });
+                for order in [0, 0x100, 0x1000000, 0x1000100] {
+                    for value in 0..=255u8 {
+                        for alpha in [0, 1, 127, 254, 255] {
+                            let color = [value, value.wrapping_add(57), 255-value, alpha];
+                            assert_eq!(packed(color, transform, use_gamma.then_some(gamma.as_slice()), order), reference_packed(color, &regs, &gamma, order).unwrap());
+                        }
+                    }
+                }
+            }
+        }
+    }
