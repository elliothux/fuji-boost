+                        let state = match m.checkpoint() {
+                            Ok(exact) => ModelState::Exact(exact),
+                            Err(_) => ModelState::Saved(m.save()),
+                        };
+                        (m.name().to_owned(), state)
+                    })
+                })
+                .collect(),
+            events: self.events.clone(),
+            log: self.log.clone(),
+            prior_records: self.prior_records,
+            frames: self.frames.clone(),
+            outputs: self.outputs.clone(),
+        }
