+//! One explicit FA ready/acknowledgment fixture; no physical function or IRQ law.
+use fujimod_emulator_devices::{Cx, Device, Record, Value as Field, checkpoint::Checkpoint};
+use serde::{Deserialize, Serialize};
+
+const NAME: &str = "xp4-fa-ready-fixture";
+pub const STATUS: u64 = 0xfa000000;
+pub const ARM: u64 = 0xfa00001c;
+const TOKEN: u64 = 1;
+const READY: u64 = 0x10000;
+const ACK: u64 = READY | 1;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Request {
+    started: u64,
+    due: u64,
+    token: u64,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+enum Stage {
+    Cold,
+    Initialized,
+    Pending(Request),
+    Ready(Request),
+    Done(Request),
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct State {
+    ticks: u64,
+    source_sha256: String,
+    stage: Stage,
+}
+
+pub struct FaReadyFixture {
+    state: State,
+}
+
+impl FaReadyFixture {
+    pub fn new(ticks: u64, source_sha256: String) -> Result<Self, String> {
+        if !(1..=1_000_000).contains(&ticks)
+            || source_sha256.len() != 64
+            || !source_sha256
+                .bytes()
+                .all(|v| v.is_ascii_digit() || (b'a'..=b'f').contains(&v))
+        {
+            return Err("Invalid FA ready fixture latency/source identity".into());
+        }
+        Ok(Self {
+            state: State {
+                ticks,
+                source_sha256,
+                stage: Stage::Cold,
+            },
+        })
+    }
+
+    fn status(&self) -> u64 {
+        match self.state.stage {
+            Stage::Cold | Stage::Initialized | Stage::Pending(_) => 0,
+            Stage::Ready(_) => READY,
+            Stage::Done(_) => ACK,
+        }
+    }
+
+    fn validate_state(&self, state: &State) -> Result<(), String> {
+        if state.ticks != self.state.ticks || state.source_sha256 != self.state.source_sha256 {
+            return Err("FA ready checkpoint configuration differs".into());
+        }
+        if let Stage::Pending(r) | Stage::Ready(r) | Stage::Done(r) = state.stage {
+            if r.token != TOKEN || r.started.checked_add(state.ticks) != Some(r.due) {
+                return Err("Invalid FA ready checkpoint request/deadline".into());
+            }
+        }
+        Ok(())
+    }
+}
+
+impl Device for FaReadyFixture {
+    fn name(&self) -> &'static str {
+        NAME
+    }
+
+    fn read(&mut self, cx: &mut Cx<'_>, address: u64, size: u8) -> u64 {
+        if address == STATUS && size == 4 {
+            return self.status();
+        }
+        cx.fail("Unsupported FA ready fixture read");
+        0
+    }
+
+    fn write(&mut self, cx: &mut Cx<'_>, address: u64, size: u8, value: u64) {
+        if size != 4 {
+            cx.fail("FA ready fixture requires exact words");
+            return;
+        }
+        let next = match (self.state.stage, address, value) {
+            (Stage::Cold, STATUS, 0) => Stage::Initialized,
+            (Stage::Initialized, ARM, 0x40) => {
+                let Some(due) = cx.now().checked_add(self.state.ticks) else {
+                    cx.fail("FA ready fixture deadline overflow");
+                    return;
+                };
+                Stage::Pending(Request {
+                    started: cx.now(),
+                    due,
+                    token: TOKEN,
+                })
+            }
+            (Stage::Ready(request), STATUS, ACK) => Stage::Done(request),
+            _ => {
+                cx.fail("Unsupported FA ready fixture sequence/value/reentry");
+                return;
+            }
+        };
+        self.state.stage = next;
+        if let Stage::Pending(request) = next {
+            cx.schedule(request.due, request.token);
+            cx.record(Record::new(
+                "XP4 FA ready fixture scheduled",
+                [
+                    ("address", Field::int(ARM)),
+                    ("command", Field::int(0x40u32)),
+                    ("tick", Field::int(request.started)),
+                    ("due", Field::int(request.due)),
+                ],
+            ));
+        }
+    }
+
+    fn event(&mut self, cx: &mut Cx<'_>, token: u64) {
+        let Stage::Pending(request) = self.state.stage else {
+            return;
+        };
+        if token != TOKEN || cx.now() < request.due {
+            return;
+        }
+        self.state.stage = Stage::Ready(request);
+        cx.record(Record::new(
+            "XP4 FA ready fixture completed",
+            [
+                ("address", Field::int(STATUS)),
+                ("value", Field::int(READY)),
+                ("tick", Field::int(request.due)),
+            ],
+        ));
+    }
+
+    fn advance(&mut self, cx: &mut Cx<'_>) {
+        self.event(cx, TOKEN);
+    }
+
+    fn next_deadline(&self, _: u64) -> Option<u64> {
+        match self.state.stage {
+            Stage::Pending(request) => Some(request.due),
+            _ => None,
+        }
+    }
+
+    fn pollable(&self, address: u64, size: u8) -> bool {
+        address == STATUS && size == 4
+    }
+
+    fn save(&self) -> serde_json::Value {
+        serde_json::to_value(&self.state).unwrap()
+    }
+
+    fn checkpoint(&self) -> Result<Checkpoint, String> {
+        Checkpoint::encode(NAME, &self.state)
+    }
+
+    fn validate_checkpoint(&self, saved: &Checkpoint) -> Result<(), String> {
+        if !saved.blobs().is_empty() || !saved.children().is_empty() {
+            return Err("Unexpected FA ready checkpoint attachments".into());
+        }
+        self.validate_state(&saved.decode(NAME)?)
+    }
+
+    fn restore_checkpoint(&mut self, saved: &Checkpoint) -> Result<(), String> {
+        self.validate_checkpoint(saved)?;
+        self.state = saved.decode(NAME)?;
+        Ok(())
+    }
+
+    fn fingerprint(&self) -> Result<serde_json::Value, String> {
+        Ok(self.save())
+    }
+}
