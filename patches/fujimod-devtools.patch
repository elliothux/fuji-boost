+                4 => c.selector1_source_sha256 = Some("a".repeat(65)),
+                5 => c.selector1_source_sha256 = Some("AB".repeat(32)),
+                _ => c.selector1_source_sha256 = Some("gg".repeat(32)),
+            }
+            assert!(BankedCalibration::new(c).is_err(), "config {bad}");
+        }
+        // This cold-origin configuration intentionally has no reprogram/post path at all.
+        let mut c = mode2_config();
+        c.selector1_source_sha256 = Some("ab12".repeat(16));
+        let mut m = BankedCalibration::new(c).unwrap();
+        let mut h = TestHost::new();
+        selector1_base(&mut m, &mut h, 0, false);
