diff --git a/crates/emulator-cpu-unicorn/src/io_section_tests.rs b/crates/emulator-cpu-unicorn/src/io_section_tests.rs
new file mode 100644
index 0000000..5709a5b
--- /dev/null
+++ b/crates/emulator-cpu-unicorn/src/io_section_tests.rs
@@ -0,0 +1,201 @@
+use super::*;
+
+struct Engine {
+    api: ffi::Api,
+    raw: ffi::Engine,
+}
+impl Drop for Engine {
+    fn drop(&mut self) {
+        unsafe {
+            (self.api.uc_close)(self.raw);
+        }
+    }
+}
+struct Probe {
+    region: usize,
+    calls: *mut Vec<(usize, u64, u32)>,
+}
+unsafe extern "C" fn read(_: ffi::Engine, offset: u64, size: u32, data: *mut c_void) -> u64 {
+    let probe = unsafe { &*data.cast::<Probe>() };
+    unsafe { &mut *probe.calls }.push((probe.region, offset, size));
+    0x60000000 + probe.region as u64
+}
+
+fn exercise(page_size: u32, regions: usize) -> serde_json::Value {
+    let api = ffi::Api::linked().unwrap();
+    let mut raw = std::ptr::null_mut();
+    assert_eq!(unsafe { (api.uc_open)(1, 0, &mut raw) }, 0);
+    let cpu = Engine { api, raw };
+    let get = cpu.api.extensions.arm32_dispatch_info.unwrap();
+    let mut not_ready = ffi::DispatchInfo {
+        page_bits: 123,
+        ..Default::default()
+    };
+    assert_ne!(
+        unsafe {
+            get(
+                raw,
+                0,
+                &mut not_ready,
+                std::mem::size_of::<ffi::DispatchInfo>() as u32,
+            )
+        },
+        0
+    );
+    assert_eq!(not_ready.page_bits, 123);
+    assert_eq!(
+        unsafe { (cpu.api.uc_ctl)(raw, ffi::ctl(1, 1, 1), page_size) },
+        0
+    );
+    assert_eq!(
+        unsafe { (cpu.api.uc_ctl)(raw, ffi::ctl(7, 1, 1), 14i32) },
+        0
+    );
+    assert_eq!(unsafe { (cpu.api.uc_mem_map)(raw, 0x1000, 4096, 7) }, 0);
+    let instruction = 0xe591000cu32.to_le_bytes();
+    assert_eq!(
+        unsafe { (cpu.api.uc_mem_write)(raw, 0x1000, instruction.as_ptr().cast(), 4) },
+        0
+    );
+    let mut calls = Vec::new();
+    let mut probes = Vec::new();
+    for region in 0..regions {
+        let mut probe = Box::new(Probe {
+            region,
+            calls: &mut calls,
+        });
+        let address = 0x40000000 + region as u64 * 0x2000;
+        assert_eq!(
+            unsafe {
+                (cpu.api.uc_mmio_map)(
+                    raw,
+                    address,
+                    4096,
+                    read as *mut c_void,
+                    (&mut *probe as *mut Probe).cast(),
+                    std::ptr::null_mut(),
+                    std::ptr::null_mut(),
+                )
+            },
+            0
+        );
+        probes.push(probe);
+    }
+    let mut info = ffi::DispatchInfo::default();
+    assert_eq!(
+        unsafe {
+            get(
+                raw,
+                0,
+                &mut info,
+                std::mem::size_of::<ffi::DispatchInfo>() as u32,
+            )
+        },
+        0
+    );
+    assert_eq!(1u32 << info.page_bits, page_size);
+    assert_eq!(std::mem::size_of::<ffi::DispatchInfo>(), 24);
+    let before = (
+        info.page_mask,
+        info.page_bits,
+        info.sections,
+        info.address_spaces,
+        info.address_space,
+    );
+    assert_ne!(
+        unsafe {
+            get(
+                raw,
+                u32::MAX,
+                &mut info,
+                std::mem::size_of::<ffi::DispatchInfo>() as u32,
+            )
+        },
+        0
+    );
+    assert_eq!(
+        (
+            info.page_mask,
+            info.page_bits,
+            info.sections,
+            info.address_spaces,
+            info.address_space
+        ),
+        before
+    );
+    assert_ne!(unsafe { get(raw, 0, &mut info, 0) }, 0);
+    assert_eq!(
+        (
+            info.page_mask,
+            info.page_bits,
+            info.sections,
+            info.address_spaces,
+            info.address_space
+        ),
+        before
+    );
+    let base = (0x40000000u64 + (regions - 1) as u64 * 0x2000) as u32;
+    assert_eq!(
+        unsafe { (cpu.api.uc_reg_write)(raw, 67, base.to_le_bytes().as_ptr().cast()) },
+        0
+    );
+    assert_eq!(
+        unsafe { (cpu.api.uc_emu_start)(raw, 0x1000, 0x1004, 0, 1) },
+        0
+    );
+    let mut r0 = 0u32;
+    assert_eq!(
+        unsafe { (cpu.api.uc_reg_read)(raw, 66, (&mut r0 as *mut u32).cast()) },
+        0
+    );
+    let result = serde_json::json!({"pageSize":page_size,"sections":info.sections,
+        "encodingCapacity":1u64<<info.page_bits,"requestedRegion":regions-1,
+        "calls":calls,"r0":r0});
+    println!("{result}");
+    // Keep native callback storage alive until the engine has closed.
+    drop(cpu);
+    drop(probes);
+    result
+}
+
+#[test]
+fn a7_4k_page_capacity_preserves_region_and_offset_across_1100_maps() {
+    let result = exercise(4096, 1100);
+    assert!(result["sections"].as_u64().unwrap() > 1024);
+    assert!(result["sections"].as_u64().unwrap() <= 4096);
+    assert_eq!(result["calls"], serde_json::json!([[1099, 12, 4]]));
+    assert_eq!(result["r0"], 0x60000000u32 + 1099);
+}
+
+#[test]
+fn dispatch_getter_keeps_a7_4k_r5f_1k_pages_and_paused_registers() {
+    let library = test_support::library();
+    for (model, bits) in [(Model::CortexA7, 12), (Model::CortexR5F, 10)] {
+        let cpu = library.open(model, 4 * 1024 * 1024).unwrap();
+        cpu.map_zeroed(0x1000, 4096, 7).unwrap();
+        let mut before = [0; 4];
+        cpu.read_register(arm::PC, &mut before).unwrap();
+        let info = cpu.physical_dispatch_info(0).unwrap().unwrap();
+        assert_eq!(info["pageBits"], bits);
+        assert_eq!(info["encodingCapacity"], 1u64 << bits);
+        assert!(cpu.physical_dispatch_info(u32::MAX).is_err());
+        let mut after = [0; 4];
+        cpu.read_register(arm::PC, &mut after).unwrap();
+        assert_eq!(before, after);
+        assert_eq!(cpu.mmio_callback_context(), None);
+    }
+}
+
+// Release matches the Wasm build where NDEBUG removes the section-bound assert.
+#[cfg(not(debug_assertions))]
+#[test]
+fn legacy_1k_overflow_selects_another_region_and_adds_0x400() {
+    let result = exercise(1024, 1100);
+    assert!(result["sections"].as_u64().unwrap() > 1024);
+    let calls = result["calls"].as_array().unwrap();
+    assert_eq!(calls.len(), 1);
+    assert_ne!(calls[0][0], 1099);
+    assert_eq!(calls[0][1], 0x40c);
+    assert_eq!(calls[0][2], 4);
+    assert_ne!(result["r0"], 0x60000000u32 + 1099);
+}
