+            write_at(&mut m, &mut h, CONTROL, 8, who);
+            assert_eq!(read(&mut m, &mut h, STATUS), ACK);
+            assert_eq!(h.irqs.len(), ((generation - 1) * 2) as usize);
+            h.now = completion.due;
+            let before = m.save();
+            for token in [ready.token, completion.token - 2] {
+                m.event(&mut Cx::new(&mut h, who.0, who.1, 0), token);
+            }
+            assert_eq!(m.save(), before);
+            assert_eq!(read(&mut m, &mut h, STATUS), ACK);
+            m.advance(&mut Cx::new(&mut h, who.0, who.1, 0));
+            assert_eq!(h.irqs.last(), Some(&(IRQ, true)));
+            assert_eq!(read(&mut m, &mut h, CONTROL), 8);
+            assert_eq!(read(&mut m, &mut h, STATUS), ACK);
+            write_at(&mut m, &mut h, CONTROL, 8, who); // Same value, not an edge.
+            assert_eq!(h.irqs.last(), Some(&(IRQ, false))); // Before the trailing clear / EOI.
+            assert_eq!(read(&mut m, &mut h, STATUS), READY);
+            write_at(&mut m, &mut h, CONTROL, 0, who);
+            assert!(matches!(m.state.stage, Stage::Done(_)));
+            assert_eq!(m.next_deadline(h.now), None);
+            let done = m.save();
