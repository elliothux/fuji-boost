new file mode 100644
index 0000000..a28baf2
--- /dev/null
+++ b/crates/emulator-xp4-io/src/uart_sink.rs
@@ -0,0 +1,140 @@
+//! Bluetooth UART1: PL011 register/idle subset, with no attached receiver.
+//! UNMEASURED FUNCTIONAL ASSUMPTION: CTS is asserted and TX drains synchronously; no RF peer or timing is measured.
+use fujimod_emulator_devices::{Cx, Device};
+use serde::{Deserialize, Serialize};
+
+pub const BASE: u64 = 0xfff3a000;
+
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct State {
+    regs: [u32; 19],
+    transmitted: u64,
+}
+pub struct UartSink {
+    state: State,
+}
+impl Default for UartSink {
+    fn default() -> Self {
+        let mut regs = [0; 19];
+        regs[0x30 / 4] = 0x300;
+        regs[0x34 / 4] = 0x12;
+        Self {
+            state: State {
+                regs,
+                transmitted: 0,
+            },
+        }
+    }
+}
+impl UartSink {
+    fn mask(offset: usize) -> Option<u32> {
+        match offset {
+            0x20 | 0x2c => Some(0xff),
+            0x24 => Some(0xffff),
+            0x30 => Some(0xff87),
+            0x28 | 0x34 => Some(0x3f),
+            0x38 => Some(0x7ff),
+            0x48 => Some(0), // DMA is not connected in this subset.
+            _ => None,
+        }
+    }
+    fn access(&mut self, address: u64, size: u8, value: Option<u64>) -> Result<u64, String> {
+        let offset = address.wrapping_sub(BASE) as usize;
+        if size != 4 || offset > 0x48 || offset & 3 != 0 {
+            return Err("Unsupported Bluetooth UART access".into());
+        }
+        if let Some(value) = value {
+            match offset {
+                0 if value <= 255 => {
+                    self.state.transmitted = self
+                        .state
+                        .transmitted
+                        .checked_add(1)
+                        .ok_or("Bluetooth UART TX counter overflow")?;
+                }
+                4 if value <= 0xf => {}      // No receive errors to clear.
+                0x44 if value <= 0x7ff => {} // No interrupts to clear.
+                _ => {
+                    let mask = Self::mask(offset).ok_or("Unsupported Bluetooth UART write")?;
+                    if value & !u64::from(mask) != 0 {
+                        return Err("Unsupported Bluetooth UART register bits/DMA".into());
+                    }
+                    self.state.regs[offset / 4] = value as u32;
+                }
+            }
+            return Ok(0);
+        }
+        match offset {
+            0 => Err("Bluetooth UART receive FIFO is empty".into()),
+            4 | 0x3c | 0x40 => Ok(0),
+            // ARM DDI0183: TXFE=bit7, RXFE=bit4, BUSY/TXFF=0; the virtual sink asserts CTS.
+            // X-T4 011a3ef4 polls (FR & 0x88)==0x80 after its four-byte HCI reset.
+            0x18 => Ok(0x91),
+            _ if Self::mask(offset).is_some() => Ok(self.state.regs[offset / 4].into()),
+            _ => Err("Unsupported Bluetooth UART read".into()),
+        }
+    }
+}
+impl Device for UartSink {
+    fn name(&self) -> &'static str {
+        "xp4-bluetooth-uart-sink"
+    }
+    fn read(&mut self, cx: &mut Cx<'_>, address: u64, size: u8) -> u64 {
+        match self.access(address, size, None) {
+            Ok(value) => value,
+            Err(error) => {
+                cx.fail(error);
+                0
+            }
+        }
+    }
+    fn write(&mut self, cx: &mut Cx<'_>, address: u64, size: u8, value: u64) {
+        if let Err(error) = self.access(address, size, Some(value)) {
+            cx.fail(error);
+        }
+    }
+    fn save(&self) -> serde_json::Value {
+        serde_json::to_value(&self.state).unwrap()
+    }
+    fn restore(&mut self, value: &serde_json::Value) -> Result<(), String> {
+        let state: State = serde_json::from_value(value.clone()).map_err(|e| e.to_string())?;
+        if state
+            .regs
+            .iter()
+            .enumerate()
+            .any(|(i, value)| value & !Self::mask(i * 4).unwrap_or(0) != 0)
+        {
+            return Err("Invalid Bluetooth UART checkpoint".into());
+        }
+        self.state = state;
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn idle_tx_sink_has_no_received_data_and_restores_atomically() {
+        let mut uart = UartSink::default();
+        assert_eq!(uart.access(BASE + 0x18, 4, None).unwrap(), 0x91);
+        for byte in [1, 3, 12, 0] {
+            uart.access(BASE, 4, Some(byte)).unwrap();
+        }
+        uart.access(BASE + 0x30, 4, Some(0x301)).unwrap();
+        assert_eq!(uart.state.transmitted, 4);
+        assert!(uart.access(BASE, 4, None).is_err());
+        assert!(uart.access(BASE, 4, Some(256)).is_err());
+        assert!(uart.access(BASE + 0x18, 1, None).is_err());
+        assert!(uart.access(BASE + 0x48, 4, Some(1)).is_err());
+        let saved = uart.save();
+        let mut restored = UartSink::default();
+        restored.restore(&saved).unwrap();
+        assert_eq!(restored.save(), saved);
+        let mut invalid = saved.clone();
+        invalid["regs"][6] = 1.into();
+        assert!(restored.restore(&invalid).is_err());
+        assert_eq!(restored.save(), saved);
+    }
+}
