+#[test]
+fn a_reasserted_request_waits_a_fresh_word_clock_even_before_the_old_deadline() {
+    for observe_withdrawal in [false, true] {
+        let (mut d, wire, mut h) = fixture(16);
+        configure(&mut d, &mut h, 1024, 64, 0);
+        wire.lock().unwrap().since = Some(0);
+        submit(&mut d, &mut h).unwrap();
+        step(&mut d, &mut h).unwrap();
+        h.now = 1;
+        if observe_withdrawal {
+            wire.lock().unwrap().since = None;
+            d.advance(&mut h.cx());
+        }
+        wire.lock().unwrap().since = Some(1);
+        d.advance(&mut h.cx());
+        assert_eq!(d.next_deadline(h.now), Some(2));
+        h.now = 1;
+        d.advance(&mut h.cx());
+        assert_eq!(wire.lock().unwrap().pops, 0);
+        h.now = 2;
+        d.advance(&mut h.cx());
+        assert_eq!(wire.lock().unwrap().pops, 1);
+    }
+}
