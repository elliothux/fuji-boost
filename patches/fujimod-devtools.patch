+                    assert_eq!(pending.action, Action::Removal);
+                    assert_eq!(pending.token, generation + 1);
+                    assert_eq!(pending.due, h.now + 8);
+                    let at = h.now + 7;
+                    advance(&mut restored, &mut h, at);
+                    assert_eq!(restored.save(), m.save());
+                    let at = h.now + 1;
+                    advance(&mut restored, &mut h, at);
+                    advance(&mut m, &mut h, at);
+                    assert_eq!(restored.save(), m.save());
+                    assert_eq!(m.state.units[unit].stage, Stage::Removed);
+                    m.validate_checkpoint(&m.checkpoint().unwrap()).unwrap();
+                }
+            }
+            for bad in 0..5 {
