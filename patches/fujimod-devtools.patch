+#[test]
+fn withdrawal_cancel_and_mux_guard_preserve_unconsumed_words() {
+    let (mut d, wire, mut h) = fixture(16);
+    configure(&mut d, &mut h, 1024, 64, 0);
+    wire.lock().unwrap().since = Some(0);
+    submit(&mut d, &mut h).unwrap();
+    step(&mut d, &mut h).unwrap();
+    wire.lock().unwrap().since = None;
+    step(&mut d, &mut h).unwrap();
+    assert_eq!(wire.lock().unwrap().pops, 0);
+    assert_eq!(d.next_deadline(h.now), None);
+    let before = d.save();
+    for value in [0x10000000, 0x10201011] {
+        assert!(write(&mut d, &mut h, DMA + 0x4028, value).is_err());
+        assert_eq!(d.save(), before);
+    }
+    assert!(write(&mut d, &mut h, 0xfff4a508, 0x1001d).is_err());
+    assert_eq!(d.save(), before);
+    wire.lock().unwrap().since = Some(h.now);
+    step(&mut d, &mut h).unwrap();
+    step(&mut d, &mut h).unwrap();
+    assert_eq!(wire.lock().unwrap().pops, 1);
+    write(&mut d, &mut h, DMA + 0x4028, 0).unwrap();
+    assert!(d.channels[4].linked.is_none());
+    assert_eq!(d.next_deadline(h.now), None);
+    assert_eq!(wire.lock().unwrap().data.len(), 15);
+    assert_eq!(d.channels[4].completed, 0);
+}
