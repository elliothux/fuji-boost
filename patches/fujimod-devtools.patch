new file mode 100644
index 0000000..fff656d
--- /dev/null
+++ b/crates/emulator-xp4-io/src/touch_i2c.rs
@@ -0,0 +1,639 @@
+//! XP4 F_I2C master with the X-T4 rear touch panel as its only target.
+//! The byte registers use the Fujitsu F_I2C layout (Linux i2c-synquacer):
+//! BSR +0, BCR +4, CCR +8, ADR +c, DAR +10, CSR +14, FSR +18, BC2R +1c.
+//! Stock 2.12 drives the panel on unit 2 (0xfff3f000, GIC67) at 7-bit
+//! address 0x55 and takes its INT on GIC153.
+//!
+//! Panel registers, as read by the stock driver: 0x10 gives two bytes
+//! (record count, status); 0x11 streams two seven-byte records
+//! `state, x_lo, x_hi, y_lo, y_hi, 0, 0`, where state bit 7 means touching
+//! and the low nibble is the finger id. Reading 0x10 latches the report and
+//! releases INT. 0x12 is a scan counter the stock watchdog expects to move.
+//! Other registers are plain storage with auto-increment.
+use fujimod_emulator_devices::{Cx, Device};
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+
+const BSR_BB: u8 = 0x80;
+const BSR_LRB: u8 = 0x10;
+const BSR_TRX: u8 = 0x08;
+const BSR_FBT: u8 = 0x01;
+const BCR_SCC: u8 = 0x20;
+const BCR_MSS: u8 = 0x10;
+const BCR_ACK: u8 = 0x08;
+const BCR_INTE: u8 = 0x02;
+const BCR_INT: u8 = 0x01;
+const CCR_EN: u8 = 0x20;
+const PANEL_ADDRESS: u8 = 0x55;
+const REPORT: u8 = 0x10;
+const RECORDS: u8 = 0x11;
+/// Counts scan periods. Stock re-reads it every few watchdog ticks and resets
+/// the chip when the value has not moved.
+const HEARTBEAT: u8 = 0x12;
+const RECORD_BYTES: usize = 7;
+pub const CONTACTS: usize = 2;
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+pub struct Config {
+    pub base: u64,
+    pub irq: u32,
+    pub touch_irq: u32,
+    pub byte_ticks: u64,
+    pub report_ticks: u64,
+    pub width: u16,
+    pub height: u16,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+pub struct Contact {
+    pub x: u16,
+    pub y: u16,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+enum Step {
+    Address,
+    Transmit,
+    Receive { ack: bool },
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+struct Bus {
+    bsr: u8,
+    bcr: u8,
+    ccr: u8,
+    adr: u8,
+    dar: u8,
+    csr: u8,
+    fsr: u8,
+    bc2r: u8,
+    step: Option<(u64, Step)>,
+    addressed: bool,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+struct Panel {
+    registers: Vec<u8>,
+    pointer: u8,
+    expect_pointer: bool,
+    offset: usize,
+    contacts: [Option<Contact>; CONTACTS],
+    /// Last down position of each slot since the previous report.
+    pressed: [Option<Contact>; CONTACTS],
+    reported: [Option<Contact>; CONTACTS],
+    report: [u8; 2],
+    records: Vec<u8>,
+    cursor: usize,
+    interrupt: bool,
+    next_report: Option<u64>,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+struct State {
+    bus: Bus,
+    panel: Panel,
+}
+
+pub struct TouchI2c {
+    config: Config,
+    state: State,
+}
+
+impl Panel {
+    fn new() -> Self {
+        Self {
+            registers: vec![0; 256],
+            pointer: 0,
+            expect_pointer: false,
+            offset: 0,
+            contacts: [None; CONTACTS],
+            pressed: [None; CONTACTS],
+            reported: [None; CONTACTS],
+            report: [0; 2],
+            records: vec![0; RECORD_BYTES * CONTACTS],
+            cursor: 0,
+            interrupt: false,
+            next_report: None,
+        }
+    }
+    fn start(&mut self, read: bool, now: u64, report_ticks: u64) {
+        self.offset = 0;
+        self.expect_pointer = !read;
+        self.registers[HEARTBEAT as usize] = (now / report_ticks) as u8;
+        if read && self.pointer == REPORT {
+            self.latch(now, report_ticks);
+        }
+    }
+    /// Touching contacts, then contacts released since the last report. A
+    /// press that ended before any report is still reported down once, so
+    /// every press yields a down and an up record.
+    fn latch(&mut self, now: u64, report_ticks: u64) {
+        let mut records = Vec::with_capacity(RECORD_BYTES * CONTACTS);
+        let mut reported = self.contacts;
+        for slot in 0..CONTACTS {
+            let unreported = self.reported[slot]
+                .is_none()
+                .then_some(self.pressed[slot])
+                .flatten();
+            let (state, contact) = match (self.contacts[slot].or(unreported), self.reported[slot]) {
+                (Some(contact), _) => {
+                    reported[slot] = Some(contact);
+                    (0x80 | (slot as u8 + 1), contact)
+                }
+                (None, Some(contact)) => (slot as u8 + 1, contact),
+                (None, None) => continue,
+            };
+            let [x_lo, x_hi] = contact.x.to_le_bytes();
+            let [y_lo, y_hi] = contact.y.to_le_bytes();
+            records.extend_from_slice(&[state, x_lo, x_hi, y_lo, y_hi, 0, 0]);
+        }
+        self.report = [(records.len() / RECORD_BYTES) as u8, 0];
+        records.resize(RECORD_BYTES * CONTACTS, 0);
+        self.records = records;
+        self.cursor = 0;
+        self.reported = reported;
+        self.pressed = [None; CONTACTS];
+        self.interrupt = false;
+        if self.reported != self.contacts && self.next_report.is_none() {
+            self.next_report = Some(now + report_ticks);
+        }
+    }
+    fn write(&mut self, byte: u8) {
+        if self.expect_pointer {
+            self.pointer = byte;
+            self.expect_pointer = false;
+        } else {
+            self.registers[self.pointer as usize] = byte;
+            self.pointer = self.pointer.wrapping_add(1);
+        }
+    }
+    fn read(&mut self) -> u8 {
+        let offset = self.offset;
+        self.offset += 1;
+        match self.pointer {
+            REPORT => self.report.get(offset).copied().unwrap_or(0),
+            RECORDS => {
+                let byte = self.records.get(self.cursor).copied().unwrap_or(0);
+                self.cursor += 1;
+                byte
+            }
+            pointer => {
+                self.pointer = pointer.wrapping_add(1);
+                self.registers[pointer as usize]
+            }
+        }
+    }
+    fn touching(&self) -> bool {
+        self.contacts.iter().any(Option::is_some)
+    }
+}
+
+impl TouchI2c {
+    pub fn new(config: Config) -> Result<Self, String> {
+        if config.base & 0xfff != 0
+            || config.irq >= 512
+            || config.touch_irq >= 512
+            || config.irq == config.touch_irq
+            || !(1..=54_000_000).contains(&config.byte_ticks)
+            || !(1..=54_000_000).contains(&config.report_ticks)
+            || config.width == 0
+            || config.height == 0
+        {
+            return Err("Invalid XP4 touch I2C wiring".into());
+        }
+        Ok(Self {
+            config,
+            state: State {
+                bus: Bus {
+                    bsr: 0,
+                    bcr: 0,
+                    ccr: 0,
+                    adr: 0,
+                    dar: 0,
+                    csr: 0,
+                    fsr: 0,
+                    bc2r: 0,
+                    step: None,
+                    addressed: false,
+                },
+                panel: Panel::new(),
+            },
+        })
+    }
+    pub fn window(&self) -> (u64, u64) {
+        (self.config.base, self.config.base + 0x20)
+    }
+    /// Host input: the fingers currently on the panel, by slot.
+    pub fn touch(&mut self, now: u64, contacts: [Option<Contact>; CONTACTS]) -> Result<(), String> {
+        if contacts
+            .iter()
+            .flatten()
+            .any(|c| c.x >= self.config.width || c.y >= self.config.height)
+        {
+            return Err(format!(
+                "Touch contact outside {}x{}",
+                self.config.width, self.config.height
+            ));
+        }
+        let panel = &mut self.state.panel;
+        if panel.contacts != contacts {
+            panel.contacts = contacts;
+            for (pressed, contact) in panel.pressed.iter_mut().zip(contacts) {
+                if contact.is_some() {
+                    *pressed = contact;
+                }
+            }
+            panel.next_report = Some(now);
+        }
+        Ok(())
+    }
+    pub fn contacts(&self) -> [Option<Contact>; CONTACTS] {
+        self.state.panel.contacts
+    }
+    fn lines(&self, cx: &mut Cx<'_>) {
+        let bcr = self.state.bus.bcr;
+        cx.set_irq(self.config.irq, bcr & BCR_INT != 0 && bcr & BCR_INTE != 0);
+        cx.set_irq(self.config.touch_irq, self.state.panel.interrupt);
+    }
+    fn begin(&mut self, cx: &mut Cx<'_>, step: Step) {
+        self.state.bus.step = Some((cx.now() + self.config.byte_ticks, step));
+    }
+    fn complete(&mut self, step: Step, now: u64) {
+        let bus = &mut self.state.bus;
+        let panel = &mut self.state.panel;
+        bus.bsr = BSR_BB;
+        match step {
+            Step::Address => {
+                let read = bus.dar & 1 != 0;
+                bus.addressed = bus.dar >> 1 == PANEL_ADDRESS;
+                if bus.addressed {
+                    panel.start(read, now, self.config.report_ticks);
+                } else {
+                    bus.bsr |= BSR_LRB;
+                }
+                bus.bsr |= BSR_FBT;
+                if !read {
+                    bus.bsr |= BSR_TRX;
+                }
+            }
+            Step::Transmit => {
+                bus.bsr |= BSR_TRX;
+                if bus.addressed {
+                    panel.write(bus.dar);
+                } else {
+                    bus.bsr |= BSR_LRB;
+                }
+            }
+            Step::Receive { ack } => {
+                bus.dar = if bus.addressed { panel.read() } else { 0xff };
+                if !ack {
+                    bus.bsr |= BSR_LRB;
+                }
+            }
+        }
+        bus.bcr |= BCR_INT;
+    }
+    fn stop(&mut self) {
+        let bus = &mut self.state.bus;
+        bus.bsr = 0;
+        bus.step = None;
+        bus.addressed = false;
+    }
+    fn control(&mut self, cx: &mut Cx<'_>, value: u8) {
+        let busy = self.state.bus.bsr & BSR_BB != 0;
+        let old = self.state.bus.bcr;
+        let interrupt = old & value & BCR_INT;
+        self.state.bus.bcr = (value & !(BCR_INT | BCR_SCC)) | interrupt;
+        if value & BCR_MSS == 0 {
+            if busy {
+                self.stop();
+            }
+        } else if !busy {
+            if self.state.bus.ccr & CCR_EN == 0 {
+                cx.unsupported("XP4 I2C start while the controller is disabled");
+                return;
+            }
+            self.state.bus.bsr = BSR_BB;
+            self.begin(cx, Step::Address);
+        } else if old & BCR_INT != 0 && interrupt == 0 {
+            let step = if value & BCR_SCC != 0 {
+                Step::Address
+            } else if self.state.bus.bsr & BSR_TRX != 0 {
+                Step::Transmit
+            } else {
+                Step::Receive {
+                    ack: value & BCR_ACK != 0,
+                }
+            };
+            self.state.bus.bsr &= BSR_BB;
+            self.begin(cx, step);
+        }
+    }
+}
+
+impl Device for TouchI2c {
+    fn name(&self) -> &'static str {
+        "xp4-touch-i2c"
+    }
+    fn read(&mut self, cx: &mut Cx<'_>, address: u64, size: u8) -> u64 {
+        self.advance(cx);
+        let bus = &self.state.bus;
+        if !matches!(size, 1 | 4) {
+            cx.unmodeled();
+            return 0;
+        }
+        u64::from(match address - self.config.base {
+            0x00 => bus.bsr,
+            0x04 => bus.bcr,
+            0x08 => bus.ccr,
+            0x0c => bus.adr,
+            0x10 => bus.dar,
+            0x14 => bus.csr,
+            0x18 => bus.fsr,
+            // SCL and SDA sense lines (bits 4/5) read high: nothing holds the bus.
+            0x1c => bus.bc2r & 3 | 0x30,
+            _ => {
+                cx.unmodeled();
+                0
+            }
+        })
+    }
+    fn write(&mut self, cx: &mut Cx<'_>, address: u64, size: u8, value: u64) {
+        self.advance(cx);
+        if !matches!(size, 1 | 4) || value > 0xff {
+            cx.unmodeled();
+            return;
+        }
+        let value = value as u8;
+        let bus = &mut self.state.bus;
+        match address - self.config.base {
+            0x04 => self.control(cx, value),
+            0x08 => {
+                bus.ccr = value;
+                if value & CCR_EN == 0 {
+                    self.stop();
+                    self.state.bus.bcr = 0;
+                }
+            }
+            0x0c => bus.adr = value,
+            0x10 => bus.dar = value,
+            0x14 => bus.csr = value,
+            0x18 => bus.fsr = value,
+            0x1c => bus.bc2r = value & 3,
+            _ => cx.unmodeled(),
+        }
+        self.lines(cx);
+    }
+    fn advance(&mut self, cx: &mut Cx<'_>) {
+        let now = cx.now();
+        if let Some((at, step)) = self.state.bus.step
+            && at <= now
+        {
+            self.state.bus.step = None;
+            self.complete(step, now);
+        }
+        let panel = &mut self.state.panel;
+        if panel.next_report.is_some_and(|at| at <= now) {
+            // GIC153 is edge-configured: every scan is a fresh edge, so one
+            // unread report cannot silence the panel for good.
+            if panel.interrupt {
+                cx.set_irq(self.config.touch_irq, false);
+            }
+            panel.interrupt = true;
+            panel.next_report = panel.touching().then(|| now + self.config.report_ticks);
+        }
+        self.lines(cx);
+    }
+    fn next_deadline(&self, _: u64) -> Option<u64> {
+        let bus = self.state.bus.step.map(|(at, _)| at);
+        match (bus, self.state.panel.next_report) {
+            (Some(a), Some(b)) => Some(a.min(b)),
+            (a, b) => a.or(b),
+        }
+    }
+    fn save(&self) -> Value {
+        serde_json::json!({ "config": self.config, "state": self.state })
+    }
+    fn restore(&mut self, value: &Value) -> Result<(), String> {
+        let config: Config =
+            serde_json::from_value(value["config"].clone()).map_err(|e| e.to_string())?;
+        let state: State =
+            serde_json::from_value(value["state"].clone()).map_err(|e| e.to_string())?;
+        if config != self.config
+            || state.panel.registers.len() != 256
+            || state.panel.records.len() != RECORD_BYTES * CONTACTS
+        {
+            return Err("Invalid XP4 touch I2C checkpoint or changed wiring".into());
+        }
+        self.state = state;
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use fujimod_emulator_devices::{Host, Record};
+
+    #[derive(Default)]
+    struct Board {
+        now: u64,
+        lines: std::collections::BTreeMap<u32, bool>,
+        edges: std::collections::BTreeMap<u32, usize>,
+    }
+    impl Host for Board {
+        fn now(&self) -> u64 {
+            self.now
+        }
+        fn schedule(&mut self, _: usize, _: u64, _: u64) {
+            unreachable!()
+        }
+        fn set_irq(&mut self, line: u32, level: bool) {
+            if self.lines.insert(line, level) != Some(true) && level {
+                *self.edges.entry(line).or_default() += 1;
+            }
+        }
+        fn raise_irq(&mut self, _: usize, _: u32) -> Result<(), String> {
+            unreachable!()
+        }
+        fn ram_read(&self, _: u64, _: &mut [u8]) -> Result<(), String> {
+            unreachable!()
+        }
+        fn ram_write(&mut self, _: u64, _: &[u8]) -> Result<(), String> {
+            unreachable!()
+        }
+        fn record(&mut self, _: Record) {}
+    }
+
+    const BASE: u64 = 0xfff3f000;
+
+    fn model() -> TouchI2c {
+        TouchI2c::new(Config {
+            base: BASE,
+            irq: 67,
+            touch_irq: 153,
+            byte_ticks: 10,
+            report_ticks: 1000,
+            width: 900,
+            height: 600,
+        })
+        .unwrap()
+    }
+
+    struct Master {
+        dev: TouchI2c,
+        board: Board,
+    }
+    impl Master {
+        fn new() -> Self {
+            let mut m = Self {
+                dev: model(),
+                board: Board::default(),
+            };
+            m.w(0x08, 0x2c);
+            m
+        }
+        fn w(&mut self, offset: u64, value: u8) {
+            let mut cx = Cx::new(&mut self.board, 0, 0, 0);
+            self.dev.write(&mut cx, BASE + offset, 4, u64::from(value));
+            assert!(cx.refusal().is_none());
+        }
+        fn r(&mut self, offset: u64) -> u8 {
+            let mut cx = Cx::new(&mut self.board, 0, 0, 0);
+            self.dev.read(&mut cx, BASE + offset, 4) as u8
+        }
+        /// Run to the next byte interrupt and return BSR.
+        fn wait(&mut self) -> u8 {
+            self.board.now = self.dev.next_deadline(0).unwrap();
+            self.dev
+                .advance(&mut Cx::new(&mut self.board, usize::MAX, 0, 0));
+            assert_eq!(self.board.lines[&67], true);
+            self.r(0x00)
+        }
+        const GO: u8 = BCR_MSS | BCR_INTE | 0x40;
+        /// The stock write-then-read sequence (0x11a9480 / ISR 0x11a8a50).
+        fn read_register(&mut self, register: u8, len: usize) -> Vec<u8> {
+            self.w(0x10, PANEL_ADDRESS << 1);
+            self.w(0x04, Self::GO);
+            let bsr = self.wait();
+            assert_eq!(bsr & (BSR_FBT | BSR_TRX | BSR_LRB), BSR_FBT | BSR_TRX);
+            self.w(0x10, register);
+            self.w(0x04, Self::GO);
+            assert_eq!(self.wait() & (BSR_TRX | BSR_LRB), BSR_TRX);
+            self.w(0x10, PANEL_ADDRESS << 1 | 1);
+            self.w(0x04, Self::GO | BCR_SCC);
+            let bsr = self.wait();
+            assert_eq!(bsr & (BSR_FBT | BSR_TRX | BSR_LRB), BSR_FBT);
+            let mut out = Vec::new();
+            for i in 0..len {
+                let ack = if i + 1 < len { BCR_ACK } else { 0 };
+                self.w(0x04, Self::GO | ack);
+                let bsr = self.wait();
+                assert_eq!(bsr & BSR_LRB != 0, i + 1 == len);
+                out.push(self.r(0x10));
+            }
+            self.w(0x04, 0x40 | BCR_INTE);
+            assert_eq!(self.r(0x00) & BSR_BB, 0);
+            out
+        }
+    }
+
+    #[test]
+    fn stock_register_read_reports_contacts_and_releases_interrupt() {
+        let mut m = Master::new();
+        m.dev
+            .touch(0, [Some(Contact { x: 450, y: 300 }), None])
+            .unwrap();
+        m.dev.advance(&mut Cx::new(&mut m.board, usize::MAX, 0, 0));
+        assert!(m.board.lines[&153]);
+        assert_eq!(m.read_register(REPORT, 2), [1, 0]);
+        assert!(!m.board.lines[&153]);
+        assert_eq!(
+            m.read_register(RECORDS, 7),
+            [0x81, 0xc2, 0x01, 0x2c, 0x01, 0, 0]
+        );
+        assert_eq!(m.read_register(RECORDS, 7), [0; 7]);
+
+        m.board.now += 5;
+        m.dev.touch(m.board.now, [None, None]).unwrap();
+        m.dev.advance(&mut Cx::new(&mut m.board, usize::MAX, 0, 0));
+        assert!(m.board.lines[&153]);
+        assert_eq!(m.read_register(REPORT, 2), [1, 0]);
+        assert_eq!(
+            m.read_register(RECORDS, 7),
+            [0x01, 0xc2, 0x01, 0x2c, 0x01, 0, 0]
+        );
+        assert_eq!(m.dev.next_deadline(0), None);
+    }
+
+    #[test]
+    fn tap_between_reports_is_reported_down_then_up() {
+        let mut m = Master::new();
+        let tap = Contact { x: 10, y: 20 };
+        m.dev.touch(0, [Some(tap), None]).unwrap();
+        m.dev.touch(0, [None, None]).unwrap();
+        m.dev.advance(&mut Cx::new(&mut m.board, usize::MAX, 0, 0));
+        assert_eq!(m.read_register(REPORT, 2), [1, 0]);
+        assert_eq!(m.read_register(RECORDS, 7), [0x81, 10, 0, 20, 0, 0, 0]);
+        m.board.now = m.dev.next_deadline(0).unwrap();
+        m.dev.advance(&mut Cx::new(&mut m.board, usize::MAX, 0, 0));
+        assert!(m.board.lines[&153]);
+        assert_eq!(m.read_register(REPORT, 2), [1, 0]);
+        assert_eq!(m.read_register(RECORDS, 7), [0x01, 10, 0, 20, 0, 0, 0]);
+        assert_eq!(m.dev.next_deadline(0), None);
+    }
+
+    #[test]
+    fn register_writes_are_stored_and_other_addresses_nack() {
+        let mut m = Master::new();
+        m.w(0x10, PANEL_ADDRESS << 1);
+        m.w(0x04, Master::GO);
+        m.wait();
+        for byte in [0xf6, 0x12] {
+            m.w(0x10, byte);
+            m.w(0x04, Master::GO);
+            assert_eq!(m.wait() & BSR_LRB, 0);
+        }
+        m.w(0x04, 0x40);
+        assert_eq!(m.read_register(0xf6, 1), [0x12]);
+
+        m.w(0x10, 0x36 << 1);
+        m.w(0x04, Master::GO);
+        assert_ne!(m.wait() & BSR_LRB, 0);
+    }
+
+    #[test]
+    fn held_contact_repeats_and_state_survives_restore() {
+        let mut m = Master::new();
+        m.dev
+            .touch(0, [None, Some(Contact { x: 1, y: 2 })])
+            .unwrap();
+        m.dev.advance(&mut Cx::new(&mut m.board, usize::MAX, 0, 0));
+        assert_eq!(m.read_register(REPORT, 2), [1, 0]);
+        assert_eq!(m.dev.next_deadline(0), Some(1000));
+        let saved = m.dev.save();
+        let mut restored = model();
+        restored.restore(&saved).unwrap();
+        assert_eq!(restored.save(), saved);
+        assert!(
+            m.dev
+                .touch(0, [Some(Contact { x: 900, y: 0 }), None])
+                .is_err()
+        );
+    }
+
+    #[test]
+    fn unread_reports_still_raise_edges_and_heartbeat_moves() {
+        let mut m = Master::new();
+        let before = m.read_register(HEARTBEAT, 1);
+        m.dev
+            .touch(0, [Some(Contact { x: 1, y: 2 }), None])
+            .unwrap();
+        for _ in 0..3 {
+            m.board.now = m.dev.next_deadline(0).unwrap();
+            m.dev.advance(&mut Cx::new(&mut m.board, usize::MAX, 0, 0));
+        }
+        assert_eq!(m.board.edges[&153], 3);
+        assert_ne!(m.read_register(HEARTBEAT, 1), before);
+    }
+}
