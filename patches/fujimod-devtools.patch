+#[test]
+fn register_reads_follow_the_inflight_cursor_without_changing_descriptor_bases() {
+    let (mut d, wire, mut h) = fixture(32);
+    configure(&mut d, &mut h, 1024, 64, 257);
+    descriptor(&mut h, 256, 1536, 64, 0);
+    wire.lock().unwrap().since = Some(0);
+    submit(&mut d, &mut h).unwrap();
+    for words in 0..=32 {
+        let base = if words < 16 { 1024 } else { 1536 };
+        let offset = if words < 16 { words * 4 } else { (words - 16) * 4 };
+        assert_eq!(d.read(&mut h.cx(), DMA + 0x4018, 4), base + offset);
+        assert_eq!(d.read(&mut h.cx(), DMA + 0x4014, 4), ADDRESS);
+        assert_eq!(
+            d.channels[4].regs[6] as u64,
+            if words == 32 { 1600 } else { base }
+        );
+        let saved = d.save();
+        d.restore(&saved).unwrap();
+        assert_eq!(d.read(&mut h.cx(), DMA + 0x4018, 4), base + offset);
+        if words < 32 {
+            step(&mut d, &mut h).unwrap();
+            step(&mut d, &mut h).unwrap();
+        }
+    }
+    assert_eq!(&h.bytes[1024..1088], expected(0, 16));
+    assert_eq!(&h.bytes[1536..1600], expected(16, 16));
+}
