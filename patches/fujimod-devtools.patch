+use std::collections::VecDeque;
+const FIFO:u64=0xfff34008;
+#[derive(Clone,Default)]
+struct Wire { rx:VecDeque<u8>,tx:Vec<u8>,rx_since:Option<u64>,tx_since:u64,capacity:usize,pops:usize }
+impl Port for Wire {
+    fn request(&self,d:Direction,burst:bool)->Option<u64> {
+        if burst { return None; }
+        match d { Direction::Receive => (!self.rx.is_empty()).then_some(self.rx_since).flatten(),
+            Direction::Transmit => (self.tx.len()<self.capacity).then_some(self.tx_since) }
+    }
+    fn receive(&mut self,now:u64,bytes:u8)->Result<u64,String> {
+        if bytes!=1 || !self.request(Direction::Receive,false).is_some_and(|at|at<=now) { return Err("no RX request".into()); }
+        let b=self.rx.pop_front().unwrap(); self.pops+=1;
+        if self.rx.is_empty() { self.rx_since=None; } Ok(b.into())
+    }
+    fn transmit(&mut self,now:u64,bytes:u8,value:u64)->Result<(),String> {
+        if bytes!=1 || value>255 || !self.request(Direction::Transmit,false).is_some_and(|at|at<=now) {return Err("no TX request".into());}
+        self.tx.push(value as u8); Ok(())
+    }
+}
