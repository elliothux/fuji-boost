+use super::*;
+use fujimod_emulator_devices::dma::Port;
+use fujimod_emulator_devices::test_host::ram::{Effect, Ram};
+use std::collections::VecDeque;
+
+#[derive(Clone, Default)]
+struct Words {
+    data: VecDeque<u32>,
+    since: Option<u64>,
+    pops: usize,
+    output: bool,
+    sent: Vec<u32>,
+}
+impl Port for Words {
+    fn request(&self, direction: Direction, burst: bool) -> Option<u64> {
+        (!burst && if self.output { direction == Direction::Transmit } else { direction == Direction::Receive && !self.data.is_empty() })
+            .then_some(self.since)
+            .flatten()
+    }
+    fn receive(&mut self, now: u64, bytes: u8) -> Result<u64, String> {
+        if bytes != 4
+            || !self
+                .request(Direction::Receive, false)
+                .is_some_and(|at| at <= now)
+        {
+            return Err("No word request".into());
+        }
+        self.pops += 1;
+        Ok(self.data.pop_front().unwrap().into())
+    }
+    fn transmit(&mut self, now: u64, bytes: u8, value: u64) -> Result<(), String> {
+        if bytes != 4 || !self.request(Direction::Transmit, false).is_some_and(|at| at <= now) {
+            return Err("No word sink request".into());
+        }
+        self.sent.push(u32::try_from(value).unwrap());
+        Ok(())
+    }
+}
+fn fixture(words: usize) -> (DmaController, Arc<Mutex<Words>>, Ram) {
+    let shared = port(
+        vec![],
+        0,
+        Geometry {
+            erase_bytes: 4096,
+            page_bytes: 256,
+            erase_ticks: 8,
+            page_ticks: 8,
+        },
+    )
+    .unwrap();
+    let mut d = DmaController::new(shared, [211; 16]);
+    let wire = Arc::new(Mutex::new(Words {
+        data: (0..words)
+            .map(|i| 0xa5f00000 ^ (i as u32 * 0x10203))
+            .collect(),
+        ..Default::default()
+    }));
+    d.connect_linked_input(wire.clone(), 4096, (2, 1)).unwrap();
+    let mut h = Ram::new(4096);
+    h.bytes.fill(0xcc);
+    write(&mut d, &mut h, 0xfff4a508, 0x10000 | u64::from(REQUEST)).unwrap();
+    (d, wire, h)
+}
+fn write(d: &mut DmaController, h: &mut Ram, address: u64, value: u64) -> Result<(), String> {
+    let mut cx = h.cx();
+    d.write(&mut cx, address, 4, value);
+    cx.take_refusal().map_or(Ok(()), Err)
+}
+fn configure(d: &mut DmaController, h: &mut Ram, destination: u32, size: u32, next: u32) {
+    for (offset, value) in [
+        (0x10, size - 1),
+        (0x14, ADDRESS as u32),
+        (0x18, destination),
+        (0x1c, 0x20f04),
+        (0x20, 0x20f00),
+        (0x24, next),
+    ] {
+        write(d, h, DMA + 0x4000 + offset, value.into()).unwrap();
+    }
+}
+fn descriptor(h: &mut Ram, address: usize, destination: u32, size: u32, next: u32) {
+    for (index, word) in [
+        size - 1,
+        ADDRESS as u32,
+        destination,
+        0x20f04,
+        0x20f00,
+        next,
+        0,
+        0,
+    ]
+    .into_iter()
+    .enumerate()
+    {
+        h.bytes[address + index * 4..address + index * 4 + 4].copy_from_slice(&word.to_le_bytes());
+    }
+}
+fn submit(d: &mut DmaController, h: &mut Ram) -> Result<(), String> {
+    write(d, h, DMA + 0x4028, 0x10201011)
+}
+fn step(d: &mut DmaController, h: &mut Ram) -> Result<bool, String> {
+    let Some(at) = d.next_deadline(h.now) else {
+        return Ok(false);
+    };
+    assert!(at >= h.now);
+    h.now = at;
+    let mut cx = h.cx();
+    d.advance(&mut cx);
+    cx.take_refusal().map_or(Ok(true), Err)
+}
+fn drain(d: &mut DmaController, h: &mut Ram) {
+    for _ in 0..1000 {
+        if !step(d, h).unwrap() {
+            return;
+        }
+    }
+    panic!("Input did not finish or block");
+}
+fn expected(start: usize, count: usize) -> Vec<u8> {
+    (start..start + count)
+        .flat_map(|i| (0xa5f00000 ^ (i as u32 * 0x10203)).to_le_bytes())
+        .collect()
+}
