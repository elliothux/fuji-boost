+            match field {
+                0 => state.ready_ticks += 1,
+                1 => state.completion_ticks += 1,
+                2 => state.source_sha256 = "cd".repeat(32),
+                3 => state.control = 0x100,
+                4 => state.generation = 0,
+                5 => state.generation = u64::MAX,
+                6 => state.stage = Stage::Cold,
+                _ => {
+                    let Stage::Preparing(mut r) = state.stage else {
+                        unreachable!()
+                    };
+                    match field {
+                        7 => r.token += 1,
+                        8 => r.due += 1,
+                        _ => r.started = u64::MAX,
+                    }
+                    state.stage = Stage::Preparing(r);
+                }
+            }
+            let bad = Checkpoint::encode(NAME, &state).unwrap();
+            assert!(m.validate_checkpoint(&bad).is_err());
+            assert!(m.restore_checkpoint(&bad).is_err());
+            assert_eq!(m.save(), baseline);
