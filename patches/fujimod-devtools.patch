+++ b/crates/emulator-cpu-unicorn/src/durable/a7/tests.rs
@@ -0,0 +1,133 @@
+use super::*;
+use crate::{durable::Document, test_support::library};
+
+// L1 section table at 0x4000: VA 0x00100000 -> PA 0, VA 0 -> PA 0.
+fn processor(library: &Library) -> Core {
+    let cpu = library.open(Model::CortexA7, 1 << 20).unwrap();
+    cpu.map_zeroed(0, 0x10000, 7).unwrap();
+    let section = |pa: u32| (pa | 0xc02).to_le_bytes(); // AP=11, section
+    cpu.write_memory(0x4000, &section(0)).unwrap();
+    cpu.write_memory(0x4004, &section(0)).unwrap();
+    cpu.write_memory(
+        0x1000,
+        &[
+            0x01, 0x00, 0x80, 0xe2, 0x04, 0x10, 0x9f, 0xe5, 0xfc, 0xff, 0xff, 0xea,
+        ],
+    )
+    .unwrap(); // add r0,1; ldr r1,[pc,#4]; b 1000
+    cpu.write_memory(0x1010, &0x5a5a_0001u32.to_le_bytes())
+        .unwrap();
+    cpu
+}
+fn run(cpu: &Core, count: usize) {
+    let mut pc = [0; 4];
+    let mut cpsr = [0; 4];
+    cpu.read_register(arm::PC, &mut pc).unwrap();
+    cpu.read_register(arm::CPSR, &mut cpsr).unwrap();
+    let thumb = u32::from_le_bytes(cpsr) & 32 != 0;
+    cpu.run(Run {
+        begin: u64::from(u32::from_le_bytes(pc) | u32::from(thumb)),
+        until: None,
+        watchdog_us: 0,
+        instructions: Some(count),
+    })
+    .unwrap();
+}
+fn state(cpu: &Core) -> Vec<u8> {
+    cpu.snapshot(None).unwrap().export().unwrap()
+}
+fn configure(cpu: &Core) {
+    for (i, mode) in MODES.into_iter().enumerate() {
+        put(cpu, arm::CPSR, 0xd0 | mode).unwrap();
+        for r in 8..13 {
+            put(
+                cpu,
+                arm::CORE[r],
+                if mode == 0x11 {
+                    0xf000 + r as u32
+                } else {
+                    r as u32
+                },
+            )
+            .unwrap();
+        }
+        put(cpu, arm::CORE[13], 0x10000 + i as u32 * 4).unwrap();
+        put(cpu, arm::CORE[14], 0x20000 + i as u32 * 4).unwrap();
+        if !shared(mode) {
+            put(cpu, arm::SPSR, 0x600000d3 + i as u32).unwrap();
+        }
+    }
+    put(cpu, arm::CPSR, 0xd3).unwrap();
+    put(cpu, SCALARS[0], 0x00f00000).unwrap();
+    put(cpu, SCALARS[1], 0x40000000).unwrap();
+    put(cpu, SCALARS[2], 0x01400010).unwrap();
+    for r in 0..16 {
+        let bytes = std::array::from_fn::<_, 16, _>(|i| (r * 16 + i) as u8);
+        cpu.write_register(Register::Arm32(arm::Register::Q(r as u8)), &bytes)
+            .unwrap();
+    }
+    for secure in 0..2 {
+        wide(cpu, WIDE[0], secure, Some(0x4000)).unwrap();
+        cp(cpu, CP15[3], secure, Some(0x5555_5555)).unwrap(); // DACR manager
+        cp(cpu, CP15[14], secure, Some(0x0001_0000 + secure * 0x100)).unwrap(); // VBAR
+        cp(cpu, CP15[16], secure, Some(0x42 + secure)).unwrap(); // CONTEXTIDR
+        cp(cpu, CP15[19], secure, Some(0xcafe_0000 + secure)).unwrap(); // TPIDRPRW
+    }
+    // Enable the MMU last, then execute through the 0x00100000 alias.
+    for secure in 0..2 {
+        let sctlr = cp(cpu, CP15[0], secure, None).unwrap();
+        cp(cpu, CP15[0], secure, Some(sctlr | 1)).unwrap();
+    }
+    put(cpu, arm::PC, 0x0010_1000).unwrap();
+}
+
+#[test]
+fn mmu_banks_and_system_registers_resume_in_a_fresh_engine() {
+    let library = library();
+    let (bytes, expected) = {
+        let cpu = processor(&library);
+        configure(&cpu);
+        run(&cpu, 37);
+        let saved = cpu.snapshot(None).unwrap();
+        let bytes = saved.export().unwrap();
+        put(&cpu, arm::CORE[0], 0xdeadbeef).unwrap();
+        cpu.restore(saved.as_ref()).unwrap();
+        run(&cpu, 101);
+        (bytes, state(&cpu))
+    };
+    let target = processor(&library);
+    let imported = target.import_snapshot(&bytes).unwrap();
+    target.restore(imported.as_ref()).unwrap();
+    assert_eq!(state(&target), bytes);
+    run(&target, 101);
+    assert_eq!(state(&target), expected);
+    let mut pc = [0; 4];
+    target.read_register(arm::PC, &mut pc).unwrap();
+    assert_eq!(u32::from_le_bytes(pc) & 0xfff0_0000, 0x0010_0000);
+    let mut r1 = [0; 4];
+    target.read_register(arm::CORE[1], &mut r1).unwrap();
+    assert_eq!(u32::from_le_bytes(r1), 0x5a5a_0001);
+}
+
+#[test]
+fn invalid_a7_architecture_fails_import_without_changing_the_receiver() {
+    let library = library();
+    let cpu = processor(&library);
+    let original = state(&cpu);
+    for corrupt in 0..4 {
+        let mut document: Document<Architecture> = decode(&original).unwrap();
+        let Architecture::CortexA7(saved) = &mut document.architecture else {
+            unreachable!()
+        };
+        match corrupt {
+            0 => saved.identity[1] ^= 1,
+            1 => saved.cpsr &= !31,
+            2 => saved.banks[7].registers[0] ^= 1,
+            _ => saved.banks[2].spsr = None,
+        }
+        assert!(cpu.import_snapshot(&encode(&document).unwrap()).is_err());
+        assert_eq!(state(&cpu), original);
+    }
+    let r5 = library.open(Model::CortexR5F, 1 << 20).unwrap();
+    assert!(r5.import_snapshot(&original).is_err());
+}
