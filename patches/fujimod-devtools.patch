+        impl Device for Dma {
+            fn name(&self) -> &'static str { "deadline-test" }
+            fn read(&mut self, _: &mut Cx<'_>, _: u64, _: u8) -> u64 { 0 }
+            fn write(&mut self, cx: &mut Cx<'_>, _: u64, _: u8, value: u64) {
+                cx.schedule(cx.now() + value, 0);
+            }
+            fn event(&mut self, cx: &mut Cx<'_>, _: u64) {
+                cx.ram_write(0x2000, &[7]).unwrap();
+            }
+        }
+        let definition: Definition = serde_json::from_value(json!({
+            "ram_size": 65536, "cores": 1, "discovery": false, "cbar": 0xffff0000u32
+        })).unwrap();
+        let board = Session::new(definition, None).unwrap();
+        let mut devices = Devices::empty();
+        devices.models.push(Some(Box::new(Dma)));
+        devices.windows.push((0xff000000, 0xff000004, 0));
+        unsafe { (*board.inner.state.get()).devices = Some(devices); }
+        board.inner.devices_due().unwrap();
+        assert_eq!(unsafe { (*board.inner.state.get()).device_deadline }, Some(None));
+        board.inner.device_access(0, 0xff000000, 4, true, 10).unwrap();
+        board.inner.devices_due().unwrap();
+        assert_eq!(unsafe { (*board.inner.state.get()).device_deadline }, Some(Some(10)));
+        board.inner.device_access(0, 0xff000000, 4, false, 0).unwrap();
+        assert_eq!(unsafe { (*board.inner.state.get()).device_deadline }, Some(Some(10)));
+        board.inner.device_access(0, 0xff100000, 4, false, 0).unwrap();
+        assert_eq!(unsafe { (*board.inner.state.get()).device_deadline }, Some(Some(10)));
+        let saved = board.checkpoint().unwrap();
+        unsafe { (*board.inner.state.get()).ticks = 9; }
+        board.inner.devices_due().unwrap();
+        assert_eq!(board.read_virtual(0, 0x2000, 1).unwrap(), [0]);
+        unsafe { (*board.inner.state.get()).ticks = 10; }
+        board.inner.devices_due().unwrap();
+        assert_eq!(board.read_virtual(0, 0x2000, 1).unwrap(), [7]);
+        board.restore_checkpoint(&saved).unwrap();
+        assert_eq!(unsafe { (*board.inner.state.get()).device_deadline }, None);
+        board.inner.devices_due().unwrap();
+        assert_eq!(unsafe { (*board.inner.state.get()).device_deadline }, Some(Some(10)));
+    }
