+#[test]
+fn descriptor_ram_is_fetched_at_the_block_boundary_after_a_software_change() {
+    let (mut d, wire, mut h) = fixture(32);
+    configure(&mut d, &mut h, 1024, 64, 257);
+    descriptor(&mut h, 256, 1280, 64, 0);
