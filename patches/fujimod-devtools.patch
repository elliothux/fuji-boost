+    #[test]
+    fn selector1_mixed_origin_tokens_and_last_write_overflow_never_lose_history() {
+        let c = selector1_config();
+        let mut m = BankedCalibration::new(c.clone()).unwrap();
+        let mut h = TestHost::new();
+        selector1_base(&mut m, &mut h, 0, false);
+        selector1_base(&mut m, &mut h, 1, true);
+        assert_eq!(m.state.generation, 17);
+        for unit in 0..2 {
+            for (o, v) in SELECTOR1 {
+                write(&mut m, &mut h, q(unit, o), v);
+            }
+        }
+        let a = m.state.units[0].pending.clone().unwrap();
+        let b = m.state.units[1].pending.clone().unwrap();
+        assert_eq!(a.action, Action::Selector1(false));
+        assert_eq!(b.action, Action::Selector1(true));
+        assert_ne!(a.token, b.token);
+        assert_eq!(m.state.generation, 19);
+        let pending = m.checkpoint().unwrap();
+        let mut fresh = BankedCalibration::new(c.clone()).unwrap();
+        fresh.restore_checkpoint(&pending).unwrap();
+        assert_eq!(fresh.save(), m.save());
+        let mut bad: State = pending.decode(NAME).unwrap();
+        bad.units[1].pending.as_mut().unwrap().token = a.token;
+        let before = m.save();
+        assert!(
+            m.restore_checkpoint(&Checkpoint::encode(NAME, &bad).unwrap())
+                .is_err()
+        );
+        assert_eq!(m.save(), before);
+        h.now = a.due;
+        m.event(&mut h.cx(), a.token);
+        assert_eq!(m.state.units[0].stage, Stage::Selector1Done(false));
+        assert_eq!(
+            m.state.units[1].stage,
+            Stage::Pending(Action::Selector1(true))
+        );
+        m.event(&mut h.cx(), b.token);
+        assert_eq!(m.state.units[1].stage, Stage::Selector1Done(true));
+        m.validate_checkpoint(&m.checkpoint().unwrap()).unwrap();
+        for origin in [false, true] {
+            for generation_overflow in [false, true] {
+                let mut m = BankedCalibration::new(c.clone()).unwrap();
+                let mut h = TestHost::new();
+                selector1_base(&mut m, &mut h, 0, origin);
+                for (o, v) in SELECTOR1[..2].to_vec() {
+                    write(&mut m, &mut h, q(0, o), v);
+                }
+                if generation_overflow {
+                    m.state.generation = u64::MAX;
+                } else {
+                    h.now = u64::MAX - 7;
+                }
+                refused(&mut m, &mut h, q(0, 0x5384), 1);
+                assert!(m.state.units[0].pending.is_none());
+                assert_eq!(m.state.units[0].paired[&0x5384], 0);
+            }
+        }
+    }
