+        assert_eq!(serde_json::to_value(board.scanout_metadata()).unwrap(), serde_json::json!(expected));
+        let full = serde_json::to_value(board.state(true)).unwrap();
+        let progress = serde_json::to_value(board.progress()).unwrap();
+        for (key, value) in progress.as_object().unwrap() {
+            assert_eq!(&full[key], value);
+        }
