+    #[test]
+    fn checksum_vectors_and_catalog_wizard_transcript() {
+        assert_eq!(header(20, 0), 0x00000514);
+        assert_eq!(header(20, 0xffff), 0xffff052e);
+        assert_eq!(header(41, 0), 0x00000a6a);
+        let mut p = BisPeer::new([0xff; 2], Pins::new([0; 16]));
+        for (tx, rx) in [
+            (0x000820d0, 0),
+            (0x08108022, 0x0800a0da),
+            (0, 0x000020c8),
+            (0x0800a0da, 0x08008012),
+        ] {
+            assert_eq!(frame(&mut p, tx).unwrap(), rx);
+        }
+    }
+
+    #[test]
+    fn exact_version_sequence_delivery_wrap_and_periodic_status() {
+        let mut p = BisPeer::new([0xff; 2], Pins::new([0; 16]));
+        for (tx, rx) in [
+            (0x00000514, 0),
+            (0x08108022, 0x08008526),
+            (0, 0xffff052e),
+            (0x08008526, 0x08008012),
+        ] {
+            assert_eq!(frame(&mut p, tx).unwrap(), rx);
+        }
+        assert!(p.state.ready);
+        for i in 1..17 {
+            assert_eq!(frame(&mut p, header(41, 0)).unwrap(), 0);
+            assert_eq!(frame(&mut p, ack(0, 0)).unwrap(), ack(41, (i & 7) as u8));
+            assert_eq!(frame(&mut p, 0).unwrap(), header(41, 0));
+            assert_eq!(frame(&mut p, ack(41, 0)).unwrap(), ack(0, (i & 7) as u8));
+        }
+        let mut other = BisPeer::new([0x12, 0x34], Pins::new([0; 16]));
+        frame(&mut other, header(20, 0)).unwrap();
+        frame(&mut other, ack(0, 0)).unwrap();
+        assert_eq!(frame(&mut other, 0).unwrap(), header(20, 0x1234));
+    }
+
+    #[test]
+    fn refuses_unknown_configuration_and_bad_checksum_with_request_bytes() {
+        for (tx, reason) in [
+            (header(43, 0), "unsupported command 43"),
+            (header(42, 2), "unsupported command 42"),
+            (header(128, 8), "unsupported command 128"),
+            (header(135, 4), "unsupported command 135"),
+            (header(168, 16), "unsupported command 168"),
+            (header(169, 64), "unsupported command 169"),
+            (0xd8030630, "configuration handoff"),
+            (2, "checksum"),
+        ] {
+            let mut p = BisPeer::new([0xff; 2], Pins::new([0; 16]));
+            let error = frame(&mut p, tx).unwrap_err();
+            assert!(error.contains(reason), "{error}");
+            assert!(error.contains(&format!("{:02x?}", tx.to_be_bytes())));
+        }
+    }
+
+    #[test]
+    fn observed_queries_and_status_only_controls_keep_matched_sequences() {
+        let mut p = BisPeer::new([0xff; 2], Pins::new([0; 16]));
+        for (command, data, wire) in [
+            (42, 0, 0x00000aaa),
+            (42, 1, 0x00010a8a),
+            (282, 0x8b, 0x008b4690),
+            (177, 0x100, 0x01002c7e),
+            (177, 0x8000, 0x80002c56),
+            (178, 0, 0x00002cb6),
+            (128, 0x101, 0x0101202c),
+            (255, 0, 0x00003fc6),
+            (168, 1, 0x00012a0c),
+            (168, 2, 0x00022a2e),
+            (169, 0, 0x00002a6e),
+            (135, 0, 0x000021cc),
+            (131, 0, 0x000020c8),
+        ] {
+            assert_eq!(header(command, data), wire);
+            let seq = p.state.sequence;
+            assert_eq!(frame(&mut p, wire).unwrap(), 0);
+            assert_eq!(frame(&mut p, ack(0, 0)).unwrap(), ack(command, seq));
+            assert_eq!(frame(&mut p, 0).unwrap(), header(command, 0));
+            assert_eq!(frame(&mut p, ack(command, 0)).unwrap(), ack(0, seq));
+        }
+    }
+
+    #[test]
+    fn checkpoint_resumes_mid_header_and_rejects_invalid_state_atomically() {
+        let mut p = BisPeer::new([0xff; 2], Pins::new([0; 16]));
+        p.exchange(8, 0, 0).unwrap();
+        p.exchange(8, 0, 1).unwrap();
+        let saved = p.save();
+        let mut q = BisPeer::new([0xff; 2], Pins::new([0; 16]));
+        q.restore(&saved).unwrap();
+        for b in [5, 0x14] {
+            assert_eq!(p.exchange(8, b, 0), q.exchange(8, b, 0));
+        }
+        assert_eq!(p.save(), q.save());
+        for (key, value) in [("position", 4), ("sequence", 8), ("command", 24)] {
+            let before = q.save();
+            let mut invalid = before.clone();
+            invalid["state"][key] = value.into();
+            assert!(q.restore(&invalid).is_err());
+            assert_eq!(q.save(), before);
+        }
+    }
