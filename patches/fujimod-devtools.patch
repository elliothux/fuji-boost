+fn overflowing_dma_clock_fails_before_fifo_acceptance() {
+    let mut s=new(); let mut h=TestHost::new(); configure(&mut s,&mut h); let before=s.save();
+    assert!(s.transmit(u64::MAX,1,1).is_err()); assert_eq!(s.save(),before);
+}
+#[test]
+fn enabled_dma_clock_and_generation_failures_do_not_partially_change_state() {
+    let mut s=new();let mut h=TestHost::new();configure(&mut s,&mut h);let before=s.save();
+    for (offset,value) in [(0x10,0),(0x10,3),(0,0xcf)] {
