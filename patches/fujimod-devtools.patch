+//! Exact instruction budgets without instruction callbacks for ordinary ARM code.
+//! IRQs enter at slice boundaries. MMIO can shorten a slice or request a stop at
+//! the following block; no wall clock participates in scheduling or accounting.
+use super::*;
+use fujimod_emulator_cpu::{Block, InstructionDisposition, Translation};
+use fujimod_emulator_cpu_unicorn::rprofile::accounting::Accounting;
+pub(super) use fujimod_emulator_cpu_unicorn::rprofile::accounting::Span;
+
+pub(super) struct Execution {
+    pub exact: Cell<bool>,
+    synced: Cell<i64>,
+    pub(super) settled_head: Cell<u64>,
+    traced_head: Cell<u64>,
+    core: Cell<usize>,
+    rings: Vec<UnsafeCell<[u64; 64]>>,
+}
+impl Execution {
+    pub(super) fn discard_recent(&self) {
+        self.traced_head.set(self.settled_head.get());
+    }
+    pub fn new(cores: usize) -> Self {
+        Self {
+            exact: Cell::new(true),
+            synced: Cell::new(0),
+            settled_head: Cell::new(0),
+            traced_head: Cell::new(0),
+            core: Cell::new(0),
+            rings: (0..cores).map(|_| UnsafeCell::new([0; 64])).collect(),
+        }
+    }
+}
+impl Cluster {
+    fn accounting(&self, core: usize) -> Result<Accounting, String> {
+        Ok(unsafe {
+            Accounting::from_raw(
+                self.cpus[core]
+                    .accounting()
+                    .ok_or("XP4 requires block accounting")?,
+            )
+        })
+    }
+    pub(super) fn execution_tail(&self, core: usize, pc: u64, entered: bool) -> u64 {
+        self.accounting(core)
+            .ok()
+            .and_then(|a| a.newest_since(self.execution.settled_head.get()))
+            .map_or(0, |span| span.tail(pc, entered))
+    }
+    pub(super) fn settle_execution(
+        &self,
+        core: usize,
+        tail: u64,
+        give_back: bool,
+    ) -> Result<(), String> {
+        let mut a = self.accounting(core)?;
+        let progress = a.settle(self.execution.synced.get(), tail, give_back)?;
+        self.execution.synced.set(progress.budget);
+        // Keep PCs here; diagnostic words are fetched only by observers/checkpoints.
+        let head = a.counters().1;
+        let no_progress = progress.instructions == 0
+            && unsafe { (*self.state.get()).tick_phase } < self.instruction_rate.parts().0;
+        if no_progress && head == self.execution.settled_head.get() {
+            return Ok(());
+        }
+        if tail != 0 && head != self.execution.settled_head.get() {
+            self.retain_execution(core, head, tail)?;
+        }
+        self.execution.settled_head.set(head);
+        if no_progress { return Ok(()); }
+        let state = unsafe { &mut *self.state.get() };
+        let (ticks, phase) = self
+            .instruction_rate
+            .advance_phase(state.tick_phase, progress.instructions)?;
+        state.ticks = state
+            .ticks
+            .checked_add(u64::try_from(ticks).map_err(|_| "A7 guest time overflow")?)
+            .ok_or("A7 guest time overflow")?;
+        state.tick_phase = phase;
+        state.instructions = state
+            .instructions
+            .checked_add(progress.instructions)
+            .ok_or("A7 instruction count overflow")?;
+        state.per_core[core] = state.per_core[core]
+            .checked_add(progress.instructions)
+            .ok_or("A7 instruction count overflow")?;
+        Ok(())
+    }
+    pub(super) fn retain_execution(&self, core: usize, head: u64, tail: u64) -> Result<(), String> {
+        if head == self.execution.traced_head.get() { return Ok(()); }
+        let a = self.accounting(core)?;
+        // Retain raw spans; only observers expand the final 32 instruction PCs.
+        let span = |index| {
+            let mut span = a.span(index);
+            span.instructions = span.instructions.saturating_sub(if index + 1 == head { tail } else { 0 });
+            span
+        };
+        let mut first = head;
+        let mut entries = 0;
+        for index in (self.execution.traced_head.get().max(head.saturating_sub(64))..head).rev() {
+            entries += span(index).instructions;
+            first = index;
+            if entries >= 32 { break; }
+        }
+        self.execution.traced_head.set(head);
+        let state = unsafe { &mut *self.state.get() };
+        let trace = &mut state.recent[core];
+        for index in first..head {
+            let span = span(index);
+            if span.instructions != 0 {
+                if trace.len() == 32 { trace.pop_front(); }
+                trace.push_back((span, None));
+            }
+        }
+        Ok(())
+    }
+    pub(super) fn recent(&self, core: usize) -> VecDeque<(u32, u32)> {
+        let (accounting, first, head) = if core == self.execution.core.get() {
+            let head = self.execution.settled_head.get();
+            (Some(self.accounting(core).expect("XP4 requires block accounting")),
+                self.execution.traced_head.get().max(head.saturating_sub(64)), head)
+        } else { (None, 0, 0) };
+        let live = (first..head).rev().map(|index| (accounting.as_ref().unwrap().span(index), None));
+        let mut rows: Vec<_> = live.chain(unsafe { &(&(*self.state.get()).recent)[core] }.iter().rev().copied())
+            .flat_map(|(span, word)| {
+                (0..span.instructions).rev().map(move |offset| ((span.address + offset * 4) as u32, word))
+            }).take(32).collect();
+        rows.reverse();
+        rows.into_iter().filter_map(|(pc, word)| {
+            word.or_else(|| self.word(core, u64::from(pc)).ok()).map(|word| (pc, word))
+        }).collect()
+    }
+    pub(super) fn deadline_budget(&self, maximum: u64) -> Result<u64, String> {
+        let s = unsafe { &*self.state.get() };
+        let deadline = [s.device_deadline.flatten(), s.timer_deadline.flatten()]
+            .into_iter()
+            .flatten()
+            .min();
+        Ok(match deadline {
+            Some(at) => maximum.min(self.instruction_rate.budget(s.ticks, s.tick_phase, at)?),
+            None => maximum,
+        })
+    }
+    pub(super) fn prepare_execution(&self) -> Result<(), String> {
+        let s = unsafe { &*self.state.get() };
+        let exact = s.driver_guard.is_some()
+            || s.recorder.is_some()
+            || s.memory_watch.is_some()
+            || s.ram_write_watch.is_some()
+            || s.irq_trace.is_some();
+        // Re-arm reservations restored from a checkpoint before any CPU runs.
+        for &(address, bytes) in s.exclusive.iter().flatten() {
+            for cpu in &self.cpus {
+                cpu.watch_stores(address, bytes as u64)?;
+            }
+        }
+        if self.execution.exact.replace(exact) != exact {
+            for (core, cpu) in self.cpus.iter().enumerate() {
+                cpu.hook_watched(self.store_hooks[core], !exact)?;
+                cpu.precise_store_pc(exact)?;
+                let data = (&*self.hooks[core] as *const Hook).cast_mut().cast();
+                unsafe {
+                    cpu.translation_hooks((!exact).then_some(cpu::TranslationHooks {
+                        classify,
+                        restart,
+                        data,
+                    }))
+                }?;
+            }
+        }
+        Ok(())
+    }
+    pub(super) fn start_execution(&self, core: usize, budget: u64) -> Result<(), String> {
+        // Preserve the old core's raw diagnostic tail before resetting its accelerator ring.
+        self.retain_execution(self.execution.core.get(), self.execution.settled_head.get(), 0)?;
+        self.execution.core.set(core);
+        self.execution.traced_head.set(0);
+        let mut record = self.cpus[core]
+            .accounting()
+            .ok_or("XP4 requires block accounting")?;
+        let r = unsafe { record.as_mut() };
+        r.enabled = u64::from(!self.execution.exact.get());
+        r.budget = budget.min(i64::MAX as u64 / 2) as i64;
+        r.head = 0;
+        r.ring = self.execution.rings[core].get().cast::<u64>();
+        r.mask = 63;
+        self.execution.synced.set(r.budget);
+        self.execution.settled_head.set(0);
+        Ok(())
+    }
+    pub(super) fn deliver_irq(&self, core: usize) -> Result<bool, String> {
+        if unsafe { (*self.state.get()).gic.next_irq(core).is_some() }
+            && self.reg(core, arm::CPSR)? & 0x80 == 0
+        {
+            unsafe {
+                (&mut (*self.state.get()).irq_entries)[core] += 1;
+            }
+            self.enter_exception(core, ExceptionEntry::Irq, self.reg(core, arm::PC)?)?;
+            return Ok(true);
+        }
+        Ok(false)
+    }
+    pub(super) fn rearm_execution(&self, core: usize) -> Result<(), String> {
+        let mut record = self.cpus[core]
+            .accounting()
+            .ok_or("XP4 requires block accounting")?;
+        let r = unsafe { record.as_mut() };
+        let s = unsafe { &*self.state.get() };
+        if s.cache_dirty
+            || s.failure.is_some()
+            || s.gic.next_irq(core).is_some() && self.reg(core, arm::CPSR)? & 0x80 == 0
+        {
+            // The following block must not debit instructions before honoring the stop.
+            r.budget = 0;
+            self.execution.synced.set(0);
+            return self.cpus[core].stop();
+        }
+        r.budget = self.deadline_budget(r.budget.max(0) as u64)? as i64;
+        self.execution.synced.set(r.budget);
+        Ok(())
+    }
+}
+fn special(c: &Cluster, word: u32) -> bool {
+    let cp = word & 0x0fff0fff;
+    word & 0x0f900fff == 0x01900f9f
+        || word & 0x0f900ff0 == 0x01800f90
+        || word == 0xf57ff01f
+        || cp == 0x0e100fb0
+        || cp == 0x0e9f0f10
+        || cp == 0x0e300f10 && c.cache_ids.is_some()
+        || matches!(word & 0x0fffffff, 0x0320f002 | 0x0320f003 | 0x0320f004)
+}
+pub(super) unsafe fn classify(data: *mut c_void, pc: u64, word: u32) -> Translation {
+    let h = unsafe { &*data.cast::<Hook>() };
+    let c = unsafe { &*h.cluster };
+    // Keep self-modifying code on the engine's dirty-page path in every CPU.
+    if let Err(error) = c.cpus[h.core].translate(pc, Access::Fetch).and_then(|physical| {
+        for cpu in &c.cpus {
+            cpu.watch_stores(physical, 4)?;
+        }
+        Ok(())
+    }) {
+        c.fail(h.core, error);
+    }
+    let s = unsafe { &*c.state.get() };
+    Translation {
+        instruction: if c.execution.exact.get() {
+            InstructionDisposition::Observe
+        } else if special(c, word)
+            || c.labels.contains(&(pc as u32))
+            || s.pending_calls[h.core].contains_key(&(pc as u32))
+            || s.pc_observers[h.core].contains(&pc)
+        {
+            InstructionDisposition::ObserveAndEndBlock
+        } else {
+            InstructionDisposition::Execute
+        },
+        observe_block: false,
+    }
+}
+pub(super) unsafe fn restart(data: *mut c_void, pc: u64) {
+    let h = unsafe { &*data.cast::<Hook>() };
+    let c = unsafe { &*h.cluster };
+    if !c.execution.exact.get() {
+        if let Err(error) = c.settle_execution(h.core, c.execution_tail(h.core, pc, false), true) {
+            c.fail(h.core, error);
+        }
+    }
+}
+pub(super) unsafe fn block(block: Block, data: *mut c_void) {
+    let h = unsafe { &*data.cast::<Hook>() };
+    let c = unsafe { &*h.cluster };
+    if c.execution.exact.get() {
+        return;
+    }
+    let result = (|| {
+        c.settle_execution(h.core, 0, true)?;
+        if block.thumb != Some(false) || block.bytes == 0 || !block.bytes.is_multiple_of(4) {
+            return Err("XP4 block accounting requires ARM instructions".into());
+        }
+        let mut a = c.accounting(h.core)?;
+        let room = a.counters().0.max(0) as u64;
+        if room == 0 {
+            return c.cpus[h.core].stop();
+        }
+        let n = u64::from(block.bytes / 4);
+        if n > room {
+            return c.cpus[h.core].retry_block(room as u32);
+        }
+        c.execution.synced.set(a.admit(
+            Span {
+                address: block.address,
+                instructions: n,
+            },
+            room,
+        )?);
+        Ok(())
+    })();
+    if let Err(error) = result {
+        c.fail(h.core, error);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn lazy_spans_match_eager_pc_ring_across_wrap_tail_special_and_restore() {
+        let definition = || serde_json::from_value(serde_json::json!({
+            "ram_size": 65536, "cores": 1, "discovery": true
+        })).unwrap();
+        let board = Session::new(definition(), None).unwrap();
+        board.write(0, &0xe320f000u32.to_le_bytes().repeat(16384)).unwrap();
+        let c = &board.inner;
+        let mut expected = VecDeque::new();
+        for cycle in 0..80 {
+            c.start_execution(0, 100_000).unwrap();
+            let mut a = c.accounting(0).unwrap();
+            let mut spans = Vec::new();
+            for index in 0..(cycle * 13 % 90 + 1) {
+                let span = Span { address: 0x1000 + index * 256, instructions: (index * 7 + cycle) % 48 + 1 };
+                a.admit(span, a.counters().0 as u64).unwrap();
+                spans.push(span);
+            }
+            let tail = cycle % (spans.last().unwrap().instructions + 1);
+            c.settle_execution(0, tail, true).unwrap();
+            let mut fresh = Vec::new();
+            for (index, span) in spans.iter().enumerate().rev().take(64) {
+                let entries = span.instructions.saturating_sub(if index + 1 == spans.len() { tail } else { 0 });
+                for offset in (0..entries).rev().take(32 - fresh.len()) {
+                    fresh.push(((span.address + offset * 4) as u32, 0xe320f000));
+                }
+                if fresh.len() == 32 { break; }
+            }
+            for row in fresh.into_iter().rev() {
+                if expected.len() == 32 { expected.pop_front(); }
+                expected.push_back(row);
+            }
+            assert_eq!(c.recent(0), expected, "cycle {cycle}");
+            // Observed instructions keep their original word even if RAM later changes.
+            c.retain_execution(0, c.execution.settled_head.get(), 0).unwrap();
+            let trace = unsafe { &mut (&mut (*c.state.get()).recent)[0] };
+            if trace.len() == 32 { trace.pop_front(); }
+            trace.push_back((Span { address: 0x800, instructions: 1 }, Some(0xe320f003)));
+            if expected.len() == 32 { expected.pop_front(); }
+            expected.push_back((0x800, 0xe320f003));
+            assert_eq!(c.recent(0), expected);
+            let saved = board.checkpoint().unwrap();
+            let restored = Session::new(definition(), None).unwrap();
+            restored.restore_checkpoint(&saved).unwrap();
+            assert_eq!(restored.inner.recent(0), expected);
+        }
+    }
+    #[test]
+    fn restore_discards_unretained_spans_from_the_previous_execution() {
+        let board = Session::new(serde_json::from_value(serde_json::json!({
+            "ram_size": 65536, "cores": 2, "discovery": true
+        })).unwrap(), None).unwrap();
+        board.write(0, &0xe320f000u32.to_le_bytes().repeat(16384)).unwrap();
+        let c = &board.inner;
+        for (core, address) in [(0, 0x1000), (1, 0x2000)] {
+            c.start_execution(core, 100).unwrap();
+            c.accounting(core).unwrap().admit(Span { address, instructions: 4 }, 100).unwrap();
+            c.settle_execution(core, 0, true).unwrap();
+        }
+        let saved = board.checkpoint().unwrap();
+        let expected = [c.recent(0), c.recent(1)];
+        for core in [1, 0] {
+            c.start_execution(core, 100).unwrap();
+            c.accounting(core).unwrap().admit(Span { address: 0x3000, instructions: 40 }, 100).unwrap();
+            c.settle_execution(core, 0, true).unwrap();
+        }
+        board.restore_checkpoint(&saved).unwrap();
+        assert_eq!([c.recent(0), c.recent(1)], expected);
+        c.start_execution(1, 100).unwrap();
+        assert_eq!([c.recent(0), c.recent(1)], expected);
+    }
+    #[test]
+    fn zero_progress_still_consumes_a_new_unentered_span() {
+        let board = Session::new(serde_json::from_value(serde_json::json!({
+            "ram_size":65536,"cores":1,"discovery":true
+        })).unwrap(), None).unwrap();
+        let c = &board.inner;
+        c.start_execution(0, 100).unwrap();
+        let before = serde_json::to_value(board.state(true)).unwrap();
+        c.settle_execution(0, 0, true).unwrap();
+        assert_eq!(serde_json::to_value(board.state(true)).unwrap(), before);
+        let mut accounting = c.accounting(0).unwrap();
+        accounting.admit(Span { address:0x1000, instructions:1 }, 100).unwrap();
+        c.settle_execution(0, 1, true).unwrap();
+        assert_eq!(c.execution.settled_head.get(), 1);
+        assert_eq!(serde_json::to_value(board.state(true)).unwrap(), before);
+        c.settle_execution(0, 0, true).unwrap();
+        assert_eq!(serde_json::to_value(board.state(true)).unwrap(), before);
+        unsafe { (*c.state.get()).tick_phase = u64::MAX; }
+        assert_eq!(c.settle_execution(0, 0, true).unwrap_err(), "clock phase exceeds its ratio");
+    }
+}
