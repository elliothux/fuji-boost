+fn write(d:&mut DmaController,h:&mut Ram,address:u64,value:u64)->Result<(),String> {
+    let mut cx=h.cx(); d.write(&mut cx,address,4,value); cx.take_refusal().map_or(Ok(()),Err)
+}
+fn configure(d:&mut DmaController,h:&mut Ram,n:usize,src:u64,dst:u64,count:u64)->Result<(),String> {
+    let base=DMA+n as u64*0x1000;
+    for (o,v) in [(0x10,count-1),(0x14,src),(0x18,dst),(0x1c,if src==FIFO {4}else{0}),(0x20,if dst==FIFO {4}else{0})] {write(d,h,base+o,v)?;}
+    Ok(())
+}
+fn submit(d:&mut DmaController,h:&mut Ram,n:usize)->Result<(),String> {write(d,h,DMA+n as u64*0x1000+0x28,0x10201011)}
+fn step(d:&mut DmaController,h:&mut Ram)->Result<bool,String> {
+    let Some(at)=d.next_deadline(h.now) else {return Ok(false)};
+    assert!(at>=h.now); h.now=at; let mut cx=h.cx(); d.advance(&mut cx); cx.take_refusal().map_or(Ok(true),Err)
+}
+fn drain(d:&mut DmaController,h:&mut Ram) {for _ in 0..64 {if !step(d,h).unwrap(){return}} panic!("peripheral did not block or finish");}
