+// Query or invalidate translated code touched by a physical DMA write.
+UNICORN_EXPORT
+uc_err uc_embedder_code_write(uc_engine *uc, uint64_t address, uint64_t size,
+                              bool invalidate, bool *overlaps)
+{
+    UC_INIT(uc);
+    if (!overlaps || !size || address > UINT64_MAX - size ||
+        !check_mem_area(uc, address, size)) {
+        restore_jit_state(uc);
+        return UC_ERR_ARG;
+    }
+    for (uint64_t at = address; at < address + size;) {
+        MemoryRegion *mr = uc->memory_mapping(uc, at);
+        if (!mr || !mr->ram_block) {
+            restore_jit_state(uc);
+            return UC_ERR_ARG;
+        }
+        at += MIN(address + size - at,
+                  int128_get64(mr->size) - (at - mr->addr));
+    }
+    *overlaps = uc->code_write(uc, address, size, invalidate);
+    restore_jit_state(uc);
+    return UC_ERR_OK;
+}
+
