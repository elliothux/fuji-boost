+                let d = dst[n] as f64 / 255. * if order & 0x100 != 0 { da } else { 1. };
+                let blended = match mode {
+                    0 => s,
+                    1 => s + d * (1. - sa),
+                    2 => s * (1. - da) + d,
+                    3 => s * da,
+                    4 => d * sa,
+                    5 => s * (1. - da) + d * (1. - sa) + s * d,
+                    6 => s + d - s * d,
+                    7 => s * (1. - da) + d * (1. - sa) + (s * da).min(d * sa),
+                    8 => s * (1. - da) + d * (1. - sa) + (s * da).max(d * sa),
+                    9 => (s + d).min(1.),
