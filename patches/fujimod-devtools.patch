+impl Device for BankedCalibration {
+    fn name(&self) -> &'static str {
+        NAME
+    }
+    fn read(&mut self, cx: &mut Cx<'_>, address: u64, size: u8) -> u64 {
+        let result = Self::address(address, size).and_then(|(i, paired, off)| {
+            let u = &self.state.units[i];
+            (if paired { &u.paired } else { &u.primary })
+                .get(&off)
+                .copied()
+                .ok_or_else(|| {
+                    format!("Unknown calibration read unit{i} paired{paired} offset{off:#x}")
+                })
+        });
+        match result {
+            Ok(v) => v.into(),
+            Err(e) => {
+                cx.fail(e);
+                0
+            }
+        }
+    }
+    fn write(&mut self, cx: &mut Cx<'_>, address: u64, size: u8, value: u64) {
+        let result = Self::address(address, size).and_then(|(i, paired, off)| {
+            let value =
+                u32::try_from(value).map_err(|_| "Calibration word exceeds32 bits".to_string())?;
+            self.write_word(cx, i, paired, off, value)
+        });
+        if let Err(e) = result {
+            cx.fail(e);
+        }
+    }
+    fn event(&mut self, cx: &mut Cx<'_>, token: u64) {
+        for (i, u) in self.state.units.iter_mut().enumerate() {
+            let Some(p) = u
+                .pending
+                .as_ref()
+                .filter(|p| p.token == token && p.due <= cx.now())
+                .cloned()
+            else {
+                continue;
+            };
+            match p.action {
+                Action::Pll => {
+                    u.pll_done();
+                    u.stage = Stage::Preparation(0);
+                }
+                Action::Clear3 => {
+                    u.paired.insert(0x7044, 0);
+                    u.stage = Stage::Command10;
+                }
+                Action::Clear10 => {
+                    u.paired.insert(0x7044, 0);
+                    u.stage = Stage::Controller;
+                }
+                Action::Controller => {
+                    u.controller_done(self.config.results[i]);
+                    u.stage = Stage::Quality;
+                }
+                Action::Finalize => {
+                    u.paired.insert(0x7364, 1);
+                    u.stage = Stage::Acknowledge;
+                }
+                Action::Mode5 => {
+                    // UNMEASURED FUNCTIONAL ASSUMPTION: reentry uses this same latency,
+                    // full-word zero result and retained-register convention as cold mode5.
+                    u.paired.insert(0x5384, 0);
+                    *u.paired.entry(0x7090).or_insert(0) &= !1;
+                    u.stage = Stage::Mode5Done;
+                }
+                Action::Selector1(from_post) => {
+                    u.paired.insert(0x5384, 0);
+                    u.stage = Stage::Selector1Done(from_post);
+                }
+                Action::PostMode2 => {
+                    u.paired.insert(0x5384, 0);
+                    u.stage = Stage::PostMode2Done;
+                }
+                Action::Mode2 => {
+                    // Explicit virtual full-word completion; no other register law is implied.
+                    u.paired.insert(0x5384, 0);
+                    u.stage = Stage::Mode2Done;
+                }
+                Action::PostPll
+                | Action::PostClear
+                | Action::PostController
+                | Action::PostFinalize => {
+                    u.stage = Self::post_done(u, p.action);
+                }
+                Action::ReprogramClear | Action::ReprogramReady | Action::ReprogramPll => {
+                    u.stage = Self::reprogram_done(u, p.action);
+                }
+                Action::Removal => {
+                    // Synthetic masked completion after declared latency; physical law is unproven.
+                    *u.paired.entry(0x7090).or_insert(0) |= 1;
+                    u.stage = Stage::Removed;
+                }
+            }
+            u.pending = None;
+            cx.record(Record::new(
+                "XP4 banked calibration fixture completed",
+                [
+                    ("unit", Field::int(i as u64)),
+                    ("phase", Field::constant(p.action.label())),
+                    ("tick", Field::int(p.due)),
+                ],
+            ));
+        }
+    }
+    fn advance(&mut self, cx: &mut Cx<'_>) {
+        let mut due: Vec<_> = self
+            .state
+            .units
+            .iter()
+            .filter_map(|u| u.pending.as_ref())
+            .filter(|p| p.due <= cx.now())
+            .map(|p| (p.due, p.token))
+            .collect();
+        due.sort_unstable();
+        for (_, token) in due {
+            self.event(cx, token);
+        }
+    }
+    fn next_deadline(&self, _: u64) -> Option<u64> {
+        self.state
+            .units
+            .iter()
+            .filter_map(|u| u.pending.as_ref().map(|p| p.due))
+            .min()
+    }
+    fn pollable(&self, address: u64, size: u8) -> bool {
+        Self::address(address, size).is_ok_and(|(i, paired, off)| {
+            let u = &self.state.units[i];
+            (if paired { &u.paired } else { &u.primary }).contains_key(&off)
+        })
+    }
+    fn save(&self) -> serde_json::Value {
+        serde_json::to_value(&self.state).unwrap()
+    }
+    fn checkpoint(&self) -> Result<Checkpoint, String> {
+        Checkpoint::encode(NAME, &self.state)
+    }
+    fn validate_checkpoint(&self, saved: &Checkpoint) -> Result<(), String> {
+        if !saved.blobs().is_empty() || !saved.children().is_empty() {
+            return Err("Unexpected calibration checkpoint attachments".into());
+        }
+        self.validate_state(&saved.decode(NAME)?)
+    }
+    fn restore_checkpoint(&mut self, saved: &Checkpoint) -> Result<(), String> {
+        self.validate_checkpoint(saved)?;
+        self.state = saved.decode(NAME)?;
+        Ok(())
+    }
+    fn fingerprint(&self) -> Result<serde_json::Value, String> {
+        Ok(self.save())
+    }
+}
