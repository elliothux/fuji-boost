+//! Explicit synthetic cold initialization, mode5 and removal of each bank pair.
+//! Results and latency are fixture inputs, not measured calibration or PHY laws.
+use fujimod_emulator_devices::{Cx, Device, Record, Value as Field, checkpoint::Checkpoint};
+use serde::{Deserialize, Serialize};
+use std::collections::{BTreeMap, BTreeSet};
+
+const NAME: &str = "xp4-banked-calibration-fixture";
+const FINAL: [(u32, u32); 3] = [(0x7c20, 0x40000520), (0x7c40, 0), (0x7084, 0x02010200)];
+
+#[derive(Clone, Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Config {
+    pub initial_script: Vec<(u32, u32)>,
+    pub preparation: Vec<(u32, u32)>,
+    pub profile: Vec<(u32, u32)>,
+    pub results: [[u16; 4]; 4],
+    pub latency_ticks: u64,
+    pub source_sha256: String,
+    /// Original absolute (address, value) pairs for each unit, in firmware order.
+    pub mode5_scripts: [Vec<(u32, u32)>; 4],
+    /// SHA256 of unit0..3 pairs concatenated as two little-endian u32 words.
+    pub mode5_sha256: String,
+    pub removal_script: Vec<(u32, u32)>,
+    /// Offset, command, status offset, mask, expected; original five u32 words.
+    pub removal_poll: [u32; 5],
+    /// SHA256 of three offset/value pairs then removal_poll, all u32 LE.
+    pub removal_sha256: String,
+    pub unit0_preinitialized: bool,
+    #[serde(default)]
+    pub mode2: Option<Mode2>,
+    #[serde(default)]
+    pub reprogram: Option<Reprogram>,
+    #[serde(default)]
+    pub post_control_source_sha256: Option<String>,
+    #[serde(default)]
+    pub post_mode2_source_sha256: Option<String>,
+    #[serde(default)]
+    pub selector1_source_sha256: Option<String>,
+}
+
+#[derive(Clone, Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Mode2 {
+    pub scripts: [Vec<(u32, u32)>; 4],
+    pub source_sha256: String,
+}
+
+/// Explicit virtual inputs for one Removed-to-reprogram lifecycle per selected unit.
+#[derive(Clone, Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Reprogram {
+    pub profile: Vec<(u32, u32)>,
+    pub cached: [Option<[u32; 6]>; 4],
+    pub input_sha256: String,
+}
+
+const REPROGRAM_SUPPLEMENT: [(u32, u32); 6] = [
+    (0x2020, 4),
+    (0x4660, 0x03000004),
+    (0x46dc, 0x20050108),
+    (0x2000, 0xb01),
+    (0x4610, 0x04000300),
+    (0x227c, 0x01000000),
+];
+const REPROGRAM_RMW: [(u32, u32); 6] = [
+    (0x4660, 0x07ff0000),
+    (0x4664, 0x7ff),
+    (0x4480, 0x7ff00),
+    (0x4484, 0x07ff07ff),
+    (0x4488, 0x07ff07ff),
+    (0x448c, 0x7ff),
+];
+const REPROGRAM_PAIRED: [(u32, u32); 4] =
+    [(0x710c, 1), (0x7114, 0), (0x7c40, 0x80000000), (0x7c14, 0)];
+
+const POST_CONTROL: [(u32, u32); 8] = [
+    (0x7c50, 1),
+    (0x7080, 0x200),
+    (0x7c50, 0),
+    (0x7360, 0xff00c00d),
+    (0x7364, 1),
+    (0x7c20, 0x40000520),
+    (0x7c40, 0),
+    (0x7084, 0x02010200),
