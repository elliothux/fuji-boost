+    fn removed(m: &mut BankedCalibration, h: &mut TestHost, unit: usize) {
+        if m.state.units[unit].stage != Stage::Complete {
+            cold_complete(m, h, unit);
+        }
+        mode5_done(m, h, unit);
+        for (o, v) in m.config.removal_script.clone() {
+            write(m, h, q(unit, o), v);
+        }
+        write(m, h, q(unit, 0x7080), 0x100);
+        let at = h.now + 8;
+        advance(m, h, at);
+        assert_eq!(m.state.units[unit].stage, Stage::Removed);
