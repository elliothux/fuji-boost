+        for (name, state) in &prior.1 {
+            assert_eq!(devices.snapshots().get(name), Some(state));
+        }
+        assert_eq!(devices.windows.last(), Some(&(ADDRESS, ADDRESS + 4, 1)));
+        assert!(devices.owns(ADDRESS, 4));
+        for address in [ADDRESS - 4, ADDRESS + 1, ADDRESS + 4, 0xfff7402c] {
