+    #[test]
+    fn typed_checkpoints_validate_configuration_request_phase_control_and_generation() {
+        let mut m = model();
+        let mut h = Clock::default();
+        let mut snapshots = vec![m.checkpoint().unwrap()];
+        write(&mut m, &mut h, CONTROL, 8);
+        write(&mut m, &mut h, STATUS, 0);
+        snapshots.push(m.checkpoint().unwrap());
+        write(&mut m, &mut h, ARM, 0x40);
+        snapshots.push(m.checkpoint().unwrap());
+        h.now = 8;
+        advance(&mut m, &mut h);
+        snapshots.push(m.checkpoint().unwrap());
+        write(&mut m, &mut h, STATUS, ACK);
+        snapshots.push(m.checkpoint().unwrap());
+        h.now = 20;
+        advance(&mut m, &mut h);
+        snapshots.push(m.checkpoint().unwrap());
+        write(&mut m, &mut h, CONTROL, 8);
+        snapshots.push(m.checkpoint().unwrap());
+        write(&mut m, &mut h, CONTROL, 0);
+        snapshots.push(m.checkpoint().unwrap());
+        for saved in &snapshots {
+            let state: State = saved.decode(NAME).unwrap();
+            let mut restored = model();
+            restored.restore_checkpoint(saved).unwrap();
+            assert_eq!(
+                restored.fingerprint().unwrap(),
+                serde_json::to_value(state).unwrap()
+            );
+        }
+        let baseline = m.save();
+        let preparing: State = snapshots[2].decode(NAME).unwrap();
+        for field in 0..10 {
+            let mut state = preparing.clone();
+            match field {
+                0 => state.ready_ticks += 1,
+                1 => state.completion_ticks += 1,
+                2 => state.source_sha256 = "cd".repeat(32),
+                3 => state.control = 0x100,
+                4 => state.generation = 0,
+                5 => state.generation = u64::MAX,
+                6 => state.stage = Stage::Cold,
+                _ => {
+                    let Stage::Preparing(mut r) = state.stage else {
+                        unreachable!()
+                    };
+                    match field {
+                        7 => r.token += 1,
+                        8 => r.due += 1,
+                        _ => r.started = u64::MAX,
+                    }
+                    state.stage = Stage::Preparing(r);
+                }
+            }
+            let bad = Checkpoint::encode(NAME, &state).unwrap();
+            assert!(m.validate_checkpoint(&bad).is_err());
+            assert!(m.restore_checkpoint(&bad).is_err());
+            assert_eq!(m.save(), baseline);
+        }
+        let mut acknowledged: State = snapshots[6].decode(NAME).unwrap();
+        acknowledged.control = 0;
+        let bad = Checkpoint::encode(NAME, &acknowledged).unwrap();
+        assert!(m.restore_checkpoint(&bad).is_err());
+        assert_eq!(m.save(), baseline);
+        for bad in [
+            snapshots[0]
+                .clone()
+                .with_children(vec![snapshots[0].clone()]),
+            snapshots[0].clone().with_blobs(vec![vec![1u8].into()]),
+            Checkpoint::encode("another-device", &preparing).unwrap(),
+        ] {
+            assert!(m.restore_checkpoint(&bad).is_err());
+            assert_eq!(m.save(), baseline);
+        }
+    }
