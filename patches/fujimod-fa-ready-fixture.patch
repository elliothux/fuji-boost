+#[cfg(test)]
+mod frontier_window_tests {
+    use fujimod_emulator::board::discovery::Discovery;
+
+    #[test]
+    fn frontier_window_bounds_clones_without_losing_observations_or_shadow_state() {
+        let mut d = Discovery::default();
+        d.fallback(0xfff12300, 4, true, 0x12345678);
+        let shadow = d.shadow_bytes();
+        for i in 0..100_000 {
+            d.record(0, 0xff000000 + 4 * (99_999 - i), 0x2000, 4, false, i);
+        }
+        // A repeat increments its count but does not become a newly seen access.
+        d.record(0, 0xff000000 + 4 * 99_999, 0x2000, 4, false, 0);
+        let (total, rows) = d.frontier_window(1024);
+        assert_eq!(total, 100_000);
+        assert_eq!(rows.len(), 1024);
+        assert_eq!(
+            rows.iter().map(|row| row.first).collect::<Vec<_>>(),
+            (0..512).chain(99_488..100_000).collect::<Vec<_>>()
+        );
+        assert_eq!(rows[0].count, 2);
+        assert_eq!(d.shadow_bytes(), shadow);
+        assert_eq!(d.fallback(0xfff12300, 4, false, 0), 0x12345678);
+        assert!(d.interventions.is_empty());
+        let all = d.frontier(false);
+        assert_eq!(all.len(), total);
+        assert_eq!(d.frontier_window(100_000), (total, all.clone()));
+        assert_eq!(d.frontier_window(usize::MAX), (total, all.clone()));
+        assert_eq!(d.frontier_window(0), (total, Vec::new()));
+        for limit in [1, 2, 3, 5] {
+            let (_, rows) = d.frontier_window(limit);
+            let expected: Vec<_> = all[..limit.div_ceil(2)]
+                .iter()
+                .chain(&all[total - limit / 2..])
+                .cloned()
+                .collect();
+            assert_eq!(rows, expected);
+        }
+        let empty = Discovery::default();
+        assert_eq!(empty.frontier_window(1024), (0, Vec::new()));
+    }
+}
