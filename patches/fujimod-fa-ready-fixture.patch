+    #[derive(Clone, Debug, Default, PartialEq)]
+    struct Clock {
+        now: u64,
+        events: Vec<(u64, u64)>,
+        irqs: Vec<(u32, bool)>,
+        records: Vec<Record>,
+    }
+    impl Host for Clock {
+        fn now(&self) -> u64 {
+            self.now
+        }
+        fn schedule(&mut self, _: usize, at: u64, token: u64) {
+            self.events.push((at, token));
+        }
+        fn set_irq(&mut self, line: u32, high: bool) {
+            self.irqs.push((line, high));
+        }
+        fn raise_irq(&mut self, _: usize, _: u32) -> Result<(), String> {
+            panic!("No per-core IRQ input");
+        }
+        fn ram_read(&self, _: u64, _: &mut [u8]) -> Result<(), String> {
+            panic!("FA completion must not read RAM");
+        }
+        fn ram_write(&mut self, _: u64, _: &[u8]) -> Result<(), String> {
+            panic!("FA completion must not write RAM");
+        }
+        fn record(&mut self, r: Record) {
+            self.records.push(r);
+        }
+    }
+    fn model() -> FaCompletionFixture {
+        FaCompletionFixture::new(8, 12, "ab".repeat(32)).unwrap()
+    }
+    fn write_at(m: &mut FaCompletionFixture, h: &mut Clock, a: u64, v: u64, who: (usize, u64)) {
+        let mut cx = Cx::new(h, who.0, who.1, 0);
+        m.write(&mut cx, a, 4, v);
+        assert_eq!(cx.refusal(), None);
+    }
+    fn write(m: &mut FaCompletionFixture, h: &mut Clock, a: u64, v: u64) {
+        write_at(m, h, a, v, (0, 0));
+    }
+    fn read(m: &mut FaCompletionFixture, h: &mut Clock, address: u64) -> u64 {
+        let mut cx = Cx::new(h, 0, 0, 0);
+        let value = m.read(&mut cx, address, 4);
+        assert_eq!(cx.refusal(), None);
+        value
+    }
+    fn refused(m: &mut FaCompletionFixture, h: &mut Clock, a: u64, size: u8, v: Option<u64>) {
+        let before = m.save();
+        let host = h.clone();
+        let mut cx = Cx::new(h, 0, 0, 0);
+        if let Some(v) = v {
+            m.write(&mut cx, a, size, v);
+        } else {
+            m.read(&mut cx, a, size);
+        }
+        assert!(cx.refusal().is_some());
+        assert_eq!(m.save(), before);
+        assert_eq!(*h, host);
+    }
+    fn advance(m: &mut FaCompletionFixture, h: &mut Clock) {
+        m.advance(&mut Cx::new(h, 0, 0, 0));
+    }
+    fn exercise(who: (usize, u64)) -> (serde_json::Value, Clock) {
+        let mut m = model();
+        let mut h = Clock {
+            now: 100,
+            ..Default::default()
+        };
+        assert_eq!(read(&mut m, &mut h, CONTROL), 0);
+        for generation in 1..=2 {
+            for value in [8, 9, 13, 15, 11, 9, 8] {
+                write_at(&mut m, &mut h, CONTROL, value, who);
+            }
+            write_at(&mut m, &mut h, STATUS, 0, who);
+            write_at(&mut m, &mut h, ARM, 0x40, who);
+            let ready = m.pending().unwrap();
+            assert_eq!(ready.generation, generation);
+            assert_eq!(ready.token, generation * 2);
+            h.now = ready.due;
+            let before = m.save();
+            let host = h.clone();
+            for _ in 0..4 {
+                assert_eq!(read(&mut m, &mut h, STATUS), 0);
+            }
+            assert_eq!(m.save(), before);
+            assert_eq!(h, host);
+            m.event(&mut Cx::new(&mut h, who.0, who.1, 0), ready.token);
+            assert_eq!(read(&mut m, &mut h, STATUS), READY);
+            write_at(&mut m, &mut h, STATUS, ACK, who);
+            let completion = m.pending().unwrap();
+            assert_eq!(completion.token, generation * 2 + 1);
+            write_at(&mut m, &mut h, CONTROL, 8, who);
+            assert_eq!(read(&mut m, &mut h, STATUS), ACK);
+            assert_eq!(h.irqs.len(), ((generation - 1) * 2) as usize);
+            h.now = completion.due;
+            let before = m.save();
+            for token in [ready.token, completion.token - 2] {
+                m.event(&mut Cx::new(&mut h, who.0, who.1, 0), token);
+            }
+            assert_eq!(m.save(), before);
+            assert_eq!(read(&mut m, &mut h, STATUS), ACK);
+            m.advance(&mut Cx::new(&mut h, who.0, who.1, 0));
+            assert_eq!(h.irqs.last(), Some(&(IRQ, true)));
+            assert_eq!(read(&mut m, &mut h, CONTROL), 8);
+            assert_eq!(read(&mut m, &mut h, STATUS), ACK);
+            write_at(&mut m, &mut h, CONTROL, 8, who); // Same value, not an edge.
+            assert_eq!(h.irqs.last(), Some(&(IRQ, false))); // Before the trailing clear / EOI.
+            assert_eq!(read(&mut m, &mut h, STATUS), READY);
+            write_at(&mut m, &mut h, CONTROL, 0, who);
+            assert!(matches!(m.state.stage, Stage::Done(_)));
+            assert_eq!(m.next_deadline(h.now), None);
+            let done = m.save();
+            m.event(&mut Cx::new(&mut h, who.0, who.1, 0), completion.token);
+            assert_eq!(m.save(), done);
+            h.now += 1;
+        }
+        assert_eq!(
+            h.irqs,
+            [(IRQ, true), (IRQ, false), (IRQ, true), (IRQ, false)]
+        );
+        assert_eq!(h.events.len(), 4);
+        (m.save(), h)
+    }
