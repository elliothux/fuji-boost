+mod fa_completion_fixture_tests {
+    use super::*;
+    use super::super::{Definition, Session};
+    use fujimod_emulator_xp4_io::fa_completion_fixture::{ARM, CONTROL, STATUS};
+
+    #[test]
+    fn completion_wiring_is_atomic_and_exclusive_with_ready_fixture() {
+        for conflict in [STATUS, ARM, CONTROL] {
+            let mut devices = Devices::empty();
+            devices.requests(vec![(conflict, 8)]).unwrap();
+            let before = (devices.models.len(), devices.windows.clone(), devices.snapshots());
+            assert!(devices.fa_completion_fixture(8, 8, "ab".repeat(32)).is_err());
+            assert_eq!((devices.models.len(), devices.windows.clone(), devices.snapshots()), before);
+        }
+        let mut devices = Devices::empty();
+        for (ready, completion, hash) in [(0, 8, "ab".repeat(32)), (8, 0, "ab".repeat(32)), (8, 8, "bad".into())] {
+            assert!(devices.fa_completion_fixture(ready, completion, hash).is_err());
+            assert!(devices.models.is_empty() && devices.windows.is_empty());
+        }
+        devices.fa_completion_fixture(8, 8, "ab".repeat(32)).unwrap();
+        assert_eq!(devices.windows, [(STATUS, STATUS + 4, 0), (ARM, ARM + 4, 0), (CONTROL, CONTROL + 4, 0)]);
+        assert!(!devices.owns(STATUS + 4, 4));
+        assert!(!devices.owns(STATUS + 0x40, 4));
+        assert!(!devices.owns(0xff70f01c, 4));
+        assert!(!devices.owns(0xfff4f01c, 4));
+        let before = (devices.models.len(), devices.windows.clone(), devices.snapshots());
+        assert!(devices.fa_ready_fixture(8, "ab".repeat(32)).is_err());
+        assert!(devices.fa_completion_fixture(8, 8, "ab".repeat(32)).is_err());
+        assert_eq!((devices.models.len(), devices.windows.clone(), devices.snapshots()), before);
+        let mut old = Devices::empty();
+        old.fa_ready_fixture(8, "ab".repeat(32)).unwrap();
+        let before = (old.models.len(), old.windows.clone(), old.snapshots());
+        assert!(old.fa_completion_fixture(8, 8, "ab".repeat(32)).is_err());
+        assert_eq!((old.models.len(), old.windows.clone(), old.snapshots()), before);
+    }
