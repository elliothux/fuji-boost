--- /dev/null
+++ b/crates/emulator-xp4-io/src/fa_ready_fixture.rs
@@ -0,0 +1,515 @@
+//! One explicit FA ready/acknowledgment fixture; no physical function or IRQ law.
+use fujimod_emulator_devices::{Cx, Device, Record, Value as Field, checkpoint::Checkpoint};
+use serde::{Deserialize, Serialize};
+
+const NAME: &str = "xp4-fa-ready-fixture";
+pub const STATUS: u64 = 0xfa000000;
+pub const ARM: u64 = 0xfa00001c;
+const TOKEN: u64 = 1;
+const READY: u64 = 0x10000;
+const ACK: u64 = READY | 1;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Request {
+    started: u64,
+    due: u64,
+    token: u64,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+enum Stage {
+    Cold,
+    Initialized,
+    Pending(Request),
+    Ready(Request),
+    Done(Request),
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct State {
+    ticks: u64,
+    source_sha256: String,
+    stage: Stage,
+}
+
+pub struct FaReadyFixture {
+    state: State,
+}
+
+impl FaReadyFixture {
+    pub fn new(ticks: u64, source_sha256: String) -> Result<Self, String> {
+        if !(1..=1_000_000).contains(&ticks)
+            || source_sha256.len() != 64
+            || !source_sha256
+                .bytes()
+                .all(|v| v.is_ascii_digit() || (b'a'..=b'f').contains(&v))
+        {
+            return Err("Invalid FA ready fixture latency/source identity".into());
+        }
+        Ok(Self {
+            state: State {
+                ticks,
+                source_sha256,
+                stage: Stage::Cold,
+            },
+        })
+    }
+
+    fn status(&self) -> u64 {
+        match self.state.stage {
+            Stage::Cold | Stage::Initialized | Stage::Pending(_) => 0,
+            Stage::Ready(_) => READY,
+            Stage::Done(_) => ACK,
+        }
+    }
+
+    fn validate_state(&self, state: &State) -> Result<(), String> {
+        if state.ticks != self.state.ticks || state.source_sha256 != self.state.source_sha256 {
+            return Err("FA ready checkpoint configuration differs".into());
+        }
+        if let Stage::Pending(r) | Stage::Ready(r) | Stage::Done(r) = state.stage {
+            if r.token != TOKEN || r.started.checked_add(state.ticks) != Some(r.due) {
+                return Err("Invalid FA ready checkpoint request/deadline".into());
+            }
+        }
+        Ok(())
+    }
+}
+
+impl Device for FaReadyFixture {
+    fn name(&self) -> &'static str {
+        NAME
+    }
+
+    fn read(&mut self, cx: &mut Cx<'_>, address: u64, size: u8) -> u64 {
+        if address == STATUS && size == 4 {
+            return self.status();
+        }
+        cx.fail("Unsupported FA ready fixture read");
+        0
+    }
+
+    fn write(&mut self, cx: &mut Cx<'_>, address: u64, size: u8, value: u64) {
+        if size != 4 {
+            cx.fail("FA ready fixture requires exact words");
+            return;
+        }
+        let next = match (self.state.stage, address, value) {
+            (Stage::Cold, STATUS, 0) => Stage::Initialized,
+            (Stage::Initialized, ARM, 0x40) => {
+                let Some(due) = cx.now().checked_add(self.state.ticks) else {
+                    cx.fail("FA ready fixture deadline overflow");
+                    return;
+                };
+                Stage::Pending(Request {
+                    started: cx.now(),
+                    due,
+                    token: TOKEN,
+                })
+            }
+            (Stage::Ready(request), STATUS, ACK) => Stage::Done(request),
+            _ => {
+                cx.fail("Unsupported FA ready fixture sequence/value/reentry");
+                return;
+            }
+        };
+        self.state.stage = next;
+        if let Stage::Pending(request) = next {
+            cx.schedule(request.due, request.token);
+            cx.record(Record::new(
+                "XP4 FA ready fixture scheduled",
+                [
+                    ("address", Field::int(ARM)),
+                    ("command", Field::int(0x40u32)),
+                    ("tick", Field::int(request.started)),
+                    ("due", Field::int(request.due)),
+                ],
+            ));
+        }
+    }
+
+    fn event(&mut self, cx: &mut Cx<'_>, token: u64) {
+        let Stage::Pending(request) = self.state.stage else {
+            return;
+        };
+        if token != TOKEN || cx.now() < request.due {
+            return;
+        }
+        self.state.stage = Stage::Ready(request);
+        cx.record(Record::new(
+            "XP4 FA ready fixture completed",
+            [
+                ("address", Field::int(STATUS)),
+                ("value", Field::int(READY)),
+                ("tick", Field::int(request.due)),
+            ],
+        ));
+    }
+
+    fn advance(&mut self, cx: &mut Cx<'_>) {
+        self.event(cx, TOKEN);
+    }
+
+    fn next_deadline(&self, _: u64) -> Option<u64> {
+        match self.state.stage {
+            Stage::Pending(request) => Some(request.due),
+            _ => None,
+        }
+    }
+
+    fn pollable(&self, address: u64, size: u8) -> bool {
+        address == STATUS && size == 4
+    }
+
+    fn save(&self) -> serde_json::Value {
+        serde_json::to_value(&self.state).unwrap()
+    }
+
+    fn checkpoint(&self) -> Result<Checkpoint, String> {
+        Checkpoint::encode(NAME, &self.state)
+    }
+
+    fn validate_checkpoint(&self, saved: &Checkpoint) -> Result<(), String> {
+        if !saved.blobs().is_empty() || !saved.children().is_empty() {
+            return Err("Unexpected FA ready checkpoint attachments".into());
+        }
+        self.validate_state(&saved.decode(NAME)?)
+    }
+
+    fn restore_checkpoint(&mut self, saved: &Checkpoint) -> Result<(), String> {
+        self.validate_checkpoint(saved)?;
+        self.state = saved.decode(NAME)?;
+        Ok(())
+    }
+
+    fn fingerprint(&self) -> Result<serde_json::Value, String> {
+        Ok(self.save())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use fujimod_emulator_devices::Host;
+
+    #[derive(Default)]
+    struct Clock {
+        now: u64,
+        events: Vec<(u64, u64)>,
+        records: Vec<Record>,
+    }
+    impl Host for Clock {
+        fn now(&self) -> u64 {
+            self.now
+        }
+        fn schedule(&mut self, _: usize, at: u64, token: u64) {
+            self.events.push((at, token));
+        }
+        fn set_irq(&mut self, _: u32, _: bool) {
+            panic!("FA fixture must not route IRQ");
+        }
+        fn raise_irq(&mut self, _: usize, _: u32) -> Result<(), String> {
+            panic!("FA fixture must not raise IRQ");
+        }
+        fn ram_read(&self, _: u64, _: &mut [u8]) -> Result<(), String> {
+            panic!("FA fixture must not read RAM");
+        }
+        fn ram_write(&mut self, _: u64, _: &[u8]) -> Result<(), String> {
+            panic!("FA fixture must not write RAM");
+        }
+        fn record(&mut self, r: Record) {
+            self.records.push(r);
+        }
+    }
+    fn model() -> FaReadyFixture {
+        FaReadyFixture::new(8, "ab".repeat(32)).unwrap()
+    }
+    fn write(m: &mut FaReadyFixture, h: &mut Clock, a: u64, v: u64) {
+        let mut cx = Cx::new(h, 0, 0, 0);
+        m.write(&mut cx, a, 4, v);
+        assert_eq!(cx.refusal(), None);
+    }
+    fn read(m: &mut FaReadyFixture, h: &mut Clock) -> u64 {
+        let mut cx = Cx::new(h, 0, 0, 0);
+        let v = m.read(&mut cx, STATUS, 4);
+        assert_eq!(cx.refusal(), None);
+        v
+    }
+    fn refused(m: &mut FaReadyFixture, h: &mut Clock, a: u64, size: u8, value: Option<u64>) {
+        let before = m.save();
+        let events = h.events.clone();
+        let records = h.records.clone();
+        let mut cx = Cx::new(h, 0, 0, 0);
+        if let Some(v) = value {
+            m.write(&mut cx, a, size, v);
+        } else {
+            m.read(&mut cx, a, size);
+        }
+        assert!(cx.refusal().is_some());
+        assert_eq!(m.save(), before);
+        assert_eq!(h.events, events);
+        assert_eq!(h.records, records);
+    }
+    fn transfer(core: usize, pc: u64) -> (serde_json::Value, Vec<Record>) {
+        let mut m = model();
+        let mut h = Clock {
+            now: 100,
+            ..Default::default()
+        };
+        assert_eq!(read(&mut m, &mut h), 0);
+        assert!(m.pollable(STATUS, 4));
+        assert!(!m.pollable(ARM, 4));
+        m.write(&mut Cx::new(&mut h, core, pc, 0), STATUS, 4, 0);
+        assert_eq!(m.state.stage, Stage::Initialized);
+        m.write(&mut Cx::new(&mut h, core, pc, 0), ARM, 4, 0x40);
+        assert_eq!(h.events, [(108, TOKEN)]);
+        assert_eq!(m.next_deadline(100), Some(108));
+        refused(&mut m, &mut h, ARM, 4, Some(0x40));
+        let pending = m.save();
+        h.now = 107;
+        m.event(&mut Cx::new(&mut h, core, pc, 0), TOKEN);
+        m.advance(&mut Cx::new(&mut h, core, pc, 0));
+        assert_eq!(m.save(), pending);
+        h.now = 108;
+        for _ in 0..50 {
+            assert_eq!(read(&mut m, &mut h), 0);
+        }
+        assert_eq!(m.save(), pending); // Reading at due time is not completion.
+        m.event(&mut Cx::new(&mut h, core, pc, 0), TOKEN + 1);
+        assert_eq!(m.save(), pending);
+        m.advance(&mut Cx::new(&mut h, core, pc, 0));
+        assert_eq!(read(&mut m, &mut h), READY);
+        assert_eq!(m.next_deadline(108), None);
+        let ready = m.save();
+        for _ in 0..50 {
+            assert_eq!(read(&mut m, &mut h), READY);
+        }
+        assert_eq!(m.save(), ready);
+        assert_eq!(h.records.len(), 2);
+        let expected = vec![
+            Record::new(
+                "XP4 FA ready fixture scheduled",
+                [
+                    ("address", Field::int(ARM)),
+                    ("command", Field::int(0x40u32)),
+                    ("tick", Field::int(100u64)),
+                    ("due", Field::int(108u64)),
+                ],
+            ),
+            Record::new(
+                "XP4 FA ready fixture completed",
+                [
+                    ("address", Field::int(STATUS)),
+                    ("value", Field::int(READY)),
+                    ("tick", Field::int(108u64)),
+                ],
+            ),
+        ];
+        assert_eq!(h.records, expected);
+        m.write(&mut Cx::new(&mut h, core, pc, 0), STATUS, 4, ACK);
+        assert_eq!(read(&mut m, &mut h), ACK);
+        let done = m.save();
+        h.now = 10000;
+        m.event(&mut Cx::new(&mut h, core, pc, 0), TOKEN);
+        m.advance(&mut Cx::new(&mut h, core, pc, 0));
+        assert_eq!(read(&mut m, &mut h), ACK);
+        assert_eq!(m.save(), done);
+        assert_eq!(h.events, [(108, TOKEN)]);
+        refused(&mut m, &mut h, STATUS, 4, Some(0));
+        refused(&mut m, &mut h, STATUS, 4, Some(ACK));
+        refused(&mut m, &mut h, ARM, 4, Some(0x40));
+        (m.save(), h.records)
+    }
+    #[test]
+    fn fa_ready_single_transfer_is_clocked_and_reads_do_not_ack_or_clear_bit0() {
+        assert_eq!(transfer(0, 0x1000), transfer(3, 0xdead0000));
+    }
+
+    #[test]
+    fn fa_ready_rejects_unknown_widths_values_arm_reads_and_every_reentry_atomically() {
+        let mut m = model();
+        let mut h = Clock::default();
+        for phase in 0..5 {
+            refused(&mut m, &mut h, ARM, 4, None);
+            for (a, s) in [
+                (STATUS, 1),
+                (STATUS, 2),
+                (STATUS, 8),
+                (STATUS + 1, 4),
+                (STATUS + 4, 4),
+                (ARM, 1),
+                (ARM, 2),
+                (ARM, 8),
+                (ARM - 4, 4),
+                (ARM + 1, 4),
+                (ARM + 4, 4),
+                (0xfa000040, 4),
+            ] {
+                refused(&mut m, &mut h, a, s, None);
+                refused(&mut m, &mut h, a, s, Some(0));
+            }
+            for (a, v) in [
+                (STATUS, 0),
+                (STATUS, 1),
+                (STATUS, READY),
+                (STATUS, ACK),
+                (STATUS, u64::MAX),
+                (ARM, 0),
+                (ARM, 2),
+                (ARM, 0x40),
+                (ARM, 0x100000040),
+            ] {
+                let legal = matches!(
+                    (phase, a, v),
+                    (0, STATUS, 0) | (1, ARM, 0x40) | (3, STATUS, ACK)
+                );
+                if !legal {
+                    refused(&mut m, &mut h, a, 4, Some(v));
+                }
+            }
+            match phase {
+                0 => write(&mut m, &mut h, STATUS, 0),
+                1 => write(&mut m, &mut h, ARM, 0x40),
+                2 => {
+                    h.now = 8;
+                    m.advance(&mut Cx::new(&mut h, 0, 0, 0));
+                }
+                3 => write(&mut m, &mut h, STATUS, ACK),
+                _ => {}
+            }
+        }
+    }
+
+    #[test]
+    fn fa_ready_configuration_and_deadline_overflow_fail_before_state_or_schedule_changes() {
+        for ticks in [0, 1_000_001, u64::MAX] {
+            assert!(FaReadyFixture::new(ticks, "ab".repeat(32)).is_err());
+        }
+        for ticks in [1, 1_000_000] {
+            assert!(FaReadyFixture::new(ticks, "ab".repeat(32)).is_ok());
+        }
+        for hash in [
+            String::new(),
+            "a".repeat(63),
+            "a".repeat(65),
+            "AB".repeat(32),
+            "gg".repeat(32),
+        ] {
+            assert!(FaReadyFixture::new(8, hash).is_err());
+        }
+        let mut m = model();
+        let mut h = Clock::default();
+        write(&mut m, &mut h, STATUS, 0);
+        h.now = u64::MAX - 7;
+        refused(&mut m, &mut h, ARM, 4, Some(0x40));
+        assert_eq!(m.state.stage, Stage::Initialized);
+        assert_eq!(m.next_deadline(h.now), None);
+    }
+
+    #[test]
+    fn fa_ready_typed_restore_keeps_due_and_rejects_configuration_time_and_shape_without_commit() {
+        let mut m = model();
+        let mut h = Clock {
+            now: 100,
+            ..Default::default()
+        };
+        let cold = m.checkpoint().unwrap();
+        write(&mut m, &mut h, STATUS, 0);
+        let init = m.checkpoint().unwrap();
+        write(&mut m, &mut h, ARM, 0x40);
+        let pending = m.checkpoint().unwrap();
+        let mut restored = model();
+        restored.restore_checkpoint(&pending).unwrap();
+        assert_eq!(restored.save(), m.save());
+        assert_eq!(restored.next_deadline(100), Some(108));
+        h.now = 107;
+        restored.advance(&mut Cx::new(&mut h, 0, 0, 0));
+        assert_eq!(restored.save(), m.save());
+        h.now = 108;
+        restored.advance(&mut Cx::new(&mut h, 0, 0, 0));
+        let ready = restored.checkpoint().unwrap();
+        assert_eq!(read(&mut restored, &mut h), READY);
+        write(&mut restored, &mut h, STATUS, ACK);
+        let done = restored.checkpoint().unwrap();
+        for saved in [&cold, &init, &pending, &ready, &done] {
+            m.restore_checkpoint(saved).unwrap();
+            assert_eq!(
+                m.fingerprint().unwrap(),
+                serde_json::to_value(saved.decode::<State>(NAME).unwrap()).unwrap()
+            );
+        }
+        for saved in [&pending, &ready, &done] {
+            for bad in 0..7 {
+                let mut state: State = saved.decode(NAME).unwrap();
+                match &mut state.stage {
+                    Stage::Pending(r) | Stage::Ready(r) | Stage::Done(r) => match bad {
+                        0 => r.token = 0,
+                        1 => r.token = 2,
+                        2 => r.due += 1,
+                        3 => r.started = u64::MAX,
+                        4 => state.ticks = 9,
+                        5 => state.source_sha256 = "cd".repeat(32),
+                        _ => r.due = 0,
+                    },
+                    _ => unreachable!(),
+                }
+                let before = m.save();
+                assert!(
+                    m.restore_checkpoint(&Checkpoint::encode(NAME, &state).unwrap())
+                        .is_err()
+                );
+                assert_eq!(m.save(), before);
+            }
+        }
+        for (mut other, saved) in [
+            (FaReadyFixture::new(9, "ab".repeat(32)).unwrap(), &pending),
+            (FaReadyFixture::new(8, "cd".repeat(32)).unwrap(), &cold),
+        ] {
+            let before = other.save();
+            assert!(other.restore_checkpoint(saved).is_err());
+            assert_eq!(other.save(), before);
+        }
+        for invalid in [
+            pending.clone().with_children(vec![cold.clone()]),
+            pending.clone().with_blobs(vec![vec![1u8].into()]),
+            Checkpoint::encode("other-device", &m.state).unwrap(),
+        ] {
+            let before = m.save();
+            assert!(m.restore_checkpoint(&invalid).is_err());
+            assert_eq!(m.save(), before);
+        }
+        for malformed in 0..3 {
+            let mut value = serde_json::to_value(&pending.decode::<State>(NAME).unwrap()).unwrap();
+            match malformed {
+                0 => {
+                    value["unknown"] = true.into();
+                }
+                1 => {
+                    value["stage"]["Pending"]["unknown"] = true.into();
+                }
+                _ => {
+                    value["stage"] = serde_json::json!({"Pending":[100,108,1]});
+                }
+            }
+            let before = m.save();
+            assert!(
+                m.restore_checkpoint(&Checkpoint::encode(NAME, &value).unwrap())
+                    .is_err()
+            );
+            assert_eq!(m.save(), before);
+        }
+        for idle in [&cold, &init] {
+            m.restore_checkpoint(idle).unwrap();
+            let before = m.save();
+            m.event(&mut Cx::new(&mut h, 0, 0, 0), TOKEN);
+            m.advance(&mut Cx::new(&mut h, 0, 0, 0));
+            assert_eq!(m.save(), before);
+        }
+        m.restore_checkpoint(&done).unwrap();
+        h.now = 100000;
+        m.advance(&mut Cx::new(&mut h, 0, 0, 0));
+        assert_eq!(read(&mut m, &mut h), ACK);
+    }
+}
