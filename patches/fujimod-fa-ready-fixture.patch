+    #[test]
+    fn restored_pending_deadlines_keep_event_and_advance_equivalent() {
+        let mut original = model();
+        let mut h = Clock::default();
+        write(&mut original, &mut h, STATUS, 0);
+        write(&mut original, &mut h, ARM, 0x40);
+        for completion in [false, true] {
+            let saved = original.checkpoint().unwrap();
+            let request = original.pending().unwrap();
+            let mut event = model();
+            let mut advanced = model();
+            event.restore_checkpoint(&saved).unwrap();
+            advanced.restore_checkpoint(&saved).unwrap();
+            let mut event_host = Clock {
+                now: request.due,
+                ..Default::default()
+            };
+            let mut advance_host = event_host.clone();
+            event.event(&mut Cx::new(&mut event_host, 0, 0, 0), request.token);
+            advance(&mut advanced, &mut advance_host);
+            assert_eq!(event.save(), advanced.save());
+            assert_eq!(event_host, advance_host);
+            if !completion {
+                original = event;
+                h.now = request.due;
+                write(&mut original, &mut h, STATUS, ACK);
+            }
+        }
+    }
+}
