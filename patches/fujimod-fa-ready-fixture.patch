+#[cfg(test)]
+mod fa_ready_fixture_tests {
+    use super::*;
+    use fujimod_emulator_xp4_io::fa_ready_fixture::{ARM, STATUS};
+
+    #[test]
+    fn fa_ready_fixture_wiring_owns_only_two_words_and_is_atomic_on_invalid_or_overlapping_inputs()
+    {
+        for conflict in [STATUS, ARM] {
+            let mut devices = Devices::empty();
+            devices.requests(vec![(conflict, 8)]).unwrap();
+            let before = (
+                devices.models.len(),
+                devices.windows.clone(),
+                devices.snapshots(),
+            );
+            assert!(devices.fa_ready_fixture(8, "ab".repeat(32)).is_err());
+            assert_eq!(
+                (
+                    devices.models.len(),
+                    devices.windows.clone(),
+                    devices.snapshots()
+                ),
+                before
+            );
+        }
+        let mut devices = Devices::empty();
+        assert!(!devices.owns(STATUS, 4));
+        assert!(!devices.owns(ARM, 4));
+        for (ticks, source) in [(0, "ab".repeat(32)), (8, "bad".into())] {
+            assert!(devices.fa_ready_fixture(ticks, source).is_err());
+            assert!(devices.models.is_empty());
+            assert!(devices.windows.is_empty());
+        }
+        devices.fa_ready_fixture(8, "ab".repeat(32)).unwrap();
+        assert_eq!(devices.models.len(), 1);
+        assert_eq!(
+            devices.windows,
+            [(STATUS, STATUS + 4, 0), (ARM, ARM + 4, 0)]
+        );
+        assert!(devices.owns(STATUS, 4));
+        assert!(devices.owns(ARM, 4));
+        for address in [
+            STATUS + 4,
+            STATUS + 8,
+            STATUS + 0x10,
+            STATUS + 0x14,
+            STATUS + 0x18,
+            STATUS + 0x40,
+        ] {
+            assert!(!devices.owns(address, 4));
+        }
+        let before = (
+            devices.models.len(),
+            devices.windows.clone(),
+            devices.snapshots(),
+        );
+        assert!(devices.fa_ready_fixture(8, "ab".repeat(32)).is_err());
+        assert_eq!(
+            (
+                devices.models.len(),
+                devices.windows.clone(),
+                devices.snapshots()
+            ),
+            before
+        );
+    }
