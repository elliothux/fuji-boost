+//! Synthetic write-one/word-zero experiment, with an opt-in second command.
+//! The device owner and physical completion timing remain unknown.
+use fujimod_emulator_devices::{Cx, Device, Record, Value as Field, checkpoint::Checkpoint};
+use serde::{Deserialize, Serialize};
+
+const NAME: &str = "xp4-fff7801c-completion-fixture";
+const ADDRESS: u64 = 0xfff7801c;
+const TOKEN: u64 = 1;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Request {
+    command: u32,
+    started: u64,
+    due: u64,
+    token: u64,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+enum Stage {
+    Idle,
+    Pending(Request),
+    Done(Request),
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct State {
+    ticks: u64,
+    stage: Stage,
+    #[serde(default, skip_serializing_if = "std::ops::Not::not")]
+    allow_second_command: bool,
+}
+
+pub struct Fff7801cCompletionFixture {
+    state: State,
+}
+
+impl Fff7801cCompletionFixture {
+    pub fn new(ticks: u64) -> Result<Self, String> {
+        if !(1..=1_000_000).contains(&ticks) {
+            return Err("Invalid FFF7801C synthetic completion latency".into());
+        }
+        Ok(Self {
+            state: State {
+                ticks,
+                stage: Stage::Idle,
+                allow_second_command: false,
+            },
+        })
+    }
+
+    /// Permit one later command; full-word zero and latency remain synthetic laws.
+    pub fn new_with_second_command(ticks: u64) -> Result<Self, String> {
+        let mut fixture = Self::new(ticks)?;
+        fixture.state.allow_second_command = true;
+        Ok(fixture)
+    }
+
+    fn access(address: u64, size: u8) -> bool {
+        address == ADDRESS && size == 4
+    }
+
+    fn validate_state(&self, state: &State) -> Result<(), String> {
+        if state.ticks != self.state.ticks {
+            return Err("FFF7801C checkpoint latency differs".into());
+        }
+        if state.allow_second_command != self.state.allow_second_command {
+            return Err("FFF7801C checkpoint command policy differs".into());
+        }
+        if let Stage::Pending(request) | Stage::Done(request) = state.stage {
+            if request.command != 1
+                || !(request.token == TOKEN || (state.allow_second_command && request.token == 2))
+                || request.started.checked_add(state.ticks) != Some(request.due)
+            {
+                return Err("Invalid FFF7801C checkpoint request/deadline".into());
+            }
+        }
+        Ok(())
+    }
+}
