+    #[test]
+    fn invalid_accesses_and_sequences_leave_device_host_and_irq_unchanged() {
+        let mut m = model();
+        let mut h = Clock::default();
+        write(&mut m, &mut h, CONTROL, 8);
+        for phase in 0..8 {
+            refused(&mut m, &mut h, ARM, 4, None);
+            for address in [STATUS, ARM, CONTROL] {
+                for size in [0, 1, 2, 8] {
+                    refused(&mut m, &mut h, address, size, None);
+                    refused(&mut m, &mut h, address, size, Some(0));
+                }
+            }
+            for address in [STATUS + 1, ARM + 4, CONTROL + 1, 0xff70f01c, 0xfff4f01c] {
+                refused(&mut m, &mut h, address, 4, None);
+                refused(&mut m, &mut h, address, 4, Some(0));
+            }
+            for value in [16, 0x100, u64::MAX] {
+                refused(&mut m, &mut h, CONTROL, 4, Some(value));
+            }
+            for value in [0, 1, READY, ACK, u64::MAX] {
+                let legal = matches!((phase, value), (0 | 7, 0) | (3, ACK));
+                if !legal {
+                    refused(&mut m, &mut h, STATUS, 4, Some(value));
+                }
+            }
+            for value in [0, 0x40, 0x100000040] {
+                if phase != 1 || value != 0x40 {
+                    refused(&mut m, &mut h, ARM, 4, Some(value));
+                }
+            }
+            match phase {
+                0 => write(&mut m, &mut h, STATUS, 0),
+                1 => write(&mut m, &mut h, ARM, 0x40),
+                2 | 4 => {
+                    h.now = m.next_deadline(h.now).unwrap();
+                    advance(&mut m, &mut h);
+                }
+                3 => write(&mut m, &mut h, STATUS, ACK),
+                5 => {
+                    refused(&mut m, &mut h, CONTROL, 4, Some(0));
+                    refused(&mut m, &mut h, CONTROL, 4, Some(9));
+                    write(&mut m, &mut h, CONTROL, 8);
+                }
+                6 => {
+                    refused(&mut m, &mut h, CONTROL, 4, Some(8));
+                    refused(&mut m, &mut h, CONTROL, 4, Some(1));
+                    write(&mut m, &mut h, CONTROL, 0);
+                }
+                _ => {}
+            }
+        }
+        let irqs = h.irqs.clone();
+        write(&mut m, &mut h, CONTROL, 8);
+        write(&mut m, &mut h, CONTROL, 0);
+        assert_eq!(h.irqs, irqs); // Cleanup shadows in Done never create completion.
+    }
