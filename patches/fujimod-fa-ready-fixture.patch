+    /// Bound diagnostic allocations before cloning rows; retain full observations and shadows.
+    /// Latest means first-seen distinct accesses, not most recently repeated accesses.
+    pub fn frontier_window(&self, limit: usize) -> (usize, Vec<FrontierEntry>) {
+        let total = self.entries.len();
+        if total <= limit {
+            return (total, self.frontier(false));
+        }
+        if limit == 0 {
+            return (total, Vec::new());
+        }
+        let first_limit = limit.div_ceil(2);
+        let last_limit = limit / 2;
+        let mut first = BinaryHeap::with_capacity(first_limit);
+        let mut last = BinaryHeap::with_capacity(last_limit);
+        for (access, &(ordinal, count)) in &self.entries {
+            let row = (ordinal, access, count);
+            if first.len() < first_limit {
+                first.push(row);
+            } else if ordinal < first.peek().unwrap().0 {
+                *first.peek_mut().unwrap() = row;
+            }
+            if last_limit != 0 {
+                if last.len() < last_limit {
+                    last.push(Reverse(row));
+                } else if ordinal > last.peek().unwrap().0.0 {
+                    *last.peek_mut().unwrap() = Reverse(row);
+                }
+            }
+        }
+        let mut rows: Vec<_> = first
+            .into_iter()
+            .chain(last.into_iter().map(|Reverse(row)| row))
+            .map(|(ordinal, access, count)| access.frontier_entry(ordinal, count))
+            .collect();
+        rows.sort_by_key(|row| row.first);
+        (total, rows)
     }
 }
 
