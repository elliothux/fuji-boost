+            session.write_register(core, arm::CORE[0], 0x2000).unwrap();
+            session
+                .write_register(core, arm::CORE[1], core as u64 + 1)
+                .unwrap();
+            session
+                .write_register(core, arm::CORE[13], 0x3000 + core as u64 * 0x100)
+                .unwrap();
+        }
+        let before = serde_json::to_value(session.state(true)).unwrap();
+        session
+            .ram_write_watch_begin(vec![(0x2000, 0x2004)], 4)
+            .unwrap();
+        assert_eq!(serde_json::to_value(session.state(true)).unwrap(), before);
+        assert!(
+            session
+                .ram_write_watch_begin(vec![(0x2000, 0x2004)], 4)
+                .is_err()
+        );
+        for core in 0..4 {
+            session.run(core, 1).unwrap();
+            let mut value = [0; 4];
+            session.read(0x2000, &mut value).unwrap();
+            assert_eq!(u32::from_le_bytes(value), core as u32 + 1);
+        }
+        let trace = session.ram_write_watch_snapshot().unwrap();
+        for (core, row) in trace["records"].as_array().unwrap().iter().enumerate() {
+            assert_eq!(row["origin"], "cpu-pre-store");
+            assert_eq!(row["physical"], 0x2000);
+            assert_eq!(row["before"]["Ok"], json!((core as u32).to_le_bytes()));
+            assert!(row["after"].is_null());
+            assert_eq!(row["context"]["core"], core);
+            assert_eq!(row["context"]["pc"]["Ok"], 0x1000);
+            assert_eq!(
+                row["context"]["spWritePhysical"]["Ok"],
+                0x3000 + core * 0x100
+            );
+        }
+        assert_eq!(trace["records"].as_array().unwrap().len(), 4);
+        session.write(0x2000, &[77; 4]).unwrap();
+        assert_eq!(session.ram_write_watch_snapshot().unwrap()["dropped"], 1);
+        let mut actual = [0; 4];
+        session.read(0x2000, &mut actual).unwrap();
+        assert_eq!(actual, [77; 4]);
+    }
+
+    #[test]
+    fn host_copy_samples_are_clipped_and_have_independent_post_copy_bytes() {
+        let session = board(1);
+        assert!(
+            session
+                .ram_write_watch_begin(vec![(0x2004, 0x2000)], 4)
+                .is_err()
+        );
+        assert!(
+            session
+                .ram_write_watch_begin(vec![(0, 0x500000)], 4)
+                .is_err()
+        );
+        assert!(
+            session
+                .ram_write_watch_begin(vec![(0x2000, 0x2004)], 0)
+                .is_err()
+        );
+        session.write(0x2000, &[0xaa; 8]).unwrap();
+        session
+            .ram_write_watch_begin(vec![(0x2002, 0x2006)], 4)
+            .unwrap();
+        session.write(0x3000, &[1; 8]).unwrap();
+        session.write(0x2000, &[0, 1, 2, 3, 4, 5, 6, 7]).unwrap();
+        let trace = session.ram_write_watch_snapshot().unwrap();
+        assert_eq!(trace["records"].as_array().unwrap().len(), 1);
+        let row = &trace["records"][0];
+        assert_eq!(row["origin"], "host-session-write");
+        assert_eq!(row["samplePhysical"], 0x2002);
+        assert_eq!(row["sampleBytes"], 4);
+        assert_eq!(row["before"]["Ok"], json!([170, 170, 170, 170]));
+        assert_eq!(row["after"]["Ok"], json!([2, 3, 4, 5]));
+        assert!(row["context"].is_null());
+    }
+
+    #[test]
+    fn nonidentity_stack_translation_and_translation_errors_are_retained() {
+        let session = board(1);
+        session.write(0x4000, &0x00000c02u32.to_le_bytes()).unwrap();
+        session
+            .write(0x4000 + 0x802 * 4, &0x00100c02u32.to_le_bytes())
+            .unwrap();
+        let cp = |crn| arm::Coprocessor {
+            cp: 15,
+            opc1: 0,
+            crn,
+            crm: 0,
+            opc2: 0,
+            secure: 0,
+            wide: false,
+        };
+        let cpu = &session.inner.cpus[0];
+        cpu.coprocessor(cp(2), Some(0x4000)).unwrap();
+        cpu.coprocessor(cp(3), Some(0xffff_ffff)).unwrap();
+        let sctlr = cpu.coprocessor(cp(1), None).unwrap();
+        cpu.coprocessor(cp(1), Some(sctlr | 1)).unwrap();
+        session.write_register(0, arm::PC, 0x1000).unwrap();
+        session.write_register(0, arm::CORE[0], 0x80200100).unwrap();
+        session.write_register(0, arm::CORE[1], 0x11223344).unwrap();
+        session
+            .write_register(0, arm::CORE[13], 0x80200140)
+            .unwrap();
+        session
+            .ram_write_watch_begin(vec![(0x100100, 0x100104)], 4)
+            .unwrap();
+        session.run(0, 1).unwrap();
+        let trace = session.ram_write_watch_snapshot().unwrap();
+        assert_eq!(trace["records"][0]["physical"], 0x100100);
+        assert_eq!(trace["records"][0]["context"]["sp"]["Ok"], 0x80200140u32);
+        assert_eq!(
+            trace["records"][0]["context"]["spWritePhysical"]["Ok"],
+            0x100140
+        );
+        let mut actual = [0; 4];
+        session.read(0x100100, &mut actual).unwrap();
+        assert_eq!(actual, 0x11223344u32.to_le_bytes());
+        session.write_register(0, arm::PC, 0x1000).unwrap();
+        session
+            .write_register(0, arm::CORE[13], 0xf0001000)
+            .unwrap();
+        session.run(0, 1).unwrap();
+        let trace = session.ram_write_watch_snapshot().unwrap();
+        assert!(trace["records"][1]["context"]["spWritePhysical"]["Err"].is_string());
+        assert!(session.state(false).failure.is_none());
+    }
+
+    #[test]
+    fn emulated_exclusive_store_has_its_own_post_copy_observation() {
+        let session = board(1);
+        let code: Vec<u8> = [0xe1902f9fu32, 0xe1803f91]
+            .into_iter()
+            .flat_map(u32::to_le_bytes)
+            .collect();
+        session.write(0x1000, &code).unwrap();
+        session.write_register(0, arm::PC, 0x1000).unwrap();
+        session.write_register(0, arm::CORE[0], 0x2000).unwrap();
+        session.write_register(0, arm::CORE[1], 0x11223344).unwrap();
+        session
+            .ram_write_watch_begin(vec![(0x2000, 0x2004)], 4)
+            .unwrap();
+        session.run(0, 1).unwrap();
+        assert_eq!(session.read_register(0, arm::PC).unwrap(), 0x1004);
+        session.run(0, 1).unwrap();
+        assert_eq!(session.read_register(0, arm::PC).unwrap(), 0x1008);
+        assert_eq!(session.read_register(0, arm::CORE[3]).unwrap(), 0);
+        let trace = session.ram_write_watch_snapshot().unwrap();
+        assert_eq!(trace["records"].as_array().unwrap().len(), 1);
+        assert_eq!(trace["records"][0]["origin"], "emulated-strex");
+        assert_eq!(trace["records"][0]["before"]["Ok"], json!([0, 0, 0, 0]));
