+            (
+                overlap.models.len(),
+                overlap.windows.clone(),
+                overlap.snapshots()
+            ),
+            before
+        );
+        minimal["fff74000_ready_fixture_ticks"] = serde_json::json!(8);
+        assert!(Session::new(serde_json::from_value(minimal).unwrap(), None).is_ok());
+    }
