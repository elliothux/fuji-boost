+    #[test]
+    fn early_stale_events_reads_and_ordinary_control_do_not_complete() {
+        let mut m = model();
+        let mut h = Clock::default();
+        write(&mut m, &mut h, CONTROL, 8);
+        write(&mut m, &mut h, STATUS, 0);
+        write(&mut m, &mut h, ARM, 0x40);
+        for completion in [false, true] {
+            let request = m.pending().unwrap();
+            h.now = request.due - 1;
+            let before = m.save();
+            let host = h.clone();
+            m.event(&mut Cx::new(&mut h, 3, 0xdead, 0), request.token);
+            advance(&mut m, &mut h);
+            assert_eq!(m.save(), before);
+            assert_eq!(h, host);
+            h.now = request.due;
+            let expected = if completion { ACK } else { 0 };
+            for _ in 0..8 {
+                assert_eq!(read(&mut m, &mut h, STATUS), expected);
+            }
+            m.event(&mut Cx::new(&mut h, 0, 0, 0), request.token + 10);
+            assert_eq!(m.save(), before);
+            write(&mut m, &mut h, CONTROL, 0);
+            write(&mut m, &mut h, CONTROL, 8);
+            assert!(h.irqs.is_empty());
+            advance(&mut m, &mut h);
+            if !completion {
+                write(&mut m, &mut h, STATUS, ACK);
+            }
+        }
+        let latched = m.save();
+        let host = h.clone();
+        for _ in 0..8 {
+            assert_eq!(read(&mut m, &mut h, STATUS), ACK);
+        }
+        advance(&mut m, &mut h);
+        assert_eq!(m.save(), latched);
+        assert_eq!(h, host);
+        assert!(m.pollable(STATUS, 4));
+        assert!(!m.pollable(ARM, 4));
+        assert!(!m.pollable(STATUS, 8));
+    }
