+//! Synthetic write-zero/ready-bit experiment, with an opt-in second request.
+//! The owner, physical ready mechanism and timing remain unknown.
+use fujimod_emulator_devices::{Cx, Device, Record, Value as Field, checkpoint::Checkpoint};
+use serde::{Deserialize, Serialize};
+
+const NAME: &str = "xp4-fff50000-ready-fixture";
+const ADDRESS: u64 = 0xfff50000;
+const TOKEN: u64 = 1;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Request {
+    command: u32,
+    started: u64,
+    due: u64,
+    token: u64,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+enum Stage {
+    Idle,
+    Pending(Request),
+    Ready(Request),
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct State {
+    ticks: u64,
+    stage: Stage,
+    #[serde(default, skip_serializing_if = "std::ops::Not::not")]
+    allow_second_request: bool,
+}
+
+pub struct Fff50000ReadyFixture {
+    state: State,
+}
+
+impl Fff50000ReadyFixture {
+    pub fn new(ticks: u64) -> Result<Self, String> {
+        if !(1..=1_000_000).contains(&ticks) {
+            return Err("Invalid FFF50000 synthetic ready latency".into());
+        }
+        Ok(Self {
+            state: State {
+                ticks,
+                stage: Stage::Idle,
+                allow_second_request: false,
+            },
+        })
+    }
+
+    /// Permit one later request; ready values and latency remain synthetic laws.
+    pub fn new_with_second_request(ticks: u64) -> Result<Self, String> {
+        let mut fixture = Self::new(ticks)?;
+        fixture.state.allow_second_request = true;
+        Ok(fixture)
+    }
+
+    fn access(address: u64, size: u8) -> bool {
+        address == ADDRESS && size == 4
+    }
+
+    fn validate_state(&self, state: &State) -> Result<(), String> {
+        if state.ticks != self.state.ticks {
+            return Err("FFF50000 checkpoint latency differs".into());
+        }
+        if state.allow_second_request != self.state.allow_second_request {
+            return Err("FFF50000 checkpoint request policy differs".into());
+        }
+        if let Stage::Pending(request) | Stage::Ready(request) = state.stage {
+            if request.command != 0
+                || !(request.token == TOKEN || (state.allow_second_request && request.token == 2))
+                || request.started.checked_add(state.ticks) != Some(request.due)
+            {
+                return Err("Invalid FFF50000 checkpoint request/deadline".into());
+            }
+        }
+        Ok(())
+    }
+}
+
+impl Device for Fff50000ReadyFixture {
+    fn name(&self) -> &'static str {
+        NAME
+    }
+
+    fn read(&mut self, cx: &mut Cx<'_>, address: u64, size: u8) -> u64 {
+        if Self::access(address, size) {
+            match self.state.stage {
+                Stage::Pending(_) => return 0,
+                Stage::Ready(_) => return 1,
+                Stage::Idle => {}
+            }
+        }
+        cx.fail("Unknown FFF50000 synthetic ready read");
+        0
+    }
+
+    fn write(&mut self, cx: &mut Cx<'_>, address: u64, size: u8, value: u64) {
+        if !Self::access(address, size) || value != 0 {
+            cx.fail("Unsupported FFF50000 synthetic ready write");
+            return;
+        }
+        let token = match self.state.stage {
+            Stage::Idle => TOKEN,
+            Stage::Ready(request) if self.state.allow_second_request && request.token == TOKEN => 2,
+            _ => {
+                cx.fail(if self.state.allow_second_request {
+                    "FFF50000 synthetic ready is pending or exhausted"
+                } else {
+                    "FFF50000 synthetic ready accepts only one request"
+                });
+                return;
+            }
+        };
+        let Some(due) = cx.now().checked_add(self.state.ticks) else {
+            cx.fail("FFF50000 synthetic ready deadline overflow");
+            return;
+        };
+        let request = Request {
+            command: 0,
+            started: cx.now(),
+            due,
+            token,
+        };
+        self.state.stage = Stage::Pending(request);
+        cx.schedule(due, token);
+        cx.record(Record::new(
+            "XP4 FFF50000 synthetic request scheduled",
+            [
+                ("address", Field::int(ADDRESS)),
+                ("command", Field::int(request.command)),
+                ("tick", Field::int(request.started)),
+                ("due", Field::int(due)),
+                ("value", Field::int(0u32)),
+            ]
+            .into_iter()
+            .chain(
+                self.state
+                    .allow_second_request
+                    .then_some(("ordinal", Field::int(request.token))),
+            ),
+        ));
+    }
+
+    fn event(&mut self, cx: &mut Cx<'_>, token: u64) {
+        let Stage::Pending(request) = self.state.stage else {
+            return;
+        };
+        if token != request.token || cx.now() < request.due {
+            return;
+        }
+        self.state.stage = Stage::Ready(request);
+        cx.record(Record::new(
+            "XP4 FFF50000 synthetic ready",
+            [
+                ("address", Field::int(ADDRESS)),
+                ("command", Field::int(request.command)),
+                ("tick", Field::int(request.due)),
+                ("due", Field::int(request.due)),
+                ("value", Field::int(1u32)),
+            ]
+            .into_iter()
+            .chain(
+                self.state
+                    .allow_second_request
+                    .then_some(("ordinal", Field::int(request.token))),
+            ),
+        ));
+    }
+
+    fn advance(&mut self, cx: &mut Cx<'_>) {
+        if let Stage::Pending(request) = self.state.stage {
+            self.event(cx, request.token);
+        }
+    }
+
+    fn next_deadline(&self, _: u64) -> Option<u64> {
+        if let Stage::Pending(request) = self.state.stage {
+            Some(request.due)
+        } else {
+            None
+        }
+    }
+
+    fn pollable(&self, address: u64, size: u8) -> bool {
+        Self::access(address, size) && !matches!(self.state.stage, Stage::Idle)
+    }
+
+    fn save(&self) -> serde_json::Value {
+        serde_json::to_value(&self.state).unwrap()
+    }
+
+    fn checkpoint(&self) -> Result<Checkpoint, String> {
+        Checkpoint::encode(NAME, &self.state)
+    }
+
+    fn validate_checkpoint(&self, saved: &Checkpoint) -> Result<(), String> {
+        if !saved.blobs().is_empty() || !saved.children().is_empty() {
+            return Err("Unexpected FFF50000 checkpoint attachments".into());
+        }
+        self.validate_state(&saved.decode(NAME)?)
+    }
+
+    fn restore_checkpoint(&mut self, saved: &Checkpoint) -> Result<(), String> {
+        self.validate_checkpoint(saved)?;
+        self.state = saved.decode(NAME)?;
+        Ok(())
+    }
+
+    fn fingerprint(&self) -> Result<serde_json::Value, String> {
+        Ok(self.save())
+    }
+}
