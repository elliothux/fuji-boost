diff --git a/crates/emulator-xp4-board/src/irq_trace.rs b/crates/emulator-xp4-board/src/irq_trace.rs
new file mode 100644
--- /dev/null
+++ b/crates/emulator-xp4-board/src/irq_trace.rs
@@ -0,0 +1,357 @@
+//! A bounded IRQ/MMIO history. Observation never acknowledges or redirects an IRQ.
+use super::{Cluster, Session};
+use fujimod_emulator_cpu::{Fault, arm};
+use serde_json::{Value, json};
+use std::collections::VecDeque;
+
+const LIMIT: usize = 64;
+pub(super) struct Trace {
+    iar_pc: u32,
+    eoi_pc: u32,
+    return_pcs: Vec<u32>,
+    records: VecDeque<Value>,
+    overwritten: u64,
+    ignored: u64,
+    frozen: Option<Value>,
+}
+
+impl Cluster {
+    pub(super) fn record_irq_event(&self, core: usize, kind: &str, details: Value, freeze: bool) {
+        let (instructions, tick, eligible) = {
+            let state = unsafe { &mut *self.state.get() };
+            let Some(trace) = state.irq_trace.as_mut() else {
+                return;
+            };
+            if trace.frozen.is_some() {
+                trace.ignored = trace.ignored.saturating_add(1);
+                return;
+            }
+            (
+                state.instructions,
+                state.ticks,
+                (0..self.cpus.len())
+                    .map(|core| state.gic.next_irq(core))
+                    .collect::<Vec<_>>(),
+            )
+        };
+        let context = json!({
+            "pc":self.reg(core,arm::PC),"cpsr":self.reg(core,arm::CPSR),"spsr":self.reg(core,arm::SPSR),
+            "r0":self.reg(core,arm::CORE[0]),"r1":self.reg(core,arm::CORE[1]),
+            "r2":self.reg(core,arm::CORE[2]),"r3":self.reg(core,arm::CORE[3]),
+            "sp":self.reg(core,arm::CORE[13]),"lr":self.reg(core,arm::CORE[14])
+        });
+        let frozen = freeze.then(|| {
+            let cp15: serde_json::Map<String, Value> = [
+                ("sctlr", 1, 0, 0, 0),
+                ("ttbr0", 2, 0, 0, 0),
+                ("ttbr1", 2, 0, 0, 1),
+                ("ttbcr", 2, 0, 0, 2),
+                ("dacr", 3, 0, 0, 0),
+                ("fcse", 13, 0, 0, 0),
+            ]
+            .into_iter()
+            .map(|(name, crn, crm, opc1, opc2)| {
+                (name.to_owned(), json!(self.cp(core, crn, crm, opc1, opc2)))
+            })
+            .collect();
+            let banks: Vec<Value> = (0..=1).map(|secure| {
+                let values: serde_json::Map<String,Value> = [
+                    ("sctlr",1,0,0,0), ("ttbr0",2,0,0,0), ("ttbr1",2,0,0,1),
+                    ("ttbcr",2,0,0,2), ("dacr",3,0,0,0), ("fcse",13,0,0,0),
+                    ("scr",1,1,0,0),
+                ].into_iter().map(|(name,crn,crm,opc1,opc2)| {
+                    (name.to_owned(),json!(self.cpus[core].coprocessor(arm::Coprocessor {
+                        cp:15,wide:false,secure,crn,crm,opc1,opc2,
+                    },None)))
+                }).collect();
+                json!({"secureSelector":secure,"registers":values})
+            }).collect();
+            json!({"reason":"IAR MMIO address differs from configured physical GICC_IAR",
+                "configuredGiccIarAddress":self.cbar.map(|base|u64::from(base)+0x200c),
+                "cp15":cp15,"cp15Banks":banks,"gicAfterCallback":unsafe {(*self.state.get()).gic.save()}})
+        });
+        let row = json!({"kind":kind,"core":core,"instructions":instructions,"tick":tick,
+            "eligibleAfterEvent":eligible,"context":context,"details":details});
+        let trace = unsafe { (*self.state.get()).irq_trace.as_mut().unwrap() };
+        if trace.records.len() == LIMIT {
+            trace.records.pop_front();
+            trace.overwritten = trace.overwritten.saturating_add(1);
+        }
+        trace.records.push_back(row);
+        trace.frozen = frozen;
+    }
+
+    pub(super) fn record_irq_instruction(&self, core: usize, address: u64, word: u32) {
+        let kind = {
+            let state = unsafe { &*self.state.get() };
+            let Some(trace) = state.irq_trace.as_ref() else {
+                return;
+            };
+            if address == u64::from(trace.iar_pc) {
+                "iar-pre-instruction"
+            } else if address == u64::from(trace.eoi_pc) {
+                "eoi-pre-instruction"
+            } else if Some(address) == u64::from(trace.iar_pc).checked_sub(4) {
+                "iar-predecessor-pre-instruction"
+            } else if Some(address) == u64::from(trace.eoi_pc).checked_sub(4) {
+                "eoi-predecessor-pre-instruction"
+            } else if trace.return_pcs.iter().any(|&pc| address == u64::from(pc)) {
+                "return-site-pre-instruction"
+            } else {
+                return;
+            }
+        };
+        self.record_irq_event(core,kind,json!({"fetchInspectionWord":word,"address":address,
+            "meaning":"Pre-instruction hook and Fetch inspection, not retired opcode or completed exception return"}),false);
+    }
+
+    pub(super) fn record_irq_mmio(
+        &self,
+        core: usize,
+        pc: Option<u32>,
+        (base, offset, address, size, write, value): (u64, u64, u64, u32, bool, u64),
+        result: &Result<u64, String>,
+        gic_result: &Option<Result<u32, String>>,
+    ) {
+        let freeze = {
+            let state = unsafe { &*self.state.get() };
+            let Some(trace) = state.irq_trace.as_ref() else {
+                return;
+            };
+            let is_iar = !write && pc == Some(trace.iar_pc);
+            let is_eoi = write && pc == Some(trace.eoi_pc);
+            if !is_iar && !is_eoi && gic_result.is_none() {
+                return;
+            }
+            is_iar && Some(address) != self.cbar.map(|base| u64::from(base) + 0x200c)
+        };
+        self.record_irq_event(core,"mmio-result",json!({"pcUsedByCallback":pc,"callbackAddress":address,
+            "mmioWindowBase":base,"normalizedCallbackOffset":offset,
+            "backendCallbackContext":self.cpus[core].mmio_callback_context(),
+            "backendDispatchInfo":[self.cpus[core].physical_dispatch_info(0),self.cpus[core].physical_dispatch_info(1)],
+            "size":size,"write":write,"writeOperand":if write{Some(value)}else{None},
+            "response":result,"gicAccessResult":gic_result,
+            "meaning":"Same MMIO invocation. Address is window base plus normalized callback offset, not an independent MMU PA observation. Backend coordinates identify the active mapping/offset, not the translation stage. GIC result null means its access function was not called"}),freeze);
+    }
+
+    pub(super) fn record_irq_fault(&self, core: usize, kind: Fault, address: u64, size: i32) {
+        let state = unsafe { &*self.state.get() };
+        let Some(trace) = state.irq_trace.as_ref() else {
+            return;
+        };
+        if trace.frozen.is_some() {
+            return;
+        }
+        let pc = self.reg(core, arm::PC);
+        if pc != Ok(trace.iar_pc) && pc != Ok(trace.eoi_pc) {
+            return;
+        }
+        let page = address & !0xfff;
+        let existed = state.pages.contains_key(&page);
+        self.record_irq_event(core,"invalid-memory-before-discovery",json!({
+            "fault":format!("{kind:?}"),"rawAddress":address,"size":size,
+            "page":page,"discoveryPageAlreadyPresent":existed,
+            "meaning":"Original CPU fault callback before discovery mapping; not an extra translation or a proven final guest-data target"
+        }),false);
+    }
+}
+
+impl Session {
+    pub fn irq_trace_begin(
+        &self,
+        iar_pc: u32,
+        eoi_pc: u32,
+        return_pcs: Vec<u32>,
+    ) -> Result<(), String> {
+        let state = unsafe { &mut *self.inner.state.get() };
+        if self.inner.running.get()
+            || state.failure.is_some()
+            || state.driver_guard.is_some()
+            || state.irq_trace.is_some()
+            || self.inner.cbar.is_none()
+        {
+            return Err("IRQ trace requires a healthy paused unguarded board with CBAR and no previous IRQ trace".into());
+        }
+        if iar_pc & 3 != 0
+            || eoi_pc & 3 != 0
+            || iar_pc == eoi_pc
+            || return_pcs.len() > 8
+            || return_pcs.iter().any(|pc| pc & 3 != 0)
+        {
+            return Err("IRQ trace requires aligned ARM instruction points".into());
+        }
+        state.irq_trace = Some(Trace {
+            iar_pc,
+            eoi_pc,
+            return_pcs,
+            records: VecDeque::new(),
+            overwritten: 0,
+            ignored: 0,
+            frozen: None,
+        });
+        Ok(())
+    }
+
+    pub fn irq_trace_snapshot(&self) -> Option<Value> {
+        let state = unsafe { &*self.inner.state.get() };
+        state.irq_trace.as_ref().map(|trace|json!({"limit":LIMIT,"records":trace.records,
+            "physicalDispatchByCore":self.inner.cpus.iter().map(|cpu|[cpu.physical_dispatch_info(0),cpu.physical_dispatch_info(1)]).collect::<Vec<_>>(),
+            "overwrittenBeforeFreeze":trace.overwritten,"ignoredAfterFreeze":trace.ignored,
+            "frozen":trace.frozen.is_some(),"freezeContext":trace.frozen,
+            "meaning":"Last bounded events before the first unexpected IAR MMIO address, or current tail if never frozen. CPU register and Fetch reads are debugger observations. IRQ entry registers are saved before redirect; return sites are pre-instruction only. No MMU walk, extra GIC read, IRQ acknowledgment or guest flow change."}))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::Definition;
+
+    fn board(words: &[u32], discovery: bool) -> Session {
+        let definition: Definition = serde_json::from_value(json!({"ram_size":65536,"cores":1,
+            "discovery":discovery,"cbar":0xffff0000u32}))
+        .unwrap();
+        let board = Session::new(definition, None).unwrap();
+        let code: Vec<u8> = words.iter().copied().flat_map(u32::to_le_bytes).collect();
+        board.write(0x1000, &code).unwrap();
+        board.write_register(0, arm::PC, 0x1000).unwrap();
+        board
+    }
+
+    fn pending64(board: &Session) {
+        let state = unsafe { &mut *board.inner.state.get() };
+        for (dist, offset, value) in [
+            (true, 0, 1),
+            (true, 0x108, 1),
+            (false, 0, 1),
+            (false, 4, 255),
+        ] {
+            state.gic.access(0, dist, offset, 4, true, value).unwrap();
+        }
+        state.gic.pulse(64);
+        assert_eq!(state.gic.next_irq(0), Some(64));
+    }
+
+    #[test]
+    fn native_gic_iar_and_eoi_have_same_call_results_without_changing_execution() {
+        let words = [0xee9f1f10, 0xe2811a02, 0xe591000c, 0xe5810010];
+        let control = board(&words, false);
+        let traced = board(&words, false);
+        pending64(&control);
+        pending64(&traced);
+        let before = serde_json::to_value(traced.state(true)).unwrap();
+        traced.irq_trace_begin(0x1008, 0x100c, vec![]).unwrap();
+        assert_eq!(serde_json::to_value(traced.state(true)).unwrap(), before);
+        control.run_board(4, 1024).unwrap();
+        traced.run_board(4, 1024).unwrap();
+        assert_eq!(
+            serde_json::to_value(traced.state(true)).unwrap(),
+            serde_json::to_value(control.state(true)).unwrap()
+        );
+        assert_eq!(traced.read_register(0, arm::CORE[0]).unwrap(), 64);
+        assert_eq!(unsafe { (*traced.inner.state.get()).gic.save() }, unsafe {
+            (*control.inner.state.get()).gic.save()
+        });
+        let trace = traced.irq_trace_snapshot().unwrap();
+        assert_eq!(trace["frozen"], false);
+        let mmio: Vec<_> = trace["records"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .filter(|r| r["kind"] == "mmio-result")
+            .collect();
+        assert_eq!(mmio.len(), 2);
+        assert_eq!(mmio[0]["details"]["callbackAddress"], 0xffff200cu32);
+        assert_eq!(mmio[0]["details"]["mmioWindowBase"], 0xffff2000u32);
+        assert_eq!(mmio[0]["details"]["normalizedCallbackOffset"], 0xc);
+        let backend = &mmio[0]["details"]["backendCallbackContext"];
+        assert_eq!(backend["mapping_base"], 0xffff2000u32);
+        assert_eq!(backend["mapping_bytes"], 4096);
+        assert_eq!(backend["backend_offset"], 0xc);
+        assert_eq!(backend["context_offset"], 0);
+        assert_eq!(backend["normalized_offset"], 0xc);
+        assert_eq!(mmio[0]["details"]["response"]["Ok"], 64);
+        assert_eq!(mmio[0]["details"]["gicAccessResult"]["Ok"], 64);
+        assert_eq!(mmio[0]["context"]["r1"]["Ok"], 0xffff2000u32);
+        assert_eq!(mmio[1]["details"]["writeOperand"], 64);
+        assert_eq!(mmio[1]["details"]["response"]["Ok"], 0);
+    }
+
+    #[test]
+    fn first_unexpected_iar_freezes_a_bounded_tail_and_keeps_errors_explicit() {
+        let traced = board(&[0xee9f1f10, 0xeafffffd, 0xe591000c], true);
+        assert!(traced.irq_trace_begin(0x1009, 0x100c, vec![]).is_err());
+        traced
+            .irq_trace_begin(0x1008, 0x100c, vec![0x1004])
+            .unwrap();
+        assert!(traced.irq_trace_begin(0x1008, 0x100c, vec![]).is_err());
+        traced.run_board(200, 1024).unwrap();
+        let tail = traced.irq_trace_snapshot().unwrap();
+        assert_eq!(tail["records"].as_array().unwrap().len(), LIMIT);
+        assert!(tail["overwrittenBeforeFreeze"].as_u64().unwrap() > 0);
+        assert_eq!(tail["frozen"], false);
+        traced.write_register(0, arm::PC, 0x1008).unwrap();
+        traced.write_register(0, arm::CORE[1], 0x7adb1400).unwrap();
+        traced.run_board(1, 1024).unwrap();
+        let frozen = traced.irq_trace_snapshot().unwrap();
+        assert_eq!(frozen["frozen"], true);
+        let last = frozen["records"].as_array().unwrap().last().unwrap();
+        assert_eq!(last["kind"], "mmio-result");
+        assert_eq!(last["details"]["callbackAddress"], 0x7adb140c);
+        assert_eq!(last["details"]["response"]["Ok"], 0);
+        assert!(last["details"]["gicAccessResult"].is_null());
+        assert_eq!(last["context"]["r1"]["Ok"], 0x7adb1400);
+        assert_eq!(
+            frozen["freezeContext"]["configuredGiccIarAddress"],
+            0xffff200cu32
+        );
+        assert!(frozen["freezeContext"]["cp15"]["ttbr0"]["Ok"].is_number());
+        assert_eq!(
+            frozen["freezeContext"]["cp15Banks"]
+                .as_array()
+                .unwrap()
+                .len(),
+            2
+        );
+        let fault = frozen["records"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .find(|row| row["kind"] == "invalid-memory-before-discovery")
+            .unwrap();
+        assert_eq!(fault["details"]["rawAddress"], 0x7adb140c);
+        assert_eq!(fault["details"]["discoveryPageAlreadyPresent"], false);
+        traced.write_register(0, arm::PC, 0x1008).unwrap();
+        traced.run_board(1, 1024).unwrap();
+        let after = traced.irq_trace_snapshot().unwrap();
+        assert_eq!(after["records"], frozen["records"]);
+        assert_eq!(after["freezeContext"], frozen["freezeContext"]);
+        assert!(after["ignoredAfterFreeze"].as_u64().unwrap() > 0);
+        assert!(traced.state(false).failure.is_none());
+    }
+
+    #[test]
+    fn irq_entry_saved_registers_and_return_site_are_observed_without_acknowledging() {
+        let traced = board(&[0xe320f000], false);
+        traced.write(0x18, &0xe25ef004u32.to_le_bytes()).unwrap(); // SUBS pc,lr,#4
+        traced.write_register(0, arm::CPSR, 0x53).unwrap();
+        pending64(&traced);
+        traced.irq_trace_begin(0x1008, 0x100c, vec![0x18]).unwrap();
+        traced.run_board(2, 1024).unwrap();
+        let trace = traced.irq_trace_snapshot().unwrap();
+        let rows = trace["records"].as_array().unwrap();
+        assert!(
+            rows.iter().any(
+                |r| r["kind"] == "irq-entry-after-registers" && r["details"]["oldCpsr"] == 0x53
+            )
+        );
+        assert!(
+            rows.iter()
+                .any(|r| r["kind"] == "return-site-pre-instruction")
+        );
+        assert_eq!(
+            unsafe { (*traced.inner.state.get()).gic.next_irq(0) },
+            Some(64)
+        );
