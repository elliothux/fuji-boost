diff --git a/crates/emulator-cpu-unicorn/src/mmio_context_tests.rs b/crates/emulator-cpu-unicorn/src/mmio_context_tests.rs
new file mode 100644
--- /dev/null
+++ b/crates/emulator-cpu-unicorn/src/mmio_context_tests.rs
@@ -0,0 +1,108 @@
+use super::*;
+
+struct Probe {
+    cpu: *const Core,
+    records: Vec<MmioCallbackContext>,
+}
+unsafe fn read(_: u64, _: u32, data: *mut c_void) -> u64 {
+    let probe = unsafe { &mut *data.cast::<Probe>() };
+    let cpu = unsafe { &*probe.cpu };
+    let active = cpu.mmio_callback_context().unwrap();
+    let mut bytes = [0; 4];
+    assert!(cpu.read_memory(0xffff2020, &mut bytes).is_err());
+    assert_eq!(cpu.mmio_callback_context(), Some(active));
+    probe.records.push(active);
+    0x12345678
+}
+unsafe fn write(_: u64, _: u32, value: u64, data: *mut c_void) {
+    let probe = unsafe { &mut *data.cast::<Probe>() };
+    assert_eq!(value, 0x12345678);
+    probe
+        .records
+        .push(unsafe { &*probe.cpu }.mmio_callback_context().unwrap());
+}
+
+#[test]
+fn a7_mmio_context_exposes_raw_and_split_offsets_only_during_callback() {
+    let library = test_support::library();
+    let cpu = library.open(Model::CortexA7, 4 * 1024 * 1024).unwrap();
+    let mut probe = Box::new(Probe {
+        cpu: &cpu,
+        records: Vec::new(),
+    });
+    cpu.map_zeroed(0x1000, 4096, 7).unwrap();
+    cpu.write_memory(
+        0x1000,
+        &[0xe5910000u32, 0xe5810004]
+            .into_iter()
+            .flat_map(u32::to_le_bytes)
+            .collect::<Vec<_>>(),
+    )
+    .unwrap();
+    unsafe {
+        cpu.map_mmio(
+            0xffff0000,
+            0x3000,
+            Mmio {
+                read,
+                write,
+                data: (&mut *probe as *mut Probe).cast(),
+            },
+        )
+        .unwrap();
+    }
+    cpu.protect(0xffff1000, 0x1000, 1).unwrap();
+    cpu.write_register(arm::CORE[1], &0xffff2020u32.to_le_bytes())
+        .unwrap();
+    assert_eq!(cpu.mmio_callback_context(), None);
+    cpu.run(Run {
+        begin: 0x1000,
+        until: Some(0x1008),
+        watchdog_us: 0,
+        instructions: Some(2),
+    })
+    .unwrap();
+    assert_eq!(cpu.mmio_callback_context(), None);
+    assert_eq!(probe.records.len(), 2);
+    let a = probe.records[0];
+    let b = probe.records[1];
+    assert_eq!((a.mapping_base, a.mapping_bytes), (0xffff2000, 4096));
+    assert_eq!(
+        (a.backend_offset, a.context_offset, a.normalized_offset),
+        (0x20, 0x2000, 0x2020)
+    );
+    assert_eq!(
+        (b.backend_offset, b.context_offset, b.normalized_offset),
+        (0x24, 0x2000, 0x2024)
+    );
+    assert_eq!(a.mapping_id, b.mapping_id);
+    assert!(a.mapping_id > 0);
+    assert_eq!((a.size, a.write, b.size, b.write), (4, false, 4, true));
+}
+
+#[test]
+fn nested_callback_scope_restores_the_outer_context() {
+    let inspection = Rc::new(Inspection::default());
+    let context = MmioData {
+        callbacks: Mmio {
+            read,
+            write,
+            data: std::ptr::null_mut(),
+        },
+        fast_reads: Vec::new(),
+        inspection: inspection.clone(),
+        offset: 0x1000,
+        mapping_id: 7,
+        mapping_base: 0x8000,
+        mapping_bytes: 4096,
+    };
+    let outer = context.enter_callback(0xc, 4, false);
+    let before = inspection.mmio_callback.get().unwrap();
+    {
+        let _inner = context.enter_callback(0x10, 4, true);
+        assert_eq!(inspection.mmio_callback.get().unwrap().backend_offset, 0x10);
+    }
+    assert_eq!(inspection.mmio_callback.get(), Some(before));
+    drop(outer);
+    assert_eq!(inspection.mmio_callback.get(), None);
+}
