+    fn record_abort_failure(
+        &self,
+        core: usize,
+        fetch: bool,
+        source: &'static str,
+        pc: Option<u32>,
+        word: Option<u32>,
+        error: &str,
+    ) {
+        let registers = arm::CORE
+            .iter()
+            .map(|&register| self.reg(core, register))
+            .collect::<Vec<_>>();
+        let cpsr = self.reg(core, arm::CPSR);
+        let spsr = self.reg(core, arm::SPSR);
+        let cp15: std::collections::BTreeMap<_, _> = [
+            ("sctlr", 1, 0, 0),
+            ("ttbcr", 2, 0, 2),
+            ("ttbr0", 2, 0, 0),
+            ("ttbr1", 2, 0, 1),
+            ("dacr", 3, 0, 0),
+            ("fcse", 13, 0, 0),
+            ("dfsr", 5, 0, 0),
+            ("dfar", 6, 0, 0),
+            ("ifsr", 5, 0, 1),
+            ("ifar", 6, 0, 2),
+            ("par", 7, 4, 0),
+            ("vbar", 12, 0, 0),
+        ]
+        .into_iter()
+        .map(|(name, crn, crm, opc2)| (name, self.cp(core, crn, crm, 0, opc2)))
+        .collect();
+        let fetch_inspection = pc.map(|address| {
+            let physical = self.cpus[core].translate(u64::from(address), Access::Fetch);
+            let backing_word = physical.as_ref().ok().map(|&physical| {
+                let pointer = self.memory_pointer(physical, 4, 1)?;
+                Ok::<_, String>(u32::from_le(unsafe {
+                    std::ptr::read_unaligned(pointer.cast::<u32>())
+                }))
+            });
+            serde_json::json!({"physical": physical, "backing_word": backing_word})
+        });
+        let (instructions, ticks, last_hook) = {
+            let state = unsafe { &*self.state.get() };
+            (
+                state.instructions,
+                state.ticks,
+                state.recent[core].back().copied(),
+            )
+        };
+        let diagnostic = serde_json::json!({
+            "source": source, "kind": if fetch {"prefetch"} else {"data"}, "core": core,
+            "error": error, "pc_used_for_diagnosis": pc, "word_used_for_decode": word,
+            "registers_after_failure": registers, "cpsr_after_failure": cpsr,
+            "spsr_after_failure": spsr, "cp15_after_failure": cp15,
+            "fetch_inspection_after_failure": fetch_inspection,
+            "instructions": instructions, "ticks": ticks, "last_instruction_hook": last_hook,
+            "meaning": "First abort diagnosis/delivery failure. Registers and Fetch/physical backing are debugger reads after failure; translation may affect soft TLB. The decoded word and last hook share Fetch inspection, not independent retired opcode evidence. No guest instruction is skipped or executed by this diagnostic."
+        });
+        unsafe { (*self.state.get()).abort_failure = Some(diagnostic) };
+    }
+
+    pub(super) fn deliver_abort(
+        &self,
+        core: usize,
+        fetch: bool,
+        source: &'static str,
+    ) -> Result<(), String> {
+        let mut pc_used = None;
+        let mut word_used = None;
+        let result: Result<(), String> = (|| {
+            let pc = self.reg(core, arm::PC)?;
+            pc_used = Some(pc);
+            let mmu = Mmu::read(self, core)?;
+            if fetch {
+                let status = mmu
+                    .status(self, pc, Access::Fetch, mmu.user)?
+                    .ok_or("Prefetch abort is not explained by the architectural page tables")?;
+                return self.abort_entry(core, pc, pc, status, Access::Fetch);
+            }
+            let word = self.word(core, u64::from(pc))?;
+            word_used = Some(word);
+            let transfer = transfer(self, core, pc, word)?;
+            if transfer.address & (transfer.alignment - 1) != 0 {
+                if mmu.sctlr & 2 != 0 || transfer.exclusive {
+                    return self.abort_entry(core, pc, transfer.address, 1, transfer.access);
+                }
+                return Err("Unaligned ARM data-abort diagnosis is unsupported".into());
+            }
+            let mut offset = 0;
+            while offset < transfer.bytes {
+                let address = transfer.address.wrapping_add(offset);
+                if let Some(status) =
+                    mmu.status(self, address, transfer.access, mmu.user || transfer.user)?
+                {
+                    return self.abort_entry(core, pc, address, status, transfer.access);
+                }
+                offset += (4096 - (address & 4095)).min(transfer.bytes - offset);
+            }
+            Err("Data abort is not explained by the architectural page tables".into())
+        })();
+        if let Err(error) = &result
+            && unsafe { (*self.state.get()).abort_failure.is_none() }
+        {
+            self.record_abort_failure(core, fetch, source, pc_used, word_used, error);
+        }
+        result
+    }
+}
