+        let mut minimal = serde_json::json!({"ram_size":65536,"cores":1,"discovery":true});
+        let definition: Definition = serde_json::from_value(minimal.clone()).unwrap();
+        assert!(definition.fff74000_ready_fixture_ticks.is_none());
