--- /dev/null
+++ b/crates/emulator-xp4-board/src/ram_write_watch.rs
@@ -0,0 +1,339 @@
+//! Opt-in physical RAM write observations. CPU callbacks are pre-store operands.
+use super::{Cluster, Session};
+use fujimod_emulator_cpu::{Access, arm};
+use serde::Serialize;
+
+#[derive(Clone, Serialize)]
+struct Context {
+    core: usize,
+    pc: Result<u32, String>,
+    cpsr: Result<u32, String>,
+    sp: Result<u32, String>,
+    #[serde(rename = "spWritePhysical")]
+    sp_write_physical: Result<u64, String>,
+}
+
+#[derive(Clone, Serialize)]
+pub(super) struct Record {
+    origin: &'static str,
+    physical: u64,
+    size: usize,
+    #[serde(rename = "samplePhysical")]
+    sample_physical: u64,
+    #[serde(rename = "sampleBytes")]
+    sample_bytes: usize,
+    before: Result<Vec<u8>, String>,
+    after: Option<Result<Vec<u8>, String>>,
+    value: Option<u64>,
+    context: Option<Context>,
+    instructions: u64,
+    tick: u64,
+}
+
+pub(super) struct Watch {
+    ranges: Vec<(u64, u64)>,
+    limit: usize,
+    records: Vec<Record>,
+    dropped: u64,
+}
+
+impl Cluster {
+    fn sample_physical(&self, address: u64, length: usize) -> Result<Vec<u8>, String> {
+        let source = self.memory_pointer(address, length, 1)?;
+        Ok(unsafe { std::slice::from_raw_parts(source, length) }.to_vec())
+    }
+
+    pub(super) fn record_ram_write(
+        &self,
+        origin: &'static str,
+        core: Option<usize>,
+        address: u64,
+        size: usize,
+        value: Option<u64>,
+    ) -> Option<usize> {
+        let (sample, length, instructions, tick) = {
+            let state = unsafe { &mut *self.state.get() };
+            let watch = state.ram_write_watch.as_mut()?;
+            let &(lo, hi) = watch.ranges.iter().find(|&&(lo, hi)| {
+                size != 0 && address < hi && lo < address.saturating_add(size as u64)
+            })?;
+            if watch.records.len() == watch.limit {
+                watch.dropped = watch.dropped.saturating_add(1);
+                return None;
+            }
+            let sample = address.max(lo);
+            let length = (hi.min(address.saturating_add(size as u64)) - sample).min(32);
+            (sample, length as usize, state.instructions, state.ticks)
+        };
+        let context = core.map(|core| {
+            let sp = self.reg(core, arm::CORE[13]);
+            let sp_write_physical = sp
+                .as_ref()
+                .map_err(Clone::clone)
+                .and_then(|&sp| self.cpus[core].translate(u64::from(sp), Access::Write));
+            Context {
+                core,
+                pc: self.reg(core, arm::PC),
+                cpsr: self.reg(core, arm::CPSR),
+                sp,
+                sp_write_physical,
+            }
+        });
+        let record = Record {
+            origin,
+            physical: address,
+            size,
+            sample_physical: sample,
+            sample_bytes: length,
+            before: self.sample_physical(sample, length),
+            after: None,
+            value,
+            context,
+            instructions,
+            tick,
+        };
+        let watch = unsafe { (*self.state.get()).ram_write_watch.as_mut()? };
+        let index = watch.records.len();
+        watch.records.push(record);
+        Some(index)
+    }
+
+    /// Only called after a successful host copy, never to certify a CPU hook.
+    pub(super) fn finish_ram_write(&self, index: Option<usize>) {
+        let Some(index) = index else { return };
+        let (address, length) = {
+            let state = unsafe { &*self.state.get() };
+            let record = &state.ram_write_watch.as_ref().unwrap().records[index];
+            (record.sample_physical, record.sample_bytes)
+        };
+        let after = self.sample_physical(address, length);
+        unsafe {
+            (*self.state.get())
+                .ram_write_watch
+                .as_mut()
+                .unwrap()
+                .records[index]
+                .after = Some(after)
+        };
+    }
+}
+
+impl Session {
+    pub fn ram_write_watch_begin(
+        &self,
+        ranges: Vec<(u64, u64)>,
+        limit: usize,
+    ) -> Result<(), String> {
+        let state = unsafe { &mut *self.inner.state.get() };
+        if self.inner.running.get()
+            || state.driver_guard.is_some()
+            || state.ram_write_watch.is_some()
+        {
+            return Err("RAM write watch requires an unguarded paused board without an existing write watch".into());
+        }
+        if ranges.is_empty()
+            || ranges.len() > 8
+            || !(1..=4096).contains(&limit)
+            || ranges
+                .iter()
+                .any(|&(lo, hi)| lo >= hi || hi > self.inner.ram.len() as u64)
+        {
+            return Err(
+                "RAM write watch requires bounded physical RAM ranges and record limit".into(),
+            );
+        }
+        state.ram_write_watch = Some(Watch {
+            ranges,
+            limit,
+            records: vec![],
+            dropped: 0,
+        });
+        Ok(())
+    }
+
+    pub fn ram_write_watch_snapshot(&self) -> Option<serde_json::Value> {
+        let state = unsafe { &*self.inner.state.get() };
+        state.ram_write_watch.as_ref().map(|watch| serde_json::json!({
+            "ranges":watch.ranges,"limit":watch.limit,"records":watch.records,"dropped":watch.dropped
+        }))
+    }
+}
+
