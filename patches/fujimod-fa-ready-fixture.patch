+        restored.advance(&mut Cx::new(&mut clock, 3, 0x1234, 0));
+        device
+            .restore_checkpoint(&restored.checkpoint().unwrap())
+            .unwrap();
+        assert_eq!(device.save(), restored.save());
+        refused(&mut device, &mut clock, ADDRESS, 4, Some(1));
+        let mut unknown_request = pending.decode::<serde_json::Value>(NAME).unwrap();
+        unknown_request["stage"]["Pending"]["extra"] = serde_json::json!(1);
+        let mut invalid = vec![
+            pending.clone().with_children(vec![restored.checkpoint().unwrap()]),
+            pending.clone().with_blobs(vec![vec![1u8].into()]),
+            Checkpoint::encode("other-device", &device.state).unwrap(),
+            Checkpoint::encode(NAME, &unknown_request).unwrap(),
+            Checkpoint::encode(NAME, &serde_json::json!({"ticks":8,"stage":"Unknown","allow_second_command":true})).unwrap(),
+            Checkpoint::encode(NAME, &serde_json::json!({"ticks":8,"stage":"Idle","allow_second_command":true,"extra":1})).unwrap(),
+        ];
+        for malformed in 0..7 {
+            let mut bad: State = pending.decode(NAME).unwrap();
+            if let Stage::Pending(ref mut request) = bad.stage {
+                match malformed {
+                    0 => request.command = 0,
+                    1 => request.token = 0,
+                    2 => request.token = 3,
+                    3 => request.due += 1,
+                    4 => request.started = u64::MAX,
+                    5 => bad.ticks = 9,
+                    _ => bad.allow_second_command = false,
+                }
+            }
+            invalid.push(Checkpoint::encode(NAME, &bad).unwrap());
+        }
+        for saved in invalid {
+            let before = device.save();
+            assert!(device.restore_checkpoint(&saved).is_err());
