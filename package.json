{
  "name": "fuji-boost",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc -b && cargo fmt --check && cargo fmt --manifest-path crates/xp4/Cargo.toml --check && cargo clippy -p fuji-boost-core --all-targets -- -D warnings && cargo clippy --manifest-path crates/xp4/Cargo.toml --lib -- -D warnings",
    "test": "cargo test --workspace && cargo test --manifest-path crates/xp4/Cargo.toml --lib && cargo test --manifest-path crates/xp4/Cargo.toml -p fujimod-emulator-cpu-unicorn -p fujimod-emulator-xp4-io -p fujimod-emulator-xp4-storage -p fujimod-emulator-xp4-board -p fujimod-emulator-xp4-display -p fujimod-emulator-ip-arm --lib && bun test src/lib",
    "test:xt4": "cargo test -p fuji-boost-core --test xt4 -- --ignored --nocapture",
    "setup": "bun scripts/setup.ts",
    "firmware:build": "bun firmware/build.ts",
    "firmware:app": "bun firmware/build.ts --watch",
    "firmware:profile": "cargo test --release --manifest-path crates/xp4/Cargo.toml --test custom -- --ignored --exact pocket_profile && bun firmware/profile.ts",
    "test:xt4:custom": "bun firmware/build.ts && cargo test --release --manifest-path crates/xp4/Cargo.toml --test custom -- --ignored --nocapture --test-threads=1 --skip pocket_profile",
    "test:xt4:cpu": "mkdir -p .temp && cargo run --manifest-path crates/xp4/Cargo.toml --example xt4 > .temp/xt4-cpu-run.json",
    "test:xt4:rec": "cargo test --release --manifest-path crates/xp4/Cargo.toml --test camera -- --ignored --exact rec_ui --nocapture",
    "test:xt4:endurance": "cargo test --release --manifest-path crates/xp4/Cargo.toml --test camera -- --ignored --exact endurance --nocapture",
    "test:xt4:checkpoint": "cargo test --release --manifest-path crates/xp4/Cargo.toml --test camera -- --ignored --exact checkpoint_full --nocapture",
    "test:xt4:scene": "cargo test --release --manifest-path crates/xp4/Cargo.toml --test camera -- --ignored --exact scene --nocapture",
    "test:xt4:long": "cargo test --release --manifest-path crates/xp4/Cargo.toml --test research -- --ignored --exact long --nocapture",
    "test:xt4:calibration": "cargo test --release --manifest-path crates/xp4/Cargo.toml --test research -- --ignored --exact calibration --nocapture",
    "test:xt4:scenarios": "cargo test --manifest-path crates/xp4/Cargo.toml --lib -- --ignored --nocapture",
    "research:xt4": "mkdir -p .temp/xt4-board && cargo run --manifest-path crates/xp4/Cargo.toml --example discover > .temp/xt4-board/discovery.json",
    "research:xt4:ready": "mkdir -p .temp/xt4-board && cargo run --manifest-path crates/xp4/Cargo.toml --example discover -- --power-ready > .temp/xt4-board/ready-probe.json",
    "research:xt4:commands": "mkdir -p .temp/xt4-board && cargo run --manifest-path crates/xp4/Cargo.toml --example discover -- --power-commands > .temp/xt4-board/command-probe.json",
    "research:xt4:retained": "mkdir -p .temp/xt4-board && cargo run --manifest-path crates/xp4/Cargo.toml --example discover -- --empty-retained > .temp/xt4-board/retained-probe.json",
    "research:xt4:flash": "mkdir -p .temp/xt4-board && cargo run --manifest-path crates/xp4/Cargo.toml --example discover -- --erased-flash > .temp/xt4-board/erased-flash-probe.json",
    "research:xt4:training": "mkdir -p .temp/xt4-board && cargo run --manifest-path crates/xp4/Cargo.toml --example discover -- --training > .temp/xt4-board/training-probe.json",
    "research:xt4:smp": "mkdir -p .temp/xt4-board && cargo run --manifest-path crates/xp4/Cargo.toml --example smp_trace > .temp/xt4-board/smp-trace.json",
    "research:xt4:ordered": "mkdir -p .temp/xt4-board && cargo run --manifest-path crates/xp4/Cargo.toml --example discover -- --ordered-startup 10 > .temp/xt4-board/ordered-probe.json",
    "research:xt4:main-init": "mkdir -p .temp/xt4-board && cargo run --manifest-path crates/xp4/Cargo.toml --example main_trace > .temp/xt4-board/main-init-trace.json",
    "research:xt4:supported-nor": "mkdir -p .temp/xt4-board && cargo run --manifest-path crates/xp4/Cargo.toml --example main_trace -- --supported-nor > .temp/xt4-board/supported-nor-probe.json",
    "test:xt4:rec:measured": "cargo test --release --manifest-path crates/xp4/Cargo.toml --test camera -- --ignored --exact rec_measured --nocapture",
    "test:browser:camera": "node scripts/test-browser-camera.ts",
    "camera:native": "sh scripts/native-camera.sh",
    "test:xt4:checkpoint:load": "cargo test --release --manifest-path crates/xp4/Cargo.toml --test camera -- --ignored --exact checkpoint_load --nocapture",
    "test:xt4:setup-crawl": "cargo test --release --manifest-path crates/xp4/Cargo.toml --test camera -- --ignored --exact setup_crawl --nocapture",
    "test:xt4:menu-tabs": "cargo test --release --manifest-path crates/xp4/Cargo.toml --test camera -- --ignored --exact menu_tabs --nocapture",
    "test:xt4:dials": "cargo test --release --manifest-path crates/xp4/Cargo.toml --test camera -- --ignored --exact dials --nocapture",
    "test:xt4:modded": "cargo test --release --manifest-path crates/xp4/Cargo.toml --test camera -- --ignored --exact modded --nocapture",
    "research:xt4:inputs": "cargo test --release --manifest-path crates/xp4/Cargo.toml --test research -- --ignored --exact compare_measured_inputs --nocapture"
  },
  "dependencies": {
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@tailwindcss/vite": "latest",
    "@types/bun": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "playwright-core": "1.58.2",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "latest"
  }
}
