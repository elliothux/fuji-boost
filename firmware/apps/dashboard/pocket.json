{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.fuji-boost.dashboard",
  "name": "fuji-boost-dashboard",
  "title": "fuji-boost: Dashboard",
  "version": "0.1.0",
  "engine": {
    "capabilities": {
      "requires": ["input.buttons", "text.glyphs.baked"],
      "enhances": ["input.touch"]
    }
  },
  "app": {
    "entry": "firmware/apps/dashboard/main.tsx",
    "output": "dashboard",
    "framework": "solid",
    "viewport": {
      "fixed": {
        "logical": [450, 300],
        "presentation": "native"
      }
    }
  }
}
